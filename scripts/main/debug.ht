      questKind = 'hidden_thunder_gulch'
    } else if (kind == 'shoot') {
      questKind = 'hidden_mist_shoot'
    } else if (kind == 'brook') {
      questKind = 'hidden_blood_brook'
    } else if (kind == 'bud') {
      questKind = 'hidden_mist_bud'
    } else if (kind == 'berm') {
      questKind = 'hidden_thunder_berm'
    } else if (kind == 'calyx') {
      questKind = 'hidden_mist_calyx'
    } else if (kind == 'eyot') {
      questKind = 'hidden_blood_eyot'
    } else if (kind == 'levee') {
      questKind = 'hidden_thunder_levee'
    } else if (kind == 'pistil') {
      questKind = 'hidden_mist_pistil'
    } else if (kind == 'holm') {
      questKind = 'hidden_blood_holm'
    } else if (kind == 'weir') {
      questKind = 'hidden_thunder_weir'
    } else if (kind == 'stamen') {
      questKind = 'hidden_mist_stamen'
    } else if (kind == 'ait') {
      questKind = 'hidden_blood_ait'
    } else if (kind == 'petal') {
      questKind = 'hidden_mist_petal'
    }
    final ctor = Quests[questKind]
    if (ctor == null) return false
    final quest = ctor(fromSite, difficulty: 0)
    if (quest == null) return false
    game.flags.jieji ??= {}
    game.flags.jieji.firstHiddenSpawned = true
    final journal = Player.createJournalByQuest(quest)
    final kindKey = 'quest_' + quest.kind
    var where = ''
    if (quest.interpolations != null && quest.interpolations.isNotEmpty) {
      where = quest.interpolations[0]
    }
    dialog.pushDialog('quest_hidden_rumor', interpolations: [
      engine.locale(kindKey),
      where,
    ])
    await dialog.execute()
    if (journal != null) {
      await Game.promptJournal(journal)
    }
    return true
  }

  async function forceJiejiEvent(kind) {
    game.flags.jieji ??= {}
    final terrain = { kind: 'plain' }
    if (kind == 'merchant') {
      await playJiejiMerchantEvent()
    } else if (kind == 'merchant2') {
      await playJiejiMerchantEvent2()
    } else if (kind == 'mist') {
      await playJiejiMistRoadEvent(terrain)
    } else if (kind == 'mist2') {
      await playJiejiMistRoadEvent2(terrain)
    } else if (kind == 'mist3') {
      await playJiejiMistRoadEvent3(terrain)
    } else if (kind == 'blood') {
      await playJiejiBloodRoadEvent(terrain)
    } else if (kind == 'blood2') {
      await playJiejiBloodRoadEvent2(terrain)
    } else if (kind == 'blood3') {
      await playJiejiBloodRoadEvent3(terrain)
    } else if (kind == 'thunder2') {
      await playJiejiThunderRoadEvent2(terrain)
    } else if (kind == 'thunder3') {
      await playJiejiThunderRoadEvent3(terrain)
    } else if (kind == 'stele') {
      await playJiejiSteleRoadEvent()
    } else if (kind == 'shrine') {
