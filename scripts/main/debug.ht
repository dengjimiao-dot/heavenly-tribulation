  async function forceBrewPotion(kind) {
    final card = brewJiejiPotionCard(kind, free: true)
    if (card == null) {
      dialog.pushDialog("hint_jieji_alchemy_failed")
      await dialog.execute()
      return null
    }
    if (card.jiejiAlchemyKarma == true) {
      await grantKarmaCard("alchemy")
    }
    return card
  }

  /// 忽略冷却与花费，仍弹出丹房试药三选。
  async function forceTaste() {
    return await tasteJiejiPotion(free: true)
  }

  /// 忽略冷却与花费，仍弹出丹房再炼三选。
  async function forceDecoct() {
    return await decoctJiejiPotion(free: true)
  }

  async function forceScribeTalisman(kind) {
    final card = scribeJiejiTalisman(kind, free: true)
    if (card == null || card == 'cooldown') {
      dialog.pushDialog("hint_jieji_rune_failed")
      await dialog.execute()
      return null
    }
    return card
  }

  /// 忽略冷却与花费，仍弹出符法所贴符三选。
  async function forcePaste() {
    return await pasteJiejiTalisman(free: true)
  }

  /// 忽略冷却与花费，仍弹出符法所描符三选。
  async function forceTrace() {
    return await traceJiejiTalisman(free: true)
  }

  async function forceRecruitAid(genre) {
    final result = recruitJiejiAid(genre, free: true)
    if (result == null || result == 'cooldown') {
      dialog.pushDialog('hint_jieji_aid_failed')
      await dialog.execute()
      return null
    }
    return result
  }

