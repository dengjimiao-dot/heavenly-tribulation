      questKind = 'hidden_mist_myceliumnet'
    } else if (kind == 'xueku') {
      questKind = 'hidden_blood_xueku'
    } else if (kind == 'hyphalveil') {
      questKind = 'hidden_mist_hyphalveil'
    } else if (kind == 'leiku') {
      questKind = 'hidden_thunder_leiku'
    } else if (kind == 'myceliumweb') {
      questKind = 'hidden_mist_myceliumweb'
    } else if (kind == 'xuedong') {
      questKind = 'hidden_blood_xuedong'
    } else if (kind == 'sporecloud') {
      questKind = 'hidden_mist_sporecloud'
    } else if (kind == 'leidong') {
      questKind = 'hidden_thunder_leidong'
    } else if (kind == 'hyphalnet') {
      questKind = 'hidden_mist_hyphalnet'
    } else if (kind == 'xueyan') {
      questKind = 'hidden_blood_xueyan'
    } else if (kind == 'myceliummist') {
      questKind = 'hidden_mist_myceliummist'
    } else if (kind == 'leiyan') {
      questKind = 'hidden_thunder_leiyan'
    }
    final ctor = Quests[questKind]
    if (ctor == null) return false
    final quest = ctor(fromSite, difficulty: 0)
    if (quest == null) return false
    game.flags.jieji ??= {}
    game.flags.jieji.firstHiddenSpawned = true
    final journal = Player.createJournalByQuest(quest)
    final kindKey = 'quest_' + quest.kind
    var where = ''
    if (quest.interpolations != null && quest.interpolations.isNotEmpty) {
      where = quest.interpolations[0]
    }
    dialog.pushDialog('quest_hidden_rumor', interpolations: [
      engine.locale(kindKey),
      where,
    ])
    await dialog.execute()
    if (journal != null) {
      await Game.promptJournal(journal)
    }
    return true
  }

