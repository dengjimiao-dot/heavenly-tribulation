  async function forceGongfa(id) {
    final ok = await grantGongfaShard(id)
    if (!ok) {
      dialog.pushDialog('hint_jieji_gongfa_none')
      await dialog.execute()
    }
  }

  async function forceHiddenQuest(kind) {
    if (hero == null) return false
    final fromSite = game.locations[hero.homeLocationId] ?? game.locations[hero.homeSiteId]
    if (fromSite == null) return false
    var questKind = 'hidden_gongfa_cache'
    if (kind == 'grove') {
      questKind = 'hidden_herb_grove'
    } else if (kind == 'vein') {
      questKind = 'hidden_ore_vein'
    } else if (kind == 'ferry') {
      questKind = 'hidden_ferry_lantern'
    } else if (kind == 'well') {
      questKind = 'hidden_storm_well'
    } else if (kind == 'banquet') {
      questKind = 'hidden_blood_feast'
    } else if (kind == 'market') {
      questKind = 'hidden_mist_market'
    } else if (kind == 'cave') {
      questKind = 'hidden_gongfa_cave'
    } else if (kind == 'mirror') {
      questKind = 'hidden_mirror_ruins'
    } else if (kind == 'remnant') {
      questKind = 'hidden_remnant_lamp'
    } else if (kind == 'lamp') {
      questKind = 'hidden_remnant_lamp'
    } else if (kind == 'mound') {
      questKind = 'hidden_drum_mound'
    } else if (kind == 'font') {
      questKind = 'hidden_remnant_spring'
    } else if (kind == 'shade') {
      questKind = 'hidden_stele_shade'
    } else if (kind == 'stall') {
      questKind = 'hidden_haggle_stall'
    } else if (kind == 'blank') {
      questKind = 'hidden_blank_cache'
    } else if (kind == 'field') {
      questKind = 'hidden_night_field'
    } else if (kind == 'tide') {
      questKind = 'hidden_tide_pool'
    } else if (kind == 'knot') {
      questKind = 'hidden_timber_knot'
    } else if (kind == 'trail') {
      questKind = 'hidden_hunt_trail'
    } else if (kind == 'slag') {
      questKind = 'hidden_ore_slag'
    } else if (kind == 'bridge') {
      questKind = 'hidden_mist_bridge'
    } else if (kind == 'bog') {
      questKind = 'hidden_blood_bog'
    } else if (kind == 'ridge') {
      questKind = 'hidden_thunder_ridge'
    }
    final ctor = Quests[questKind]
    if (ctor == null) return false
    final quest = ctor(fromSite, difficulty: 0)
    if (quest == null) return false
    game.flags.jieji ??= {}
    game.flags.jieji.firstHiddenSpawned = true
    final journal = Player.createJournalByQuest(quest)
    final kindKey = 'quest_' + quest.kind
    var where = ''
    if (quest.interpolations != null && quest.interpolations.isNotEmpty) {
      where = quest.interpolations[0]
    }
    dialog.pushDialog('quest_hidden_rumor', interpolations: [
      engine.locale(kindKey),
      where,
    ])
    await dialog.execute()
    if (journal != null) {
      await Game.promptJournal(journal)
    }
    return true
  }

  async function forceJiejiEvent(kind) {
    game.flags.jieji ??= {}
    final terrain = { kind: 'plain' }
    if (kind == 'merchant') {
      await playJiejiMerchantEvent()
    } else if (kind == 'merchant2') {
      await playJiejiMerchantEvent2()
    } else if (kind == 'mist') {
      await playJiejiMistRoadEvent(terrain)
    } else if (kind == 'mist2') {
      await playJiejiMistRoadEvent2(terrain)
    } else if (kind == 'mist3') {
      await playJiejiMistRoadEvent3(terrain)
    } else if (kind == 'blood') {
      await playJiejiBloodRoadEvent(terrain)
    } else if (kind == 'blood2') {
      await playJiejiBloodRoadEvent2(terrain)
    } else if (kind == 'blood3') {
      await playJiejiBloodRoadEvent3(terrain)
    } else if (kind == 'thunder2') {
      await playJiejiThunderRoadEvent2(terrain)
    } else if (kind == 'thunder3') {
      await playJiejiThunderRoadEvent3(terrain)
    } else if (kind == 'stele') {
      await playJiejiSteleRoadEvent()
    } else if (kind == 'shrine') {
      await playJiejiShrineRoadEvent()
    } else if (kind == 'scavenge') {
      await playJiejiScavengeEvent(terrain)
    } else if (kind == 'camp') {
      await playJiejiCampEvent(terrain)
    } else if (kind == 'blade') {
      await playJiejiBladeEvent(terrain)
    } else if (kind == 'scroll') {
      await playJiejiScrollEvent(terrain)
    } else if (kind == 'lantern') {
      await playJiejiLanternEvent(terrain)
    } else if (kind == 'echo') {
      await playJiejiEchoEvent(terrain)
    } else if (kind == 'draw') {
      await playJiejiDrawEvent(terrain)
    } else {
      await playJiejiThunderRoadEvent(terrain)
    }
  }

  async function forceDungeonJieji(kind) {
    game.flags.dungeon ??= {}
    if (kind == 'encamp') {
      game.flags.dungeon.pendingEncampOmen = true
      await playJiejiDungeonEncampOmen()
    } else if (kind == 'altar') {
      game.flags.dungeon.pendingEncounter = 'jiejiAltar'
      await playJiejiDungeonEncounter()
    } else if (kind == 'cache') {
      game.flags.dungeon.pendingEncounter = 'jiejiCache'
      await playJiejiDungeonEncounter()
    } else if (kind == 'spring') {
      game.flags.dungeon.pendingEncounter = 'jiejiSpring'
      await playJiejiDungeonEncounter()
    } else if (kind == 'ambush') {
      game.flags.dungeon.pendingEncounter = 'jiejiAmbush'
      await playJiejiDungeonEncounter()
    } else if (kind == 'trial') {
      game.flags.dungeon.pendingEncounter = 'jiejiTrial'
      await playJiejiDungeonEncounter()
    } else if (kind == 'bell') {
      game.flags.dungeon.pendingEncounter = 'jiejiBell'
      await playJiejiDungeonEncounter()
    } else if (kind == 'leaf') {
      game.flags.dungeon.pendingEncounter = 'jiejiLeaf'
      await playJiejiDungeonEncounter()
    } else if (kind == 'vault') {
      game.flags.dungeon.pendingEncounter = 'jiejiVault'
      await playJiejiDungeonEncounter()
    } else if (kind == 'forge') {
      game.flags.dungeon.pendingEncounter = 'jiejiForge'
      await playJiejiDungeonEncounter()
    } else if (kind == 'mirror') {
      game.flags.dungeon.pendingEncounter = 'jiejiMirror'
      await playJiejiDungeonEncounter()
    } else if (kind == 'lamp') {
      game.flags.dungeon.pendingEncounter = 'jiejiLamp'
      await playJiejiDungeonEncounter()
    } else if (kind == 'drum') {
      game.flags.dungeon.pendingEncounter = 'jiejiDrum'
      await playJiejiDungeonEncounter()
    } else if (kind == 'cistern') {
      game.flags.dungeon.pendingEncounter = 'jiejiWell'
      await playJiejiDungeonEncounter()
    } else if (kind == 'seal') {
      game.flags.dungeon.pendingEncounter = 'jiejiSeal'
      await playJiejiDungeonEncounter()
    } else if (kind == 'exit') {
      await playJiejiDungeonExitGift()
    } else {
      game.flags.dungeon.pendingEncampOmen = true
      await playJiejiDungeonEncampOmen()
    }
  }

  async function forceBrewPotion(kind) {
    final card = brewJiejiPotionCard(kind, free: true)
    if (card == null) {
      dialog.pushDialog("hint_jieji_alchemy_failed")
      await dialog.execute()
      return null
    }
    if (card.jiejiAlchemyKarma == true) {
      await grantKarmaCard("alchemy")
    }
    return card
  }

