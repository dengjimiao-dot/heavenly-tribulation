  async function forceGongfa(id) {
    final ok = await grantGongfaShard(id)
    if (!ok) {
      dialog.pushDialog('hint_jieji_gongfa_none')
      await dialog.execute()
    }
  }

  async function forceJiejiEvent(kind) {
    game.flags.jieji ??= {}
    final terrain = { kind: 'plain' }
    if (kind == 'merchant') {
      await playJiejiMerchantEvent()
    } else if (kind == 'mist') {
      await playJiejiMistRoadEvent(terrain)
    } else if (kind == 'mist2') {
      await playJiejiMistRoadEvent2(terrain)
    } else if (kind == 'blood') {
      await playJiejiBloodRoadEvent(terrain)
    } else if (kind == 'blood2') {
      await playJiejiBloodRoadEvent2(terrain)
    } else if (kind == 'thunder2') {
      await playJiejiThunderRoadEvent2(terrain)
    } else if (kind == 'stele') {
      await playJiejiSteleRoadEvent()
    } else {
      await playJiejiThunderRoadEvent(terrain)
    }
  }

  async function forceDungeonJieji(kind) {
    game.flags.dungeon ??= {}
    if (kind == 'encamp') {
      game.flags.dungeon.pendingEncampOmen = true
      await playJiejiDungeonEncampOmen()
    } else if (kind == 'altar') {
      game.flags.dungeon.pendingEncounter = 'jiejiAltar'
      await playJiejiDungeonEncounter()
    } else if (kind == 'cache') {
      game.flags.dungeon.pendingEncounter = 'jiejiCache'
      await playJiejiDungeonEncounter()
    } else {
      game.flags.dungeon.pendingEncampOmen = true
      await playJiejiDungeonEncampOmen()
    }
  }

  async function forceBrewPotion(kind) {
    final card = brewJiejiPotionCard(kind, free: true)
    if (card == null) {
      dialog.pushDialog("hint_jieji_alchemy_failed")
      await dialog.execute()
      return null
    }
    if (card.jiejiAlchemyKarma == true) {
      await grantKarmaCard("alchemy")
    }
    return card
  }

  async function forceRecruitAid(genre) {
    final result = recruitJiejiAid(genre, free: true)
    if (result == null || result == 'cooldown') {
      dialog.pushDialog('hint_jieji_aid_failed')
      await dialog.execute()
      return null
    }
    return result
  }

  /// 沙盒立刻打指定季的渡劫 Boss（含前兆三选）。会走 trySettleJieji。
  async function forceTribulation(seasonId) {
    var id = seasonId
    if (id != 'thunder' && id != 'mist' && id != 'blood') {
      id = 'thunder'
    }
    if (hero == null) return 'done'
    final jieji = ensureJiejiFlags()
    jieji.fighting = false
    jieji.pendingEndedSeasonId = id
    jieji.lastSettledSeasonId = null
    return await trySettleJieji(endedSeasonId: id)
  }
}
