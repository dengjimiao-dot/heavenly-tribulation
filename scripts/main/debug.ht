  /// 忽略冷却与花费，仍弹出工坊养刃三选。
  async function forceOil() {
    return await oilJiejiWeapon(free: true)
  }

  async function forceBounty(kind) {
    var k = kind
    if (k != 'hunt' && k != 'search' && k != 'blood') {
      k = 'hunt'
    }
    return await claimJiejiBounty(free: true, kind: k)
  }

  /// 忽略一季一次与花费，仍弹出劫令三选。
  async function forceEdict() {
    return await issueJiejiEdict(free: true)
  }

  /// 忽略一城一季一次，仍弹出进城劫谣三选。无参则用主角故乡。
  async function forceCityRumor(location) {
    var loc = location
    if (loc == null) loc = getHeroHomeCity()
    return await tryJiejiCityRumor(loc, free: true)
  }

  /// 忽略余日与一季一次，仍弹出季末前夜劫兆三选。
  async function forceEve() {
    return await playJiejiSeasonEve()
  }

  /// 忽略几率与冷却，仍弹出赶路拾荒三选。
  async function forceScavenge() {
    return await playJiejiScavengeEvent({ kind: 'plain' })
  }

  /// 忽略几率与冷却，仍弹出赶路扎营三选。
  async function forceCamp() {
    return await playJiejiCampEvent({ kind: 'plain' })
  }

  /// 忽略几率与冷却，仍弹出赶路残锋三选。
  async function forceBlade() {
    return await playJiejiBladeEvent({ kind: 'plain' })
  }

  /// 忽略几率与冷却，仍弹出赶路劫纹残卷三选。
  async function forceScroll() {
    return await playJiejiScrollEvent({ kind: 'plain' })
  }

  /// 忽略几率与冷却，仍弹出赶路雾灯三选。
  async function forceLantern() {
    return await playJiejiLanternEvent({ kind: 'plain' })
  }

  /// 忽略几率与冷却，仍弹出赶路残鼓三选。
  async function forceEcho() {
    return await playJiejiEchoEvent({ kind: 'plain' })
  }

  /// 忽略几率与冷却，仍弹出赶路汲泉三选。
  async function forceDraw() {
    return await playJiejiDrawEvent({ kind: 'plain' })
  }

  /// 忽略冷却与花费，仍弹出幻术祭坛入幻三选。
  async function forceEnter() {
    return await enterJiejiIllusion(free: true)
  }

  /// 忽略冷却与花费，仍弹出幻术祭坛映幻三选。
  async function forceEchoIllusion() {
    return await echoJiejiIllusion(free: true)
  }

  /// 忽略费用与冷却，直接挂上迷障（下次野遇糊弄过去）。
  function forceVeil() {
    if (hero == null) return
    final jieji = ensureJiejiFlags()
    jieji.illusionVeil = true
    Game.updateUI()
  }

  /// 忽略几率与冷却，在当前地形开一场劫纹精英（未知则平原）。
  async function forceWildElite() {
    if (hero == null) return
    var terrain = { kind: 'plain' }
    if (world != null && hero.worldPosition != null) {
      final pos = hero.worldPosition
      if (pos.left != null && pos.top != null) {
        final tile = getTerrainByWorldPosition(pos.left, pos.top)
        if (tile != null && tile.kind != null) {
          terrain = tile
        }
      }
    }
    await startJiejiWildEliteEncounter(terrain)
  }

  /// 沙盒立刻打指定季的渡劫 Boss（含前兆三选）。会走 trySettleJieji。
  async function forceTribulation(seasonId) {
    var id = seasonId
    if (id != 'thunder' && id != 'mist' && id != 'blood') {
      id = 'thunder'
    }
    if (hero == null) return 'done'
    final jieji = ensureJiejiFlags()
    jieji.fighting = false
    jieji.pendingEndedSeasonId = id
    jieji.lastSettledSeasonId = null
    return await trySettleJieji(endedSeasonId: id)
  }
}
