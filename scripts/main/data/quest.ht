const kMaxActiveHiddenQuests = 2
const kHiddenQuestBaseRate = 0.05
const kHiddenQuestFirstMoveWindow = 10

function _activeHiddenQuestCount() {
  var n = 0
  for (final journal in hero.journals.values) {
    if (journal.isFinished) continue
    if (journal.quest == null) continue
    final qdata = game.quests[journal.quest.kind]
    if (qdata != null && qdata.isHidden == true) {
      n += 1
    }
  }
  return n




}


