async function trySpawnHiddenQuestOnMove(terrain) {
  if (hero == null) return false
  if (game.enableTutorial && game.flags.tutorial.bountyQuest != true) return false
  if (_activeHiddenQuestCount() >= kMaxActiveHiddenQuests) return false

  game.flags.jieji ??= {}
  game.flags.jieji.worldMoves = (game.flags.jieji.worldMoves ?? 0) + 1
  final moves = game.flags.jieji.worldMoves
  final forceFirst = game.flags.jieji.firstHiddenSpawned != true && moves <= kHiddenQuestFirstMoveWindow

  if (!forceFirst) {
    var rate = kHiddenQuestBaseRate
    if (game.jieji != null && game.jieji.hiddenQuestMul != null) {
      rate = rate * game.jieji.hiddenQuestMul
    }
    if (random.nextDouble() > rate) return false
  }

  final fromSite = game.locations[hero.homeLocationId] ?? game.locations[hero.homeSiteId]
  if (fromSite == null) return false
  let quest = createHiddenQuest(fromSite)
  if (quest == null) {
    for (var i in range(5)) {
      quest = createHiddenQuest(fromSite)
      if (quest != null) break
    }
  }
  if (quest == null) return false

  game.flags.jieji.firstHiddenSpawned = true
  final journal = Player.createJournalByQuest(quest)
  final kindKey = 'quest_' + quest.kind
  var where = ''
  if (quest.interpolations != null && quest.interpolations.isNotEmpty) {
    where = quest.interpolations[0]
  }
  dialog.pushDialog('quest_hidden_rumor', interpolations: [
    engine.locale(kindKey),
    where,
  ])
  await dialog.execute()
  if (journal != null) {
    await Game.promptJournal(journal)
  }
  return true
}

function createQuest(cityhall, {
  kind, sect,
  isBounty = false,
  policy,
  maxDifficulty: integer,
}) {
  let quest
  // 因为任务可能会因为一些原因生成失败导致返回 null，这里需要循环尝试
  while(quest == null) {
    let questData = random.nextIterable(game.quests.values.where((q) {
      if (q.isHidden == true) return false
      if (isBounty && !q.isBounty) return false
      if (isBounty && q.rank > 2) return false
      if (policy && q.policy && q.policy != policy) return false
      return true
    }))
    final difficulty = random.nextInt(maxDifficulty + 1)
    final ctor = Quests[questData.id]
    assert(ctor != null, 'quest generator function not found: ${questData.id}')
    quest = ctor(
      cityhall,
      difficulty: difficulty,
      sect: sect,
    )
  }

  return quest
}

/// 刷新悬赏任务，这里不检查城市类型
function replenishBounty(location) {
  // 此处的 sect 可能为 null
  final sect = game.sects[location.sectId]
  
  // 清空现有悬赏任务
  location.bounties = []
  
  final amount = kBaseBountyReplenishAmount + location.development
  for (var i in range(amount)) {
    final bountyQuest = createQuest(location,
      sect: sect,
      isBounty: true,
      maxDifficulty: location.development,
    )
    location.bounties.add(bountyQuest)
  }
}

function generateSectQuests(sect, location) {
  final quests = []

  for (var i in range (kSectQuestCount)) {
    final quest = createQuest(location,
      sect: sect,
      policy: sect.policies[location.id],
      maxDifficulty: hero.rank,
    )
    quests.add(quest)
  }

  return quests
}
