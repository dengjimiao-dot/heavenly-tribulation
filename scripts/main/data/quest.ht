const kMaxActiveHiddenQuests = 2
const kHiddenQuestBaseRate = 0.05
const kHiddenQuestFirstMoveWindow = 10

function _activeHiddenQuestCount() {
  var n = 0
  for (final journal in hero.journals.values) {
    if (journal.isFinished) continue
    if (journal.quest == null) continue
    final qdata = game.quests[journal.quest.kind]
    if (qdata != null && qdata.isHidden == true) {
      n += 1
    }
  }
  return n
}

function createHiddenQuest(fromSite) {
  let seasonId = 'thunder'
  if (game.jieji != null && game.jieji.seasonId != null) {
    seasonId = game.jieji.seasonId
  }
  var kinds = ['hidden_karma_shrine', 'hidden_karma_shrine', 'hidden_gongfa_cache', 'hidden_gongfa_cave', 'hidden_ruins_explore', 'hidden_ore_vein', 'hidden_ore_vein', 'hidden_ferry_lantern', 'hidden_storm_well', 'hidden_storm_well', 'hidden_blood_feast', 'hidden_mist_market', 'hidden_mirror_ruins', 'hidden_remnant_lamp', 'hidden_drum_mound', 'hidden_remnant_spring']
  if (seasonId == 'mist') {
    kinds = ['hidden_ruins_explore', 'hidden_herb_grove', 'hidden_herb_grove', 'hidden_karma_shrine', 'hidden_ferry_lantern', 'hidden_ferry_lantern', 'hidden_ore_vein', 'hidden_storm_well', 'hidden_blood_feast', 'hidden_mist_market', 'hidden_mist_market', 'hidden_gongfa_cave', 'hidden_mirror_ruins', 'hidden_mirror_ruins', 'hidden_remnant_lamp', 'hidden_drum_mound', 'hidden_remnant_spring', 'hidden_remnant_spring']
  } else if (seasonId == 'thunder') {
    kinds = ['hidden_karma_shrine', 'hidden_karma_shrine', 'hidden_gongfa_cache', 'hidden_gongfa_cave', 'hidden_gongfa_cave', 'hidden_ruins_explore', 'hidden_ore_vein', 'hidden_ore_vein', 'hidden_storm_well', 'hidden_storm_well', 'hidden_blood_feast', 'hidden_mist_market', 'hidden_mirror_ruins', 'hidden_remnant_lamp', 'hidden_remnant_lamp', 'hidden_drum_mound', 'hidden_remnant_spring']
  } else if (seasonId == 'blood') {
    kinds = ['hidden_blood_omen', 'hidden_blood_omen', 'hidden_gongfa_cache', 'hidden_gongfa_cave', 'hidden_karma_shrine', 'hidden_ore_vein', 'hidden_ferry_lantern', 'hidden_storm_well', 'hidden_blood_feast', 'hidden_blood_feast', 'hidden_mist_market', 'hidden_mirror_ruins', 'hidden_remnant_lamp', 'hidden_drum_mound', 'hidden_drum_mound', 'hidden_remnant_spring']
  }
  final kind = random.nextIterable(kinds)
  final ctor = Quests[kind]
  if (ctor == null) return
  var cap = hero.rank
  if (cap > 3) cap = 3
  if (cap < 0) cap = 0
  final difficulty = random.nextInt(cap + 1)
  return ctor(fromSite, difficulty: difficulty)
}

async function trySpawnHiddenQuestOnMove(terrain) {
  if (hero == null) return false
  if (game.enableTutorial && game.flags.tutorial.bountyQuest != true) return false
  if (_activeHiddenQuestCount() >= kMaxActiveHiddenQuests) return false

  game.flags.jieji ??= {}
  game.flags.jieji.worldMoves = (game.flags.jieji.worldMoves ?? 0) + 1
  final moves = game.flags.jieji.worldMoves
  final forceFirst = game.flags.jieji.firstHiddenSpawned != true && moves <= kHiddenQuestFirstMoveWindow

  if (!forceFirst) {
    var rate = kHiddenQuestBaseRate
    if (game.jieji != null && game.jieji.hiddenQuestMul != null) {
      rate = rate * game.jieji.hiddenQuestMul
    }
    if (random.nextDouble() > rate) return false
  }

  final fromSite = game.locations[hero.homeLocationId] ?? game.locations[hero.homeSiteId]
  if (fromSite == null) return false
  let quest = createHiddenQuest(fromSite)
  if (quest == null) {
    for (var i in range(5)) {
      quest = createHiddenQuest(fromSite)
      if (quest != null) break
    }
  }
  if (quest == null) return false

  game.flags.jieji.firstHiddenSpawned = true
  final journal = Player.createJournalByQuest(quest)
  final kindKey = 'quest_' + quest.kind
  var where = ''
  if (quest.interpolations != null && quest.interpolations.isNotEmpty) {
    where = quest.interpolations[0]
  }
  dialog.pushDialog('quest_hidden_rumor', interpolations: [
    engine.locale(kindKey),
    where,
  ])
  await dialog.execute()
  if (journal != null) {
    await Game.promptJournal(journal)
  }
  return true
}

function createQuest(cityhall, {
  kind, sect,
  isBounty = false,
  policy,
  maxDifficulty: integer,
}) {
  let quest
  // 因为任务可能会因为一些原因生成失败导致返回 null，这里需要循环尝试
  while(quest == null) {
    let questData = random.nextIterable(game.quests.values.where((q) {
      if (q.isHidden == true) return false
      if (isBounty && !q.isBounty) return false
      if (isBounty && q.rank > 2) return false
      if (policy && q.policy && q.policy != policy) return false
      return true
    }))
    final difficulty = random.nextInt(maxDifficulty + 1)
    final ctor = Quests[questData.id]
    assert(ctor != null, 'quest generator function not found: ${questData.id}')
    quest = ctor(
      cityhall,
      difficulty: difficulty,
      sect: sect,
    )
  }

  return quest
}

/// 刷新悬赏任务，这里不检查城市类型
function replenishBounty(location) {
  // 此处的 sect 可能为 null
  final sect = game.sects[location.sectId]
  
  // 清空现有悬赏任务
  location.bounties = []
  
  final amount = kBaseBountyReplenishAmount + location.development
  for (var i in range(amount)) {
    final bountyQuest = createQuest(location,
      sect: sect,
      isBounty: true,
      maxDifficulty: location.development,
    )
    location.bounties.add(bountyQuest)
  }
}

function generateSectQuests(sect, location) {
  final quests = []

  for (var i in range (kSectQuestCount)) {
    final quest = createQuest(location,
      sect: sect,
      policy: sect.policies[location.id],
      maxDifficulty: hero.rank,
    )
    quests.add(quest)
  }

  return quests
}
