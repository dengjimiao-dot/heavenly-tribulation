      game.flags.jieji ??= {}
      game.flags.jieji.illusionVeil = true
      if (jiejiDungeonSeasonId() == 'mist') {
        final extra = kJiejiDungeonMirrorSmashMistMoney
        await Player.collect('money', extra, incurIncident: false)
        dialog.pushDialog('hint_jieji_dungeon_smash_mist', interpolations: ['${cost}', '${extra}'])
        await dialog.execute()
      } else {
        dialog.pushDialog('hint_jieji_dungeon_smash', interpolations: ['${cost}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_dungeon_smash_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_shadow') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonMirrorBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_shadow', interpolations: ['${lost}'])
    await dialog.execute()
    var ok = await tryDropGongfaShard(rate: 1)
    if (ok != true) {
      ok = await grantGongfaShard(null)
    }
    if (ok != true) {
      final money = kJiejiDungeonMirrorBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_shadow_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonMirrorGazeHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
    }
    final healed = Player.restoreLife(jiejiDungeonMirrorGazeLife())
    dialog.pushDialog('hint_jieji_dungeon_gaze', interpolations: ['${healed}'])
    await dialog.execute()
