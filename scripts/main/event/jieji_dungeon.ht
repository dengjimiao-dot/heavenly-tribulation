function jiejiDungeonForgeApplyFury() {
  game.flags.jieji ??= {}
  if (game.flags.jieji.arrayFury != true) {
    game.flags.jieji.arrayFury = true
  } else {
    game.flags.jieji.feastFury = true
  }
}

