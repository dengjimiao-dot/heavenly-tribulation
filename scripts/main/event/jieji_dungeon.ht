  if (selected == 'jieji_dungeon_hear') {
    final cost = jiejiDungeonDrumListenMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      final herb = kJiejiDungeonDrumListenHerb
      await Player.collect('herb', herb, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_hear', interpolations: ['${cost}', '${herb}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonDrumListenGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_hear_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_blooddrum') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonDrumBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_blooddrum', interpolations: ['${lost}'])
    await dialog.execute()
    var ok = await tryDropGongfaShard(rate: 1)
    if (ok != true) {
      ok = await grantGongfaShard(null)
    }
    if (ok != true) {
      final money = kJiejiDungeonDrumBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_blooddrum_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonDrumTapHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
    }
    final healed = Player.restoreLife(kJiejiDungeonDrumTapLife)
    game.flags.jieji ??= {}
    if (game.flags.jieji.arrayFury != true) {
      game.flags.jieji.arrayFury = true
    } else {
      game.flags.jieji.feastFury = true
    }
    dialog.pushDialog('hint_jieji_dungeon_tap', interpolations: ['${healed}'])
    await dialog.execute()
    if (jiejiDungeonSeasonId() == 'thunder') {
      await tryDropGongfaShard(rate: kJiejiDungeonDrumTapGongfaRateThunder)
    }
  }
}

