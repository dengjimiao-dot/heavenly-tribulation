async function playJiejiDungeonVolute() {
  dialog.pushDialog('hint_jieji_dungeon_volute_room')
  dialog.pushSelection('jiejiDungeonVolute', [
    'jieji_dungeon_readvolute',
    'jieji_dungeon_sealvolute',
    'jieji_dungeon_bloodvolute',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonVolute')

  if (selected == 'jieji_dungeon_sealvolute') {
    final cost = jiejiDungeonVoluteSealMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      final healed = Player.restoreLife(kJiejiDungeonVoluteSealLife)
      jiejiDungeonVoluteApplyWard()
      dialog.pushDialog('hint_jieji_dungeon_sealvolute', interpolations: ['${cost}', '${healed}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonVoluteSealGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_sealvolute_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_bloodvolute') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonVoluteBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_bloodvolute', interpolations: ['${lost}'])
    await dialog.execute()
    await grantKarmaCard(jiejiDungeonKarmaSource())
