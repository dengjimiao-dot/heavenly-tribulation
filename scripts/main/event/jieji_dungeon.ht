async function playJiejiDungeonJamb() {
  dialog.pushDialog('hint_jieji_dungeon_jamb_room')
  dialog.pushSelection('jiejiDungeonJamb', [
    'jieji_dungeon_readjamb',
    'jieji_dungeon_sealjamb',
    'jieji_dungeon_bloodjamb',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonJamb')

  if (selected == 'jieji_dungeon_sealjamb') {
    final cost = jiejiDungeonJambSealMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      final healed = Player.restoreLife(kJiejiDungeonJambSealLife)
      jiejiDungeonJambApplyWard()
      dialog.pushDialog('hint_jieji_dungeon_sealjamb', interpolations: ['${cost}', '${healed}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonJambSealGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_sealjamb_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_bloodjamb') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonJambBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_bloodjamb', interpolations: ['${lost}'])
    await dialog.execute()
    await grantKarmaCard(jiejiDungeonKarmaSource())
