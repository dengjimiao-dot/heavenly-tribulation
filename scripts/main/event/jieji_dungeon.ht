    'jieji_dungeon_sitthrone',
    'jieji_dungeon_sealthrone',
    'jieji_dungeon_bloodthrone',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonThrone')

  if (selected == 'jieji_dungeon_sealthrone') {
    final cost = jiejiDungeonThroneSealMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      final healed = Player.restoreLife(kJiejiDungeonThroneSealLife)
      jiejiDungeonThroneApplyWard()
      dialog.pushDialog('hint_jieji_dungeon_sealthrone', interpolations: ['${cost}', '${healed}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonThroneSealGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_sealthrone_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_bloodthrone') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonThroneBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_bloodthrone', interpolations: ['${lost}'])
    await dialog.execute()
    await grantKarmaCard(jiejiDungeonKarmaSource())
    var ok = await tryDropGongfaShard(rate: kJiejiDungeonThroneBloodGongfaRate)
    if (ok != true) {
      final money = kJiejiDungeonThroneBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_bloodthrone_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonThroneSitthroneHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
      jiejiDungeonGrantBlank()
      if (jiejiDungeonSeasonId() == 'mist') {
        final money = kJiejiDungeonThroneSitthroneMistMoney
        await Player.collect('money', money, incurIncident: false)
        dialog.pushDialog('hint_jieji_dungeon_sitthrone_mist', interpolations: ['${herbCost}', '${money}'])
        await dialog.execute()
      } else {
        dialog.pushDialog('hint_jieji_dungeon_sitthrone', interpolations: ['${herbCost}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_dungeon_sitthrone_broke', interpolations: ['${herbCost}'])
      await dialog.execute()
    }
  }
}


