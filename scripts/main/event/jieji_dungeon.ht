function jiejiDungeonEavesApplyWard() {
  game.flags.jieji ??= {}
  if (game.flags.jieji.arrayWard != true) {
    game.flags.jieji.arrayWard = true
  } else {
    game.flags.jieji.feastFury = true
  }
}

async function playJiejiDungeonEaves() {
  dialog.pushDialog('hint_jieji_dungeon_eaves_room')
  dialog.pushSelection('jiejiDungeonEaves', [
    'jieji_dungeon_readeaves',
    'jieji_dungeon_sealeaves',
    'jieji_dungeon_bloodeaves',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonEaves')

  if (selected == 'jieji_dungeon_sealeaves') {
    final cost = jiejiDungeonEavesSealMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      final healed = Player.restoreLife(kJiejiDungeonEavesSealLife)
      jiejiDungeonEavesApplyWard()
      dialog.pushDialog('hint_jieji_dungeon_sealeaves', interpolations: ['${cost}', '${healed}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonEavesSealGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_sealeaves_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_bloodeaves') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonEavesBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_bloodeaves', interpolations: ['${lost}'])
    await dialog.execute()
    await grantKarmaCard(jiejiDungeonKarmaSource())
    var ok = await tryDropGongfaShard(rate: kJiejiDungeonEavesBloodGongfaRate)
    if (ok != true) {
      final money = kJiejiDungeonEavesBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_bloodeaves_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonEavesReadeavesHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
      jiejiDungeonGrantBlank()
      if (jiejiDungeonSeasonId() == 'mist') {
        final money = kJiejiDungeonEavesReadeavesMistMoney
        await Player.collect('money', money, incurIncident: false)
        dialog.pushDialog('hint_jieji_dungeon_readeaves_mist', interpolations: ['${herbCost}', '${money}'])
        await dialog.execute()
      } else {
        dialog.pushDialog('hint_jieji_dungeon_readeaves', interpolations: ['${herbCost}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_dungeon_readeaves_broke', interpolations: ['${herbCost}'])
      await dialog.execute()
    }
  }
}

