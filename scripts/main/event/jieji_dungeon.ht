      dialog.pushDialog('hint_jieji_dungeon_bloodvolute_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonVoluteReadvoluteHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
