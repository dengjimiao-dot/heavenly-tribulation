function jiejiDungeonFriezeApplyWard() {
  game.flags.jieji ??= {}
  if (game.flags.jieji.arrayWard != true) {
    game.flags.jieji.arrayWard = true
  } else {
    game.flags.jieji.feastFury = true
  }
}

async function playJiejiDungeonFrieze() {
  dialog.pushDialog('hint_jieji_dungeon_frieze_room')
  dialog.pushSelection('jiejiDungeonFrieze', [
    'jieji_dungeon_readfrieze',
    'jieji_dungeon_sealfrieze',
    'jieji_dungeon_bloodfrieze',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonFrieze')

  if (selected == 'jieji_dungeon_sealfrieze') {
    final cost = jiejiDungeonFriezeSealMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      final healed = Player.restoreLife(kJiejiDungeonFriezeSealLife)
      jiejiDungeonFriezeApplyWard()
      dialog.pushDialog('hint_jieji_dungeon_sealfrieze', interpolations: ['${cost}', '${healed}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonFriezeSealGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_sealfrieze_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_bloodfrieze') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonFriezeBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_bloodfrieze', interpolations: ['${lost}'])
    await dialog.execute()
    await grantKarmaCard(jiejiDungeonKarmaSource())
    var ok = await tryDropGongfaShard(rate: kJiejiDungeonFriezeBloodGongfaRate)
    if (ok != true) {
      final money = kJiejiDungeonFriezeBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_bloodfrieze_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonFriezeReadfriezeHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
      jiejiDungeonGrantBlank()
      if (jiejiDungeonSeasonId() == 'mist') {
        final money = kJiejiDungeonFriezeReadfriezeMistMoney
        await Player.collect('money', money, incurIncident: false)
        dialog.pushDialog('hint_jieji_dungeon_readfrieze_mist', interpolations: ['${herbCost}', '${money}'])
        await dialog.execute()
      } else {
        dialog.pushDialog('hint_jieji_dungeon_readfrieze', interpolations: ['${herbCost}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_dungeon_readfrieze_broke', interpolations: ['${herbCost}'])
      await dialog.execute()
    }
  }
}



