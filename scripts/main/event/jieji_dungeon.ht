async function playJiejiDungeonLamp() {
  dialog.pushDialog('hint_jieji_dungeon_lamp')
  dialog.pushSelection('jiejiDungeonLamp', [
    'jieji_dungeon_fill',
    'jieji_dungeon_kindle',
    'jieji_dungeon_bloodlamp',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonLamp')

  if (selected == 'jieji_dungeon_kindle') {
    final cost = jiejiDungeonLampTakeMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      jiejiDungeonGrantBlank()
      dialog.pushDialog('hint_jieji_dungeon_kindle', interpolations: ['${cost}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonLampTakeGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_kindle_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_bloodlamp') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonLampBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    game.flags.jieji ??= {}
    if (game.flags.jieji.arrayWard != true) {
      game.flags.jieji.arrayWard = true
    }
    dialog.pushDialog('hint_jieji_dungeon_bloodlamp', interpolations: ['${lost}'])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiDungeonLampBloodGongfaRate)
    if (dropped != true) {
      final money = kJiejiDungeonLampBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_bloodlamp_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonLampFillHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
    }
    final healed = Player.restoreLife(kJiejiDungeonLampFillLife)
    game.flags.jieji ??= {}
    game.flags.jieji.illusionVeil = true
    if (jiejiDungeonSeasonId() == 'mist') {
      final extra = kJiejiDungeonLampFillMistMoney
      await Player.collect('money', extra, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_fill_mist', interpolations: ['${healed}', '${extra}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_dungeon_fill', interpolations: ['${healed}'])
      await dialog.execute()
    }
  }
}

function jiejiDungeonDrumListenMoney() {
  if (jiejiDungeonSeasonId() == 'thunder') return kJiejiDungeonDrumListenMoneyThunder
  return kJiejiDungeonDrumListenMoney
}

function jiejiDungeonDrumBloodLifeLoss() {
  if (jiejiDungeonSeasonId() == 'blood') return kJiejiDungeonDrumBloodLifeBlood
  return kJiejiDungeonDrumBloodLife
}

async function playJiejiDungeonDrum() {
  dialog.pushDialog('hint_jieji_dungeon_drum')
  dialog.pushSelection('jiejiDungeonDrum', [
    'jieji_dungeon_tap',
    'jieji_dungeon_hear',
    'jieji_dungeon_blooddrum',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonDrum')

  if (selected == 'jieji_dungeon_hear') {
    final cost = jiejiDungeonDrumListenMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      final herb = kJiejiDungeonDrumListenHerb
      await Player.collect('herb', herb, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_hear', interpolations: ['${cost}', '${herb}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonDrumListenGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_hear_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_blooddrum') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonDrumBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_blooddrum', interpolations: ['${lost}'])
    await dialog.execute()
    var ok = await tryDropGongfaShard(rate: 1)
    if (ok != true) {
      ok = await grantGongfaShard(null)
    }
    if (ok != true) {
      final money = kJiejiDungeonDrumBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_blooddrum_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonDrumTapHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
    }
    final healed = Player.restoreLife(kJiejiDungeonDrumTapLife)
    game.flags.jieji ??= {}
    if (game.flags.jieji.arrayFury != true) {
      game.flags.jieji.arrayFury = true
    } else {
      game.flags.jieji.feastFury = true
    }
    dialog.pushDialog('hint_jieji_dungeon_tap', interpolations: ['${healed}'])
    await dialog.execute()
    if (jiejiDungeonSeasonId() == 'thunder') {
      await tryDropGongfaShard(rate: kJiejiDungeonDrumTapGongfaRateThunder)
    }
  }
}

