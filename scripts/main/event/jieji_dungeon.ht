        final money = kJiejiDungeonCenserStokeMistMoney
        await Player.collect('money', money, incurIncident: false)
        dialog.pushDialog('hint_jieji_dungeon_stoke_mist', interpolations: ['${herbCost}', '${money}'])
        await dialog.execute()
      } else {
        dialog.pushDialog('hint_jieji_dungeon_stoke', interpolations: ['${herbCost}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_dungeon_stoke_broke', interpolations: ['${herbCost}'])
      await dialog.execute()
    }
  }
}

function jiejiDungeonExitPackMoney() {
  final seasonId = jiejiDungeonSeasonId()
  if (seasonId == 'thunder') return kJiejiDungeonExitPackMoneyThunder
  if (seasonId == 'blood') return kJiejiDungeonExitPackMoneyBlood
  return kJiejiDungeonExitPackMoney
}

function jiejiDungeonExitBindLife() {
  if (jiejiDungeonSeasonId() == 'mist') return kJiejiDungeonExitBindLifeMist
  return kJiejiDungeonExitBindLife
}

/// 有赶路耗日辅助则耗 1 日；与 _jiejiRoadSpendDay 同一套 Game.updateGame。不可见则跳过。
async function _jiejiDungeonExitSpendDay() {
  if (Constants.ticksPerDay == null) return false
  if (Constants.ticksPerDay <= 0) return false
  await Game.updateGame(tick: Constants.ticksPerDay)
  return true
}

async function _playJiejiDungeonExitPack() {
  final money = jiejiDungeonExitPackMoney()
  await Player.collect('money', money, incurIncident: false)
  await tryDropGongfaShard(rate: kJiejiDungeonExitPackGongfaRate)
  dialog.pushDialog('hint_jieji_dungeon_pack', interpolations: ['${money}'])
  await dialog.execute()
}

/// 秘境出口劫礼。须在 unlockDungeonDeck / 清空 dungeon flags 之前调用。
async function playJiejiDungeonExitGift() {
  if (hero == null) return

  dialog.pushDialog('hint_jieji_dungeon_exit')
  dialog.pushSelection('jiejiDungeonExitGift', [
    'jieji_dungeon_pack',
    'jieji_dungeon_bind',
    'jieji_dungeon_dash',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonExitGift')

  if (selected == 'jieji_dungeon_bind') {
    final healed = Player.restoreLife(jiejiDungeonExitBindLife())
    dialog.pushDialog('hint_jieji_dungeon_bind', interpolations: ['${healed}'])
    await dialog.execute()
  } else if (selected == 'jieji_dungeon_dash') {
    final spentDay = await _jiejiDungeonExitSpendDay()
    final healed = Player.restoreLife(kJiejiDungeonExitDashLife)
    final herb = kJiejiDungeonExitDashHerb
    await Player.collect('herb', herb, incurIncident: false)
    if (spentDay) {
      dialog.pushDialog('hint_jieji_dungeon_dash', interpolations: ['${healed}', '${herb}'])
    } else {
      dialog.pushDialog('hint_jieji_dungeon_dash_noday', interpolations: ['${healed}', '${herb}'])
    }
    await dialog.execute()
  } else {
    await _playJiejiDungeonExitPack()
  }
  Game.updateUI()
}
