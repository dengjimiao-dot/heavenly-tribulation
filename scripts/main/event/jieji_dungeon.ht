    await dialog.execute()
    var ok = await tryDropGongfaShard(rate: 1)
    if (ok != true) {
      ok = await grantGongfaShard(null)
    }
    if (ok != true) {
      final money = kJiejiDungeonForgeBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_bleed_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
