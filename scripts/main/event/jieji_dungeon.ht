  return kJiejiDungeonLampBloodLife
}

async function playJiejiDungeonLamp() {
  dialog.pushDialog('hint_jieji_dungeon_lamp')
  dialog.pushSelection('jiejiDungeonLamp', [
    'jieji_dungeon_fill',
    'jieji_dungeon_kindle',
    'jieji_dungeon_bloodlamp',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonLamp')

  if (selected == 'jieji_dungeon_kindle') {
    final cost = jiejiDungeonLampTakeMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      jiejiDungeonGrantBlank()
      dialog.pushDialog('hint_jieji_dungeon_kindle', interpolations: ['${cost}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonLampTakeGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_kindle_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_bloodlamp') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonLampBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    game.flags.jieji ??= {}
    if (game.flags.jieji.arrayWard != true) {
      game.flags.jieji.arrayWard = true
    }
    dialog.pushDialog('hint_jieji_dungeon_bloodlamp', interpolations: ['${lost}'])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiDungeonLampBloodGongfaRate)
    if (dropped != true) {
      final money = kJiejiDungeonLampBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_bloodlamp_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonLampFillHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
    }
    final healed = Player.restoreLife(kJiejiDungeonLampFillLife)
    game.flags.jieji ??= {}
    game.flags.jieji.illusionVeil = true
    if (jiejiDungeonSeasonId() == 'mist') {
      final extra = kJiejiDungeonLampFillMistMoney
      await Player.collect('money', extra, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_fill_mist', interpolations: ['${healed}', '${extra}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_dungeon_fill', interpolations: ['${healed}'])
      await dialog.execute()
    }
  }
}

