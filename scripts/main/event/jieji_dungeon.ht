async function _playJiejiDungeonEncampThunder() {
  dialog.pushDialog('hint_jieji_dungeon_encamp_thunder')
  dialog.pushSelection('jiejiDungeonEncampThunder', [
    'jieji_dungeon_pray',
    'jieji_dungeon_quench',
    'jieji_dungeon_rest',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonEncampThunder')

  if (selected == 'jieji_dungeon_pray') {
    if (random.nextDouble() < kJiejiDungeonPrayBlankChance) {
      jiejiDungeonGrantBlank()
      dialog.pushDialog('hint_jieji_dungeon_pray_blank')
      await dialog.execute()
    } else {
      final money = 40 + random.nextInt(41)
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_pray_money', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_quench') {
    final dungeon = jiejiDungeonEnsureFlags()
    dungeon.jiejiBuffEnemyRank = 1
    dialog.pushDialog('hint_jieji_dungeon_quench')
    await dialog.execute()
  } else {
    final healed = Player.restoreLife(kJiejiDungeonRestLife)
    dialog.pushDialog('hint_jieji_dungeon_rest', interpolations: ['${healed}'])
    await dialog.execute()
    if (random.nextDouble() < kJiejiDungeonRestKarmaChance + jiejiKarmaChanceBonus()) {
      await grantKarmaCard(jiejiDungeonKarmaSource())
    }
  }
}

async function _playJiejiDungeonEncampMist() {
  dialog.pushDialog('hint_jieji_dungeon_encamp_mist')
  dialog.pushSelection('jiejiDungeonEncampMist', [
    'jieji_dungeon_scavenge',
    'jieji_dungeon_askway',
    'jieji_dungeon_guide',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonEncampMist')

  if (selected == 'jieji_dungeon_scavenge') {
    if (random.nextDouble() < 0.50) {
      final herb = 2 + random.nextInt(3)
      await Player.collect('herb', herb, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_scavenge_herb', interpolations: ['${herb}'])
      await dialog.execute()
    } else {
      final money = 50 + random.nextInt(51)
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_scavenge_money', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_askway') {
    final label = jiejiDungeonNextRoomLabel()
    if (game.flags.dungeon != null && game.flags.dungeon.jiejiNextRoomKind != null) {
      dialog.pushDialog('hint_jieji_dungeon_askway', interpolations: [label])
      await dialog.execute()
    } else {
      final money = 40 + random.nextInt(31)
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_askway_loot', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final cost = kJiejiDungeonGuideCost
    final money = hero.materials['money'] ?? 0
    if (money >= cost) {
      Player.exhaust('money', cost)
      dialog.pushDialog('hint_jieji_dungeon_guide', interpolations: ['${cost}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_dungeon_guide_broke')
      await dialog.execute()
      if (random.nextDouble() < kJiejiDungeonGuideKarmaChance + jiejiKarmaChanceBonus()) {
        await grantKarmaCard('mist')
      }
    }
  }
}

async function _playJiejiDungeonEncampBlood() {
  dialog.pushDialog('hint_jieji_dungeon_encamp_blood')
  dialog.pushSelection('jiejiDungeonEncampBlood', [
    'jieji_dungeon_rite',
    'jieji_dungeon_contract',
    'jieji_dungeon_bypass',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonEncampBlood')

  if (selected == 'jieji_dungeon_rite') {
    final lost = jiejiDungeonClampLifeLoss(kJiejiDungeonRiteLifeLoss)
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    if (random.nextDouble() < 0.50 - jiejiKarmaChanceBonus()) {
      final money = 80 + random.nextInt(71)
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_rite_money', interpolations: ['${lost}', '${money}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_dungeon_rite_karma', interpolations: ['${lost}'])
      await dialog.execute()
      await grantKarmaCard('blood')
    }
  } else if (selected == 'jieji_dungeon_contract') {
    final dungeon = jiejiDungeonEnsureFlags()
    dungeon.jiejiLootBonus = true
    dialog.pushDialog('hint_jieji_dungeon_contract')
    await dialog.execute()
  } else {
    dialog.pushDialog('hint_jieji_dungeon_bypass')
    await dialog.execute()
  }
}

async function playJiejiDungeonAltar() {
  dialog.pushDialog('hint_jieji_dungeon_altar')
  dialog.pushSelection('jiejiDungeonAltar', [
    'jieji_dungeon_offer',
    'jieji_dungeon_borrow',
    'jieji_dungeon_leave',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonAltar')

  if (selected == 'jieji_dungeon_offer') {
    final herb = hero.materials['herb'] ?? 0
    if (herb >= kJiejiDungeonAltarHerbCost) {
      Player.exhaust('herb', kJiejiDungeonAltarHerbCost)
      if (random.nextDouble() < 0.50) {
        jiejiDungeonGrantBlank()
        dialog.pushDialog('hint_jieji_dungeon_offer_blank', interpolations: ['${kJiejiDungeonAltarHerbCost}'])
        await dialog.execute()
      } else {
        final money = 80 + random.nextInt(61)
        await Player.collect('money', money, incurIncident: false)
        dialog.pushDialog('hint_jieji_dungeon_offer_money', interpolations: ['${kJiejiDungeonAltarHerbCost}', '${money}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_dungeon_offer_broke', interpolations: ['${kJiejiDungeonAltarHerbCost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_borrow') {
    await grantKarmaCard(jiejiDungeonKarmaSource())
  } else {
    dialog.pushDialog('hint_jieji_dungeon_altar_leave')
    await dialog.execute()
  }
}

async function playJiejiDungeonCache() {
  dialog.pushDialog('hint_jieji_dungeon_cache')
  dialog.pushSelection('jiejiDungeonCache', [
    'jieji_dungeon_open',
    'jieji_dungeon_see_leave',
    'jieji_dungeon_force',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonCache')

  if (selected == 'jieji_dungeon_open') {
    if (random.nextDouble() < kJiejiDungeonCacheGoodChance) {
      final money = 100 + random.nextInt(81)
      await Player.collect('money', money, incurIncident: false)
      jiejiDungeonGrantBlank()
      dialog.pushDialog('hint_jieji_dungeon_open_good', interpolations: ['${money}'])
      await dialog.execute()
    } else if (random.nextDouble() < 0.50) {
      final have = hero.materials['money'] ?? 0
      var lost = kJiejiDungeonCacheFailCost
      if (lost > have) lost = have
      if (lost > 0) {
        Player.exhaust('money', lost)
      }
      dialog.pushDialog('hint_jieji_dungeon_open_money', interpolations: ['${lost}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_dungeon_open_karma')
      await dialog.execute()
      await grantKarmaCard('blackmarket')
    }
  } else if (selected == 'jieji_dungeon_force') {
    final lost = jiejiDungeonClampLifeLoss(kJiejiDungeonForceLifeLoss)
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    final money = 180 + random.nextInt(71)
    await Player.collect('money', money, incurIncident: false)
    jiejiDungeonGrantBlank()
    final herb = 3 + random.nextInt(3)
    await Player.collect('herb', herb, incurIncident: false)
    dialog.pushDialog('hint_jieji_dungeon_force', interpolations: ['${lost}', '${money}', '${herb}'])
    await dialog.execute()
  } else {
    dialog.pushDialog('hint_jieji_dungeon_see_leave')
    await dialog.execute()
  }
}

function jiejiDungeonSpringSipLife() {
  final seasonId = jiejiDungeonSeasonId()
  if (seasonId == 'thunder') return kJiejiDungeonSpringSipLifeThunder
  if (seasonId == 'blood') return kJiejiDungeonSpringSipLifeBlood
  return kJiejiDungeonSpringSipLife
}

function jiejiDungeonSpringBottleHerb() {
  var herb = kJiejiDungeonSpringBottleHerb
  if (jiejiDungeonSeasonId() == 'mist') {
    herb = herb + kJiejiDungeonSpringBottleHerbMistExtra
  }
  return herb
}

function jiejiDungeonAmbushTollCost() {
  final seasonId = jiejiDungeonSeasonId()
  if (seasonId == 'thunder') return kJiejiDungeonAmbushTollThunder
  if (seasonId == 'blood') return kJiejiDungeonAmbushTollBlood
  return kJiejiDungeonAmbushToll
}

function _jiejiDungeonAmbushFoeRank() {
  var rank = hero.rank ?? 0
  if (jiejiDungeonSeasonId() == 'thunder') {
    if (rank < kCultivationRankMax) {
      rank = rank + 1
    }
  }
  return rank
}

function _jiejiDungeonAmbushFoeLevel(rank) {
  final minLevel = minLevelForRank(rank)
  final maxLevel = maxLevelForRank(rank)
  var level = (hero.level ?? 1) + random.nextInt(5) - 2
  if (level < minLevel) level = minLevel
  if (level > maxLevel) level = maxLevel
  return level
}

async function _playJiejiDungeonSpringSip() {
  final want = jiejiDungeonSpringSipLife()
  final healed = Player.restoreLife(want)
  dialog.pushDialog('hint_jieji_dungeon_sip', interpolations: ['${healed}'])
  await dialog.execute()
}

async function playJiejiDungeonSpring() {
  dialog.pushDialog('hint_jieji_dungeon_spring')
  dialog.pushSelection('jiejiDungeonSpring', [
    'jieji_dungeon_sip',
    'jieji_dungeon_bottle',
    'jieji_dungeon_no_drink',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonSpring')

  if (selected == 'jieji_dungeon_sip') {
    await _playJiejiDungeonSpringSip()
  } else if (selected == 'jieji_dungeon_bottle') {
    final cost = kJiejiDungeonSpringBottleCost
    final money = hero.materials['money'] ?? 0
    if (money >= cost) {
      Player.exhaust('money', cost)
      final herb = jiejiDungeonSpringBottleHerb()
      await Player.collect('herb', herb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiDungeonSpringBottleLife)
      dialog.pushDialog('hint_jieji_dungeon_bottle', interpolations: ['${cost}', '${herb}', '${healed}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_dungeon_bottle_broke')
      await dialog.execute()
      await _playJiejiDungeonSpringSip()
    }
  } else {
    dialog.pushDialog('hint_jieji_dungeon_no_drink')
    await dialog.execute()
  }
}

async function _playJiejiDungeonAmbushFight() {
  final rank = _jiejiDungeonAmbushFoeRank()
  final level = _jiejiDungeonAmbushFoeLevel(rank)
  final enemy = BattleEntity(name: engine.locale('jieji_dungeon_ambush_foe'), rank: rank, level: level)

  Game.updateUI()
  Game.showPrebattle(enemy,
    background: 'battle/scene/dungeon_night.png',
    loseOnEscape: true,
    onBattleEnd: async function [onJiejiDungeonAmbushEnd] (result, roundCount) {
      if (result) {
        final money = kJiejiDungeonAmbushWinMoneyMin + random.nextInt(kJiejiDungeonAmbushWinMoneySpan)
        await Player.collect('money', money, incurIncident: false)
        await tryDropGongfaShard(rate: kJiejiDungeonAmbushGongfaRate)
        dialog.pushDialog('hint_jieji_dungeon_charge_win', interpolations: ['${money}'])
        await dialog.execute()
      } else {
        var nextLife = (hero.life ?? 1) - kJiejiDungeonAmbushLoseLife
        if (nextLife < 1) nextLife = 1
        Player.setLife(nextLife)
        dialog.pushDialog('hint_jieji_dungeon_charge_lose')
        await dialog.execute()
      }
      Game.updateUI()
    }
  )
}

async function playJiejiDungeonAmbush() {
  dialog.pushDialog('hint_jieji_dungeon_ambush')
  dialog.pushSelection('jiejiDungeonAmbush', [
    'jieji_dungeon_charge',
    'jieji_dungeon_toll',
    'jieji_dungeon_detour',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonAmbush')

  if (selected == 'jieji_dungeon_toll') {
    final cost = jiejiDungeonAmbushTollCost()
    final money = hero.materials['money'] ?? 0
    if (money >= cost) {
      Player.exhaust('money', cost)
      dialog.pushDialog('hint_jieji_dungeon_toll', interpolations: ['${cost}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_dungeon_toll_broke')
      await dialog.execute()
      await _playJiejiDungeonAmbushFight()
    }
  } else if (selected == 'jieji_dungeon_detour') {
    final healed = Player.restoreLife(kJiejiDungeonAmbushDetourLife)
    if (jiejiDungeonSeasonId() == 'mist') {
      final herb = kJiejiDungeonAmbushDetourHerbMist
      await Player.collect('herb', herb, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_detour_mist', interpolations: ['${healed}', '${herb}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_dungeon_detour', interpolations: ['${healed}'])
      await dialog.execute()
    }
  } else {
    await _playJiejiDungeonAmbushFight()
  }
}

function jiejiDungeonTrialOfferMoney() {
  if (jiejiDungeonSeasonId() == 'mist') return kJiejiDungeonTrialOfferMoneyMist
  return kJiejiDungeonTrialOfferMoney
}

function _jiejiDungeonTrialFoeRank() {
  var rank = hero.rank ?? 0
  if (rank < kCultivationRankMax) {
    rank = rank + 1
  }
  if (jiejiDungeonSeasonId() == 'blood' && rank < kCultivationRankMax) {
    rank = rank + 1
  }
  return rank
}

function _jiejiDungeonTrialFoeLevel(rank) {
  final minLevel = minLevelForRank(rank)
  final maxLevel = maxLevelForRank(rank)
  var level = (hero.level ?? 1) + 2 + random.nextInt(4)
  if (level < minLevel) level = minLevel
  if (level > maxLevel) level = maxLevel
  return level
}

async function _playJiejiDungeonTrialFight() {
  final rank = _jiejiDungeonTrialFoeRank()
  final level = _jiejiDungeonTrialFoeLevel(rank)
  final enemy = BattleEntity(name: engine.locale('jieji_dungeon_trial_foe'), rank: rank, level: level)

  Game.updateUI()
  Game.showPrebattle(enemy,
    background: 'battle/scene/dungeon_night.png',
    loseOnEscape: true,
    onBattleEnd: async function [onJiejiDungeonTrialEnd] (result, roundCount) {
      if (result) {
        final money = kJiejiDungeonTrialWinMoneyMin + random.nextInt(kJiejiDungeonTrialWinMoneySpan)
        await Player.collect('money', money, incurIncident: false)
        jiejiDungeonGrantBlank()
        await tryDropGongfaShard(rate: kJiejiDungeonTrialGongfaRate)
        if (jiejiDungeonSeasonId() == 'thunder') {
          dialog.pushDialog('hint_jieji_dungeon_duel_win_thunder', interpolations: ['${money}'])
        } else {
          dialog.pushDialog('hint_jieji_dungeon_duel_win', interpolations: ['${money}'])
        }
        await dialog.execute()
      } else {
        final lost = jiejiDungeonClampLifeLoss(kJiejiDungeonTrialLoseLife)
        if (lost > 0) {
          Player.setLife(hero.life - lost)
        }
        dialog.pushDialog('hint_jieji_dungeon_duel_lose', interpolations: ['${lost}'])
        await dialog.execute()
      }
      Game.updateUI()
    }
  )
}

async function _playJiejiDungeonTrialOffer() {
  final seasonId = jiejiDungeonSeasonId()
  if (seasonId == 'blood') {
    final lost = jiejiDungeonClampLifeLoss(kJiejiDungeonTrialOfferLifeBlood)
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    jiejiDungeonGrantBlank()
    dialog.pushDialog('hint_jieji_dungeon_offer_blade_blood', interpolations: ['${lost}'])
    await dialog.execute()
    if (random.nextDouble() < 0.25 + jiejiKarmaChanceBonus()) {
      await grantKarmaCard(jiejiDungeonKarmaSource())
    }
    return
  }

  final moneyCost = jiejiDungeonTrialOfferMoney()
  final herbHave = hero.materials['herb'] ?? 0
  final moneyHave = hero.materials['money'] ?? 0
  if (seasonId == 'mist' && herbHave >= kJiejiDungeonTrialOfferHerb) {
    final herbCost = kJiejiDungeonTrialOfferHerb
    Player.exhaust('herb', herbCost)
    jiejiDungeonGrantBlank()
    dialog.pushDialog('hint_jieji_dungeon_offer_blade_herb', interpolations: ['${herbCost}'])
    await dialog.execute()
    return
  }
  if (moneyHave >= moneyCost) {
    Player.exhaust('money', moneyCost)
    jiejiDungeonGrantBlank()
    final dungeon = jiejiDungeonEnsureFlags()
    dungeon.jiejiLootBonus = true
    dialog.pushDialog('hint_jieji_dungeon_offer_blade_money', interpolations: ['${moneyCost}'])
    await dialog.execute()
    return
  }
  dialog.pushDialog('hint_jieji_dungeon_offer_blade_broke')
  await dialog.execute()
  await _playJiejiDungeonTrialFight()
}

async function playJiejiDungeonTrial() {
  dialog.pushDialog('hint_jieji_dungeon_trial')
  dialog.pushSelection('jiejiDungeonTrial', [
    'jieji_dungeon_duel',
    'jieji_dungeon_offer_blade',
    'jieji_dungeon_watch',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonTrial')

  if (selected == 'jieji_dungeon_offer_blade') {
    await _playJiejiDungeonTrialOffer()
  } else if (selected == 'jieji_dungeon_watch') {
    final healed = Player.restoreLife(kJiejiDungeonTrialWatchLife)
    if (jiejiDungeonSeasonId() == 'mist') {
      final herb = kJiejiDungeonTrialWatchHerbMist
      await Player.collect('herb', herb, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_watch_mist', interpolations: ['${healed}', '${herb}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_dungeon_watch', interpolations: ['${healed}'])
      await dialog.execute()
    }
  } else {
    await _playJiejiDungeonTrialFight()
  }
}

