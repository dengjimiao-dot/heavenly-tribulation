        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_dungeon_blank_broke', interpolations: ['${herbCost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_bleed') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonForgeBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
