      dialog.pushDialog('hint_jieji_dungeon_sealluojinzhu_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_bloodluojinzhu') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonLuojinzhuBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_bloodluojinzhu', interpolations: ['${lost}'])
    await dialog.execute()
    await grantKarmaCard(jiejiDungeonKarmaSource())
    var ok = await tryDropGongfaShard(rate: kJiejiDungeonLuojinzhuBloodGongfaRate)
    if (ok != true) {
      final money = kJiejiDungeonLuojinzhuBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_bloodluojinzhu_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonLuojinzhuReadyluojinzhuHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
      jiejiDungeonGrantBlank()
      if (jiejiDungeonSeasonId() == 'mist') {
        final money = kJiejiDungeonLuojinzhuReadyluojinzhuMistMoney
        await Player.collect('money', money, incurIncident: false)
        dialog.pushDialog('hint_jieji_dungeon_readyluojinzhu_mist', interpolations: ['${herbCost}', '${money}'])
        await dialog.execute()
      } else {
        dialog.pushDialog('hint_jieji_dungeon_readyluojinzhu', interpolations: ['${herbCost}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_dungeon_readyluojinzhu_broke', interpolations: ['${herbCost}'])
      await dialog.execute()
    }
  }
}


function jiejiDungeonDenglongzhuSealMoney() {
  if (jiejiDungeonSeasonId() == 'thunder') return kJiejiDungeonDenglongzhuSealMoneyThunder
  return kJiejiDungeonDenglongzhuSealMoney
}

function jiejiDungeonDenglongzhuBloodLifeLoss() {
  if (jiejiDungeonSeasonId() == 'blood') return kJiejiDungeonDenglongzhuBloodLifeBlood
  return kJiejiDungeonDenglongzhuBloodLife
}

function jiejiDungeonDenglongzhuApplyWard() {
  game.flags.jieji ??= {}
  if (game.flags.jieji.arrayWard != true) {
    game.flags.jieji.arrayWard = true
  } else {
    game.flags.jieji.feastFury = true
  }
}

async function playJiejiDungeonDenglongzhu() {
  dialog.pushDialog('hint_jieji_dungeon_denglongzhu_room')
  dialog.pushSelection('jiejiDungeonDenglongzhu', [
    'jieji_dungeon_readydenglongzhu',
    'jieji_dungeon_sealdenglongzhu',
    'jieji_dungeon_blooddenglongzhu',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonDenglongzhu')

  if (selected == 'jieji_dungeon_sealdenglongzhu') {
    final cost = jiejiDungeonDenglongzhuSealMoney()
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave >= cost) {
      Player.exhaust('money', cost)
      final healed = Player.restoreLife(kJiejiDungeonDenglongzhuSealLife)
      jiejiDungeonDenglongzhuApplyWard()
      dialog.pushDialog('hint_jieji_dungeon_sealdenglongzhu', interpolations: ['${cost}', '${healed}'])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiDungeonDenglongzhuSealGongfaRate)
    } else {
      dialog.pushDialog('hint_jieji_dungeon_sealdenglongzhu_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_dungeon_blooddenglongzhu') {
    final lost = jiejiDungeonClampLifeLoss(jiejiDungeonDenglongzhuBloodLifeLoss())
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_dungeon_blooddenglongzhu', interpolations: ['${lost}'])
    await dialog.execute()
    await grantKarmaCard(jiejiDungeonKarmaSource())
    var ok = await tryDropGongfaShard(rate: kJiejiDungeonDenglongzhuBloodGongfaRate)
    if (ok != true) {
      final money = kJiejiDungeonDenglongzhuBloodMoney
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_dungeon_blooddenglongzhu_none', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else {
    final herbCost = kJiejiDungeonDenglongzhuReadydenglongzhuHerb
    final herbHave = hero.materials['herb'] ?? 0
    if (herbHave >= herbCost) {
      Player.exhaust('herb', herbCost)
      jiejiDungeonGrantBlank()
      if (jiejiDungeonSeasonId() == 'mist') {
        final money = kJiejiDungeonDenglongzhuReadydenglongzhuMistMoney
        await Player.collect('money', money, incurIncident: false)
        dialog.pushDialog('hint_jieji_dungeon_readydenglongzhu_mist', interpolations: ['${herbCost}', '${money}'])
        await dialog.execute()
      } else {
        dialog.pushDialog('hint_jieji_dungeon_readydenglongzhu', interpolations: ['${herbCost}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_dungeon_readydenglongzhu_broke', interpolations: ['${herbCost}'])
      await dialog.execute()
    }
  }
}

function jiejiDungeonExitPackMoney() {
  final seasonId = jiejiDungeonSeasonId()
  if (seasonId == 'thunder') return kJiejiDungeonExitPackMoneyThunder
  if (seasonId == 'blood') return kJiejiDungeonExitPackMoneyBlood
  return kJiejiDungeonExitPackMoney
}

function jiejiDungeonExitBindLife() {
  if (jiejiDungeonSeasonId() == 'mist') return kJiejiDungeonExitBindLifeMist
  return kJiejiDungeonExitBindLife
}

/// 有赶路耗日辅助则耗 1 日；与 _jiejiRoadSpendDay 同一套 Game.updateGame。不可见则跳过。
async function _jiejiDungeonExitSpendDay() {
  if (Constants.ticksPerDay == null) return false
  if (Constants.ticksPerDay <= 0) return false
  await Game.updateGame(tick: Constants.ticksPerDay)
  return true
}

async function _playJiejiDungeonExitPack() {
  final money = jiejiDungeonExitPackMoney()
  await Player.collect('money', money, incurIncident: false)
  await tryDropGongfaShard(rate: kJiejiDungeonExitPackGongfaRate)
  dialog.pushDialog('hint_jieji_dungeon_pack', interpolations: ['${money}'])
  await dialog.execute()
}

/// 秘境出口劫礼。须在 unlockDungeonDeck / 清空 dungeon flags 之前调用。
async function playJiejiDungeonExitGift() {
  if (hero == null) return

  dialog.pushDialog('hint_jieji_dungeon_exit')
  dialog.pushSelection('jiejiDungeonExitGift', [
    'jieji_dungeon_pack',
    'jieji_dungeon_bind',
    'jieji_dungeon_dash',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiDungeonExitGift')

  if (selected == 'jieji_dungeon_bind') {
    final healed = Player.restoreLife(jiejiDungeonExitBindLife())
    dialog.pushDialog('hint_jieji_dungeon_bind', interpolations: ['${healed}'])
    await dialog.execute()
  } else if (selected == 'jieji_dungeon_dash') {
    final spentDay = await _jiejiDungeonExitSpendDay()
    final healed = Player.restoreLife(kJiejiDungeonExitDashLife)
    final herb = kJiejiDungeonExitDashHerb
    await Player.collect('herb', herb, incurIncident: false)
    if (spentDay) {
      dialog.pushDialog('hint_jieji_dungeon_dash', interpolations: ['${healed}', '${herb}'])
    } else {
      dialog.pushDialog('hint_jieji_dungeon_dash_noday', interpolations: ['${healed}', '${herb}'])
    }
    await dialog.execute()
  } else {
    await _playJiejiDungeonExitPack()
  }
  Game.updateUI()
}
