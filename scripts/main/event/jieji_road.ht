/// 劫季赶路事件：雷/雾/血三季分叉（表 A/B 各一套）+ 残碑稀有事件 + 行脚商人。
/// 由 sandbox onAfterMove 在隐藏任务与野遇都没触发时调用。
/// 大地图野遇成功后可升格为当季具名劫纹精英（见 tryJiejiWildEliteOnWildEncounter）。

const kJiejiRoadEventBaseRate = 0.10
const kJiejiRoadEventMoveCooldown = 6
const kMistRoadEventBaseRate = 0.10
const kMistRoadEventMoveCooldown = 6
const kMistRoadEventGuideCost = 80
const kJiejiMerchantBaseRate = 0.04
const kJiejiMerchantMoveCooldown = 10
const kJiejiMerchantHerbCost = 80
const kJiejiMerchantHerbGain = 5
const kJiejiMerchantSellHerb = 3
const kJiejiMerchantSellMoney = 120
const kJiejiMerchantBoxFailCost = 50
const kJiejiMerchantBoxKarmaChance = 0.40
const kThunderTempleKarmaChance = 0.20
const kThunderPrayBlankChance = 0.30
const kJiejiRoadSteleRate = 0.25
const kJiejiRoadTableBRate = 0.50
const kJiejiRoadOilCost = 80
const kJiejiRoadOilHeal = 6
const kJiejiRoadOilHerb = 2
const kJiejiRoadLootKarmaChance = 0.20
const kJiejiRoadRiteLifeLoss = 3
const kJiejiRoadRiteHeal = 5
const kJiejiRoadSteleHeal = 6
const kJiejiRoadSteleKarmaChance = 0.15
const kJiejiWildEliteMoveCooldown = 8
const kJiejiWildEliteChanceThunder = 0.28
const kJiejiWildEliteChanceBlood = 0.22
const kJiejiWildEliteChanceMist = 0.12
const kJiejiWildEliteMoneyMin = 80
const kJiejiWildEliteMoneySpan = 61
const kJiejiWildEliteThunderMoneyBonus = 40

function _jiejiRoadWildMul() {
  var mul = 1.0
  if (game.jieji != null && game.jieji.wildEncounterMul != null) {
    mul = game.jieji.wildEncounterMul
  }
  if (mul < 0) mul = 0
  return mul
}

function _jiejiRoadSeasonId() {
  if (game.jieji == null) return null
  return game.jieji.seasonId
}

function _jiejiRoadTerrainKind(terrain) {
  if (terrain != null && terrain.kind != null) return terrain.kind
  return 'plain'
}

function _jiejiRoadEnsureFlags() {
  game.flags.jieji ??= {}
  return game.flags.jieji
}

function _jiejiRoadTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiRoadClampLifeLoss(want) {
  if (hero == null) return 0
  var lost = want
  if (lost < 0) lost = 0
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  return lost
}

function _jiejiRoadGrantBlank() {
  final card = BattleCard(rank: 0)
  card.isCardBlank = true
  Player.acquireCard(card)
}

/// 耗 1 日。血月绕路已用 Game.updateGame(tick: ticksPerDay)，表 B 绕谷/绕开复用。
async function _jiejiRoadSpendDay() {
  await Game.updateGame(tick: Constants.ticksPerDay)
}

async function _playJiejiPickedRoadEvent(seasonId, terrain) {
  if (random.nextDouble() < kJiejiRoadSteleRate) {
    await playJiejiSteleRoadEvent()
    return
  }
  final tableB = random.nextDouble() < kJiejiRoadTableBRate
  if (seasonId == 'mist') {
    if (tableB) {
      await playJiejiMistRoadEvent2(terrain)
    } else {
      await playJiejiMistRoadEvent(terrain)
    }
  } else if (seasonId == 'thunder') {
    if (tableB) {
      await playJiejiThunderRoadEvent2(terrain)
    } else {
      await playJiejiThunderRoadEvent(terrain)
    }
  } else if (seasonId == 'blood') {
    if (tableB) {
      await playJiejiBloodRoadEvent2(terrain)
    } else {
      await playJiejiBloodRoadEvent(terrain)
    }
  }
}

/// 雾月赶路迷雾。隐藏任务与野遇都没触发时才滚；用 wildEncounterMul，不用 hiddenQuestMul。
async function tryMistRoadEventOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiRoadSeasonId() != 'mist') return false
  if (_jiejiRoadTutorialLocked()) return false

  final jieji = _jiejiRoadEnsureFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastMistEventMove ?? -999
  if (moves - last < kMistRoadEventMoveCooldown) return false

  var rate = kMistRoadEventBaseRate * _jiejiRoadWildMul()
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastMistEventMove = moves
  jieji.lastRoadEventMove = moves
  await playJiejiMistRoadEvent(terrain)
  return true
}

async function tryJiejiRoadEventOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiRoadTutorialLocked()) return false
  final seasonId = _jiejiRoadSeasonId()
  if (seasonId == null) return false

  final jieji = _jiejiRoadEnsureFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastRoadEventMove ?? -999
  if (moves - last < kJiejiRoadEventMoveCooldown) return false

  var rate = kJiejiRoadEventBaseRate * _jiejiRoadWildMul()
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  if (seasonId != 'mist' && seasonId != 'thunder' && seasonId != 'blood') {
    return false
  }

  jieji.lastRoadEventMove = moves
  if (seasonId == 'mist') {
    jieji.lastMistEventMove = moves
  }
  await _playJiejiPickedRoadEvent(seasonId, terrain)
  return true
}

async function tryJiejiMerchantOnMove() {
  if (hero == null) return false
  if (_jiejiRoadTutorialLocked()) return false

  final jieji = _jiejiRoadEnsureFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastMerchantMove ?? -999
  if (moves - last < kJiejiMerchantMoveCooldown) return false

  var rate = kJiejiMerchantBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastMerchantMove = moves
  await playJiejiMerchantEvent()
  return true
}

function _jiejiWildEliteChance(seasonId) {
  if (seasonId == 'thunder') return kJiejiWildEliteChanceThunder
  if (seasonId == 'blood') return kJiejiWildEliteChanceBlood
  if (seasonId == 'mist') return kJiejiWildEliteChanceMist
  return 0
}

function _jiejiWildEliteNameKey(seasonId) {
  if (seasonId == 'mist') return 'jieji_wild_elite_mist'
  if (seasonId == 'blood') return 'jieji_wild_elite_blood'
  return 'jieji_wild_elite_thunder'
}

/// 具名劫纹精英：境界 +1（封顶），胜后额外铜钱 + 功法残页骰。不管冷却/几率。
async function startJiejiWildEliteEncounter(terrain) {
  if (hero == null) return
  final jieji = _jiejiRoadEnsureFlags()
  jieji.lastWildEliteMove = jieji.worldMoves ?? 0

  var seasonId = _jiejiRoadSeasonId()
  if (seasonId != 'thunder' && seasonId != 'mist' && seasonId != 'blood') {
    seasonId = 'thunder'
  }

  var eliteRank = (hero.rank ?? 0) + 1
  if (eliteRank > kCultivationRankMax) eliteRank = kCultivationRankMax

  dialog.pushDialog('hint_jieji_wild_elite')
  await dialog.execute()

  final nameKey = _jiejiWildEliteNameKey(seasonId)
  await encounterEnemy(
    rank: eliteRank,
    terrainKind: _jiejiRoadTerrainKind(terrain),
    name: engine.locale(nameKey),
    battleEndCallback: async function (result, roundCount) {
      if (result) {
        var extra = kJiejiWildEliteMoneyMin + random.nextInt(kJiejiWildEliteMoneySpan)
        if (seasonId == 'thunder') {
          extra = extra + kJiejiWildEliteThunderMoneyBonus
        }
        await Player.collect('money', extra, incurIncident: false)
        await tryDropGongfaShard()
        Game.updateUI()
      }
    },
  )
}

/// 野遇掷中之后调用。教程锁、冷却、当季几率都过才升格为精英。
async function tryJiejiWildEliteOnWildEncounter(terrain) {
  if (hero == null) return false
  if (_jiejiRoadTutorialLocked()) return false
  final seasonId = _jiejiRoadSeasonId()
  final chance = _jiejiWildEliteChance(seasonId)
  if (chance <= 0) return false

  final jieji = _jiejiRoadEnsureFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastWildEliteMove ?? -999
  if (moves - last < kJiejiWildEliteMoveCooldown) return false
  if (random.nextDouble() > chance) return false

  await startJiejiWildEliteEncounter(terrain)
  return true
}

async function playJiejiMistRoadEvent(terrain) {
  dialog.pushDialog('hint_jieji_mist_lost')
  dialog.pushSelection('jiejiMistRoad', [
    'jieji_mist_forage',
    'jieji_mist_charge',
    'jieji_mist_guide',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiMistRoad')

  if (selected == 'jieji_mist_forage') {
    final herb = 2 + random.nextInt(3)
    final money = 50 + random.nextInt(51)
    await Player.collect('herb', herb, incurIncident: false)
    await Player.collect('money', money, incurIncident: false)
    dialog.pushDialog('hint_jieji_mist_forage', interpolations: ['${herb}', '${money}'])
    await dialog.execute()
  } else if (selected == 'jieji_mist_charge') {
    dialog.pushDialog('hint_jieji_mist_charge')
    await dialog.execute()
    await encounterEnemy(
      rank: hero.rank,
      terrainKind: _jiejiRoadTerrainKind(terrain),
      battleEndCallback: async function (result, roundCount) {
        if (result) {
          await tryDropGongfaShard()
        }
      },
    )
  } else {
    final cost = kMistRoadEventGuideCost
    final money = hero.materials['money'] ?? 0
    if (money >= cost) {
      Player.exhaust('money', cost)
      dialog.pushDialog('hint_jieji_mist_guide', interpolations: ['${cost}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_mist_guide_broke')
      await dialog.execute()
      if (random.nextDouble() < 0.30 + jiejiKarmaChanceBonus()) {
        await grantKarmaCard('mist')
      }
    }
  }
  Game.updateUI()
}

async function playJiejiThunderRoadEvent(terrain) {
  dialog.pushDialog('hint_jieji_road_thunder')
  dialog.pushSelection('jiejiThunderRoad', [
    'jieji_thunder_pray',
    'jieji_thunder_elite',
    'jieji_thunder_temple',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiThunderRoad')

  if (selected == 'jieji_thunder_pray') {
    if (random.nextDouble() < kThunderPrayBlankChance) {
      final card = BattleCard(rank: 0)
      card.isCardBlank = true
      Player.acquireCard(card)
      dialog.pushDialog('hint_jieji_road_thunder_pray_blank')
      await dialog.execute()
    } else {
      final money = 40 + random.nextInt(41)
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_thunder_pray_money', interpolations: ['${money}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_thunder_elite') {
    dialog.pushDialog('hint_jieji_road_thunder_elite')
    await dialog.execute()
    var eliteRank = (hero.rank ?? 0) + 1
    if (eliteRank > kCultivationRankMax) eliteRank = kCultivationRankMax
    await encounterEnemy(
      rank: eliteRank,
      terrainKind: _jiejiRoadTerrainKind(terrain),
      name: engine.locale('jieji_road_elite'),
      battleEndCallback: async function (result, roundCount) {
        if (result) {
          final extra = 80 + random.nextInt(41)
          await Player.collect('money', extra, incurIncident: false)
          dialog.pushDialog('hint_jieji_road_thunder_elite_loot', interpolations: ['${extra}'])
          await dialog.execute()
          await tryDropGongfaShard()
        }
      },
    )
  } else {
    dialog.pushDialog('hint_jieji_road_thunder_temple')
    await dialog.execute()
    if (random.nextDouble() < kThunderTempleKarmaChance + jiejiKarmaChanceBonus()) {
      await grantKarmaCard('temple')
    }
  }
  Game.updateUI()
}

async function playJiejiBloodRoadEvent(terrain) {
  dialog.pushDialog('hint_jieji_road_blood')
  dialog.pushSelection('jiejiBloodRoad', [
    'jieji_blood_rite',
    'jieji_blood_hunt',
    'jieji_blood_detour',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiBloodRoad')

  if (selected == 'jieji_blood_rite') {
    final lost = _jiejiRoadClampLifeLoss(3)
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    if (random.nextDouble() < 0.50 - jiejiKarmaChanceBonus()) {
      final money = 80 + random.nextInt(71)
      await Player.collect('money', money, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_blood_rite_money', interpolations: ['${lost}', '${money}'])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_road_blood_rite_karma', interpolations: ['${lost}'])
      await dialog.execute()
      await grantKarmaCard('blood')
      await tryDropGongfaShard()
    }
  } else if (selected == 'jieji_blood_hunt') {
    dialog.pushDialog('hint_jieji_road_blood_hunt')
    await dialog.execute()
    await encounterEnemy(
      rank: hero.rank,
      terrainKind: _jiejiRoadTerrainKind(terrain),
      battleEndCallback: async function (result, roundCount) {
        if (result) {
          await tryDropGongfaShard()
        }
      },
    )
  } else {
    dialog.pushDialog('hint_jieji_road_blood_detour')
    await dialog.execute()
    await _jiejiRoadSpendDay()
  }
  Game.updateUI()
}

