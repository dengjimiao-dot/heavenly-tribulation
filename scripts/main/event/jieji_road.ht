async function playJiejiMerchantEvent() {
  dialog.pushDialog('hint_jieji_road_merchant')
  dialog.pushSelection('jiejiWanderMerchant', [
    'jieji_merchant_buy',
    'jieji_merchant_sell',
    'jieji_merchant_box',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiWanderMerchant')

  if (selected == 'jieji_merchant_buy') {
    final money = hero.materials['money'] ?? 0
    if (money >= kJiejiMerchantHerbCost) {
      Player.exhaust('money', kJiejiMerchantHerbCost)
      await Player.collect('herb', kJiejiMerchantHerbGain, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_merchant_buy', interpolations: [
        '${kJiejiMerchantHerbCost}',
        '${kJiejiMerchantHerbGain}',
      ])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_road_merchant_buy_broke', interpolations: ['${kJiejiMerchantHerbCost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_merchant_sell') {
    final herb = hero.materials['herb'] ?? 0
    if (herb >= kJiejiMerchantSellHerb) {
      Player.exhaust('herb', kJiejiMerchantSellHerb)
      await Player.collect('money', kJiejiMerchantSellMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_merchant_sell', interpolations: [
        '${kJiejiMerchantSellHerb}',
        '${kJiejiMerchantSellMoney}',
      ])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_road_merchant_sell_broke', interpolations: ['${kJiejiMerchantSellHerb}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_merchant_box') {
    if (random.nextDouble() < kJiejiMerchantBoxKarmaChance + jiejiKarmaChanceBonus()) {
      await grantKarmaCard('blackmarket')
      await tryDropGongfaShard(rate: kGongfaMerchantDropRate)
    } else {
      final money = hero.materials['money'] ?? 0
      var lost = kJiejiMerchantBoxFailCost
      if (lost > money) lost = money
      if (lost > 0) {
        Player.exhaust('money', lost)
      }
      dialog.pushDialog('hint_jieji_road_merchant_box_fail', interpolations: ['${lost}'])
      await dialog.execute()
    }
  }
  Game.updateUI()
}

function _addJiejiRoadCardToCurrentDeck(card) {
  if (hero == null || card == null) return
  if (hero.battleDeckIndex == null) return
  if (hero.battleDeckIndex < 0) return
  if (hero.battleDecks == null || hero.battleDecks.isEmpty) return
  final deck = hero.battleDecks[hero.battleDeckIndex]
  if (deck == null || deck.cards == null) return
  if (!deck.cards.contains(card.id)) {
    deck.cards.add(card.id)
  }
}

function _createJiejiMerchantBladeCard() {
  if (game.battleCards == null) return null
  if (game.battleCards['punch_attack'] == null) return null
  final card = BattleCard(
    affixId: 'punch_attack',
    rank: 0,
    isIdentified: true,
  )
  card.isSeasonLimited = true
  card.name = engine.locale('card_jieji_merchant_blade')
  return card
}

async function playJiejiMerchantEvent2() {
  dialog.pushDialog('hint_jieji_road_merchant2')
  dialog.pushSelection('jiejiWanderMerchant2', [
    'jieji_merchant2_blade',
    'jieji_merchant2_herb',
    'jieji_merchant2_gamble',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiWanderMerchant2')
  final seasonId = _jiejiRoadSeasonId()

  if (selected == 'jieji_merchant2_blade') {
    var cost = kJiejiMerchant2BladeCost
    if (seasonId == 'thunder') {
      cost = kJiejiMerchant2BladeCostThunder
    }
    final money = hero.materials['money'] ?? 0
    if (money >= cost) {
      Player.exhaust('money', cost)
      final card = _createJiejiMerchantBladeCard()
      if (card != null) {
        Player.acquireCard(card)
        _addJiejiRoadCardToCurrentDeck(card)
        dialog.pushDialog('hint_jieji_road_merchant2_blade', interpolations: [
          '${cost}',
          card.name,
        ])
        await dialog.execute()
      } else {
        _jiejiRoadGrantBlank()
        dialog.pushDialog('hint_jieji_road_merchant2_blade_blank', interpolations: ['${cost}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_road_merchant2_blade_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_merchant2_herb') {
    var herbCost = kJiejiMerchant2HerbCost
    var moneyGain = kJiejiMerchant2HerbMoney
    if (seasonId == 'mist') {
      herbCost = kJiejiMerchant2HerbCostMist
      moneyGain = kJiejiMerchant2HerbMoneyMist
    }
    final herb = hero.materials['herb'] ?? 0
    if (herb >= herbCost) {
      Player.exhaust('herb', herbCost)
      await Player.collect('money', moneyGain, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_merchant2_herb', interpolations: [
        '${herbCost}',
        '${moneyGain}',
      ])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_road_merchant2_herb_broke', interpolations: ['${herbCost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_merchant2_gamble') {
    var karmaChance = kJiejiMerchant2GambleKarmaChance
    if (seasonId == 'blood') {
      karmaChance = kJiejiMerchant2GambleKarmaChanceBlood
    }
    if (random.nextDouble() < karmaChance) {
      await grantKarmaCard('merchant2')
      final herbGain = kJiejiMerchant2GambleHerbGain
      await Player.collect('herb', herbGain, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_merchant2_gamble_win', interpolations: ['${herbGain}'])
      await dialog.execute()
    } else {
      final lost = _jiejiRoadClampLifeLoss(kJiejiMerchant2GambleLifeLoss)
      if (lost > 0) {
        Player.setLife(hero.life - lost)
      }
      dialog.pushDialog('hint_jieji_road_merchant2_gamble_fail', interpolations: ['${lost}'])
      await dialog.execute()
    }
  }
  Game.updateUI()
}
