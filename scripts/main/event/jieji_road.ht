      final herb = 2 + random.nextInt(3)
      await Player.collect('herb', herb, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_thunder2_crystal_herb', interpolations: ['${herb}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_thunder2_tread') {
    dialog.pushDialog('hint_jieji_road_thunder2_tread')
    await dialog.execute()
    await encounterEnemy(
      rank: hero.rank,
      terrainKind: _jiejiRoadTerrainKind(terrain),
      name: engine.locale('jieji_road_rift'),
      battleEndCallback: async function (result, roundCount) {
        if (result) {
          await tryDropGongfaShard()
        }
      },
    )
  } else {
    dialog.pushDialog('hint_jieji_road_thunder2_detour')
    await dialog.execute()
    await _jiejiRoadSpendDay()
  }
  Game.updateUI()
}

async function playJiejiMistRoadEvent2(terrain) {
  dialog.pushDialog('hint_jieji_road_mist2')
  dialog.pushSelection('jiejiMistRoad2', [
    'jieji_mist2_oil',
    'jieji_mist2_box',
    'jieji_mist2_leave',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiMistRoad2')

  if (selected == 'jieji_mist2_oil') {
    final cost = kJiejiRoadOilCost
    final money = hero.materials['money'] ?? 0
    if (money >= cost) {
      Player.exhaust('money', cost)
      var preferHeal = false
      if (hero.life < hero.stats.lifeMax && random.nextDouble() < 0.50) {
        preferHeal = true
      }
      if (preferHeal) {
        final healed = Player.restoreLife(kJiejiRoadOilHeal)
        dialog.pushDialog('hint_jieji_road_mist2_oil_heal', interpolations: ['${cost}', '${healed}'])
        await dialog.execute()
      } else {
        final herb = kJiejiRoadOilHerb
        await Player.collect('herb', herb, incurIncident: false)
        dialog.pushDialog('hint_jieji_road_mist2_oil_herb', interpolations: ['${cost}', '${herb}'])
        await dialog.execute()
      }
    } else {
      dialog.pushDialog('hint_jieji_road_mist2_oil_broke', interpolations: ['${cost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_mist2_box') {
    if (random.nextDouble() < 0.50) {
      final herb = 2 + random.nextInt(3)
      final moneyGain = 50 + random.nextInt(51)
      await Player.collect('herb', herb, incurIncident: false)
      await Player.collect('money', moneyGain, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_mist2_box_loot', interpolations: ['${herb}', '${moneyGain}'])
      await dialog.execute()
    } else {
      await grantKarmaCard('mist')
    }
  } else {
    dialog.pushDialog('hint_jieji_road_mist2_leave')
    await dialog.execute()
  }
  Game.updateUI()
}

async function playJiejiBloodRoadEvent2(terrain) {
  dialog.pushDialog('hint_jieji_road_blood2')
  dialog.pushSelection('jiejiBloodRoad2', [
    'jieji_blood2_loot',
    'jieji_blood2_rite',
    'jieji_blood2_detour',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiBloodRoad2')

  if (selected == 'jieji_blood2_loot') {
    final money = 80 + random.nextInt(71)
    await Player.collect('money', money, incurIncident: false)
    dialog.pushDialog('hint_jieji_road_blood2_loot', interpolations: ['${money}'])
    await dialog.execute()
    if (random.nextDouble() < kJiejiRoadLootKarmaChance + jiejiKarmaChanceBonus()) {
      await grantKarmaCard('blood')
    }
  } else if (selected == 'jieji_blood2_rite') {
    final lost = _jiejiRoadClampLifeLoss(kJiejiRoadRiteLifeLoss)
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    if (clearOneJiejiCurse()) {
      dialog.pushDialog('hint_jieji_road_blood2_rite_curse', interpolations: ['${lost}'])
      await dialog.execute()
    } else if (random.nextDouble() < 0.50) {
      final healed = Player.restoreLife(kJiejiRoadRiteHeal)
      dialog.pushDialog('hint_jieji_road_blood2_rite_heal', interpolations: ['${lost}', '${healed}'])
      await dialog.execute()
    } else {
      _jiejiRoadGrantBlank()
      dialog.pushDialog('hint_jieji_road_blood2_rite_blank', interpolations: ['${lost}'])
      await dialog.execute()
    }
  } else {
    dialog.pushDialog('hint_jieji_road_blood2_detour')
    await dialog.execute()
    await _jiejiRoadSpendDay()
  }
  Game.updateUI()
}

async function playJiejiSteleRoadEvent() {
  dialog.pushDialog('hint_jieji_road_stele')
  dialog.pushSelection('jiejiSteleRoad', [
    'jieji_stele_rub',
    'jieji_stele_worship',
    'jieji_stele_chisel',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiSteleRoad')

  if (selected == 'jieji_stele_rub') {
    _jiejiRoadGrantBlank()
    dialog.pushDialog('hint_jieji_road_stele_rub')
    await dialog.execute()
  } else if (selected == 'jieji_stele_worship') {
    final healed = Player.restoreLife(kJiejiRoadSteleHeal)
    dialog.pushDialog('hint_jieji_road_stele_worship', interpolations: ['${healed}'])
    await dialog.execute()
  } else {
    final money = 50 + random.nextInt(51)
    await Player.collect('money', money, incurIncident: false)
    dialog.pushDialog('hint_jieji_road_stele_chisel', interpolations: ['${money}'])
    await dialog.execute()
    if (random.nextDouble() < kJiejiRoadSteleKarmaChance + jiejiKarmaChanceBonus()) {
      await grantKarmaCard('stele')
    }
  }
  Game.updateUI()
}

async function playJiejiMerchantEvent() {
  dialog.pushDialog('hint_jieji_road_merchant')
  dialog.pushSelection('jiejiWanderMerchant', [
    'jieji_merchant_buy',
    'jieji_merchant_sell',
    'jieji_merchant_box',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiWanderMerchant')

  if (selected == 'jieji_merchant_buy') {
    final money = hero.materials['money'] ?? 0
    if (money >= kJiejiMerchantHerbCost) {
      Player.exhaust('money', kJiejiMerchantHerbCost)
      await Player.collect('herb', kJiejiMerchantHerbGain, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_merchant_buy', interpolations: [
        '${kJiejiMerchantHerbCost}',
        '${kJiejiMerchantHerbGain}',
      ])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_road_merchant_buy_broke', interpolations: ['${kJiejiMerchantHerbCost}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_merchant_sell') {
    final herb = hero.materials['herb'] ?? 0
    if (herb >= kJiejiMerchantSellHerb) {
      Player.exhaust('herb', kJiejiMerchantSellHerb)
      await Player.collect('money', kJiejiMerchantSellMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_road_merchant_sell', interpolations: [
        '${kJiejiMerchantSellHerb}',
        '${kJiejiMerchantSellMoney}',
      ])
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_jieji_road_merchant_sell_broke', interpolations: ['${kJiejiMerchantSellHerb}'])
      await dialog.execute()
    }
  } else if (selected == 'jieji_merchant_box') {
    if (random.nextDouble() < kJiejiMerchantBoxKarmaChance + jiejiKarmaChanceBonus()) {
      await grantKarmaCard('blackmarket')
      await tryDropGongfaShard(rate: kGongfaMerchantDropRate)
    } else {
      final money = hero.materials['money'] ?? 0
      var lost = kJiejiMerchantBoxFailCost
      if (lost > money) lost = money
      if (lost > 0) {
        Player.exhaust('money', lost)
      }
      dialog.pushDialog('hint_jieji_road_merchant_box_fail', interpolations: ['${lost}'])
      await dialog.execute()
    }
  }
  Game.updateUI()
}
