      } else if (r < 0.67) {
        await Player.collect('money', 30, incurIncident: false)
      } else {
        Player.restoreLife(1)
      }
      dialog.pushDialog('hint_jieji_blood_tor_extra_blood')
      await dialog.execute()
    }
  }

