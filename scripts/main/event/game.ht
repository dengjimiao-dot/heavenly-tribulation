async function onRested() {
  if (game.enableTutorial) {
    if (game.flags.tutorial.rested) return

    if (hero.life >= hero.stats.lifeMax) {
      game.flags.tutorial.rested = true
      Player.progressJournalById('sandboxTutorial')
    }
  }
}

/// 进入据点/城市场景之前，教程阶段对特定设施进行封锁
async function onBeforeEnterLocation(location) -> bool {
  if (game.enableTutorial) {
    final journal = hero.journals['sandboxTutorial']
    if (journal != null && !journal.isFinished) {
      // // 斗技场：完成悬赏任务前（stage < 3）封锁
      // if (location.kind == 'arena' && journal.stage < 3) {
      //   final npc = game.npcs[location.npcId]
      //   dialog.pushDialog('tutorial_arena_locked', npc: npc)
      //   await dialog.execute()
      //   return true
      // }
      // // 秘境入口：完成斗技场挑战前（stage < 4）封锁
      // if (location.kind == 'dungeon' && journal.stage < 4) {
      //   final npc = game.npcs[location.npcId]
      //   dialog.pushDialog('tutorial_dungeon_locked', npc: npc)
      //   await dialog.execute()
      //   return true
      // }
    }
  }
  return false
}

/// 进入城市场景
/// 这个接口的逻辑较复杂，为了避免 bug 并不会一次就触发所有的事件
/// 每次触发某个事件后，就会返回 true，这样就会跳过后续其他逻辑的判断
async function onAfterEnterLocation(location) -> bool {
  // 游戏教程的提示
  if (game.enableTutorial) {
    if (location.id == hero.homeLocationId) {
      if (!game.flags.tutorial.homeLocation) {
        // 提示进入家宅
        game.flags.tutorial.homeLocation = true
        
        dialog.pushDialog('tutorial_homeLocation_line_1', npc: game.npcs['xitong'])
        await dialog.execute()
        return true
      } else if (!game.flags.tutorial.dummyPractice && game.flags.tutorial.rested) {
        dialog.pushDialog('tutorial_homeLocation_line_3', npc: game.npcs['xitong'])
        await dialog.execute()

        final dummy = BattleEntity(
          name: 'wooden_dummy',
          isFemale: false,
          level: 0,
          rank: 0,
          icon: 'illustration/npc/wooden_dummy_head.png',
          skin: 'wooden_dummy',
          attributes: {
            'charisma': 0,
            'wisdom': 0,
            'luck': 0,
            'spirituality': 0,
            'dexterity': 0,
            'strength': 20,
            'willpower': 0,
            'perception': 0,
          },
          cultivationFavor: '',
          allocateSkills: false,
          autoGenerateDeck: false,
        )
        generateBattleDeck(dummy,
          cardInfoList: List.filled(Constants.battleDeckSize, {'affixId': 'blank_default'})
        )

        Game.showPrebattle(
          dummy,
          loseOnEscape: false,
          onBattleEnd: async function [onBattleEnd] (battleResult, roundCount) {
            if (!battleResult) return

            game.flags.tutorial.dummyPractice = true
            Player.progressJournalById('sandboxTutorial')

            dialog.pushDialog('tutorial_homeLocation_line_4', npc: game.npcs['xitong'])
            await dialog.execute()
          }
        )
        return true
      } else if (game.flags.tutorial.bountyQuest) {
        // 完成悬赏任务后回到家乡，提示斗技场已开放并推进事项
        final journal = hero.journals['sandboxTutorial']
        if (journal?.stage == 2) {
          dialog.pushDialog('tutorial_homeLocation_bountyDone', npc: game.npcs['xitong'])
          await dialog.execute()
          Player.progressJournalById('sandboxTutorial')
          return true
        }
      }
    } else if (location.id == hero.homeSiteId) {
      if (!game.flags.tutorial.homeSite) {
        // 提示休息
        game.flags.tutorial.homeSite = true
        
        dialog.pushDialog('tutorial_homeLocation_line_2', npc: game.npcs['xitong'])
        await dialog.execute()
        return true
      }
    }
  }

  // 处理角色初入门派的报告，以及门派每月例会
  if (hero.sectId != null) {
    final sect = game.sects[hero.sectId];
    final memberData = sect.membersData[hero.id];
    assert(memberData != null,
        'Member data not found in sect [${sect.id}], member id: ${hero.id}');
    final reportSiteId = memberData.reportSiteId;
    if (reportSiteId == location.id) {
      final superior = game.characters[memberData.superiorId];
      assert(superior != null,
          'character not found, id: ${memberData.superiorId}');
      final initiationQuest = hero.journals.sectInitiation;
      if (initiationQuest?.stage == 0) {
        characterMet(hero, superior)
        dialog.pushDialog(
          'hint_sect_initiation2',
          character: superior,
        );
        await dialog.execute();

        final itemsInfo = [
          {
            'type': 'potion',
            'rank': hero.rank,
          },
          {
            'type': 'cardpack',
            'genre': sect['genre'],
            'rank': hero.rank,
          },
        ];
        final items = await Player.loot(itemsInfo);
        await Game.promptItems(items);
        Player.progressJournalById('sectInitiation');
        await Game.promptJournal(initiationQuest);
        return true;
      } else {
        if (hero.id != sect.headId) {
          final monthly = game.flags.monthly;
          final day = toDay(game.timestamp)
          if (monthly.attendedMeeting != true && day < 5) {
            monthly.attendedMeeting = true;

            // 教程：首次参加例会后推进事项到最终阶段
            if (game.enableTutorial && game.flags.tutorial.sect && !game.flags.tutorial.meeting) {
              game.flags.tutorial.meeting = true
              Player.progressJournalById('sandboxTutorial')
            }

            Game.showMeeting(sect, location, superior);
            return true;
          }
        }
      }
    }
  }

  // 处理任务上交
  final questJournals = hero.journals.values.where((journal) =>
   !journal.isFinished && journal.quest != null
  )
  for (final journal in questJournals) {
    if (journal.quest.reportSiteId == location.id) {
      final endTime = journal.timestamp + journal.quest.timeLimit
      let isLate = game.timestamp > endTime
      switch (journal.quest.kind) {
        case 'deliver_material', 'deliver_item': {
          // final receiverId = journal.quest.receiverId
          // final receiver = game.characters[receiverId]
          final success = Player.deliver(journal.quest.package)
          // characterMet(receiver, hero)
          if (success) {
            Player.progressJournalById(journal.id)
            if (game.enableTutorial && !game.flags.tutorial.bountyQuest) {
              game.flags.tutorial.bountyQuest = true
            }
            if (isLate) {
              dialog.pushDialog('quest_deliver_late_success', npcId: location.npcId);
              await dialog.execute();
            } else {
              dialog.pushDialog('quest_deliver_success', npcId: location.npcId);
              await dialog.execute();
            }
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
          } else {
            Player.progressJournalById(journal.id, stage: 2)
            if (isLate) {
              dialog.pushDialog('quest_late_failed', npcId: location.npcId);
              await dialog.execute();
            } else {
              dialog.pushDialog('quest_unfinished', npcId: location.npcId, interpolations: [journal.title]);
              await dialog.execute();
            }
          }
          return true
        }
        case 'escort': {
          final success = Player.deliver(journal.quest.package)
          if (success) {
            Player.progressJournalById(journal.id)
            if (game.enableTutorial && !game.flags.tutorial.bountyQuest) {
              game.flags.tutorial.bountyQuest = true
            }
            final escortType = journal.quest.escortType;
            final escorteeId = journal.quest.package.characterId;
            if (isLate) {
              dialog.pushDialog('quest_escort_late_success_${escortType}', characterId: escorteeId);
              await dialog.execute();
            } else {
              dialog.pushDialog('quest_escort_success_${escortType}', characterId: escorteeId);
              await dialog.execute();
            }
            Game.updateNpcsAtLocation(location)
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
          }
          return true
        }
        case 'guard_site': {
          return true
        }
        case 'purchase_material': {
          final success = Player.deliver(journal.quest.requirement)
          if (success) {
            Player.progressJournalById(journal.id)
            if (game.enableTutorial && !game.flags.tutorial.bountyQuest) {
              game.flags.tutorial.bountyQuest = true
            }
            if (isLate) {
              dialog.pushDialog('quest_purchase_late_success', npcId: location.npcId);
              await dialog.execute();
            } else {
              dialog.pushDialog('quest_purchase_success', npcId: location.npcId);
              await dialog.execute();
            }
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
          } else {
            if (isLate) {
              Player.exhaust(journal.quest.budget.kind, journal.quest.budget.amount, forceExhaust: true)
              Player.progressJournalById(journal.id, stage: 2)
              dialog.pushDialog('quest_purchase_late_failed', npcId: location.npcId);
              await dialog.execute();
            } else {
              dialog.pushDialog('quest_unfinished', npcId: location.npcId, interpolations: [journal.title]);
              await dialog.execute();
            }
          }
          return true
        }
        case 'purchase_item': {
          if (isLate) {
            dialog.pushDialog('quest_purchase_late_greeting', npcId: location.npcId);
            await dialog.execute();
          } else {
            dialog.pushDialog('quest_purchase_greeting', npcId: location.npcId);
            await dialog.execute();
          }
          final selectedItems = await Game.selectItem(
            character: hero,
            filter: journal.quest.requirement,
            multiSelect: false,
          )
          if (selectedItems.isNotEmpty) {
            Player.progressJournalById(journal.id)
            if (game.enableTutorial && !game.flags.tutorial.bountyQuest) {
              game.flags.tutorial.bountyQuest = true
            }
            final item = selectedItems.first
            Player.lose(item)
            if (isLate) {
              dialog.pushDialog('quest_purchase_late_success', npcId: location.npcId);
              await dialog.execute();
            } else {
              dialog.pushDialog('quest_purchase_success', npcId: location.npcId);
              await dialog.execute();
            }
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
          } else {
            if (isLate) {
              Player.exhaust(journal.quest.budget.kind, journal.quest.budget.amount, forceExhaust: true)
              Player.progressJournalById(journal.id, stage: 2)
              dialog.pushDialog('quest_purchase_late_failed', npcId: location.npcId);
              await dialog.execute();
            } else {
              dialog.pushDialog('quest_unfinished', npcId: location.npcId, interpolations: [journal.title]);
              await dialog.execute();
            }
          }
          return true
        }
        case 'discover_location': {
          final targetLocationId = journal.quest.targetLocationId
          final targetLocation = game.locations[targetLocationId]
          if (targetLocation.isDiscovered) {
            Player.progressJournalById(journal.id)
            if (game.enableTutorial && !game.flags.tutorial.bountyQuest) {
              game.flags.tutorial.bountyQuest = true
            }
            if (isLate) {
              dialog.pushDialog('quest_discover_late_success', npcId: location.npcId);
              await dialog.execute();
            } else {
              dialog.pushDialog('quest_discover_success', npcId: location.npcId,
                interpolations: [targetLocation.name],
              );
              await dialog.execute();
            }
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
          } else {
            if (isLate) {
              Player.progressJournalById(journal.id, stage: 2)
              dialog.pushDialog('quest_discover_late_failed', npcId: location.npcId);
              await dialog.execute();
            } else {
              dialog.pushDialog('quest_unfinished', npcId: location.npcId, interpolations: [journal.title]);
              await dialog.execute();
            }
          }
          return true
        }
        case 'hidden_ruins_explore': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await grantJiejiHiddenQuestExtra('ruins')
          }
          return true
        }
        case 'hidden_karma_shrine': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await grantKarmaCard('shrine')
            await grantJiejiHiddenQuestExtra('shrine')
          }
          return true
        }
        case 'hidden_blood_omen': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
            return true
          }
          encounterEnemy(
            rank: journal.quest.difficulty,
            terrainKind: location.kind,
            name: engine.locale('quest_hidden_blood_omen_enemy'),
            battleEndCallback: async function (result, roundCount) {
              if (!result) return
              Player.progressJournalById(journal.id)
              var locName = ''
              final loc = game.locations[journal.quest.targetLocationId]
              if (loc != null) {
                locName = loc.name
              }
              dialog.pushDialog('quest_hidden_blood_omen_success', interpolations: [
                locName,
              ])
              await dialog.execute()
              final items = await Player.loot(journal.quest.reward)
              Game.promptItems(items)
              await grantJiejiHiddenQuestExtra('blood')
            }
          )
          return true
        }
        case 'hidden_gongfa_cache': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_gongfa_cache_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await grantGongfaShard(null)
            await grantJiejiHiddenQuestExtra('gongfa')
          }
          return true
        }
        case 'hidden_herb_grove': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_herb_grove_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await grantJiejiHiddenQuestExtra('grove')
          }
          return true
        }
        case 'hidden_ore_vein': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_ore_vein_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            if (Constants.materialKinds != null && Constants.materialKinds.contains('ore')) {
              await Player.collect('ore', 2, incurIncident: false)
              dialog.pushDialog('hint_jieji_ore_vein_extra')
              await dialog.execute()
            } else {
              await Player.collect('money', 80, incurIncident: false)
              dialog.pushDialog('hint_jieji_ore_vein_extra_money')
              await dialog.execute()
            }
            await grantJiejiHiddenQuestExtra('vein')
          }
          return true
        }
        case 'hidden_ferry_lantern': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_ferry_lantern_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await Player.collect('herb', 2, incurIncident: false)
            dialog.pushDialog('hint_jieji_ferry_lantern_extra')
            await dialog.execute()
            if (random.nextDouble() < 0.15) {
              await grantGongfaShard(null)
            }
            await grantJiejiHiddenQuestExtra('ferry')
          }
          return true
        }
        case 'hidden_storm_well': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_storm_well_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            Player.restoreLife(6)
            dialog.pushDialog('hint_jieji_storm_well_extra')
            await dialog.execute()
            await tryDropGongfaShard(rate: 0.2)
            await grantJiejiHiddenQuestExtra('well')
          }
          return true
        }
        case 'hidden_blood_feast': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_blood_feast_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            Player.restoreLife(4)
            dialog.pushDialog('hint_jieji_blood_feast_extra')
            await dialog.execute()
            await tryDropGongfaShard(rate: 0.25)
            await grantJiejiHiddenQuestExtra('banquet')
          }
          return true
        }
        case 'hidden_mist_market': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_mist_market_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await Player.collect('money', 40, incurIncident: false)
            final jieji = ensureJiejiFlags()
            jieji.illusionVeil = true
            dialog.pushDialog('hint_jieji_mist_market_extra')
            await dialog.execute()
            await grantJiejiHiddenQuestExtra('market')
          }
          return true
        }
        case 'hidden_gongfa_cave': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_gongfa_cave_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await grantJiejiHiddenQuestExtra('cave')
          }
          return true
        }
        case 'hidden_mirror_ruins': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_mirror_ruins_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await Player.collect('money', 20, incurIncident: false)
            final jieji = ensureJiejiFlags()
            jieji.illusionVeil = true
            dialog.pushDialog('hint_jieji_mirror_ruins_extra')
            await dialog.execute()
            await tryDropGongfaShard(rate: 0.35)
            await grantJiejiHiddenQuestExtra('mirror')
          }
          return true
        }
        case 'hidden_remnant_lamp': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_remnant_lamp_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await Player.collect('money', 25, incurIncident: false)
            final jieji = ensureJiejiFlags()
            if (jieji.arrayWard != true) {
              jieji.arrayWard = true
              dialog.pushDialog('hint_jieji_remnant_lamp_extra')
            } else {
              jieji.illusionVeil = true
              dialog.pushDialog('hint_jieji_remnant_lamp_extra_veil')
            }
            await dialog.execute()
            await tryDropGongfaShard(rate: 0.4)
            await grantJiejiHiddenQuestExtra('remnant')
          }
          return true
        }
        case 'hidden_drum_mound': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_drum_mound_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            await Player.collect('money', 30, incurIncident: false)
            final jieji = ensureJiejiFlags()
            if (jieji.arrayFury != true) {
              jieji.arrayFury = true
              dialog.pushDialog('hint_jieji_drum_mound_extra')
            } else {
              jieji.feastFury = true
              dialog.pushDialog('hint_jieji_drum_mound_extra_feast')
            }
            await dialog.execute()
            await tryDropGongfaShard(rate: 0.4)
            await grantJiejiHiddenQuestExtra('mound')
          }
          return true
        }
