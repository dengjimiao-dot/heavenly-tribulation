            Player.restoreLife(4)
            dialog.pushDialog('hint_jieji_thunder_tuan_extra')
            await dialog.execute()
            await tryDropGongfaShard(rate: 0.25)
            await grantJiejiHiddenQuestExtra('tuan')
          }
          return true
        }

        case 'hidden_mist_hypocotyl': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_mist_hypocotyl_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            if (random.nextDouble() < 0.5) {
              await Player.collect('herb', 2, incurIncident: false)
            } else {
              await Player.collect('money', 40, incurIncident: false)
            }
            Player.restoreLife(4)
            dialog.pushDialog('hint_jieji_mist_hypocotyl_extra')
            await dialog.execute()
            await tryDropGongfaShard(rate: 0.25)
            await grantJiejiHiddenQuestExtra('hypocotyl')
          }
          return true
        }

        case 'hidden_blood_liang': {
          if (isLate) {
            Player.progressJournalById(journal.id, stage: 2)
            dialog.pushDialog('quest_hidden_late_failed', interpolations: [journal.title])
            await dialog.execute()
          } else {
            Player.progressJournalById(journal.id)
            var locName = ''
            final loc = game.locations[journal.quest.targetLocationId]
            if (loc != null) {
              locName = loc.name
            }
            dialog.pushDialog('quest_hidden_blood_liang_complete', interpolations: [
              journal.title,
              locName,
            ])
            await dialog.execute()
            final items = await Player.loot(journal.quest.reward)
            Game.promptItems(items)
            if (random.nextDouble() < 0.5) {
              await Player.collect('herb', 2, incurIncident: false)
            } else {
              await Player.collect('money', 40, incurIncident: false)
            }
            Player.restoreLife(4)
            dialog.pushDialog('hint_jieji_blood_liang_extra')
            await dialog.execute()
            await tryDropGongfaShard(rate: 0.25)
            await grantJiejiHiddenQuestExtra('liang')
          }
          return true
        }























































































































      }
    }
  }
}

/// 斗技场战斗结束后触发（无论胜负）
async function onArenaEnd() {
  if (game.enableTutorial && !game.flags.tutorial.arena) {
    game.flags.tutorial.arena = true
    Player.progressJournalById('sandboxTutorial')
  }
}

/// 进入秘境前触发
async function onBeforeEnterDungeon() {
  if (game.enableTutorial && !game.flags.tutorial.dungeon) {
    game.flags.tutorial.dungeon = true
    Player.progressJournalById('sandboxTutorial')
  }
}

/// 境界突破成功时触发
async function onHeroRankUp() {
  if (game.enableTutorial && hero.rank >= 1 && !game.flags.tutorial.rank1) {
    game.flags.tutorial.rank1 = true
    Player.progressJournalById('sandboxTutorial')
    dialog.pushDialog('tutorial_rankUp_rank1', npc: game.npcs['xitong'])
    await dialog.execute()
  }
}

/// 玩家加入门派时触发，推进教程到「参与例会」阶段
async function onAfterJoinedSect() {
  if (game.enableTutorial && !game.flags.tutorial.sect) {
    game.flags.tutorial.sect = true
    Player.progressJournalById('sandboxTutorial')
  }
}

/// 逃劫：濒死结算时记一笔业力，不打断原作回城逻辑
async function onDying() {
  await grantKarmaCard('flee')
  return false
}

function currentJiejiSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return ''
}

/// 隐藏任务按时成功时的季象额外奖励。迟到不发。
async function grantJiejiHiddenQuestExtra(kind) {
  final seasonId = currentJiejiSeasonId()
  if (kind == 'shrine' && seasonId == 'thunder') {
    if (random.nextDouble() < 0.3) {
      await grantKarmaCard('shrine')
      dialog.pushDialog('hint_jieji_shrine_extra_karma')
      await dialog.execute()
    } else {
      await Player.collect('money', 100, incurIncident: false)
      dialog.pushDialog('hint_jieji_shrine_extra_money')
      await dialog.execute()
    }
    return
  }
  if (kind == 'ruins' && seasonId == 'mist') {
    if (random.nextDouble() < 0.5) {
      await Player.collect('money', 80, incurIncident: false)
    } else {
      await Player.collect('herb', 3, incurIncident: false)
    }
    dialog.pushDialog('hint_jieji_ruins_extra')
    await dialog.execute()
    return
  }
  if (kind == 'blood' && seasonId == 'blood') {
    await Player.collect('money', 120, incurIncident: false)
    dialog.pushDialog('hint_jieji_blood_extra')
    await dialog.execute()
    return
  }
  if (kind == 'gongfa') {
    if (seasonId == 'thunder') {
      await Player.collect('money', 40, incurIncident: false)
      dialog.pushDialog('hint_jieji_gongfa_cache_extra_money')
      await dialog.execute()
    } else if (seasonId == 'blood') {
      if (random.nextDouble() < 0.15) {
        await grantKarmaCard('shrine')
        dialog.pushDialog('hint_jieji_gongfa_cache_extra_karma')
        await dialog.execute()
      }
    }
    return
  }
  if (kind == 'cave') {
    await Player.collect('money', 30, incurIncident: false)
    dialog.pushDialog('hint_jieji_gongfa_cave_extra')
    await dialog.execute()
    var ok = await tryDropGongfaShard(rate: 0.55)
    if (ok != true) {
      ok = await grantGongfaShard(null)
    }
    return
  }
  if (kind == 'grove') {
    if (seasonId == 'mist') {
      await Player.collect('herb', 2, incurIncident: false)
      dialog.pushDialog('hint_jieji_grove_extra')
      await dialog.execute()
    } else if (seasonId == 'thunder') {
      if (random.nextDouble() < 0.2) {
        final card = BattleCard(rank: 0)
        card.isCardBlank = true
        Player.acquireCard(card)
        dialog.pushDialog('hint_jieji_grove_extra_blank')
        await dialog.execute()
      }
    }
    return
  }
  if (kind == 'shade') {
    if (seasonId == 'mist') {
      await Player.collect('herb', 2, incurIncident: false)
      dialog.pushDialog('hint_jieji_stele_shade_extra_mist')
      await dialog.execute()
    }
    return
  }
  if (kind == 'stall') {
    if (seasonId == 'mist') {
      await Player.collect('herb', 2, incurIncident: false)
      dialog.pushDialog('hint_jieji_haggle_stall_extra_mist')
      await dialog.execute()
    }
  }
  if (kind == 'blank') {
    if (seasonId == 'thunder') {
      await Player.collect('money', 20, incurIncident: false)
      dialog.pushDialog('hint_jieji_blank_cache_extra_thunder')
      await dialog.execute()
    }
  }
  if (kind == 'field') {
    if (seasonId == 'mist') {
      await Player.collect('herb', 2, incurIncident: false)
      dialog.pushDialog('hint_jieji_night_field_extra_mist')
