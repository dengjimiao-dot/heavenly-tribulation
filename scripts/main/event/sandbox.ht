async function briefJiejiNewGame() {
  game.flags.jieji ??= {}
  if (game.flags.jieji.briefed == true) return
  game.flags.jieji.briefed = true
  dialog.pushDialog('hint_jieji_brief_1')
  dialog.pushDialog('hint_jieji_brief_2')
  dialog.pushDialog('hint_jieji_brief_3')
  await dialog.execute()
}

function jiejiWildEncounterMul() {
  var mul = 1.0
  if (game.jieji != null && game.jieji.wildEncounterMul != null) {
    mul = game.jieji.wildEncounterMul
  }
  if (mul < 0) mul = 0
  return mul
}

async function tryWildEncounterOnMove(terrain) {
  let rate = Constants.terrainKindToEnemyEncounterRate[terrain.kind] ?? kEnemyEncounterRateBase
  let er = rate * (1 - hero.rank * kEnemyEncounterRateRankFactor) * jiejiWildEncounterMul()
  if (er < 0) er = 0
  if (random.nextDouble() > er) return false
  if (consumeJiejiIllusionVeil()) {
    dialog.pushDialog('hint_jieji_veil_dodge')
    await dialog.execute()
    Game.updateUI()
    return true
  }
  if (consumeJiejiStarWardWild()) {
    await encounterEnemy(
      rank: hero.rank,
      terrainKind: terrain.kind,
      battleEndCallback: async function (result, roundCount) {
        await applyJiejiStarWardOnWildWin(result)
      },
    )
    return true
  }
  if (consumeJiejiPsychicDrawElite()) {
    await startJiejiWildEliteEncounter(terrain)
    return true
  }
  if (await tryJiejiWildEliteOnWildEncounter(terrain)) return true
  await encounterEnemy(rank: hero.rank, terrainKind: terrain.kind)
  return true
}


async function onAfterMove(terrain) {
  // 先尝试隐藏任务，避免开局十步保证被野遇吃掉。
  if (await trySpawnHiddenQuestOnMove(terrain)) return true

  // 季末前夜劫兆：余日 1～2 赶路必出，占掉本步野遇/赶路/行商。
  if (await tryJiejiSeasonEveOnMove()) return true

  var fought = false
  final tradeQuest = hero.journals.values.where((journal) =>
   !journal.isFinished &&
   journal.quest != null &&
   Constants.enemyEncounterQuests.contains(journal.quest.kind) &&
   !journal.hasEncounteredEnemy
  )

  if (tradeQuest.isEmpty) {
    fought = await tryWildEncounterOnMove(terrain)
  } else {
    final roll = random.nextDouble()
    let rate = Constants.terrainKindToEnemyEncounterRate[terrain.kind] ?? kEnemyEncounterRateBase
    let er = rate * (1 - hero.rank * kEnemyEncounterRateRankFactor) * jiejiWildEncounterMul()
    if (roll <= er) {
      final journal = tradeQuest.first
      journal.hasEncounteredEnemy = true

      encounterEnemy(
        rank: journal.quest.difficulty,
        terrainKind: terrain.kind,
        battleEndCallback: async function (result, roundCount) {
          if (result) return

          final materialLostRate = kEncounterDefeatMaterialLostBase + kEncounterDefeatMaterialLostPerRank * journal.quest.difficulty
          final materials = hero.materials.keys.where((materialId) =>
            hero.materials[materialId] > 0
          ).toList()
          if (materials.isNotEmpty) {
            final materialId = random.nextIterable(materials)
            final amount = hero.materials[materialId]
            final lost = (amount * materialLostRate).ceil()
            Player.exhaust(materialId, lost)
            dialog.pushDialog('hint_loseMultiple', interpolations: [lost, engine.locale(materialId)])
            await dialog.execute()
          }

          final equipmentLostRate = kEncounterDefeatEquipmentLostBase + kEncounterDefeatEquipmentLostPerRank * journal.quest.difficulty
          let equippedIndexes = hero.equipments.keys.where((slot) =>
            hero.equipments[slot] != null
          ).toList()
          final roll = random.nextDouble()
          if (equippedIndexes.isNotEmpty && roll < equipmentLostRate) {
            final slot = random.nextIterable(equippedIndexes)
            final itemId = hero.equipments[slot]
            final item = hero.inventory[itemId]
            Player.unequip(item)
            Player.lose(item)
            dialog.pushDialog('hint_lose', interpolations: [item.name])
            await dialog.execute()
          }

          if (journal.quest.kind == 'escort') {
            Player.progressJournalById(journal.id, stage: 2)
            final character = game.characters[journal.quest.package.characterId]
            final escortType = journal.quest.escortType;
            dialog.pushDialog('quest_escort_failed_${escortType}', character: character);
            await dialog.execute()
            Player.dismiss(character)
          }
      })

      fought = true
    }
  }

  if (!fought) {
    if (await tryJiejiRoadEventOnMove(terrain)) return true
    if (await tryJiejiMerchantOnMove()) return true
    if (await tryJiejiScavengeOnMove(terrain)) return true
    if (await tryJiejiCampOnMove(terrain)) return true
    if (await tryJiejiBladeOnMove(terrain)) return true
    if (await tryJiejiScrollOnMove(terrain)) return true
    if (await tryJiejiLanternOnMove(terrain)) return true
    if (await tryJiejiEchoOnMove(terrain)) return true
    if (await tryJiejiDrawOnMove(terrain)) return true
    if (await tryJiejiPennantOnMove(terrain)) return true
    if (await tryJiejiChimeOnMove(terrain)) return true
    if (await tryJiejiTalismanOnMove(terrain)) return true
    if (await tryJiejiStreamerOnMove(terrain)) return true
    if (await tryJiejiCandleOnMove(terrain)) return true
    if (await tryJiejiHornOnMove(terrain)) return true
    if (await tryJiejiFluteOnMove(terrain)) return true
    if (await tryJiejiHatOnMove(terrain)) return true
    if (await tryJiejiSashOnMove(terrain)) return true
    if (await tryJiejiBootOnMove(terrain)) return true
    if (await tryJiejiCapeOnMove(terrain)) return true
    if (await tryJiejiFanOnMove(terrain)) return true
    if (await tryJiejiStaffOnMove(terrain)) return true
    if (await tryJiejiUmbrellaOnMove(terrain)) return true
    if (await tryJiejiMaskOnMove(terrain)) return true
    if (await tryJiejiShawlOnMove(terrain)) return true
    if (await tryJiejiGloveOnMove(terrain)) return true
    if (await tryJiejiRingOnMove(terrain)) return true
    if (await tryJiejiMirrorOnMove(terrain)) return true
    if (await tryJiejiDrumOnMove(terrain)) return true
    if (await tryJiejiTorchOnMove(terrain)) return true
    if (await tryJiejiCombOnMove(terrain)) return true
    if (await tryJiejiLadleOnMove(terrain)) return true
    if (await tryJiejiBowlOnMove(terrain)) return true
    if (await tryJiejiCupOnMove(terrain)) return true
    if (await tryJiejiJarOnMove(terrain)) return true
    if (await tryJiejiVialOnMove(terrain)) return true
    if (await tryJiejiInkOnMove(terrain)) return true
    if (await tryJiejiRobeOnMove(terrain)) return true
    if (await tryJiejiBeltOnMove(terrain)) return true
    if (await tryJiejiPinOnMove(terrain)) return true
    if (await tryJiejiBrushOnMove(terrain)) return true
    if (await tryJiejiNeedleOnMove(terrain)) return true
    if (await tryJiejiClaspOnMove(terrain)) return true
    if (await tryJiejiCordOnMove(terrain)) return true
    if (await tryJiejiBeadOnMove(terrain)) return true
    if (await tryJiejiBroochOnMove(terrain)) return true
    if (await tryJiejiLaceOnMove(terrain)) return true
    if (await tryJiejiTasselOnMove(terrain)) return true
    if (await tryJiejiRibbonOnMove(terrain)) return true
    if (await tryJiejiFringeOnMove(terrain)) return true
    if (await tryJiejiCuffOnMove(terrain)) return true
  }
  return fought
}
