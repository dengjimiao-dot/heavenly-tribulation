/// 赶路「劫拇长展肌革」三选：系拇长展肌 / 解拇长展肌 / 血拇长展肌。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革、劫肋头革、劫肋颈革、劫肋结节革、劫肋角革、劫肋沟革、劫肋脊革、劫肋体革、劫肋椎革、劫肋横突革、劫肋软骨结革、劫胸肋革、劫柄胸革、劫胸骨角革、劫剑胸革、劫肋胸革、劫颈静脉切迹革、劫锁骨切迹革、劫肋软骨弓革、劫肋下角革、劫胸骨体革、劫肋剑突革、劫锁间韧带革、劫肋软骨结合革、劫胸骨肌革、劫胸大肌革、劫前锯肌革、劫锁骨下肌革、劫背阔肌革、劫斜方肌革、劫三角肌革、劫冈下肌革、劫大圆肌革、劫小圆肌革、劫冈上肌革、劫肩胛下肌革、劫喙肱肌革、劫肱肌革、劫肱三头肌革、劫肘肌革、劫肱桡肌革、劫指伸肌革、劫尺侧腕屈肌革、劫掌长肌革、劫桡侧腕屈肌革、劫尺侧腕伸肌革、劫桡侧腕长伸肌革、劫桡侧腕短伸肌革、劫拇长展肌革都没中时才滚。
const kJiejiAbductorpolicislongusstrapBaseRate = 0.00000000000000008
const kJiejiAbductorpolicislongusstrapMoveCooldown = 24
const kJiejiAbductorpolicislongusstrapTieabductorpolicislongusstrapHerb = 1
const kJiejiAbductorpolicislongusstrapTieabductorpolicislongusstrapLife = 1
const kJiejiAbductorpolicislongusstrapTieabductorpolicislongusstrapGongfaRate = 0.005
const kJiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapMoney = 1
const kJiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapMoneyThunder = 1
const kJiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapHerb = 1
const kJiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapLife = 1
const kJiejiAbductorpolicislongusstrapBloodLife = 1
const kJiejiAbductorpolicislongusstrapBloodLifeBlood = 2
const kJiejiAbductorpolicislongusstrapBloodGongfaRate = 0.03
const kJiejiAbductorpolicislongusstrapBloodMoney = 2

function _jiejiAbductorpolicislongusstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiAbductorpolicislongusstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiAbductorpolicislongusstrapTieabductorpolicislongusstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiAbductorpolicislongusstrapTieabductorpolicislongusstrapHerb
}

function _jiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapMoneyThunder
  return kJiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapMoney
}

function _jiejiAbductorpolicislongusstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiAbductorpolicislongusstrapBloodLifeBlood
  return kJiejiAbductorpolicislongusstrapBloodLife
}

function _jiejiAbductorpolicislongusstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiAbductorpolicislongusstrapNormalizeKind(kind) {
  if (kind == 'tieabductorpolicislongusstrap' || kind == 'jieji_abductorpolicislongusstrap_tieabductorpolicislongusstrap') return 'tieabductorpolicislongusstrap'
  if (kind == 'looseabductorpolicislongusstrap' || kind == 'jieji_abductorpolicislongusstrap_looseabductorpolicislongusstrap') return 'looseabductorpolicislongusstrap'
  if (kind == 'bloodabductorpolicislongusstrap' || kind == 'jieji_abductorpolicislongusstrap_bloodabductorpolicislongusstrap') return 'bloodabductorpolicislongusstrap'
  return null
}

function _jiejiAbductorpolicislongusstrapChoices() {
  return [
    {
      text: 'jieji_abductorpolicislongusstrap_tieabductorpolicislongusstrap',
      description: 'hint_jieji_abductorpolicislongusstrap_tieabductorpolicislongusstrap',
    },
    {
      text: 'jieji_abductorpolicislongusstrap_looseabductorpolicislongusstrap',
      description: 'hint_jieji_abductorpolicislongusstrap_looseabductorpolicislongusstrap',
    },
    {
      text: 'jieji_abductorpolicislongusstrap_bloodabductorpolicislongusstrap',
      description: 'hint_jieji_abductorpolicislongusstrap_bloodabductorpolicislongusstrap',
    },
  ]
}

/// 赶路劫拇长展肌革三选。debug.forceJiejiEvent('abductorpolicislongusstrap') / forceAbductorpolicislongusstrap 直接走这里，仍弹出三选。
async function playJiejiAbductorpolicislongusstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_abductorpolicislongusstrap')
  dialog.pushSelection('jiejiAbductorpolicislongusstrap', _jiejiAbductorpolicislongusstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiAbductorpolicislongusstrap')
  var selected = _jiejiAbductorpolicislongusstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieabductorpolicislongusstrap'
  }

  final seasonId = _jiejiAbductorpolicislongusstrapSeasonId()
  if (selected == 'tieabductorpolicislongusstrap') {
    final herbNeed = _jiejiAbductorpolicislongusstrapTieabductorpolicislongusstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_abductorpolicislongusstrap_tieabductorpolicislongusstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiAbductorpolicislongusstrapTieabductorpolicislongusstrapLife)
      dialog.pushDialog('hint_jieji_abductorpolicislongusstrap_tieabductorpolicislongusstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiAbductorpolicislongusstrapTieabductorpolicislongusstrapGongfaRate)
    }
  } else if (selected == 'looseabductorpolicislongusstrap') {
    final moneyNeed = _jiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_abductorpolicislongusstrap_looseabductorpolicislongusstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapLife)
      dialog.pushDialog('hint_jieji_abductorpolicislongusstrap_looseabductorpolicislongusstrap_ok', interpolations: [kJiejiAbductorpolicislongusstrapLooseabductorpolicislongusstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiAbductorpolicislongusstrapCostLife(_jiejiAbductorpolicislongusstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_abductorpolicislongusstrap_bloodabductorpolicislongusstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiAbductorpolicislongusstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiAbductorpolicislongusstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_abductorpolicislongusstrap_bloodabductorpolicislongusstrap_none', interpolations: [kJiejiAbductorpolicislongusstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000000008%。出过则返回 true。
async function tryJiejiAbductorpolicislongusstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiAbductorpolicislongusstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastAbductorpolicislongusstrapMove ?? -999
  if (moves - last < kJiejiAbductorpolicislongusstrapMoveCooldown) return false

  var rate = kJiejiAbductorpolicislongusstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastAbductorpolicislongusstrapMove = moves
  await playJiejiAbductorpolicislongusstrapEvent(terrain)
  return true
}
