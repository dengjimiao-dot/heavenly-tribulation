/// 赶路「劫蹄铁」三选：钉铁 / 卸铁 / 血铁。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索都没中时才滚。
const kJiejiShoeBaseRate = 0.000018
const kJiejiShoeMoveCooldown = 24
const kJiejiShoeNailshoeHerb = 1
const kJiejiShoeNailshoeLife = 1
const kJiejiShoeNailshoeGongfaRate = 0.006
const kJiejiShoeLooseshoeMoney = 1
const kJiejiShoeLooseshoeMoneyThunder = 1
const kJiejiShoeLooseshoeHerb = 1
const kJiejiShoeLooseshoeLife = 1
const kJiejiShoeBloodLife = 1
const kJiejiShoeBloodLifeBlood = 2
const kJiejiShoeBloodGongfaRate = 0.04
const kJiejiShoeBloodMoney = 2

function _jiejiShoeSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiShoeTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiShoeNailshoeHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiShoeNailshoeHerb
}

function _jiejiShoeLooseshoeMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiShoeLooseshoeMoneyThunder
  return kJiejiShoeLooseshoeMoney
}

function _jiejiShoeBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiShoeBloodLifeBlood
  return kJiejiShoeBloodLife
}

function _jiejiShoeCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiShoeNormalizeKind(kind) {
  if (kind == 'nailshoe' || kind == 'jieji_shoe_nailshoe') return 'nailshoe'
  if (kind == 'looseshoe' || kind == 'jieji_shoe_looseshoe') return 'looseshoe'
  if (kind == 'bloodshoe' || kind == 'jieji_shoe_bloodshoe') return 'bloodshoe'
  return null
}

function _jiejiShoeChoices() {
  return [
    {
      text: 'jieji_shoe_nailshoe',
      description: 'hint_jieji_shoe_nailshoe',
    },
    {
      text: 'jieji_shoe_looseshoe',
      description: 'hint_jieji_shoe_looseshoe',
    },
    {
      text: 'jieji_shoe_bloodshoe',
      description: 'hint_jieji_shoe_bloodshoe',
    },
  ]
}

/// 赶路劫蹄铁三选。debug.forceJiejiEvent('shoe') / forceShoe 直接走这里，仍弹出三选。
async function playJiejiShoeEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_shoe')
  dialog.pushSelection('jiejiShoe', _jiejiShoeChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiShoe')
  var selected = _jiejiShoeNormalizeKind(picked)
  if (selected == null) {
    selected = 'nailshoe'
  }

  final seasonId = _jiejiShoeSeasonId()
  if (selected == 'nailshoe') {
    final herbNeed = _jiejiShoeNailshoeHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_shoe_nailshoe_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiShoeNailshoeLife)
      dialog.pushDialog('hint_jieji_shoe_nailshoe_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiShoeNailshoeGongfaRate)
    }
  } else if (selected == 'looseshoe') {
    final moneyNeed = _jiejiShoeLooseshoeMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_shoe_looseshoe_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiShoeLooseshoeHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiShoeLooseshoeLife)
      dialog.pushDialog('hint_jieji_shoe_looseshoe_ok', interpolations: [kJiejiShoeLooseshoeHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiShoeCostLife(_jiejiShoeBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_shoe_bloodshoe_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiShoeBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiShoeBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_shoe_bloodshoe_none', interpolations: [kJiejiShoeBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0018%。出过则返回 true。
async function tryJiejiShoeOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiShoeTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastShoeMove ?? -999
  if (moves - last < kJiejiShoeMoveCooldown) return false

  var rate = kJiejiShoeBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastShoeMove = moves
  await playJiejiShoeEvent(terrain)
  return true
}
