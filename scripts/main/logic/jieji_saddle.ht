/// 赶路「劫鞍」三选：安鞍 / 卸鞍 / 血鞍。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊都没中时才滚。
const kJiejiSaddleBaseRate = 0.00003
const kJiejiSaddleMoveCooldown = 24
const kJiejiSaddleSetsaddleHerb = 1
const kJiejiSaddleSetsaddleLife = 1
const kJiejiSaddleSetsaddleGongfaRate = 0.006
const kJiejiSaddleLoosesaddleMoney = 1
const kJiejiSaddleLoosesaddleMoneyThunder = 1
const kJiejiSaddleLoosesaddleHerb = 1
const kJiejiSaddleLoosesaddleLife = 1
const kJiejiSaddleBloodLife = 1
const kJiejiSaddleBloodLifeBlood = 2
const kJiejiSaddleBloodGongfaRate = 0.04
const kJiejiSaddleBloodMoney = 2

function _jiejiSaddleSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiSaddleTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiSaddleSetsaddleHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiSaddleSetsaddleHerb
}

function _jiejiSaddleLoosesaddleMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiSaddleLoosesaddleMoneyThunder
  return kJiejiSaddleLoosesaddleMoney
}

function _jiejiSaddleBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiSaddleBloodLifeBlood
  return kJiejiSaddleBloodLife
}

function _jiejiSaddleCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiSaddleNormalizeKind(kind) {
  if (kind == 'setsaddle' || kind == 'jieji_saddle_setsaddle') return 'setsaddle'
  if (kind == 'loosesaddle' || kind == 'jieji_saddle_loosesaddle') return 'loosesaddle'
  if (kind == 'bloodsaddle' || kind == 'jieji_saddle_bloodsaddle') return 'bloodsaddle'
  return null
}

function _jiejiSaddleChoices() {
  return [
    {
      text: 'jieji_saddle_setsaddle',
      description: 'hint_jieji_saddle_setsaddle',
    },
    {
      text: 'jieji_saddle_loosesaddle',
      description: 'hint_jieji_saddle_loosesaddle',
    },
    {
      text: 'jieji_saddle_bloodsaddle',
      description: 'hint_jieji_saddle_bloodsaddle',
    },
  ]
}

/// 赶路劫鞍三选。debug.forceJiejiEvent('saddle') / forceSaddle 直接走这里，仍弹出三选。
async function playJiejiSaddleEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_saddle')
  dialog.pushSelection('jiejiSaddle', _jiejiSaddleChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiSaddle')
  var selected = _jiejiSaddleNormalizeKind(picked)
  if (selected == null) {
    selected = 'setsaddle'
  }

  final seasonId = _jiejiSaddleSeasonId()
  if (selected == 'setsaddle') {
    final herbNeed = _jiejiSaddleSetsaddleHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_saddle_setsaddle_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiSaddleSetsaddleLife)
      dialog.pushDialog('hint_jieji_saddle_setsaddle_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiSaddleSetsaddleGongfaRate)
    }
  } else if (selected == 'loosesaddle') {
    final moneyNeed = _jiejiSaddleLoosesaddleMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_saddle_loosesaddle_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiSaddleLoosesaddleHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiSaddleLoosesaddleLife)
      dialog.pushDialog('hint_jieji_saddle_loosesaddle_ok', interpolations: [kJiejiSaddleLoosesaddleHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiSaddleCostLife(_jiejiSaddleBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_saddle_bloodsaddle_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiSaddleBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiSaddleBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_saddle_bloodsaddle_none', interpolations: [kJiejiSaddleBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.003%。出过则返回 true。
async function tryJiejiSaddleOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiSaddleTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastSaddleMove ?? -999
  if (moves - last < kJiejiSaddleMoveCooldown) return false

  var rate = kJiejiSaddleBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastSaddleMove = moves
  await playJiejiSaddleEvent(terrain)
  return true
}
