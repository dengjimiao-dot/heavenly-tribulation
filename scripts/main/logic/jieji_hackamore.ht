/// 赶路「劫套革」三选：系套 / 解套 / 血套。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革都没中时才滚。
const kJiejiHackamoreBaseRate = 0.0000010
const kJiejiHackamoreMoveCooldown = 24
const kJiejiHackamoreTiehackamoreHerb = 1
const kJiejiHackamoreTiehackamoreLife = 1
const kJiejiHackamoreTiehackamoreGongfaRate = 0.005
const kJiejiHackamoreLoosehackamoreMoney = 1
const kJiejiHackamoreLoosehackamoreMoneyThunder = 1
const kJiejiHackamoreLoosehackamoreHerb = 1
const kJiejiHackamoreLoosehackamoreLife = 1
const kJiejiHackamoreBloodLife = 1
const kJiejiHackamoreBloodLifeBlood = 2
const kJiejiHackamoreBloodGongfaRate = 0.03
const kJiejiHackamoreBloodMoney = 2

function _jiejiHackamoreSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiHackamoreTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiHackamoreTiehackamoreHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiHackamoreTiehackamoreHerb
}

function _jiejiHackamoreLoosehackamoreMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiHackamoreLoosehackamoreMoneyThunder
  return kJiejiHackamoreLoosehackamoreMoney
}

function _jiejiHackamoreBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiHackamoreBloodLifeBlood
  return kJiejiHackamoreBloodLife
}

function _jiejiHackamoreCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiHackamoreNormalizeKind(kind) {
  if (kind == 'tiehackamore' || kind == 'jieji_hackamore_tiehackamore') return 'tiehackamore'
  if (kind == 'loosehackamore' || kind == 'jieji_hackamore_loosehackamore') return 'loosehackamore'
  if (kind == 'bloodhackamore' || kind == 'jieji_hackamore_bloodhackamore') return 'bloodhackamore'
  return null
}

function _jiejiHackamoreChoices() {
  return [
    {
      text: 'jieji_hackamore_tiehackamore',
      description: 'hint_jieji_hackamore_tiehackamore',
    },
    {
      text: 'jieji_hackamore_loosehackamore',
      description: 'hint_jieji_hackamore_loosehackamore',
    },
    {
      text: 'jieji_hackamore_bloodhackamore',
      description: 'hint_jieji_hackamore_bloodhackamore',
    },
  ]
}

/// 赶路劫套革三选。debug.forceJiejiEvent('hackamore') / forceHackamore 直接走这里，仍弹出三选。
async function playJiejiHackamoreEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_hackamore')
  dialog.pushSelection('jiejiHackamore', _jiejiHackamoreChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiHackamore')
  var selected = _jiejiHackamoreNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiehackamore'
  }

  final seasonId = _jiejiHackamoreSeasonId()
  if (selected == 'tiehackamore') {
    final herbNeed = _jiejiHackamoreTiehackamoreHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_hackamore_tiehackamore_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiHackamoreTiehackamoreLife)
      dialog.pushDialog('hint_jieji_hackamore_tiehackamore_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiHackamoreTiehackamoreGongfaRate)
    }
  } else if (selected == 'loosehackamore') {
    final moneyNeed = _jiejiHackamoreLoosehackamoreMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_hackamore_loosehackamore_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiHackamoreLoosehackamoreHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiHackamoreLoosehackamoreLife)
      dialog.pushDialog('hint_jieji_hackamore_loosehackamore_ok', interpolations: [kJiejiHackamoreLoosehackamoreHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiHackamoreCostLife(_jiejiHackamoreBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_hackamore_bloodhackamore_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiHackamoreBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiHackamoreBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_hackamore_bloodhackamore_none', interpolations: [kJiejiHackamoreBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0001%。出过则返回 true。
async function tryJiejiHackamoreOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiHackamoreTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastHackamoreMove ?? -999
  if (moves - last < kJiejiHackamoreMoveCooldown) return false

  var rate = kJiejiHackamoreBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastHackamoreMove = moves
  await playJiejiHackamoreEvent(terrain)
  return true
}
