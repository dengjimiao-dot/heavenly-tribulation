/// 赶路「劫颈革」三选：系颈 / 解颈 / 血颈。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革都没中时才滚。
const kJiejiNeckstrapBaseRate = 0.00000006
const kJiejiNeckstrapMoveCooldown = 24
const kJiejiNeckstrapTieneckstrapHerb = 1
const kJiejiNeckstrapTieneckstrapLife = 1
const kJiejiNeckstrapTieneckstrapGongfaRate = 0.005
const kJiejiNeckstrapLooseneckstrapMoney = 1
const kJiejiNeckstrapLooseneckstrapMoneyThunder = 1
const kJiejiNeckstrapLooseneckstrapHerb = 1
const kJiejiNeckstrapLooseneckstrapLife = 1
const kJiejiNeckstrapBloodLife = 1
const kJiejiNeckstrapBloodLifeBlood = 2
const kJiejiNeckstrapBloodGongfaRate = 0.03
const kJiejiNeckstrapBloodMoney = 2

function _jiejiNeckstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiNeckstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiNeckstrapTieneckstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiNeckstrapTieneckstrapHerb
}

function _jiejiNeckstrapLooseneckstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiNeckstrapLooseneckstrapMoneyThunder
  return kJiejiNeckstrapLooseneckstrapMoney
}

function _jiejiNeckstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiNeckstrapBloodLifeBlood
  return kJiejiNeckstrapBloodLife
}

function _jiejiNeckstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiNeckstrapNormalizeKind(kind) {
  if (kind == 'tieneckstrap' || kind == 'jieji_neckstrap_tieneckstrap') return 'tieneckstrap'
  if (kind == 'looseneckstrap' || kind == 'jieji_neckstrap_looseneckstrap') return 'looseneckstrap'
  if (kind == 'bloodneckstrap' || kind == 'jieji_neckstrap_bloodneckstrap') return 'bloodneckstrap'
  return null
}

function _jiejiNeckstrapChoices() {
  return [
    {
      text: 'jieji_neckstrap_tieneckstrap',
      description: 'hint_jieji_neckstrap_tieneckstrap',
    },
    {
      text: 'jieji_neckstrap_looseneckstrap',
      description: 'hint_jieji_neckstrap_looseneckstrap',
    },
    {
      text: 'jieji_neckstrap_bloodneckstrap',
      description: 'hint_jieji_neckstrap_bloodneckstrap',
    },
  ]
}

/// 赶路劫颈革三选。debug.forceJiejiEvent('neckstrap') / forceNeckstrap 直接走这里，仍弹出三选。
async function playJiejiNeckstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_neckstrap')
  dialog.pushSelection('jiejiNeckstrap', _jiejiNeckstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiNeckstrap')
  var selected = _jiejiNeckstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieneckstrap'
  }

  final seasonId = _jiejiNeckstrapSeasonId()
  if (selected == 'tieneckstrap') {
    final herbNeed = _jiejiNeckstrapTieneckstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_neckstrap_tieneckstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiNeckstrapTieneckstrapLife)
      dialog.pushDialog('hint_jieji_neckstrap_tieneckstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiNeckstrapTieneckstrapGongfaRate)
    }
  } else if (selected == 'looseneckstrap') {
    final moneyNeed = _jiejiNeckstrapLooseneckstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_neckstrap_looseneckstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiNeckstrapLooseneckstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiNeckstrapLooseneckstrapLife)
      dialog.pushDialog('hint_jieji_neckstrap_looseneckstrap_ok', interpolations: [kJiejiNeckstrapLooseneckstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiNeckstrapCostLife(_jiejiNeckstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_neckstrap_bloodneckstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiNeckstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiNeckstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_neckstrap_bloodneckstrap_none', interpolations: [kJiejiNeckstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000006%。出过则返回 true。
async function tryJiejiNeckstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiNeckstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastNeckstrapMove ?? -999
  if (moves - last < kJiejiNeckstrapMoveCooldown) return false

  var rate = kJiejiNeckstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastNeckstrapMove = moves
  await playJiejiNeckstrapEvent(terrain)
  return true
}
