/// 赶路「劫趾革」三选：系趾 / 解趾 / 血趾。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革都没中时才滚。
const kJiejiToestrapBaseRate = 0.0000000008
const kJiejiToestrapMoveCooldown = 24
const kJiejiToestrapTietoestrapHerb = 1
const kJiejiToestrapTietoestrapLife = 1
const kJiejiToestrapTietoestrapGongfaRate = 0.005
const kJiejiToestrapLoosetoestrapMoney = 1
const kJiejiToestrapLoosetoestrapMoneyThunder = 1
const kJiejiToestrapLoosetoestrapHerb = 1
const kJiejiToestrapLoosetoestrapLife = 1
const kJiejiToestrapBloodLife = 1
const kJiejiToestrapBloodLifeBlood = 2
const kJiejiToestrapBloodGongfaRate = 0.03
const kJiejiToestrapBloodMoney = 2

function _jiejiToestrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiToestrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiToestrapTietoestrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiToestrapTietoestrapHerb
}

function _jiejiToestrapLoosetoestrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiToestrapLoosetoestrapMoneyThunder
  return kJiejiToestrapLoosetoestrapMoney
}

function _jiejiToestrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiToestrapBloodLifeBlood
  return kJiejiToestrapBloodLife
}

function _jiejiToestrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiToestrapNormalizeKind(kind) {
  if (kind == 'tietoestrap' || kind == 'jieji_toestrap_tietoestrap') return 'tietoestrap'
  if (kind == 'loosetoestrap' || kind == 'jieji_toestrap_loosetoestrap') return 'loosetoestrap'
  if (kind == 'bloodtoestrap' || kind == 'jieji_toestrap_bloodtoestrap') return 'bloodtoestrap'
  return null
}

function _jiejiToestrapChoices() {
  return [
    {
      text: 'jieji_toestrap_tietoestrap',
      description: 'hint_jieji_toestrap_tietoestrap',
    },
    {
      text: 'jieji_toestrap_loosetoestrap',
      description: 'hint_jieji_toestrap_loosetoestrap',
    },
    {
      text: 'jieji_toestrap_bloodtoestrap',
      description: 'hint_jieji_toestrap_bloodtoestrap',
    },
  ]
}

/// 赶路劫趾革三选。debug.forceJiejiEvent('toestrap') / forceToestrap 直接走这里，仍弹出三选。
async function playJiejiToestrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_toestrap')
  dialog.pushSelection('jiejiToestrap', _jiejiToestrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiToestrap')
  var selected = _jiejiToestrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tietoestrap'
  }

  final seasonId = _jiejiToestrapSeasonId()
  if (selected == 'tietoestrap') {
    final herbNeed = _jiejiToestrapTietoestrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_toestrap_tietoestrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiToestrapTietoestrapLife)
      dialog.pushDialog('hint_jieji_toestrap_tietoestrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiToestrapTietoestrapGongfaRate)
    }
  } else if (selected == 'loosetoestrap') {
    final moneyNeed = _jiejiToestrapLoosetoestrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_toestrap_loosetoestrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiToestrapLoosetoestrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiToestrapLoosetoestrapLife)
      dialog.pushDialog('hint_jieji_toestrap_loosetoestrap_ok', interpolations: [kJiejiToestrapLoosetoestrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiToestrapCostLife(_jiejiToestrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_toestrap_bloodtoestrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiToestrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiToestrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_toestrap_bloodtoestrap_none', interpolations: [kJiejiToestrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00000008%。出过则返回 true。
async function tryJiejiToestrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiToestrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastToestrapMove ?? -999
  if (moves - last < kJiejiToestrapMoveCooldown) return false

  var rate = kJiejiToestrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastToestrapMove = moves
  await playJiejiToestrapEvent(terrain)
  return true
}
