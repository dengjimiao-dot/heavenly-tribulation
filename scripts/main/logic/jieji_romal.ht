/// 赶路「劫罗革」三选：系罗 / 解罗 / 血罗。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革都没中时才滚。
const kJiejiRomalBaseRate = 0.0000004
const kJiejiRomalMoveCooldown = 24
const kJiejiRomalTieromalHerb = 1
const kJiejiRomalTieromalLife = 1
const kJiejiRomalTieromalGongfaRate = 0.005
const kJiejiRomalLooseromalMoney = 1
const kJiejiRomalLooseromalMoneyThunder = 1
const kJiejiRomalLooseromalHerb = 1
const kJiejiRomalLooseromalLife = 1
const kJiejiRomalBloodLife = 1
const kJiejiRomalBloodLifeBlood = 2
const kJiejiRomalBloodGongfaRate = 0.03
const kJiejiRomalBloodMoney = 2

function _jiejiRomalSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiRomalTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiRomalTieromalHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiRomalTieromalHerb
}

function _jiejiRomalLooseromalMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiRomalLooseromalMoneyThunder
  return kJiejiRomalLooseromalMoney
}

function _jiejiRomalBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiRomalBloodLifeBlood
  return kJiejiRomalBloodLife
}

function _jiejiRomalCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiRomalNormalizeKind(kind) {
  if (kind == 'tieromal' || kind == 'jieji_romal_tieromal') return 'tieromal'
  if (kind == 'looseromal' || kind == 'jieji_romal_looseromal') return 'looseromal'
  if (kind == 'bloodromal' || kind == 'jieji_romal_bloodromal') return 'bloodromal'
  return null
}

function _jiejiRomalChoices() {
  return [
    {
      text: 'jieji_romal_tieromal',
      description: 'hint_jieji_romal_tieromal',
    },
    {
      text: 'jieji_romal_looseromal',
      description: 'hint_jieji_romal_looseromal',
    },
    {
      text: 'jieji_romal_bloodromal',
      description: 'hint_jieji_romal_bloodromal',
    },
  ]
}

/// 赶路劫罗革三选。debug.forceJiejiEvent('romal') / forceRomal 直接走这里，仍弹出三选。
async function playJiejiRomalEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_romal')
  dialog.pushSelection('jiejiRomal', _jiejiRomalChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiRomal')
  var selected = _jiejiRomalNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieromal'
  }

  final seasonId = _jiejiRomalSeasonId()
  if (selected == 'tieromal') {
    final herbNeed = _jiejiRomalTieromalHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_romal_tieromal_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiRomalTieromalLife)
      dialog.pushDialog('hint_jieji_romal_tieromal_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiRomalTieromalGongfaRate)
    }
  } else if (selected == 'looseromal') {
    final moneyNeed = _jiejiRomalLooseromalMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_romal_looseromal_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiRomalLooseromalHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiRomalLooseromalLife)
      dialog.pushDialog('hint_jieji_romal_looseromal_ok', interpolations: [kJiejiRomalLooseromalHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiRomalCostLife(_jiejiRomalBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_romal_bloodromal_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiRomalBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiRomalBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_romal_bloodromal_none', interpolations: [kJiejiRomalBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00004%。出过则返回 true。
async function tryJiejiRomalOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiRomalTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastRomalMove ?? -999
  if (moves - last < kJiejiRomalMoveCooldown) return false

  var rate = kJiejiRomalBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastRomalMove = moves
  await playJiejiRomalEvent(terrain)
  return true
}
