/// 赶路「劫扣」三选：扣合 / 折扣 / 血染。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针都没中时才滚。
const kJiejiClaspBaseRate = 0.0035
const kJiejiClaspMoveCooldown = 24
const kJiejiClaspFastenclaspHerb = 1
const kJiejiClaspFastenclaspLife = 5
const kJiejiClaspFastenclaspGongfaRate = 0.08
const kJiejiClaspFoldclaspMoney = 8
const kJiejiClaspFoldclaspMoneyThunder = 4
const kJiejiClaspFoldclaspHerb = 2
const kJiejiClaspFoldclaspLife = 3
const kJiejiClaspBloodLife = 2
const kJiejiClaspBloodLifeBlood = 3
const kJiejiClaspBloodGongfaRate = 0.26
const kJiejiClaspBloodMoney = 16

function _jiejiClaspSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiClaspTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiClaspFastenclaspHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiClaspFastenclaspHerb
}

function _jiejiClaspFoldclaspMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiClaspFoldclaspMoneyThunder
  return kJiejiClaspFoldclaspMoney
}

function _jiejiClaspBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiClaspBloodLifeBlood
  return kJiejiClaspBloodLife
}

function _jiejiClaspCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiClaspNormalizeKind(kind) {
  if (kind == 'fastenclasp' || kind == 'jieji_clasp_fastenclasp') return 'fastenclasp'
  if (kind == 'foldclasp' || kind == 'jieji_clasp_foldclasp') return 'foldclasp'
  if (kind == 'bloodclasp' || kind == 'jieji_clasp_bloodclasp') return 'bloodclasp'
  return null
}

function _jiejiClaspChoices() {
  return [
    {
      text: 'jieji_clasp_fastenclasp',
      description: 'hint_jieji_clasp_fastenclasp',
    },
    {
      text: 'jieji_clasp_foldclasp',
      description: 'hint_jieji_clasp_foldclasp',
    },
    {
      text: 'jieji_clasp_bloodclasp',
      description: 'hint_jieji_clasp_bloodclasp',
    },
  ]
}

/// 赶路劫扣三选。debug.forceJiejiEvent('clasp') / forceClasp 直接走这里，仍弹出三选。
async function playJiejiClaspEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_clasp')
  dialog.pushSelection('jiejiClasp', _jiejiClaspChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiClasp')
  var selected = _jiejiClaspNormalizeKind(picked)
  if (selected == null) {
    selected = 'fastenclasp'
  }

  final seasonId = _jiejiClaspSeasonId()
  if (selected == 'fastenclasp') {
    final herbNeed = _jiejiClaspFastenclaspHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_clasp_fastenclasp_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiClaspFastenclaspLife)
      dialog.pushDialog('hint_jieji_clasp_fastenclasp_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiClaspFastenclaspGongfaRate)
    }
  } else if (selected == 'foldclasp') {
    final moneyNeed = _jiejiClaspFoldclaspMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_clasp_foldclasp_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiClaspFoldclaspHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiClaspFoldclaspLife)
      dialog.pushDialog('hint_jieji_clasp_foldclasp_ok', interpolations: [kJiejiClaspFoldclaspHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiClaspCostLife(_jiejiClaspBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_clasp_bloodclasp_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiClaspBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiClaspBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_clasp_bloodclasp_none', interpolations: [kJiejiClaspBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.35%。出过则返回 true。
async function tryJiejiClaspOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiClaspTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastClaspMove ?? -999
  if (moves - last < kJiejiClaspMoveCooldown) return false

  var rate = kJiejiClaspBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastClaspMove = moves
  await playJiejiClaspEvent(terrain)
  return true
}
