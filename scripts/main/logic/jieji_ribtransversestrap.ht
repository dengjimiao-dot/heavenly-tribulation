/// 赶路「劫肋横突革」三选：系横 / 解横 / 血横。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革、劫肋头革、劫肋颈革、劫肋结节革、劫肋角革、劫肋沟革、劫肋脊革、劫肋体革、劫肋椎革、劫肋横突革都没中时才滚。
const kJiejiRibtransversestrapBaseRate = 0.0000000000000001
const kJiejiRibtransversestrapMoveCooldown = 24
const kJiejiRibtransversestrapTieribtransversestrapHerb = 1
const kJiejiRibtransversestrapTieribtransversestrapLife = 1
const kJiejiRibtransversestrapTieribtransversestrapGongfaRate = 0.005
const kJiejiRibtransversestrapLooseribtransversestrapMoney = 1
const kJiejiRibtransversestrapLooseribtransversestrapMoneyThunder = 1
const kJiejiRibtransversestrapLooseribtransversestrapHerb = 1
const kJiejiRibtransversestrapLooseribtransversestrapLife = 1
const kJiejiRibtransversestrapBloodLife = 1
const kJiejiRibtransversestrapBloodLifeBlood = 2
const kJiejiRibtransversestrapBloodGongfaRate = 0.03
const kJiejiRibtransversestrapBloodMoney = 2

function _jiejiRibtransversestrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiRibtransversestrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiRibtransversestrapTieribtransversestrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiRibtransversestrapTieribtransversestrapHerb
}

function _jiejiRibtransversestrapLooseribtransversestrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiRibtransversestrapLooseribtransversestrapMoneyThunder
  return kJiejiRibtransversestrapLooseribtransversestrapMoney
}

function _jiejiRibtransversestrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiRibtransversestrapBloodLifeBlood
  return kJiejiRibtransversestrapBloodLife
}

function _jiejiRibtransversestrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiRibtransversestrapNormalizeKind(kind) {
  if (kind == 'tieribtransversestrap' || kind == 'jieji_ribtransversestrap_tieribtransversestrap') return 'tieribtransversestrap'
  if (kind == 'looseribtransversestrap' || kind == 'jieji_ribtransversestrap_looseribtransversestrap') return 'looseribtransversestrap'
  if (kind == 'bloodribtransversestrap' || kind == 'jieji_ribtransversestrap_bloodribtransversestrap') return 'bloodribtransversestrap'
  return null
}

function _jiejiRibtransversestrapChoices() {
  return [
    {
      text: 'jieji_ribtransversestrap_tieribtransversestrap',
      description: 'hint_jieji_ribtransversestrap_tieribtransversestrap',
    },
    {
      text: 'jieji_ribtransversestrap_looseribtransversestrap',
      description: 'hint_jieji_ribtransversestrap_looseribtransversestrap',
    },
    {
      text: 'jieji_ribtransversestrap_bloodribtransversestrap',
      description: 'hint_jieji_ribtransversestrap_bloodribtransversestrap',
    },
  ]
}

/// 赶路劫肋横突革三选。debug.forceJiejiEvent('ribtransversestrap') / forceRibtransversestrap 直接走这里，仍弹出三选。
async function playJiejiRibtransversestrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_ribtransversestrap')
  dialog.pushSelection('jiejiRibtransversestrap', _jiejiRibtransversestrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiRibtransversestrap')
  var selected = _jiejiRibtransversestrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieribtransversestrap'
  }

  final seasonId = _jiejiRibtransversestrapSeasonId()
  if (selected == 'tieribtransversestrap') {
    final herbNeed = _jiejiRibtransversestrapTieribtransversestrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_ribtransversestrap_tieribtransversestrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiRibtransversestrapTieribtransversestrapLife)
      dialog.pushDialog('hint_jieji_ribtransversestrap_tieribtransversestrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiRibtransversestrapTieribtransversestrapGongfaRate)
    }
  } else if (selected == 'looseribtransversestrap') {
    final moneyNeed = _jiejiRibtransversestrapLooseribtransversestrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_ribtransversestrap_looseribtransversestrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiRibtransversestrapLooseribtransversestrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiRibtransversestrapLooseribtransversestrapLife)
      dialog.pushDialog('hint_jieji_ribtransversestrap_looseribtransversestrap_ok', interpolations: [kJiejiRibtransversestrapLooseribtransversestrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiRibtransversestrapCostLife(_jiejiRibtransversestrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_ribtransversestrap_bloodribtransversestrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiRibtransversestrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiRibtransversestrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_ribtransversestrap_bloodribtransversestrap_none', interpolations: [kJiejiRibtransversestrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00000000000001%。出过则返回 true。
async function tryJiejiRibtransversestrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiRibtransversestrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastRibtransversestrapMove ?? -999
  if (moves - last < kJiejiRibtransversestrapMoveCooldown) return false

  var rate = kJiejiRibtransversestrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastRibtransversestrapMove = moves
  await playJiejiRibtransversestrapEvent(terrain)
  return true
}
