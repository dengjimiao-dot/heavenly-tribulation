const kJiejiCurseSlotMax = 3
const kJiejiCurseDamageTakenPer = 0.05
const kJiejiBossWardCost = 80
const kJiejiBossWardHeal = 8
const kJiejiBossDefaultWinMoney = 400
const kJiejiBossThunderWinMoney = 550
const kJiejiBossClashWinMoney = 700
const kJiejiBossHuntWinMoneyBonus = 200
const kJiejiBossBloodWinHeal = 8
const kJiejiBossRiteLifeLoss = 4
const kJiejiBossRiteGongfaRate = 0.40
const kJiejiBossBorrowKarmaRate = 0.20
const kJiejiBossMistLoseKarmaRate = 0.50
const kJiejiBossWatchLevelDelta = 2

const _kJiejiKeepSiteKinds = {
  'home': true,
  'cardforge': true,
  'alchemylab': true,
  'cityhall': true,
  'headquarters': true,
  'residence': true,
}

function ensureJiejiFlags() {
  game.flags.jieji ??= {}
  game.flags.jieji.curseSlots ??= []
  game.flags.jieji.shards ??= []
  game.flags.jieji.gongfa ??= []
  return game.flags.jieji
}

function jiejiCurseCount() {
  final jieji = ensureJiejiFlags()
  jieji.curseSlots ??= []
  return jieji.curseSlots.length
}

function addJiejiCurse(source) {
  final jieji = ensureJiejiFlags()
  jieji.curseSlots ??= []
  if (jieji.curseSlots.length >= kJiejiCurseSlotMax) return false
  jieji.curseSlots.add({
    id: 'curse_${jieji.curseSlots.length}',
    source: source ?? 'unknown',
  })
  return true
}

function clearOneJiejiCurse() {
  final jieji = ensureJiejiFlags()
  jieji.curseSlots ??= []
  if (jieji.curseSlots.isEmpty) return false
  jieji.curseSlots.remove(jieji.curseSlots.last)
  return true
}

function getHeroHomeCity() {
  if (hero == null) return null
  var city = game.locations[hero.homeLocationId]
  if (city != null && city.category == 'site') {
    city = game.locations[city.atCityId]
  }
  if (city == null && hero.homeSiteId != null) {
    final home = game.locations[hero.homeSiteId]
    if (home != null) city = game.locations[home.atCityId]
  }
  if (city != null && city.category != 'city') {
    return null
  }
  return city
}

function listUndigestedKarmaCards() {
  let cards = []
  if (hero == null) return cards
  if (hero.cardLibrary == null) return cards
  for (final card in hero.cardLibrary.values) {
    if (card.isKarma == true) {
      cards.add(card)
    }
  }
  return cards
}

/// 未消化业力牌移出牌库/卡组，并转为诅咒槽（上限 3）。
function convertKarmaToCurses() {
  final jieji = ensureJiejiFlags()
  jieji.curseSlots ??= []
  final cards = listUndigestedKarmaCards()
  var converted = 0
  for (final card in cards) {
    if (jieji.curseSlots.length < kJiejiCurseSlotMax) {
      jieji.curseSlots.add({
        id: 'karma_curse_${jieji.curseSlots.length}',
        source: card.affixId ?? card.id,
      })
      converted += 1
    }
    if (hero.cardLibrary.containsKey(card.id)) {
      hero.cardLibrary.remove(card.id)
    }
    if (hero.battleDecks != null) {
      for (final deck in hero.battleDecks) {
        if (deck.cards != null) {
          deck.cards.remove(card.id)
        }
      }
    }
  }
  engine.info('季末业力转咒：牌 ${cards.length}，入槽 ${converted}，当前诅咒 ${jieji.curseSlots.length}')
  return converted
}

/// 迁徙：弃多余据点，保留铸牌斋与人。
function migrateSect() {
  final city = getHeroHomeCity()
  if (city == null) return 0
  var keepExtra = 0
  var skipDevPenalty = false
  if (ensureJiejiFlags().xianming == 'xianming_guard') {
    keepExtra = 1
    skipDevPenalty = true
  }
  var removed = 0
  final siteIds = []
  final rawSiteIds = city.siteIds ?? []
  for (final id in rawSiteIds) {
    siteIds.add(id)
  }
  final fallbackId = hero.homeSiteId ?? city.id
  for (final siteId in siteIds) {
    final site = game.locations[siteId]
    if (site == null) continue
    if (_kJiejiKeepSiteKinds[site.kind] == true) continue
    if (site.kind == kLocationKindHome) continue
    if (keepExtra > 0) {
      keepExtra = keepExtra - 1
      continue
    }
    for (final character in game.characters.values) {
      if (character.locationId == site.id) {
        character.locationId = fallbackId
      }
      if (character.managingLocationIds != null && character.managingLocationIds.contains(site.id)) {
        character.managingLocationIds.remove(site.id)
      }
    }
    removeLocation(site)
    removed += 1
  }
  if (!skipDevPenalty) {
    var dev = city.development ?? 0
    if (dev > 2) {
      city.development = dev - 2
    } else {
      city.development = 0
    }
  }
  city.maxSiteCount = calculateMaxSiteCountForCity(city)
  ensureHomeCardforge()
  ensureHomeAlchemylab()
  engine.info('季末迁徙：拆除据点 ${removed}，城市规模 ${city.development}')
  return removed
}

async function pickXianming() {
  dialog.pushDialog('hint_jieji_xianming')
  dialog.pushSelection('jiejiXianming', [
    'xianming_guard',
    'xianming_break',
    'xianming_nurture',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiXianming')
  if (selected != null) {
    final jieji = ensureJiejiFlags()
    jieji.xianming = selected
    var nextSeasonId = null
    if (game.jieji != null) {
      nextSeasonId = game.jieji.seasonId
    }
    jieji.xianmingSeason = nextSeasonId
    if (selected == 'xianming_nurture') {
      await Player.collect('worker', 8)
      await Player.collect('money', 300)
      final blank = BattleCard(genre: null, rank: 0)
      blank.isCardBlank = true
      Player.acquireCard(blank)
    }
    dialog.pushDialog('hint_jieji_xianming_picked', interpolations: [engine.locale(selected)])
    await dialog.execute()
  }
}

function _jiejiBossClampLifeLoss(want) {
  if (hero == null) return 0
  var lost = want
  if (lost < 0) lost = 0
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  return lost
}

function _jiejiBossBumpRank(rank, extra) {
  var r = rank ?? 0
  var n = extra ?? 0
  if (n <= 0) return r
  for (var i in range(n)) {
    if (r < kCultivationRankMax) {
      r = r + 1
    }
  }
  return r
}

async function _settleJiejiByMigrate(endedId) {
  final jieji = ensureJiejiFlags()
  jieji.fighting = false
  final removed = migrateSect()
  dialog.pushDialog('hint_jieji_migrate_done', interpolations: ['${removed}'])
  await dialog.execute()
  await finishJiejiSeason(endedId)
}

async function _playJiejiBossPrep(endedId) {
  final prepKey = 'hint_jieji_boss_prep_' + endedId
  dialog.pushDialog(prepKey)
  var choices = [
    'jieji_boss_prep_ward',
    'jieji_boss_prep_clash',
    'jieji_boss_prep_flee',
  ]
  if (endedId == 'mist') {
    choices = [
      'jieji_boss_prep_watch',
      'jieji_boss_prep_borrow',
      'jieji_boss_prep_flee',
    ]
  } else if (endedId == 'blood') {
    choices = [
      'jieji_boss_prep_rite',
      'jieji_boss_prep_hunt',
      'jieji_boss_prep_flee',
    ]
  }
  dialog.pushSelection('jiejiBossPrep', choices)
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiBossPrep')
  if (selected == 'jieji_boss_prep_flee') return 'flee'
  if (selected == 'jieji_boss_prep_ward') return 'ward'
  if (selected == 'jieji_boss_prep_clash') return 'clash'
  if (selected == 'jieji_boss_prep_watch') return 'watch'
  if (selected == 'jieji_boss_prep_borrow') return 'borrow'
  if (selected == 'jieji_boss_prep_rite') return 'rite'
  if (selected == 'jieji_boss_prep_hunt') return 'hunt'
  return 'none'
}

async function finishJiejiSeason(endedId) {
  final jieji = ensureJiejiFlags()
  jieji.lastSettledSeasonId = endedId
  jieji.pendingEndedSeasonId = null
  jieji.fighting = false
  jieji.bossPrep = null
  jieji.bossWinMoney = null
  await tryOfferGongfaEngrave()
  await pickXianming()
  // 仅在劫季 id 已切换（Dart 写入 pendingOmenSeasonId）时弹入季天象征兆。
  final omenId = jieji.pendingOmenSeasonId
  if (omenId != null && omenId != '') {
    await onJiejiSeasonStart(omenId)
  }
  Game.updateUI()
}

/// 入季天象征兆。每个 seasonId 只发一次小礼物并弹一句说明。
async function onJiejiSeasonStart(seasonId) {
  if (hero == null) return
  if (seasonId == null || seasonId == '') return
  final jieji = ensureJiejiFlags()
  jieji.pendingOmenSeasonId = null
  if (jieji.lastOmenSeasonId == seasonId) return
  jieji.lastOmenSeasonId = seasonId

  if (seasonId == 'thunder') {
    await Player.collect('money', 150, incurIncident: false)
    dialog.pushDialog('hint_jieji_omen_thunder')
  } else if (seasonId == 'mist') {
    await Player.collect('herb', 4, incurIncident: false)
    dialog.pushDialog('hint_jieji_omen_mist')
  } else if (seasonId == 'blood') {
    var healed = 0
    if (hero.life < hero.stats.lifeMax) {
      healed = Player.restoreLife(8)
    }
    if (healed <= 0) {
      await Player.collect('money', 80, incurIncident: false)
    }
    dialog.pushDialog('hint_jieji_omen_blood')
  } else {
    return
  }
  if (jieji.xianming == 'xianming_nurture') {
    await Player.collect('worker', 2, incurIncident: false)
    dialog.pushDialog('hint_jieji_omen_nurture_hands')
  }
  await dialog.execute()
  Game.updateUI()
}

async function startTribulationBoss() {
  if (hero == null) return 'done'
  final jieji = ensureJiejiFlags()
  jieji.fighting = true
  jieji.bossPrep = null
  jieji.bossWinMoney = null
  final endedId = jieji.pendingEndedSeasonId ?? 'thunder'

  final bossName = engine.locale('jieji_boss_' + endedId)
  dialog.pushDialog('hint_jieji_boss_intro', interpolations: [bossName])
  dialog.pushDialog('hint_jieji_boss_intro_' + endedId)
  await dialog.execute()

  var prep = await _playJiejiBossPrep(endedId)
  if (prep == 'flee') {
    await _settleJiejiByMigrate(endedId)
    return 'done'
  }

  if (prep == 'ward') {
    final money = hero.materials['money'] ?? 0
    if (money >= kJiejiBossWardCost) {
      Player.exhaust('money', kJiejiBossWardCost)
      Player.restoreLife(kJiejiBossWardHeal)
      dialog.pushDialog('hint_jieji_boss_prep_ward')
      await dialog.execute()
    } else {
      prep = 'none'
      dialog.pushDialog('hint_jieji_boss_prep_ward_broke')
      await dialog.execute()
    }
  } else if (prep == 'clash') {
    dialog.pushDialog('hint_jieji_boss_prep_clash')
    await dialog.execute()
  } else if (prep == 'watch') {
    dialog.pushDialog('hint_jieji_boss_prep_watch')
    await dialog.execute()
  } else if (prep == 'borrow') {
    if (random.nextDouble() < kJiejiBossBorrowKarmaRate) {
      await grantKarmaCard('mist')
    } else {
      dialog.pushDialog('hint_jieji_boss_prep_borrow')
      await dialog.execute()
    }
  } else if (prep == 'rite') {
    final lost = _jiejiBossClampLifeLoss(kJiejiBossRiteLifeLoss)
    if (lost > 0) {
      Player.setLife(hero.life - lost)
    }
    dialog.pushDialog('hint_jieji_boss_prep_rite', interpolations: ['${lost}'])
    await dialog.execute()
  } else if (prep == 'hunt') {
    dialog.pushDialog('hint_jieji_boss_prep_hunt')
    await dialog.execute()
  }

  jieji.bossPrep = prep

  var rank = hero.rank ?? 0
  rank = _jiejiBossBumpRank(rank, 1)
  if (endedId == 'thunder') {
    rank = _jiejiBossBumpRank(rank, 1)
  }
  if (prep == 'clash') {
    rank = _jiejiBossBumpRank(rank, 1)
  }
  final minLevel = minLevelForRank(rank)
  final maxLevel = maxLevelForRank(rank)
  var bonus = 10
  if (jieji.xianming == 'xianming_break') {
    bonus = 0
  }
  var level = (hero.level ?? 1) + bonus
  var strict = 1.0
  if (jieji.endedTribulationStrictness != null) {
    strict = jieji.endedTribulationStrictness
  } else if (game.jieji != null && game.jieji.tribulationStrictness != null) {
    strict = game.jieji.tribulationStrictness
  }
  level = (level * strict).round()
  if (prep == 'watch') {
    level = level - kJiejiBossWatchLevelDelta
  }
  level = level.clamp(minLevel, maxLevel)

  var winMoney = kJiejiBossDefaultWinMoney
  if (endedId == 'thunder') {
    winMoney = kJiejiBossThunderWinMoney
  }
  if (prep == 'clash') {
    winMoney = kJiejiBossClashWinMoney
  }
  if (prep == 'hunt') {
    winMoney = winMoney + kJiejiBossHuntWinMoneyBonus
  }
  jieji.bossWinMoney = winMoney

  final enemy = BattleEntity(name: bossName, rank: rank, level: level)
  if (endedId == 'blood' || prep == 'hunt') {
    enemy.isElite = true
  }

  Game.updateUI()
  Game.showPrebattle(enemy,
    background: 'battle/scene/mountain_night.png',
    loseOnEscape: true,
    onBattleEnd: async function [onJiejiBossEnd] (result, roundCount) {
      jieji.fighting = false
      if (result) {
        clearOneJiejiCurse()
        final moneyPack = MaterialPack(kind: 'money', amount: winMoney)
        await Player.acquire(moneyPack)
        await Game.promptItems([moneyPack])
        if (endedId == 'blood') {
          Player.restoreLife(kJiejiBossBloodWinHeal)
        }
        if (prep == 'rite') {
          await tryDropGongfaShard(rate: kJiejiBossRiteGongfaRate)
        }
        dialog.pushDialog('hint_jieji_boss_win', interpolations: ['${jiejiCurseCount()}'])
        await dialog.execute()
      } else {
        Player.setLife(1)
        addJiejiCurse('tribulation_fail')
        if (endedId == 'blood') {
          addJiejiCurse('tribulation_fail')
        }
        if (endedId == 'mist') {
          if (random.nextDouble() < kJiejiBossMistLoseKarmaRate) {
            await grantKarmaCard('tribulation')
          }
        }
        dialog.pushDialog('hint_jieji_boss_lose', interpolations: ['${jiejiCurseCount()}'])
        await dialog.execute()
      }
      await finishJiejiSeason(endedId)
    }
  )
  return 'deferred'
}

/// 季末强制结算。由 Dart 在劫季切换后调用一次。
async function trySettleJieji({ endedSeasonId }) {
  if (hero == null) return 'done'
  final jieji = ensureJiejiFlags()
  if (jieji.fighting == true) return 'deferred'
  final endedId = jieji.pendingEndedSeasonId ?? endedSeasonId
  if (endedId == null) return 'done'
  jieji.pendingEndedSeasonId = endedId
  if (jieji.lastSettledSeasonId == endedId) {
    jieji.pendingEndedSeasonId = null
    return 'done'
  }

  stripJiejiPotionCards()
  final converted = convertKarmaToCurses()
  final seasonName = engine.locale('jieji_season_' + endedId)
  dialog.pushDialog('hint_jieji_season_end', interpolations: [
    seasonName,
    '${converted}',
    '${jiejiCurseCount()}',
  ])
  dialog.pushSelection('jiejiSettle', [
    'jiejiTribulation',
    'jiejiMigrate',
  ])
  await dialog.execute()
  final selected = dialog.checkSelected('jiejiSettle')
  if (selected == 'jiejiMigrate') {
    await _settleJiejiByMigrate(endedId)
    return 'done'
  } else {
    return await startTribulationBoss()
  }
}
