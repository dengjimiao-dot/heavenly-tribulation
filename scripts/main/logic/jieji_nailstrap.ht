/// 赶路「劫甲革」三选：系甲 / 解甲 / 血甲。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革都没中时才滚。
const kJiejiNailstrapBaseRate = 0.000000005
const kJiejiNailstrapMoveCooldown = 24
const kJiejiNailstrapTienailstrapHerb = 1
const kJiejiNailstrapTienailstrapLife = 1
const kJiejiNailstrapTienailstrapGongfaRate = 0.005
const kJiejiNailstrapLoosenailstrapMoney = 1
const kJiejiNailstrapLoosenailstrapMoneyThunder = 1
const kJiejiNailstrapLoosenailstrapHerb = 1
const kJiejiNailstrapLoosenailstrapLife = 1
const kJiejiNailstrapBloodLife = 1
const kJiejiNailstrapBloodLifeBlood = 2
const kJiejiNailstrapBloodGongfaRate = 0.03
const kJiejiNailstrapBloodMoney = 2

function _jiejiNailstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiNailstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiNailstrapTienailstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiNailstrapTienailstrapHerb
}

function _jiejiNailstrapLoosenailstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiNailstrapLoosenailstrapMoneyThunder
  return kJiejiNailstrapLoosenailstrapMoney
}

function _jiejiNailstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiNailstrapBloodLifeBlood
  return kJiejiNailstrapBloodLife
}

function _jiejiNailstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiNailstrapNormalizeKind(kind) {
  if (kind == 'tienailstrap' || kind == 'jieji_nailstrap_tienailstrap') return 'tienailstrap'
  if (kind == 'loosenailstrap' || kind == 'jieji_nailstrap_loosenailstrap') return 'loosenailstrap'
  if (kind == 'bloodnailstrap' || kind == 'jieji_nailstrap_bloodnailstrap') return 'bloodnailstrap'
  return null
}

function _jiejiNailstrapChoices() {
  return [
    {
      text: 'jieji_nailstrap_tienailstrap',
      description: 'hint_jieji_nailstrap_tienailstrap',
    },
    {
      text: 'jieji_nailstrap_loosenailstrap',
      description: 'hint_jieji_nailstrap_loosenailstrap',
    },
    {
      text: 'jieji_nailstrap_bloodnailstrap',
      description: 'hint_jieji_nailstrap_bloodnailstrap',
    },
  ]
}

/// 赶路劫甲革三选。debug.forceJiejiEvent('nailstrap') / forceNailstrap 直接走这里，仍弹出三选。
async function playJiejiNailstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_nailstrap')
  dialog.pushSelection('jiejiNailstrap', _jiejiNailstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiNailstrap')
  var selected = _jiejiNailstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tienailstrap'
  }

  final seasonId = _jiejiNailstrapSeasonId()
  if (selected == 'tienailstrap') {
    final herbNeed = _jiejiNailstrapTienailstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_nailstrap_tienailstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiNailstrapTienailstrapLife)
      dialog.pushDialog('hint_jieji_nailstrap_tienailstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiNailstrapTienailstrapGongfaRate)
    }
  } else if (selected == 'loosenailstrap') {
    final moneyNeed = _jiejiNailstrapLoosenailstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_nailstrap_loosenailstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiNailstrapLoosenailstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiNailstrapLoosenailstrapLife)
      dialog.pushDialog('hint_jieji_nailstrap_loosenailstrap_ok', interpolations: [kJiejiNailstrapLoosenailstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiNailstrapCostLife(_jiejiNailstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_nailstrap_bloodnailstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiNailstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiNailstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_nailstrap_bloodnailstrap_none', interpolations: [kJiejiNailstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000005%。出过则返回 true。
async function tryJiejiNailstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiNailstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastNailstrapMove ?? -999
  if (moves - last < kJiejiNailstrapMoveCooldown) return false

  var rate = kJiejiNailstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastNailstrapMove = moves
  await playJiejiNailstrapEvent(terrain)
  return true
}
