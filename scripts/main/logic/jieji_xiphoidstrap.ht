/// 赶路「劫剑突革」三选：系突 / 解突 / 血突。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革都没中时才滚。
const kJiejiXiphoidstrapBaseRate = 0.0000000000001
const kJiejiXiphoidstrapMoveCooldown = 24
const kJiejiXiphoidstrapTiexiphoidstrapHerb = 1
const kJiejiXiphoidstrapTiexiphoidstrapLife = 1
const kJiejiXiphoidstrapTiexiphoidstrapGongfaRate = 0.005
const kJiejiXiphoidstrapLoosexiphoidstrapMoney = 1
const kJiejiXiphoidstrapLoosexiphoidstrapMoneyThunder = 1
const kJiejiXiphoidstrapLoosexiphoidstrapHerb = 1
const kJiejiXiphoidstrapLoosexiphoidstrapLife = 1
const kJiejiXiphoidstrapBloodLife = 1
const kJiejiXiphoidstrapBloodLifeBlood = 2
const kJiejiXiphoidstrapBloodGongfaRate = 0.03
const kJiejiXiphoidstrapBloodMoney = 2

function _jiejiXiphoidstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiXiphoidstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiXiphoidstrapTiexiphoidstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiXiphoidstrapTiexiphoidstrapHerb
}

function _jiejiXiphoidstrapLoosexiphoidstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiXiphoidstrapLoosexiphoidstrapMoneyThunder
  return kJiejiXiphoidstrapLoosexiphoidstrapMoney
}

function _jiejiXiphoidstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiXiphoidstrapBloodLifeBlood
  return kJiejiXiphoidstrapBloodLife
}

function _jiejiXiphoidstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiXiphoidstrapNormalizeKind(kind) {
  if (kind == 'tiexiphoidstrap' || kind == 'jieji_xiphoidstrap_tiexiphoidstrap') return 'tiexiphoidstrap'
  if (kind == 'loosexiphoidstrap' || kind == 'jieji_xiphoidstrap_loosexiphoidstrap') return 'loosexiphoidstrap'
  if (kind == 'bloodxiphoidstrap' || kind == 'jieji_xiphoidstrap_bloodxiphoidstrap') return 'bloodxiphoidstrap'
  return null
}

function _jiejiXiphoidstrapChoices() {
  return [
    {
      text: 'jieji_xiphoidstrap_tiexiphoidstrap',
      description: 'hint_jieji_xiphoidstrap_tiexiphoidstrap',
    },
    {
      text: 'jieji_xiphoidstrap_loosexiphoidstrap',
      description: 'hint_jieji_xiphoidstrap_loosexiphoidstrap',
    },
    {
      text: 'jieji_xiphoidstrap_bloodxiphoidstrap',
      description: 'hint_jieji_xiphoidstrap_bloodxiphoidstrap',
    },
  ]
}

/// 赶路劫剑突革三选。debug.forceJiejiEvent('xiphoidstrap') / forceXiphoidstrap 直接走这里，仍弹出三选。
async function playJiejiXiphoidstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_xiphoidstrap')
  dialog.pushSelection('jiejiXiphoidstrap', _jiejiXiphoidstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiXiphoidstrap')
  var selected = _jiejiXiphoidstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiexiphoidstrap'
  }

  final seasonId = _jiejiXiphoidstrapSeasonId()
  if (selected == 'tiexiphoidstrap') {
    final herbNeed = _jiejiXiphoidstrapTiexiphoidstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_xiphoidstrap_tiexiphoidstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiXiphoidstrapTiexiphoidstrapLife)
      dialog.pushDialog('hint_jieji_xiphoidstrap_tiexiphoidstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiXiphoidstrapTiexiphoidstrapGongfaRate)
    }
  } else if (selected == 'loosexiphoidstrap') {
    final moneyNeed = _jiejiXiphoidstrapLoosexiphoidstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_xiphoidstrap_loosexiphoidstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiXiphoidstrapLoosexiphoidstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiXiphoidstrapLoosexiphoidstrapLife)
      dialog.pushDialog('hint_jieji_xiphoidstrap_loosexiphoidstrap_ok', interpolations: [kJiejiXiphoidstrapLoosexiphoidstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiXiphoidstrapCostLife(_jiejiXiphoidstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_xiphoidstrap_bloodxiphoidstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiXiphoidstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiXiphoidstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_xiphoidstrap_bloodxiphoidstrap_none', interpolations: [kJiejiXiphoidstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00000000001%。出过则返回 true。
async function tryJiejiXiphoidstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiXiphoidstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastXiphoidstrapMove ?? -999
  if (moves - last < kJiejiXiphoidstrapMoveCooldown) return false

  var rate = kJiejiXiphoidstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastXiphoidstrapMove = moves
  await playJiejiXiphoidstrapEvent(terrain)
  return true
}
