/// 赶路「劫刺」三选：上刺 / 卸刺 / 血刺。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍都没中时才滚。
const kJiejiSpurBaseRate = 0.000025
const kJiejiSpurMoveCooldown = 24
const kJiejiSpurSetspurHerb = 1
const kJiejiSpurSetspurLife = 1
const kJiejiSpurSetspurGongfaRate = 0.006
const kJiejiSpurLoosespurMoney = 1
const kJiejiSpurLoosespurMoneyThunder = 1
const kJiejiSpurLoosespurHerb = 1
const kJiejiSpurLoosespurLife = 1
const kJiejiSpurBloodLife = 1
const kJiejiSpurBloodLifeBlood = 2
const kJiejiSpurBloodGongfaRate = 0.04
const kJiejiSpurBloodMoney = 2

function _jiejiSpurSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiSpurTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiSpurSetspurHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiSpurSetspurHerb
}

function _jiejiSpurLoosespurMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiSpurLoosespurMoneyThunder
  return kJiejiSpurLoosespurMoney
}

function _jiejiSpurBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiSpurBloodLifeBlood
  return kJiejiSpurBloodLife
}

function _jiejiSpurCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiSpurNormalizeKind(kind) {
  if (kind == 'setspur' || kind == 'jieji_spur_setspur') return 'setspur'
  if (kind == 'loosespur' || kind == 'jieji_spur_loosespur') return 'loosespur'
  if (kind == 'bloodspur' || kind == 'jieji_spur_bloodspur') return 'bloodspur'
  return null
}

function _jiejiSpurChoices() {
  return [
    {
      text: 'jieji_spur_setspur',
      description: 'hint_jieji_spur_setspur',
    },
    {
      text: 'jieji_spur_loosespur',
      description: 'hint_jieji_spur_loosespur',
    },
    {
      text: 'jieji_spur_bloodspur',
      description: 'hint_jieji_spur_bloodspur',
    },
  ]
}

/// 赶路劫刺三选。debug.forceJiejiEvent('spur') / forceSpur 直接走这里，仍弹出三选。
async function playJiejiSpurEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_spur')
  dialog.pushSelection('jiejiSpur', _jiejiSpurChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiSpur')
  var selected = _jiejiSpurNormalizeKind(picked)
  if (selected == null) {
    selected = 'setspur'
  }

  final seasonId = _jiejiSpurSeasonId()
  if (selected == 'setspur') {
    final herbNeed = _jiejiSpurSetspurHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_spur_setspur_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiSpurSetspurLife)
      dialog.pushDialog('hint_jieji_spur_setspur_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiSpurSetspurGongfaRate)
    }
  } else if (selected == 'loosespur') {
    final moneyNeed = _jiejiSpurLoosespurMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_spur_loosespur_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiSpurLoosespurHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiSpurLoosespurLife)
      dialog.pushDialog('hint_jieji_spur_loosespur_ok', interpolations: [kJiejiSpurLoosespurHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiSpurCostLife(_jiejiSpurBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_spur_bloodspur_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiSpurBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiSpurBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_spur_bloodspur_none', interpolations: [kJiejiSpurBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0025%。出过则返回 true。
async function tryJiejiSpurOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiSpurTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastSpurMove ?? -999
  if (moves - last < kJiejiSpurMoveCooldown) return false

  var rate = kJiejiSpurBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastSpurMove = moves
  await playJiejiSpurEvent(terrain)
  return true
}
