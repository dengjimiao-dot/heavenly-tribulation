/// 赶路「劫笼革」三选：系笼 / 解笼 / 血笼。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革都没中时才滚。
const kJiejiCavessonBaseRate = 0.0000012
const kJiejiCavessonMoveCooldown = 24
const kJiejiCavessonTiecavessonHerb = 1
const kJiejiCavessonTiecavessonLife = 1
const kJiejiCavessonTiecavessonGongfaRate = 0.005
const kJiejiCavessonLoosecavessonMoney = 1
const kJiejiCavessonLoosecavessonMoneyThunder = 1
const kJiejiCavessonLoosecavessonHerb = 1
const kJiejiCavessonLoosecavessonLife = 1
const kJiejiCavessonBloodLife = 1
const kJiejiCavessonBloodLifeBlood = 2
const kJiejiCavessonBloodGongfaRate = 0.03
const kJiejiCavessonBloodMoney = 2

function _jiejiCavessonSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiCavessonTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiCavessonTiecavessonHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiCavessonTiecavessonHerb
}

function _jiejiCavessonLoosecavessonMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiCavessonLoosecavessonMoneyThunder
  return kJiejiCavessonLoosecavessonMoney
}

function _jiejiCavessonBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiCavessonBloodLifeBlood
  return kJiejiCavessonBloodLife
}

function _jiejiCavessonCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiCavessonNormalizeKind(kind) {
  if (kind == 'tiecavesson' || kind == 'jieji_cavesson_tiecavesson') return 'tiecavesson'
  if (kind == 'loosecavesson' || kind == 'jieji_cavesson_loosecavesson') return 'loosecavesson'
  if (kind == 'bloodcavesson' || kind == 'jieji_cavesson_bloodcavesson') return 'bloodcavesson'
  return null
}

function _jiejiCavessonChoices() {
  return [
    {
      text: 'jieji_cavesson_tiecavesson',
      description: 'hint_jieji_cavesson_tiecavesson',
    },
    {
      text: 'jieji_cavesson_loosecavesson',
      description: 'hint_jieji_cavesson_loosecavesson',
    },
    {
      text: 'jieji_cavesson_bloodcavesson',
      description: 'hint_jieji_cavesson_bloodcavesson',
    },
  ]
}

/// 赶路劫笼革三选。debug.forceJiejiEvent('cavesson') / forceCavesson 直接走这里，仍弹出三选。
async function playJiejiCavessonEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_cavesson')
  dialog.pushSelection('jiejiCavesson', _jiejiCavessonChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiCavesson')
  var selected = _jiejiCavessonNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiecavesson'
  }

  final seasonId = _jiejiCavessonSeasonId()
  if (selected == 'tiecavesson') {
    final herbNeed = _jiejiCavessonTiecavessonHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_cavesson_tiecavesson_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiCavessonTiecavessonLife)
      dialog.pushDialog('hint_jieji_cavesson_tiecavesson_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiCavessonTiecavessonGongfaRate)
    }
  } else if (selected == 'loosecavesson') {
    final moneyNeed = _jiejiCavessonLoosecavessonMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_cavesson_loosecavesson_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiCavessonLoosecavessonHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiCavessonLoosecavessonLife)
      dialog.pushDialog('hint_jieji_cavesson_loosecavesson_ok', interpolations: [kJiejiCavessonLoosecavessonHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiCavessonCostLife(_jiejiCavessonBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_cavesson_bloodcavesson_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiCavessonBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiCavessonBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_cavesson_bloodcavesson_none', interpolations: [kJiejiCavessonBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00012%。出过则返回 true。
async function tryJiejiCavessonOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiCavessonTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastCavessonMove ?? -999
  if (moves - last < kJiejiCavessonMoveCooldown) return false

  var rate = kJiejiCavessonBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastCavessonMove = moves
  await playJiejiCavessonEvent(terrain)
  return true
}
