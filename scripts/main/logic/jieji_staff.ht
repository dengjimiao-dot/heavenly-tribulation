/// 赶路「劫杖」三选：拄杖 / 收杖 / 血杖。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇都没中时才滚。
const kJiejiStaffBaseRate = 0.024
const kJiejiStaffMoveCooldown = 24
const kJiejiStaffLeanHerb = 1
const kJiejiStaffLeanLife = 5
const kJiejiStaffLeanGongfaRate = 0.08
const kJiejiStaffStowstaffMoney = 8
const kJiejiStaffStowstaffMoneyThunder = 4
const kJiejiStaffStowstaffHerb = 2
const kJiejiStaffStowstaffLife = 3
const kJiejiStaffBloodLife = 2
const kJiejiStaffBloodLifeBlood = 3
const kJiejiStaffBloodGongfaRate = 0.26
const kJiejiStaffBloodMoney = 16

function _jiejiStaffSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiStaffTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiStaffLeanHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiStaffLeanHerb
}

function _jiejiStaffStowstaffMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiStaffStowstaffMoneyThunder
  return kJiejiStaffStowstaffMoney
}

function _jiejiStaffBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiStaffBloodLifeBlood
  return kJiejiStaffBloodLife
}

function _jiejiStaffCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiStaffNormalizeKind(kind) {
  if (kind == 'lean' || kind == 'jieji_staff_lean') return 'lean'
  if (kind == 'stowstaff' || kind == 'jieji_staff_stowstaff') return 'stowstaff'
  if (kind == 'bloodstaff' || kind == 'jieji_staff_bloodstaff') return 'bloodstaff'
  return null
}

function _jiejiStaffChoices() {
  return [
    {
      text: 'jieji_staff_lean',
      description: 'hint_jieji_staff_lean',
    },
    {
      text: 'jieji_staff_stowstaff',
      description: 'hint_jieji_staff_stowstaff',
    },
    {
      text: 'jieji_staff_bloodstaff',
      description: 'hint_jieji_staff_bloodstaff',
    },
  ]
}

/// 赶路劫杖三选。debug.forceJiejiEvent('staff') / forceStaff 直接走这里，仍弹出三选。
async function playJiejiStaffEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_staff')
  dialog.pushSelection('jiejiStaff', _jiejiStaffChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiStaff')
  var selected = _jiejiStaffNormalizeKind(picked)
  if (selected == null) {
    selected = 'lean'
  }

  final seasonId = _jiejiStaffSeasonId()
  if (selected == 'lean') {
    final herbNeed = _jiejiStaffLeanHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_staff_lean_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiStaffLeanLife)
      dialog.pushDialog('hint_jieji_staff_lean_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiStaffLeanGongfaRate)
    }
  } else if (selected == 'stowstaff') {
    final moneyNeed = _jiejiStaffStowstaffMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_staff_stowstaff_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiStaffStowstaffHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiStaffStowstaffLife)
      dialog.pushDialog('hint_jieji_staff_stowstaff_ok', interpolations: [kJiejiStaffStowstaffHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiStaffCostLife(_jiejiStaffBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_staff_bloodstaff_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiStaffBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiStaffBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_staff_bloodstaff_none', interpolations: [kJiejiStaffBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 2.4%。出过则返回 true。
async function tryJiejiStaffOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiStaffTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastStaffMove ?? -999
  if (moves - last < kJiejiStaffMoveCooldown) return false

  var rate = kJiejiStaffBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastStaffMove = moves
  await playJiejiStaffEvent(terrain)
  return true
}
