/// 赶路「劫真肋革」三选：系真 / 解真 / 血真。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革都没中时才滚。
const kJiejiTrueribstrapBaseRate = 0.00000000000001
const kJiejiTrueribstrapMoveCooldown = 24
const kJiejiTrueribstrapTietrueribstrapHerb = 1
const kJiejiTrueribstrapTietrueribstrapLife = 1
const kJiejiTrueribstrapTietrueribstrapGongfaRate = 0.005
const kJiejiTrueribstrapLoosetrueribstrapMoney = 1
const kJiejiTrueribstrapLoosetrueribstrapMoneyThunder = 1
const kJiejiTrueribstrapLoosetrueribstrapHerb = 1
const kJiejiTrueribstrapLoosetrueribstrapLife = 1
const kJiejiTrueribstrapBloodLife = 1
const kJiejiTrueribstrapBloodLifeBlood = 2
const kJiejiTrueribstrapBloodGongfaRate = 0.03
const kJiejiTrueribstrapBloodMoney = 2

function _jiejiTrueribstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiTrueribstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiTrueribstrapTietrueribstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiTrueribstrapTietrueribstrapHerb
}

function _jiejiTrueribstrapLoosetrueribstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiTrueribstrapLoosetrueribstrapMoneyThunder
  return kJiejiTrueribstrapLoosetrueribstrapMoney
}

function _jiejiTrueribstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiTrueribstrapBloodLifeBlood
  return kJiejiTrueribstrapBloodLife
}

function _jiejiTrueribstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiTrueribstrapNormalizeKind(kind) {
  if (kind == 'tietrueribstrap' || kind == 'jieji_trueribstrap_tietrueribstrap') return 'tietrueribstrap'
  if (kind == 'loosetrueribstrap' || kind == 'jieji_trueribstrap_loosetrueribstrap') return 'loosetrueribstrap'
  if (kind == 'bloodtrueribstrap' || kind == 'jieji_trueribstrap_bloodtrueribstrap') return 'bloodtrueribstrap'
  return null
}

function _jiejiTrueribstrapChoices() {
  return [
    {
      text: 'jieji_trueribstrap_tietrueribstrap',
      description: 'hint_jieji_trueribstrap_tietrueribstrap',
    },
    {
      text: 'jieji_trueribstrap_loosetrueribstrap',
      description: 'hint_jieji_trueribstrap_loosetrueribstrap',
    },
    {
      text: 'jieji_trueribstrap_bloodtrueribstrap',
      description: 'hint_jieji_trueribstrap_bloodtrueribstrap',
    },
  ]
}

/// 赶路劫真肋革三选。debug.forceJiejiEvent('trueribstrap') / forceTrueribstrap 直接走这里，仍弹出三选。
async function playJiejiTrueribstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_trueribstrap')
  dialog.pushSelection('jiejiTrueribstrap', _jiejiTrueribstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiTrueribstrap')
  var selected = _jiejiTrueribstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tietrueribstrap'
  }

  final seasonId = _jiejiTrueribstrapSeasonId()
  if (selected == 'tietrueribstrap') {
    final herbNeed = _jiejiTrueribstrapTietrueribstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_trueribstrap_tietrueribstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiTrueribstrapTietrueribstrapLife)
      dialog.pushDialog('hint_jieji_trueribstrap_tietrueribstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiTrueribstrapTietrueribstrapGongfaRate)
    }
  } else if (selected == 'loosetrueribstrap') {
    final moneyNeed = _jiejiTrueribstrapLoosetrueribstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_trueribstrap_loosetrueribstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiTrueribstrapLoosetrueribstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiTrueribstrapLoosetrueribstrapLife)
      dialog.pushDialog('hint_jieji_trueribstrap_loosetrueribstrap_ok', interpolations: [kJiejiTrueribstrapLoosetrueribstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiTrueribstrapCostLife(_jiejiTrueribstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_trueribstrap_bloodtrueribstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiTrueribstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiTrueribstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_trueribstrap_bloodtrueribstrap_none', interpolations: [kJiejiTrueribstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000001%。出过则返回 true。
async function tryJiejiTrueribstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiTrueribstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastTrueribstrapMove ?? -999
  if (moves - last < kJiejiTrueribstrapMoveCooldown) return false

  var rate = kJiejiTrueribstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastTrueribstrapMove = moves
  await playJiejiTrueribstrapEvent(terrain)
  return true
}
