/// 赶路「劫肘革」三选：系肘 / 解肘 / 血肘。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革都没中时才滚。
const kJiejiElbowstrapBaseRate = 0.00000000002
const kJiejiElbowstrapMoveCooldown = 24
const kJiejiElbowstrapTieelbowstrapHerb = 1
const kJiejiElbowstrapTieelbowstrapLife = 1
const kJiejiElbowstrapTieelbowstrapGongfaRate = 0.005
const kJiejiElbowstrapLooseelbowstrapMoney = 1
const kJiejiElbowstrapLooseelbowstrapMoneyThunder = 1
const kJiejiElbowstrapLooseelbowstrapHerb = 1
const kJiejiElbowstrapLooseelbowstrapLife = 1
const kJiejiElbowstrapBloodLife = 1
const kJiejiElbowstrapBloodLifeBlood = 2
const kJiejiElbowstrapBloodGongfaRate = 0.03
const kJiejiElbowstrapBloodMoney = 2

function _jiejiElbowstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiElbowstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiElbowstrapTieelbowstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiElbowstrapTieelbowstrapHerb
}

function _jiejiElbowstrapLooseelbowstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiElbowstrapLooseelbowstrapMoneyThunder
  return kJiejiElbowstrapLooseelbowstrapMoney
}

function _jiejiElbowstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiElbowstrapBloodLifeBlood
  return kJiejiElbowstrapBloodLife
}

function _jiejiElbowstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiElbowstrapNormalizeKind(kind) {
  if (kind == 'tieelbowstrap' || kind == 'jieji_elbowstrap_tieelbowstrap') return 'tieelbowstrap'
  if (kind == 'looseelbowstrap' || kind == 'jieji_elbowstrap_looseelbowstrap') return 'looseelbowstrap'
  if (kind == 'bloodelbowstrap' || kind == 'jieji_elbowstrap_bloodelbowstrap') return 'bloodelbowstrap'
  return null
}

function _jiejiElbowstrapChoices() {
  return [
    {
      text: 'jieji_elbowstrap_tieelbowstrap',
      description: 'hint_jieji_elbowstrap_tieelbowstrap',
    },
    {
      text: 'jieji_elbowstrap_looseelbowstrap',
      description: 'hint_jieji_elbowstrap_looseelbowstrap',
    },
    {
      text: 'jieji_elbowstrap_bloodelbowstrap',
      description: 'hint_jieji_elbowstrap_bloodelbowstrap',
    },
  ]
}

/// 赶路劫肘革三选。debug.forceJiejiEvent('elbowstrap') / forceElbowstrap 直接走这里，仍弹出三选。
async function playJiejiElbowstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_elbowstrap')
  dialog.pushSelection('jiejiElbowstrap', _jiejiElbowstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiElbowstrap')
  var selected = _jiejiElbowstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieelbowstrap'
  }

  final seasonId = _jiejiElbowstrapSeasonId()
  if (selected == 'tieelbowstrap') {
    final herbNeed = _jiejiElbowstrapTieelbowstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_elbowstrap_tieelbowstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiElbowstrapTieelbowstrapLife)
      dialog.pushDialog('hint_jieji_elbowstrap_tieelbowstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiElbowstrapTieelbowstrapGongfaRate)
    }
  } else if (selected == 'looseelbowstrap') {
    final moneyNeed = _jiejiElbowstrapLooseelbowstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_elbowstrap_looseelbowstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiElbowstrapLooseelbowstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiElbowstrapLooseelbowstrapLife)
      dialog.pushDialog('hint_jieji_elbowstrap_looseelbowstrap_ok', interpolations: [kJiejiElbowstrapLooseelbowstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiElbowstrapCostLife(_jiejiElbowstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_elbowstrap_bloodelbowstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiElbowstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiElbowstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_elbowstrap_bloodelbowstrap_none', interpolations: [kJiejiElbowstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000003%。出过则返回 true。
async function tryJiejiElbowstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiElbowstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastElbowstrapMove ?? -999
  if (moves - last < kJiejiElbowstrapMoveCooldown) return false

  var rate = kJiejiElbowstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastElbowstrapMove = moves
  await playJiejiElbowstrapEvent(terrain)
  return true
}
