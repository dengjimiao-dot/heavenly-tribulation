/// 赶路「劫足革」三选：系足 / 解足 / 血足。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革都没中时才滚。
const kJiejiFootstrapBaseRate = 0.000000001
const kJiejiFootstrapMoveCooldown = 24
const kJiejiFootstrapTiefootstrapHerb = 1
const kJiejiFootstrapTiefootstrapLife = 1
const kJiejiFootstrapTiefootstrapGongfaRate = 0.005
const kJiejiFootstrapLoosefootstrapMoney = 1
const kJiejiFootstrapLoosefootstrapMoneyThunder = 1
const kJiejiFootstrapLoosefootstrapHerb = 1
const kJiejiFootstrapLoosefootstrapLife = 1
const kJiejiFootstrapBloodLife = 1
const kJiejiFootstrapBloodLifeBlood = 2
const kJiejiFootstrapBloodGongfaRate = 0.03
const kJiejiFootstrapBloodMoney = 2

function _jiejiFootstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiFootstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiFootstrapTiefootstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiFootstrapTiefootstrapHerb
}

function _jiejiFootstrapLoosefootstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiFootstrapLoosefootstrapMoneyThunder
  return kJiejiFootstrapLoosefootstrapMoney
}

function _jiejiFootstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiFootstrapBloodLifeBlood
  return kJiejiFootstrapBloodLife
}

function _jiejiFootstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiFootstrapNormalizeKind(kind) {
  if (kind == 'tiefootstrap' || kind == 'jieji_footstrap_tiefootstrap') return 'tiefootstrap'
  if (kind == 'loosefootstrap' || kind == 'jieji_footstrap_loosefootstrap') return 'loosefootstrap'
  if (kind == 'bloodfootstrap' || kind == 'jieji_footstrap_bloodfootstrap') return 'bloodfootstrap'
  return null
}

function _jiejiFootstrapChoices() {
  return [
    {
      text: 'jieji_footstrap_tiefootstrap',
      description: 'hint_jieji_footstrap_tiefootstrap',
    },
    {
      text: 'jieji_footstrap_loosefootstrap',
      description: 'hint_jieji_footstrap_loosefootstrap',
    },
    {
      text: 'jieji_footstrap_bloodfootstrap',
      description: 'hint_jieji_footstrap_bloodfootstrap',
    },
  ]
}

/// 赶路劫足革三选。debug.forceJiejiEvent('footstrap') / forceFootstrap 直接走这里，仍弹出三选。
async function playJiejiFootstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_footstrap')
  dialog.pushSelection('jiejiFootstrap', _jiejiFootstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiFootstrap')
  var selected = _jiejiFootstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiefootstrap'
  }

  final seasonId = _jiejiFootstrapSeasonId()
  if (selected == 'tiefootstrap') {
    final herbNeed = _jiejiFootstrapTiefootstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_footstrap_tiefootstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiFootstrapTiefootstrapLife)
      dialog.pushDialog('hint_jieji_footstrap_tiefootstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiFootstrapTiefootstrapGongfaRate)
    }
  } else if (selected == 'loosefootstrap') {
    final moneyNeed = _jiejiFootstrapLoosefootstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_footstrap_loosefootstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiFootstrapLoosefootstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiFootstrapLoosefootstrapLife)
      dialog.pushDialog('hint_jieji_footstrap_loosefootstrap_ok', interpolations: [kJiejiFootstrapLoosefootstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiFootstrapCostLife(_jiejiFootstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_footstrap_bloodfootstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiFootstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiFootstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_footstrap_bloodfootstrap_none', interpolations: [kJiejiFootstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000001%。出过则返回 true。
async function tryJiejiFootstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiFootstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastFootstrapMove ?? -999
  if (moves - last < kJiejiFootstrapMoveCooldown) return false

  var rate = kJiejiFootstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastFootstrapMove = moves
  await playJiejiFootstrapEvent(terrain)
  return true
}
