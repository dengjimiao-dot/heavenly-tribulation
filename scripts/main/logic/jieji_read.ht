/// 藏经阁「夜读」三选：温卷 / 抄页 / 血注。不替换问道。
const kJiejiReadCooldownDays = 1
const kJiejiReadWarmHerb = 1
const kJiejiReadWarmLife = 5
const kJiejiReadWarmGongfaRate = 0.20
const kJiejiReadCopyMoney = 30
const kJiejiReadCopyMoneyThunder = 15
const kJiejiReadCopyLife = 2
const kJiejiReadBloodLife = 2
const kJiejiReadBloodLifeBlood = 3
const kJiejiReadBloodMoney = 60

function _jiejiReadSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return 'thunder'
}

function _jiejiReadCurrentDay() {
  if (game.timestamp == null) return null
  if (Constants.ticksPerDay == null) return null
  if (Constants.ticksPerDay <= 0) return null
  return game.timestamp ~/ Constants.ticksPerDay
}

function _jiejiReadOnCooldown() {
  final jieji = ensureJiejiFlags()
  final day = _jiejiReadCurrentDay()
  if (day == null) return false
  if (jieji.lastReadDay == null) return false
  if (day - jieji.lastReadDay < kJiejiReadCooldownDays) return true
  return false
}

function _jiejiReadMark() {
  final jieji = ensureJiejiFlags()
  jieji.lastReadDay = _jiejiReadCurrentDay()
}

function _jiejiReadCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiReadWarmHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiReadWarmHerb
}

function _jiejiReadCopyMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiReadCopyMoneyThunder
  return kJiejiReadCopyMoney
}

function _jiejiReadBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiReadBloodLifeBlood
  return kJiejiReadBloodLife
}

function _jiejiReadNormalizeKind(kind) {
  if (kind == 'warm' || kind == 'jieji_read_warm') return 'warm'
  if (kind == 'copy' || kind == 'jieji_read_copy') return 'copy'
  if (kind == 'blood' || kind == 'jieji_read_blood') return 'blood'
  return null
}

function _jiejiReadChoices() {
  return [
    {
      text: 'jieji_read_warm',
      description: 'hint_jieji_read_warm',
    },
    {
      text: 'jieji_read_copy',
      description: 'hint_jieji_read_copy',
    },
    {
      text: 'jieji_read_blood',
      description: 'hint_jieji_read_blood',
    },
    'cancel',
  ]
}

function _jiejiReadHerbNeed(selected, seasonId) {
  if (selected == 'warm') return _jiejiReadWarmHerbCost(seasonId)
  return 0
}

function _jiejiReadMoneyNeed(selected, seasonId) {
  if (selected == 'copy') return _jiejiReadCopyMoneyCost(seasonId)
  return 0
}

/// 藏经阁夜读三选。free 为 true 时不扣费、不检查冷却（debug），仍弹出三选。
/// 返回 'ok' | 'cooldown' | 'poor' | 'cancel'。
async function readJiejiNight({ free = false }) {
  if (hero == null) return 'cancel'
  if (free != true && _jiejiReadOnCooldown()) {
    return 'cooldown'
  }

  dialog.pushDialog('hint_readJiejiNight')
  dialog.pushSelection('jiejiRead', _jiejiReadChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiRead')
  var selected = null
  if (picked == null || picked == 'cancel') {
    if (free == true && picked == null) {
      selected = 'warm'
    } else {
      return 'cancel'
    }
  } else {
    selected = _jiejiReadNormalizeKind(picked)
  }
  if (selected == null) return 'cancel'

  final seasonId = _jiejiReadSeasonId()
  if (free != true) {
    final herbNeed = _jiejiReadHerbNeed(selected, seasonId)
    final moneyNeed = _jiejiReadMoneyNeed(selected, seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    final moneyHave = hero.materials['money'] ?? 0
    if (herbHave < herbNeed || moneyHave < moneyNeed) {
      return 'poor'
    }
  }

  var bloodLost = 0
  if (free != true) {
    final herbNeed = _jiejiReadHerbNeed(selected, seasonId)
    final moneyNeed = _jiejiReadMoneyNeed(selected, seasonId)
    if (herbNeed > 0) {
      Player.exhaust('herb', herbNeed)
    }
    if (moneyNeed > 0) {
      Player.exhaust('money', moneyNeed)
    }
    if (selected == 'blood') {
      bloodLost = _jiejiReadCostLife(_jiejiReadBloodLifeCost(seasonId))
    }
    _jiejiReadMark()
  }

  if (selected == 'copy') {
    jiejiDungeonGrantBlank()
    final healed = Player.restoreLife(kJiejiReadCopyLife)
    dialog.pushDialog('hint_readJiejiNight_copy', interpolations: [healed])
    await dialog.execute()
  } else if (selected == 'blood') {
    if (free == true) {
      bloodLost = _jiejiReadBloodLifeCost(seasonId)
    }
    dialog.pushDialog('hint_readJiejiNight_blood', interpolations: [bloodLost])
    await dialog.execute()
    var ok = await tryDropGongfaShard(rate: 1)
    if (ok != true) {
      ok = await grantGongfaShard(null)
    }
    if (ok != true) {
      await Player.collect('money', kJiejiReadBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_readJiejiNight_blood_none', interpolations: [kJiejiReadBloodMoney])
      await dialog.execute()
    }
  } else {
    final healed = Player.restoreLife(kJiejiReadWarmLife)
    dialog.pushDialog('hint_readJiejiNight_warm', interpolations: [healed])
    await dialog.execute()
    await tryDropGongfaShard(rate: kJiejiReadWarmGongfaRate)
  }

  Game.updateUI()
  return 'ok'
}
