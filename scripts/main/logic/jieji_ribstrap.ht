/// 赶路「劫肋革」三选：系肋 / 解肋 / 血肋。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革都没中时才滚。
const kJiejiRibstrapBaseRate = 0.000000015
const kJiejiRibstrapMoveCooldown = 24
const kJiejiRibstrapTieribstrapHerb = 1
const kJiejiRibstrapTieribstrapLife = 1
const kJiejiRibstrapTieribstrapGongfaRate = 0.005
const kJiejiRibstrapLooseribstrapMoney = 1
const kJiejiRibstrapLooseribstrapMoneyThunder = 1
const kJiejiRibstrapLooseribstrapHerb = 1
const kJiejiRibstrapLooseribstrapLife = 1
const kJiejiRibstrapBloodLife = 1
const kJiejiRibstrapBloodLifeBlood = 2
const kJiejiRibstrapBloodGongfaRate = 0.03
const kJiejiRibstrapBloodMoney = 2

function _jiejiRibstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiRibstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiRibstrapTieribstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiRibstrapTieribstrapHerb
}

function _jiejiRibstrapLooseribstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiRibstrapLooseribstrapMoneyThunder
  return kJiejiRibstrapLooseribstrapMoney
}

function _jiejiRibstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiRibstrapBloodLifeBlood
  return kJiejiRibstrapBloodLife
}

function _jiejiRibstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiRibstrapNormalizeKind(kind) {
  if (kind == 'tieribstrap' || kind == 'jieji_ribstrap_tieribstrap') return 'tieribstrap'
  if (kind == 'looseribstrap' || kind == 'jieji_ribstrap_looseribstrap') return 'looseribstrap'
  if (kind == 'bloodribstrap' || kind == 'jieji_ribstrap_bloodribstrap') return 'bloodribstrap'
  return null
}

function _jiejiRibstrapChoices() {
  return [
    {
      text: 'jieji_ribstrap_tieribstrap',
      description: 'hint_jieji_ribstrap_tieribstrap',
    },
    {
      text: 'jieji_ribstrap_looseribstrap',
      description: 'hint_jieji_ribstrap_looseribstrap',
    },
    {
      text: 'jieji_ribstrap_bloodribstrap',
      description: 'hint_jieji_ribstrap_bloodribstrap',
    },
  ]
}

/// 赶路劫肋革三选。debug.forceJiejiEvent('ribstrap') / forceRibstrap 直接走这里，仍弹出三选。
async function playJiejiRibstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_ribstrap')
  dialog.pushSelection('jiejiRibstrap', _jiejiRibstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiRibstrap')
  var selected = _jiejiRibstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieribstrap'
  }

  final seasonId = _jiejiRibstrapSeasonId()
  if (selected == 'tieribstrap') {
    final herbNeed = _jiejiRibstrapTieribstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_ribstrap_tieribstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiRibstrapTieribstrapLife)
      dialog.pushDialog('hint_jieji_ribstrap_tieribstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiRibstrapTieribstrapGongfaRate)
    }
  } else if (selected == 'looseribstrap') {
    final moneyNeed = _jiejiRibstrapLooseribstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_ribstrap_looseribstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiRibstrapLooseribstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiRibstrapLooseribstrapLife)
      dialog.pushDialog('hint_jieji_ribstrap_looseribstrap_ok', interpolations: [kJiejiRibstrapLooseribstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiRibstrapCostLife(_jiejiRibstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_ribstrap_bloodribstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiRibstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiRibstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_ribstrap_bloodribstrap_none', interpolations: [kJiejiRibstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000015%。出过则返回 true。
async function tryJiejiRibstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiRibstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastRibstrapMove ?? -999
  if (moves - last < kJiejiRibstrapMoveCooldown) return false

  var rate = kJiejiRibstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastRibstrapMove = moves
  await playJiejiRibstrapEvent(terrain)
  return true
}
