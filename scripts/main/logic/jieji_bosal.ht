/// 赶路「劫羁革」三选：系羁 / 解羁 / 血羁。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革都没中时才滚。
const kJiejiBosalBaseRate = 0.0000008
const kJiejiBosalMoveCooldown = 24
const kJiejiBosalTiebosalHerb = 1
const kJiejiBosalTiebosalLife = 1
const kJiejiBosalTiebosalGongfaRate = 0.005
const kJiejiBosalLoosebosalMoney = 1
const kJiejiBosalLoosebosalMoneyThunder = 1
const kJiejiBosalLoosebosalHerb = 1
const kJiejiBosalLoosebosalLife = 1
const kJiejiBosalBloodLife = 1
const kJiejiBosalBloodLifeBlood = 2
const kJiejiBosalBloodGongfaRate = 0.03
const kJiejiBosalBloodMoney = 2

function _jiejiBosalSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiBosalTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiBosalTiebosalHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiBosalTiebosalHerb
}

function _jiejiBosalLoosebosalMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiBosalLoosebosalMoneyThunder
  return kJiejiBosalLoosebosalMoney
}

function _jiejiBosalBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiBosalBloodLifeBlood
  return kJiejiBosalBloodLife
}

function _jiejiBosalCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiBosalNormalizeKind(kind) {
  if (kind == 'tiebosal' || kind == 'jieji_bosal_tiebosal') return 'tiebosal'
  if (kind == 'loosebosal' || kind == 'jieji_bosal_loosebosal') return 'loosebosal'
  if (kind == 'bloodbosal' || kind == 'jieji_bosal_bloodbosal') return 'bloodbosal'
  return null
}

function _jiejiBosalChoices() {
  return [
    {
      text: 'jieji_bosal_tiebosal',
      description: 'hint_jieji_bosal_tiebosal',
    },
    {
      text: 'jieji_bosal_loosebosal',
      description: 'hint_jieji_bosal_loosebosal',
    },
    {
      text: 'jieji_bosal_bloodbosal',
      description: 'hint_jieji_bosal_bloodbosal',
    },
  ]
}

/// 赶路劫羁革三选。debug.forceJiejiEvent('bosal') / forceBosal 直接走这里，仍弹出三选。
async function playJiejiBosalEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_bosal')
  dialog.pushSelection('jiejiBosal', _jiejiBosalChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiBosal')
  var selected = _jiejiBosalNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiebosal'
  }

  final seasonId = _jiejiBosalSeasonId()
  if (selected == 'tiebosal') {
    final herbNeed = _jiejiBosalTiebosalHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_bosal_tiebosal_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiBosalTiebosalLife)
      dialog.pushDialog('hint_jieji_bosal_tiebosal_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiBosalTiebosalGongfaRate)
    }
  } else if (selected == 'loosebosal') {
    final moneyNeed = _jiejiBosalLoosebosalMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_bosal_loosebosal_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiBosalLoosebosalHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiBosalLoosebosalLife)
      dialog.pushDialog('hint_jieji_bosal_loosebosal_ok', interpolations: [kJiejiBosalLoosebosalHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiBosalCostLife(_jiejiBosalBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_bosal_bloodbosal_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiBosalBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiBosalBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_bosal_bloodbosal_none', interpolations: [kJiejiBosalBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00008%。出过则返回 true。
async function tryJiejiBosalOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiBosalTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastBosalMove ?? -999
  if (moves - last < kJiejiBosalMoveCooldown) return false

  var rate = kJiejiBosalBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastBosalMove = moves
  await playJiejiBosalEvent(terrain)
  return true
}
