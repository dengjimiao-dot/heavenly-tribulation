/// 赶路「劫胫革」三选：系胫 / 解胫 / 血胫。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革都没中时才滚。
const kJiejiShinstrapBaseRate = 0.000000005
const kJiejiShinstrapMoveCooldown = 24
const kJiejiShinstrapTieshinstrapHerb = 1
const kJiejiShinstrapTieshinstrapLife = 1
const kJiejiShinstrapTieshinstrapGongfaRate = 0.005
const kJiejiShinstrapLooseshinstrapMoney = 1
const kJiejiShinstrapLooseshinstrapMoneyThunder = 1
const kJiejiShinstrapLooseshinstrapHerb = 1
const kJiejiShinstrapLooseshinstrapLife = 1
const kJiejiShinstrapBloodLife = 1
const kJiejiShinstrapBloodLifeBlood = 2
const kJiejiShinstrapBloodGongfaRate = 0.03
const kJiejiShinstrapBloodMoney = 2

function _jiejiShinstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiShinstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiShinstrapTieshinstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiShinstrapTieshinstrapHerb
}

function _jiejiShinstrapLooseshinstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiShinstrapLooseshinstrapMoneyThunder
  return kJiejiShinstrapLooseshinstrapMoney
}

function _jiejiShinstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiShinstrapBloodLifeBlood
  return kJiejiShinstrapBloodLife
}

function _jiejiShinstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiShinstrapNormalizeKind(kind) {
  if (kind == 'tieshinstrap' || kind == 'jieji_shinstrap_tieshinstrap') return 'tieshinstrap'
  if (kind == 'looseshinstrap' || kind == 'jieji_shinstrap_looseshinstrap') return 'looseshinstrap'
  if (kind == 'bloodshinstrap' || kind == 'jieji_shinstrap_bloodshinstrap') return 'bloodshinstrap'
  return null
}

function _jiejiShinstrapChoices() {
  return [
    {
      text: 'jieji_shinstrap_tieshinstrap',
      description: 'hint_jieji_shinstrap_tieshinstrap',
    },
    {
      text: 'jieji_shinstrap_looseshinstrap',
      description: 'hint_jieji_shinstrap_looseshinstrap',
    },
    {
      text: 'jieji_shinstrap_bloodshinstrap',
      description: 'hint_jieji_shinstrap_bloodshinstrap',
    },
  ]
}

/// 赶路劫胫革三选。debug.forceJiejiEvent('shinstrap') / forceShinstrap 直接走这里，仍弹出三选。
async function playJiejiShinstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_shinstrap')
  dialog.pushSelection('jiejiShinstrap', _jiejiShinstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiShinstrap')
  var selected = _jiejiShinstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieshinstrap'
  }

  final seasonId = _jiejiShinstrapSeasonId()
  if (selected == 'tieshinstrap') {
    final herbNeed = _jiejiShinstrapTieshinstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_shinstrap_tieshinstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiShinstrapTieshinstrapLife)
      dialog.pushDialog('hint_jieji_shinstrap_tieshinstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiShinstrapTieshinstrapGongfaRate)
    }
  } else if (selected == 'looseshinstrap') {
    final moneyNeed = _jiejiShinstrapLooseshinstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_shinstrap_looseshinstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiShinstrapLooseshinstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiShinstrapLooseshinstrapLife)
      dialog.pushDialog('hint_jieji_shinstrap_looseshinstrap_ok', interpolations: [kJiejiShinstrapLooseshinstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiShinstrapCostLife(_jiejiShinstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_shinstrap_bloodshinstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiShinstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiShinstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_shinstrap_bloodshinstrap_none', interpolations: [kJiejiShinstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000005%。出过则返回 true。
async function tryJiejiShinstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiShinstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastShinstrapMove ?? -999
  if (moves - last < kJiejiShinstrapMoveCooldown) return false

  var rate = kJiejiShinstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastShinstrapMove = moves
  await playJiejiShinstrapEvent(terrain)
  return true
}
