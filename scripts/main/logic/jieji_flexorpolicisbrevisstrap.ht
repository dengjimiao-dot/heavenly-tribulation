/// 赶路「劫拇短屈肌革」三选：系拇短屈肌 / 解拇短屈肌 / 血拇短屈肌。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革、劫肋头革、劫肋颈革、劫肋结节革、劫肋角革、劫肋沟革、劫肋脊革、劫肋体革、劫肋椎革、劫肋横突革、劫肋软骨结革、劫胸肋革、劫柄胸革、劫胸骨角革、劫剑胸革、劫肋胸革、劫颈静脉切迹革、劫锁骨切迹革、劫肋软骨弓革、劫肋下角革、劫胸骨体革、劫肋剑突革、劫锁间韧带革、劫肋软骨结合革、劫胸骨肌革、劫胸大肌革、劫前锯肌革、劫锁骨下肌革、劫背阔肌革、劫斜方肌革、劫三角肌革、劫冈下肌革、劫大圆肌革、劫小圆肌革、劫冈上肌革、劫肩胛下肌革、劫喙肱肌革、劫肱肌革、劫肱三头肌革、劫肘肌革、劫肱桡肌革、劫指伸肌革、劫尺侧腕屈肌革、劫掌长肌革、劫桡侧腕屈肌革、劫尺侧腕伸肌革、劫桡侧腕长伸肌革、劫桡侧腕短伸肌革、劫拇长展肌革、劫拇短伸肌革、劫拇长伸肌革、劫拇短展肌革、劫拇长屈肌革、劫拇短屈肌革都没中时才滚。
const kJiejiFlexorpolicisbrevisstrapBaseRate = 0.00000000000000008
const kJiejiFlexorpolicisbrevisstrapMoveCooldown = 24
const kJiejiFlexorpolicisbrevisstrapTieflexorpolicisbrevisstrapHerb = 1
const kJiejiFlexorpolicisbrevisstrapTieflexorpolicisbrevisstrapLife = 1
const kJiejiFlexorpolicisbrevisstrapTieflexorpolicisbrevisstrapGongfaRate = 0.005
const kJiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapMoney = 1
const kJiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapMoneyThunder = 1
const kJiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapHerb = 1
const kJiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapLife = 1
const kJiejiFlexorpolicisbrevisstrapBloodLife = 1
const kJiejiFlexorpolicisbrevisstrapBloodLifeBlood = 2
const kJiejiFlexorpolicisbrevisstrapBloodGongfaRate = 0.03
const kJiejiFlexorpolicisbrevisstrapBloodMoney = 2

function _jiejiFlexorpolicisbrevisstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiFlexorpolicisbrevisstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiFlexorpolicisbrevisstrapTieflexorpolicisbrevisstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiFlexorpolicisbrevisstrapTieflexorpolicisbrevisstrapHerb
}

function _jiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapMoneyThunder
  return kJiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapMoney
}

function _jiejiFlexorpolicisbrevisstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiFlexorpolicisbrevisstrapBloodLifeBlood
  return kJiejiFlexorpolicisbrevisstrapBloodLife
}

function _jiejiFlexorpolicisbrevisstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiFlexorpolicisbrevisstrapNormalizeKind(kind) {
  if (kind == 'tieflexorpolicisbrevisstrap' || kind == 'jieji_flexorpolicisbrevisstrap_tieflexorpolicisbrevisstrap') return 'tieflexorpolicisbrevisstrap'
  if (kind == 'looseflexorpolicisbrevisstrap' || kind == 'jieji_flexorpolicisbrevisstrap_looseflexorpolicisbrevisstrap') return 'looseflexorpolicisbrevisstrap'
  if (kind == 'bloodflexorpolicisbrevisstrap' || kind == 'jieji_flexorpolicisbrevisstrap_bloodflexorpolicisbrevisstrap') return 'bloodflexorpolicisbrevisstrap'
  return null
}

function _jiejiFlexorpolicisbrevisstrapChoices() {
  return [
    {
      text: 'jieji_flexorpolicisbrevisstrap_tieflexorpolicisbrevisstrap',
      description: 'hint_jieji_flexorpolicisbrevisstrap_tieflexorpolicisbrevisstrap',
    },
    {
      text: 'jieji_flexorpolicisbrevisstrap_looseflexorpolicisbrevisstrap',
      description: 'hint_jieji_flexorpolicisbrevisstrap_looseflexorpolicisbrevisstrap',
    },
    {
      text: 'jieji_flexorpolicisbrevisstrap_bloodflexorpolicisbrevisstrap',
      description: 'hint_jieji_flexorpolicisbrevisstrap_bloodflexorpolicisbrevisstrap',
    },
  ]
}

/// 赶路劫拇短屈肌革三选。debug.forceJiejiEvent('flexorpolicisbrevisstrap') / forceFlexorpolicisbrevisstrap 直接走这里，仍弹出三选。
async function playJiejiFlexorpolicisbrevisstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_flexorpolicisbrevisstrap')
  dialog.pushSelection('jiejiFlexorpolicisbrevisstrap', _jiejiFlexorpolicisbrevisstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiFlexorpolicisbrevisstrap')
  var selected = _jiejiFlexorpolicisbrevisstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieflexorpolicisbrevisstrap'
  }

  final seasonId = _jiejiFlexorpolicisbrevisstrapSeasonId()
  if (selected == 'tieflexorpolicisbrevisstrap') {
    final herbNeed = _jiejiFlexorpolicisbrevisstrapTieflexorpolicisbrevisstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_flexorpolicisbrevisstrap_tieflexorpolicisbrevisstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiFlexorpolicisbrevisstrapTieflexorpolicisbrevisstrapLife)
      dialog.pushDialog('hint_jieji_flexorpolicisbrevisstrap_tieflexorpolicisbrevisstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiFlexorpolicisbrevisstrapTieflexorpolicisbrevisstrapGongfaRate)
    }
  } else if (selected == 'looseflexorpolicisbrevisstrap') {
    final moneyNeed = _jiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_flexorpolicisbrevisstrap_looseflexorpolicisbrevisstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapLife)
      dialog.pushDialog('hint_jieji_flexorpolicisbrevisstrap_looseflexorpolicisbrevisstrap_ok', interpolations: [kJiejiFlexorpolicisbrevisstrapLooseflexorpolicisbrevisstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiFlexorpolicisbrevisstrapCostLife(_jiejiFlexorpolicisbrevisstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_flexorpolicisbrevisstrap_bloodflexorpolicisbrevisstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiFlexorpolicisbrevisstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiFlexorpolicisbrevisstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_flexorpolicisbrevisstrap_bloodflexorpolicisbrevisstrap_none', interpolations: [kJiejiFlexorpolicisbrevisstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000000008%。出过则返回 true。
async function tryJiejiFlexorpolicisbrevisstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiFlexorpolicisbrevisstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastFlexorpolicisbrevisstrapMove ?? -999
  if (moves - last < kJiejiFlexorpolicisbrevisstrapMoveCooldown) return false

  var rate = kJiejiFlexorpolicisbrevisstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastFlexorpolicisbrevisstrapMove = moves
  await playJiejiFlexorpolicisbrevisstrapEvent(terrain)
  return true
}
