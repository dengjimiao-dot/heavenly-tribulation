/// 赶路「劫绊索」三选：系索 / 解索 / 血索。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺都没中时才滚。
const kJiejiHobbleBaseRate = 0.00002
const kJiejiHobbleMoveCooldown = 24
const kJiejiHobbleTiehobbleHerb = 1
const kJiejiHobbleTiehobbleLife = 1
const kJiejiHobbleTiehobbleGongfaRate = 0.006
const kJiejiHobbleLoosehobbleMoney = 1
const kJiejiHobbleLoosehobbleMoneyThunder = 1
const kJiejiHobbleLoosehobbleHerb = 1
const kJiejiHobbleLoosehobbleLife = 1
const kJiejiHobbleBloodLife = 1
const kJiejiHobbleBloodLifeBlood = 2
const kJiejiHobbleBloodGongfaRate = 0.04
const kJiejiHobbleBloodMoney = 2

function _jiejiHobbleSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiHobbleTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiHobbleTiehobbleHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiHobbleTiehobbleHerb
}

function _jiejiHobbleLoosehobbleMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiHobbleLoosehobbleMoneyThunder
  return kJiejiHobbleLoosehobbleMoney
}

function _jiejiHobbleBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiHobbleBloodLifeBlood
  return kJiejiHobbleBloodLife
}

function _jiejiHobbleCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiHobbleNormalizeKind(kind) {
  if (kind == 'tiehobble' || kind == 'jieji_hobble_tiehobble') return 'tiehobble'
  if (kind == 'loosehobble' || kind == 'jieji_hobble_loosehobble') return 'loosehobble'
  if (kind == 'bloodhobble' || kind == 'jieji_hobble_bloodhobble') return 'bloodhobble'
  return null
}

function _jiejiHobbleChoices() {
  return [
    {
      text: 'jieji_hobble_tiehobble',
      description: 'hint_jieji_hobble_tiehobble',
    },
    {
      text: 'jieji_hobble_loosehobble',
      description: 'hint_jieji_hobble_loosehobble',
    },
    {
      text: 'jieji_hobble_bloodhobble',
      description: 'hint_jieji_hobble_bloodhobble',
    },
  ]
}

/// 赶路劫绊索三选。debug.forceJiejiEvent('hobble') / forceHobble 直接走这里，仍弹出三选。
async function playJiejiHobbleEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_hobble')
  dialog.pushSelection('jiejiHobble', _jiejiHobbleChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiHobble')
  var selected = _jiejiHobbleNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiehobble'
  }

  final seasonId = _jiejiHobbleSeasonId()
  if (selected == 'tiehobble') {
    final herbNeed = _jiejiHobbleTiehobbleHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_hobble_tiehobble_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiHobbleTiehobbleLife)
      dialog.pushDialog('hint_jieji_hobble_tiehobble_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiHobbleTiehobbleGongfaRate)
    }
  } else if (selected == 'loosehobble') {
    final moneyNeed = _jiejiHobbleLoosehobbleMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_hobble_loosehobble_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiHobbleLoosehobbleHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiHobbleLoosehobbleLife)
      dialog.pushDialog('hint_jieji_hobble_loosehobble_ok', interpolations: [kJiejiHobbleLoosehobbleHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiHobbleCostLife(_jiejiHobbleBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_hobble_bloodhobble_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiHobbleBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiHobbleBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_hobble_bloodhobble_none', interpolations: [kJiejiHobbleBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.002%。出过则返回 true。
async function tryJiejiHobbleOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiHobbleTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastHobbleMove ?? -999
  if (moves - last < kJiejiHobbleMoveCooldown) return false

  var rate = kJiejiHobbleBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastHobbleMove = moves
  await playJiejiHobbleEvent(terrain)
  return true
}
