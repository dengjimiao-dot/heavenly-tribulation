/// 赶路「劫柄革」三选：系柄 / 解柄 / 血柄。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革都没中时才滚。
const kJiejiManubriumstrapBaseRate = 0.0000000000002
const kJiejiManubriumstrapMoveCooldown = 24
const kJiejiManubriumstrapTiemanubriumstrapHerb = 1
const kJiejiManubriumstrapTiemanubriumstrapLife = 1
const kJiejiManubriumstrapTiemanubriumstrapGongfaRate = 0.005
const kJiejiManubriumstrapLoosemanubriumstrapMoney = 1
const kJiejiManubriumstrapLoosemanubriumstrapMoneyThunder = 1
const kJiejiManubriumstrapLoosemanubriumstrapHerb = 1
const kJiejiManubriumstrapLoosemanubriumstrapLife = 1
const kJiejiManubriumstrapBloodLife = 1
const kJiejiManubriumstrapBloodLifeBlood = 2
const kJiejiManubriumstrapBloodGongfaRate = 0.03
const kJiejiManubriumstrapBloodMoney = 2

function _jiejiManubriumstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiManubriumstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiManubriumstrapTiemanubriumstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiManubriumstrapTiemanubriumstrapHerb
}

function _jiejiManubriumstrapLoosemanubriumstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiManubriumstrapLoosemanubriumstrapMoneyThunder
  return kJiejiManubriumstrapLoosemanubriumstrapMoney
}

function _jiejiManubriumstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiManubriumstrapBloodLifeBlood
  return kJiejiManubriumstrapBloodLife
}

function _jiejiManubriumstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiManubriumstrapNormalizeKind(kind) {
  if (kind == 'tiemanubriumstrap' || kind == 'jieji_manubriumstrap_tiemanubriumstrap') return 'tiemanubriumstrap'
  if (kind == 'loosemanubriumstrap' || kind == 'jieji_manubriumstrap_loosemanubriumstrap') return 'loosemanubriumstrap'
  if (kind == 'bloodmanubriumstrap' || kind == 'jieji_manubriumstrap_bloodmanubriumstrap') return 'bloodmanubriumstrap'
  return null
}

function _jiejiManubriumstrapChoices() {
  return [
    {
      text: 'jieji_manubriumstrap_tiemanubriumstrap',
      description: 'hint_jieji_manubriumstrap_tiemanubriumstrap',
    },
    {
      text: 'jieji_manubriumstrap_loosemanubriumstrap',
      description: 'hint_jieji_manubriumstrap_loosemanubriumstrap',
    },
    {
      text: 'jieji_manubriumstrap_bloodmanubriumstrap',
      description: 'hint_jieji_manubriumstrap_bloodmanubriumstrap',
    },
  ]
}

/// 赶路劫柄革三选。debug.forceJiejiEvent('manubriumstrap') / forceManubriumstrap 直接走这里，仍弹出三选。
async function playJiejiManubriumstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_manubriumstrap')
  dialog.pushSelection('jiejiManubriumstrap', _jiejiManubriumstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiManubriumstrap')
  var selected = _jiejiManubriumstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiemanubriumstrap'
  }

  final seasonId = _jiejiManubriumstrapSeasonId()
  if (selected == 'tiemanubriumstrap') {
    final herbNeed = _jiejiManubriumstrapTiemanubriumstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_manubriumstrap_tiemanubriumstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiManubriumstrapTiemanubriumstrapLife)
      dialog.pushDialog('hint_jieji_manubriumstrap_tiemanubriumstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiManubriumstrapTiemanubriumstrapGongfaRate)
    }
  } else if (selected == 'loosemanubriumstrap') {
    final moneyNeed = _jiejiManubriumstrapLoosemanubriumstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_manubriumstrap_loosemanubriumstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiManubriumstrapLoosemanubriumstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiManubriumstrapLoosemanubriumstrapLife)
      dialog.pushDialog('hint_jieji_manubriumstrap_loosemanubriumstrap_ok', interpolations: [kJiejiManubriumstrapLoosemanubriumstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiManubriumstrapCostLife(_jiejiManubriumstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_manubriumstrap_bloodmanubriumstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiManubriumstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiManubriumstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_manubriumstrap_bloodmanubriumstrap_none', interpolations: [kJiejiManubriumstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00000000002%。出过则返回 true。
async function tryJiejiManubriumstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiManubriumstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastManubriumstrapMove ?? -999
  if (moves - last < kJiejiManubriumstrapMoveCooldown) return false

  var rate = kJiejiManubriumstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastManubriumstrapMove = moves
  await playJiejiManubriumstrapEvent(terrain)
  return true
}
