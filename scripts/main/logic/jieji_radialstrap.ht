/// 赶路「劫桡革」三选：系桡 / 解桡 / 血桡。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革都没中时才滚。
const kJiejiRadialstrapBaseRate = 0.000000000005
const kJiejiRadialstrapMoveCooldown = 24
const kJiejiRadialstrapTieradialstrapHerb = 1
const kJiejiRadialstrapTieradialstrapLife = 1
const kJiejiRadialstrapTieradialstrapGongfaRate = 0.005
const kJiejiRadialstrapLooseradialstrapMoney = 1
const kJiejiRadialstrapLooseradialstrapMoneyThunder = 1
const kJiejiRadialstrapLooseradialstrapHerb = 1
const kJiejiRadialstrapLooseradialstrapLife = 1
const kJiejiRadialstrapBloodLife = 1
const kJiejiRadialstrapBloodLifeBlood = 2
const kJiejiRadialstrapBloodGongfaRate = 0.03
const kJiejiRadialstrapBloodMoney = 2

function _jiejiRadialstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiRadialstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiRadialstrapTieradialstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiRadialstrapTieradialstrapHerb
}

function _jiejiRadialstrapLooseradialstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiRadialstrapLooseradialstrapMoneyThunder
  return kJiejiRadialstrapLooseradialstrapMoney
}

function _jiejiRadialstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiRadialstrapBloodLifeBlood
  return kJiejiRadialstrapBloodLife
}

function _jiejiRadialstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiRadialstrapNormalizeKind(kind) {
  if (kind == 'tieradialstrap' || kind == 'jieji_radialstrap_tieradialstrap') return 'tieradialstrap'
  if (kind == 'looseradialstrap' || kind == 'jieji_radialstrap_looseradialstrap') return 'looseradialstrap'
  if (kind == 'bloodradialstrap' || kind == 'jieji_radialstrap_bloodradialstrap') return 'bloodradialstrap'
  return null
}

function _jiejiRadialstrapChoices() {
  return [
    {
      text: 'jieji_radialstrap_tieradialstrap',
      description: 'hint_jieji_radialstrap_tieradialstrap',
    },
    {
      text: 'jieji_radialstrap_looseradialstrap',
      description: 'hint_jieji_radialstrap_looseradialstrap',
    },
    {
      text: 'jieji_radialstrap_bloodradialstrap',
      description: 'hint_jieji_radialstrap_bloodradialstrap',
    },
  ]
}

/// 赶路劫桡革三选。debug.forceJiejiEvent('radialstrap') / forceRadialstrap 直接走这里，仍弹出三选。
async function playJiejiRadialstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_radialstrap')
  dialog.pushSelection('jiejiRadialstrap', _jiejiRadialstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiRadialstrap')
  var selected = _jiejiRadialstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieradialstrap'
  }

  final seasonId = _jiejiRadialstrapSeasonId()
  if (selected == 'tieradialstrap') {
    final herbNeed = _jiejiRadialstrapTieradialstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_radialstrap_tieradialstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiRadialstrapTieradialstrapLife)
      dialog.pushDialog('hint_jieji_radialstrap_tieradialstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiRadialstrapTieradialstrapGongfaRate)
    }
  } else if (selected == 'looseradialstrap') {
    final moneyNeed = _jiejiRadialstrapLooseradialstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_radialstrap_looseradialstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiRadialstrapLooseradialstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiRadialstrapLooseradialstrapLife)
      dialog.pushDialog('hint_jieji_radialstrap_looseradialstrap_ok', interpolations: [kJiejiRadialstrapLooseradialstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiRadialstrapCostLife(_jiejiRadialstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_radialstrap_bloodradialstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiRadialstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiRadialstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_radialstrap_bloodradialstrap_none', interpolations: [kJiejiRadialstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000000005%。出过则返回 true。
async function tryJiejiRadialstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiRadialstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastRadialstrapMove ?? -999
  if (moves - last < kJiejiRadialstrapMoveCooldown) return false

  var rate = kJiejiRadialstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastRadialstrapMove = moves
  await playJiejiRadialstrapEvent(terrain)
  return true
}
