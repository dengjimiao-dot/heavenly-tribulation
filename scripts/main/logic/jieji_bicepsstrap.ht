/// 赶路「劫膊革」三选：系膊 / 解膊 / 血膊。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革都没中时才滚。
const kJiejiBicepsstrapBaseRate = 0.000000000008
const kJiejiBicepsstrapMoveCooldown = 24
const kJiejiBicepsstrapTiebicepsstrapHerb = 1
const kJiejiBicepsstrapTiebicepsstrapLife = 1
const kJiejiBicepsstrapTiebicepsstrapGongfaRate = 0.005
const kJiejiBicepsstrapLoosebicepsstrapMoney = 1
const kJiejiBicepsstrapLoosebicepsstrapMoneyThunder = 1
const kJiejiBicepsstrapLoosebicepsstrapHerb = 1
const kJiejiBicepsstrapLoosebicepsstrapLife = 1
const kJiejiBicepsstrapBloodLife = 1
const kJiejiBicepsstrapBloodLifeBlood = 2
const kJiejiBicepsstrapBloodGongfaRate = 0.03
const kJiejiBicepsstrapBloodMoney = 2

function _jiejiBicepsstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiBicepsstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiBicepsstrapTiebicepsstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiBicepsstrapTiebicepsstrapHerb
}

function _jiejiBicepsstrapLoosebicepsstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiBicepsstrapLoosebicepsstrapMoneyThunder
  return kJiejiBicepsstrapLoosebicepsstrapMoney
}

function _jiejiBicepsstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiBicepsstrapBloodLifeBlood
  return kJiejiBicepsstrapBloodLife
}

function _jiejiBicepsstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiBicepsstrapNormalizeKind(kind) {
  if (kind == 'tiebicepsstrap' || kind == 'jieji_bicepsstrap_tiebicepsstrap') return 'tiebicepsstrap'
  if (kind == 'loosebicepsstrap' || kind == 'jieji_bicepsstrap_loosebicepsstrap') return 'loosebicepsstrap'
  if (kind == 'bloodbicepsstrap' || kind == 'jieji_bicepsstrap_bloodbicepsstrap') return 'bloodbicepsstrap'
  return null
}

function _jiejiBicepsstrapChoices() {
  return [
    {
      text: 'jieji_bicepsstrap_tiebicepsstrap',
      description: 'hint_jieji_bicepsstrap_tiebicepsstrap',
    },
    {
      text: 'jieji_bicepsstrap_loosebicepsstrap',
      description: 'hint_jieji_bicepsstrap_loosebicepsstrap',
    },
    {
      text: 'jieji_bicepsstrap_bloodbicepsstrap',
      description: 'hint_jieji_bicepsstrap_bloodbicepsstrap',
    },
  ]
}

/// 赶路劫膊革三选。debug.forceJiejiEvent('bicepsstrap') / forceBicepsstrap 直接走这里，仍弹出三选。
async function playJiejiBicepsstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_bicepsstrap')
  dialog.pushSelection('jiejiBicepsstrap', _jiejiBicepsstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiBicepsstrap')
  var selected = _jiejiBicepsstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiebicepsstrap'
  }

  final seasonId = _jiejiBicepsstrapSeasonId()
  if (selected == 'tiebicepsstrap') {
    final herbNeed = _jiejiBicepsstrapTiebicepsstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_bicepsstrap_tiebicepsstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiBicepsstrapTiebicepsstrapLife)
      dialog.pushDialog('hint_jieji_bicepsstrap_tiebicepsstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiBicepsstrapTiebicepsstrapGongfaRate)
    }
  } else if (selected == 'loosebicepsstrap') {
    final moneyNeed = _jiejiBicepsstrapLoosebicepsstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_bicepsstrap_loosebicepsstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiBicepsstrapLoosebicepsstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiBicepsstrapLoosebicepsstrapLife)
      dialog.pushDialog('hint_jieji_bicepsstrap_loosebicepsstrap_ok', interpolations: [kJiejiBicepsstrapLoosebicepsstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiBicepsstrapCostLife(_jiejiBicepsstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_bicepsstrap_bloodbicepsstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiBicepsstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiBicepsstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_bicepsstrap_bloodbicepsstrap_none', interpolations: [kJiejiBicepsstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000000008%。出过则返回 true。
async function tryJiejiBicepsstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiBicepsstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastBicepsstrapMove ?? -999
  if (moves - last < kJiejiBicepsstrapMoveCooldown) return false

  var rate = kJiejiBicepsstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastBicepsstrapMove = moves
  await playJiejiBicepsstrapEvent(terrain)
  return true
}
