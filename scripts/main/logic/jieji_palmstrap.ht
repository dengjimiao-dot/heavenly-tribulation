/// 赶路「劫掌革」三选：系掌 / 解掌 / 血掌。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革都没中时才滚。
const kJiejiPalmstrapBaseRate = 0.0000000003
const kJiejiPalmstrapMoveCooldown = 24
const kJiejiPalmstrapTiepalmstrapHerb = 1
const kJiejiPalmstrapTiepalmstrapLife = 1
const kJiejiPalmstrapTiepalmstrapGongfaRate = 0.005
const kJiejiPalmstrapLoosepalmstrapMoney = 1
const kJiejiPalmstrapLoosepalmstrapMoneyThunder = 1
const kJiejiPalmstrapLoosepalmstrapHerb = 1
const kJiejiPalmstrapLoosepalmstrapLife = 1
const kJiejiPalmstrapBloodLife = 1
const kJiejiPalmstrapBloodLifeBlood = 2
const kJiejiPalmstrapBloodGongfaRate = 0.03
const kJiejiPalmstrapBloodMoney = 2

function _jiejiPalmstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiPalmstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiPalmstrapTiepalmstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiPalmstrapTiepalmstrapHerb
}

function _jiejiPalmstrapLoosepalmstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiPalmstrapLoosepalmstrapMoneyThunder
  return kJiejiPalmstrapLoosepalmstrapMoney
}

function _jiejiPalmstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiPalmstrapBloodLifeBlood
  return kJiejiPalmstrapBloodLife
}

function _jiejiPalmstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiPalmstrapNormalizeKind(kind) {
  if (kind == 'tiepalmstrap' || kind == 'jieji_palmstrap_tiepalmstrap') return 'tiepalmstrap'
  if (kind == 'loosepalmstrap' || kind == 'jieji_palmstrap_loosepalmstrap') return 'loosepalmstrap'
  if (kind == 'bloodpalmstrap' || kind == 'jieji_palmstrap_bloodpalmstrap') return 'bloodpalmstrap'
  return null
}

function _jiejiPalmstrapChoices() {
  return [
    {
      text: 'jieji_palmstrap_tiepalmstrap',
      description: 'hint_jieji_palmstrap_tiepalmstrap',
    },
    {
      text: 'jieji_palmstrap_loosepalmstrap',
      description: 'hint_jieji_palmstrap_loosepalmstrap',
    },
    {
      text: 'jieji_palmstrap_bloodpalmstrap',
      description: 'hint_jieji_palmstrap_bloodpalmstrap',
    },
  ]
}

/// 赶路劫掌革三选。debug.forceJiejiEvent('palmstrap') / forcePalmstrap 直接走这里，仍弹出三选。
async function playJiejiPalmstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_palmstrap')
  dialog.pushSelection('jiejiPalmstrap', _jiejiPalmstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiPalmstrap')
  var selected = _jiejiPalmstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiepalmstrap'
  }

  final seasonId = _jiejiPalmstrapSeasonId()
  if (selected == 'tiepalmstrap') {
    final herbNeed = _jiejiPalmstrapTiepalmstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_palmstrap_tiepalmstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiPalmstrapTiepalmstrapLife)
      dialog.pushDialog('hint_jieji_palmstrap_tiepalmstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiPalmstrapTiepalmstrapGongfaRate)
    }
  } else if (selected == 'loosepalmstrap') {
    final moneyNeed = _jiejiPalmstrapLoosepalmstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_palmstrap_loosepalmstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiPalmstrapLoosepalmstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiPalmstrapLoosepalmstrapLife)
      dialog.pushDialog('hint_jieji_palmstrap_loosepalmstrap_ok', interpolations: [kJiejiPalmstrapLoosepalmstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiPalmstrapCostLife(_jiejiPalmstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_palmstrap_bloodpalmstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiPalmstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiPalmstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_palmstrap_bloodpalmstrap_none', interpolations: [kJiejiPalmstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00000003%。出过则返回 true。
async function tryJiejiPalmstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiPalmstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastPalmstrapMove ?? -999
  if (moves - last < kJiejiPalmstrapMoveCooldown) return false

  var rate = kJiejiPalmstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastPalmstrapMove = moves
  await playJiejiPalmstrapEvent(terrain)
  return true
}
