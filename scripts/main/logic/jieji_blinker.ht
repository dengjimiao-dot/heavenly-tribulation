/// 赶路「劫障革」三选：系障 / 解障 / 血障。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革都没中时才滚。
const kJiejiBlinkerBaseRate = 0.0000015
const kJiejiBlinkerMoveCooldown = 24
const kJiejiBlinkerTieblinkerHerb = 1
const kJiejiBlinkerTieblinkerLife = 1
const kJiejiBlinkerTieblinkerGongfaRate = 0.005
const kJiejiBlinkerLooseblinkerMoney = 1
const kJiejiBlinkerLooseblinkerMoneyThunder = 1
const kJiejiBlinkerLooseblinkerHerb = 1
const kJiejiBlinkerLooseblinkerLife = 1
const kJiejiBlinkerBloodLife = 1
const kJiejiBlinkerBloodLifeBlood = 2
const kJiejiBlinkerBloodGongfaRate = 0.03
const kJiejiBlinkerBloodMoney = 2

function _jiejiBlinkerSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiBlinkerTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiBlinkerTieblinkerHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiBlinkerTieblinkerHerb
}

function _jiejiBlinkerLooseblinkerMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiBlinkerLooseblinkerMoneyThunder
  return kJiejiBlinkerLooseblinkerMoney
}

function _jiejiBlinkerBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiBlinkerBloodLifeBlood
  return kJiejiBlinkerBloodLife
}

function _jiejiBlinkerCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiBlinkerNormalizeKind(kind) {
  if (kind == 'tieblinker' || kind == 'jieji_blinker_tieblinker') return 'tieblinker'
  if (kind == 'looseblinker' || kind == 'jieji_blinker_looseblinker') return 'looseblinker'
  if (kind == 'bloodblinker' || kind == 'jieji_blinker_bloodblinker') return 'bloodblinker'
  return null
}

function _jiejiBlinkerChoices() {
  return [
    {
      text: 'jieji_blinker_tieblinker',
      description: 'hint_jieji_blinker_tieblinker',
    },
    {
      text: 'jieji_blinker_looseblinker',
      description: 'hint_jieji_blinker_looseblinker',
    },
    {
      text: 'jieji_blinker_bloodblinker',
      description: 'hint_jieji_blinker_bloodblinker',
    },
  ]
}

/// 赶路劫面革三选。debug.forceJiejiEvent('blinker') / forceBlinker 直接走这里，仍弹出三选。
async function playJiejiBlinkerEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_blinker')
  dialog.pushSelection('jiejiBlinker', _jiejiBlinkerChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiBlinker')
  var selected = _jiejiBlinkerNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieblinker'
  }

  final seasonId = _jiejiBlinkerSeasonId()
  if (selected == 'tieblinker') {
    final herbNeed = _jiejiBlinkerTieblinkerHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_blinker_tieblinker_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiBlinkerTieblinkerLife)
      dialog.pushDialog('hint_jieji_blinker_tieblinker_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiBlinkerTieblinkerGongfaRate)
    }
  } else if (selected == 'looseblinker') {
    final moneyNeed = _jiejiBlinkerLooseblinkerMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_blinker_looseblinker_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiBlinkerLooseblinkerHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiBlinkerLooseblinkerLife)
      dialog.pushDialog('hint_jieji_blinker_looseblinker_ok', interpolations: [kJiejiBlinkerLooseblinkerHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiBlinkerCostLife(_jiejiBlinkerBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_blinker_bloodblinker_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiBlinkerBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiBlinkerBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_blinker_bloodblinker_none', interpolations: [kJiejiBlinkerBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00015%。出过则返回 true。
async function tryJiejiBlinkerOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiBlinkerTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastBlinkerMove ?? -999
  if (moves - last < kJiejiBlinkerMoveCooldown) return false

  var rate = kJiejiBlinkerBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastBlinkerMove = moves
  await playJiejiBlinkerEvent(terrain)
  return true
}
