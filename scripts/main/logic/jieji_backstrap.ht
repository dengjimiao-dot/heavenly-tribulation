/// 赶路「劫背革」三选：系背 / 解背 / 血背。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革都没中时才滚。
const kJiejiBackstrapBaseRate = 0.00000004
const kJiejiBackstrapMoveCooldown = 24
const kJiejiBackstrapTiebackstrapHerb = 1
const kJiejiBackstrapTiebackstrapLife = 1
const kJiejiBackstrapTiebackstrapGongfaRate = 0.005
const kJiejiBackstrapLoosebackstrapMoney = 1
const kJiejiBackstrapLoosebackstrapMoneyThunder = 1
const kJiejiBackstrapLoosebackstrapHerb = 1
const kJiejiBackstrapLoosebackstrapLife = 1
const kJiejiBackstrapBloodLife = 1
const kJiejiBackstrapBloodLifeBlood = 2
const kJiejiBackstrapBloodGongfaRate = 0.03
const kJiejiBackstrapBloodMoney = 2

function _jiejiBackstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiBackstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiBackstrapTiebackstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiBackstrapTiebackstrapHerb
}

function _jiejiBackstrapLoosebackstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiBackstrapLoosebackstrapMoneyThunder
  return kJiejiBackstrapLoosebackstrapMoney
}

function _jiejiBackstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiBackstrapBloodLifeBlood
  return kJiejiBackstrapBloodLife
}

function _jiejiBackstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiBackstrapNormalizeKind(kind) {
  if (kind == 'tiebackstrap' || kind == 'jieji_backstrap_tiebackstrap') return 'tiebackstrap'
  if (kind == 'loosebackstrap' || kind == 'jieji_backstrap_loosebackstrap') return 'loosebackstrap'
  if (kind == 'bloodbackstrap' || kind == 'jieji_backstrap_bloodbackstrap') return 'bloodbackstrap'
  return null
}

function _jiejiBackstrapChoices() {
  return [
    {
      text: 'jieji_backstrap_tiebackstrap',
      description: 'hint_jieji_backstrap_tiebackstrap',
    },
    {
      text: 'jieji_backstrap_loosebackstrap',
      description: 'hint_jieji_backstrap_loosebackstrap',
    },
    {
      text: 'jieji_backstrap_bloodbackstrap',
      description: 'hint_jieji_backstrap_bloodbackstrap',
    },
  ]
}

/// 赶路劫背革三选。debug.forceJiejiEvent('backstrap') / forceBackstrap 直接走这里，仍弹出三选。
async function playJiejiBackstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_backstrap')
  dialog.pushSelection('jiejiBackstrap', _jiejiBackstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiBackstrap')
  var selected = _jiejiBackstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiebackstrap'
  }

  final seasonId = _jiejiBackstrapSeasonId()
  if (selected == 'tiebackstrap') {
    final herbNeed = _jiejiBackstrapTiebackstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_backstrap_tiebackstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiBackstrapTiebackstrapLife)
      dialog.pushDialog('hint_jieji_backstrap_tiebackstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiBackstrapTiebackstrapGongfaRate)
    }
  } else if (selected == 'loosebackstrap') {
    final moneyNeed = _jiejiBackstrapLoosebackstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_backstrap_loosebackstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiBackstrapLoosebackstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiBackstrapLoosebackstrapLife)
      dialog.pushDialog('hint_jieji_backstrap_loosebackstrap_ok', interpolations: [kJiejiBackstrapLoosebackstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiBackstrapCostLife(_jiejiBackstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_backstrap_bloodbackstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiBackstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiBackstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_backstrap_bloodbackstrap_none', interpolations: [kJiejiBackstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000004%。出过则返回 true。
async function tryJiejiBackstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiBackstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastBackstrapMove ?? -999
  if (moves - last < kJiejiBackstrapMoveCooldown) return false

  var rate = kJiejiBackstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastBackstrapMove = moves
  await playJiejiBackstrapEvent(terrain)
  return true
}
