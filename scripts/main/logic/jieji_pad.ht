/// 赶路「劫鞍垫」三选：垫鞍 / 抽垫 / 血垫。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁都没中时才滚。
const kJiejiPadBaseRate = 0.000015
const kJiejiPadMoveCooldown = 24
const kJiejiPadSetpadHerb = 1
const kJiejiPadSetpadLife = 1
const kJiejiPadSetpadGongfaRate = 0.006
const kJiejiPadLoosepadMoney = 1
const kJiejiPadLoosepadMoneyThunder = 1
const kJiejiPadLoosepadHerb = 1
const kJiejiPadLoosepadLife = 1
const kJiejiPadBloodLife = 1
const kJiejiPadBloodLifeBlood = 2
const kJiejiPadBloodGongfaRate = 0.04
const kJiejiPadBloodMoney = 2

function _jiejiPadSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiPadTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiPadSetpadHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiPadSetpadHerb
}

function _jiejiPadLoosepadMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiPadLoosepadMoneyThunder
  return kJiejiPadLoosepadMoney
}

function _jiejiPadBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiPadBloodLifeBlood
  return kJiejiPadBloodLife
}

function _jiejiPadCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiPadNormalizeKind(kind) {
  if (kind == 'setpad' || kind == 'jieji_pad_setpad') return 'setpad'
  if (kind == 'loosepad' || kind == 'jieji_pad_loosepad') return 'loosepad'
  if (kind == 'bloodpad' || kind == 'jieji_pad_bloodpad') return 'bloodpad'
  return null
}

function _jiejiPadChoices() {
  return [
    {
      text: 'jieji_pad_setpad',
      description: 'hint_jieji_pad_setpad',
    },
    {
      text: 'jieji_pad_loosepad',
      description: 'hint_jieji_pad_loosepad',
    },
    {
      text: 'jieji_pad_bloodpad',
      description: 'hint_jieji_pad_bloodpad',
    },
  ]
}

/// 赶路劫鞍垫三选。debug.forceJiejiEvent('pad') / forcePad 直接走这里，仍弹出三选。
async function playJiejiPadEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_pad')
  dialog.pushSelection('jiejiPad', _jiejiPadChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiPad')
  var selected = _jiejiPadNormalizeKind(picked)
  if (selected == null) {
    selected = 'setpad'
  }

  final seasonId = _jiejiPadSeasonId()
  if (selected == 'setpad') {
    final herbNeed = _jiejiPadSetpadHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_pad_setpad_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiPadSetpadLife)
      dialog.pushDialog('hint_jieji_pad_setpad_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiPadSetpadGongfaRate)
    }
  } else if (selected == 'loosepad') {
    final moneyNeed = _jiejiPadLoosepadMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_pad_loosepad_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiPadLoosepadHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiPadLoosepadLife)
      dialog.pushDialog('hint_jieji_pad_loosepad_ok', interpolations: [kJiejiPadLoosepadHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiPadCostLife(_jiejiPadBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_pad_bloodpad_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiPadBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiPadBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_pad_bloodpad_none', interpolations: [kJiejiPadBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0015%。出过则返回 true。
async function tryJiejiPadOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiPadTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastPadMove ?? -999
  if (moves - last < kJiejiPadMoveCooldown) return false

  var rate = kJiejiPadBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastPadMove = moves
  await playJiejiPadEvent(terrain)
  return true
}
