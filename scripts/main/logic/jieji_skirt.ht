/// 赶路「劫裙革」三选：系裙 / 解裙 / 血裙。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革都没中时才滚。
const kJiejiSkirtBaseRate = 0.0000002
const kJiejiSkirtMoveCooldown = 24
const kJiejiSkirtTieskirtHerb = 1
const kJiejiSkirtTieskirtLife = 1
const kJiejiSkirtTieskirtGongfaRate = 0.005
const kJiejiSkirtLooseskirtMoney = 1
const kJiejiSkirtLooseskirtMoneyThunder = 1
const kJiejiSkirtLooseskirtHerb = 1
const kJiejiSkirtLooseskirtLife = 1
const kJiejiSkirtBloodLife = 1
const kJiejiSkirtBloodLifeBlood = 2
const kJiejiSkirtBloodGongfaRate = 0.03
const kJiejiSkirtBloodMoney = 2

function _jiejiSkirtSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiSkirtTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiSkirtTieskirtHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiSkirtTieskirtHerb
}

function _jiejiSkirtLooseskirtMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiSkirtLooseskirtMoneyThunder
  return kJiejiSkirtLooseskirtMoney
}

function _jiejiSkirtBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiSkirtBloodLifeBlood
  return kJiejiSkirtBloodLife
}

function _jiejiSkirtCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiSkirtNormalizeKind(kind) {
  if (kind == 'tieskirt' || kind == 'jieji_skirt_tieskirt') return 'tieskirt'
  if (kind == 'looseskirt' || kind == 'jieji_skirt_looseskirt') return 'looseskirt'
  if (kind == 'bloodskirt' || kind == 'jieji_skirt_bloodskirt') return 'bloodskirt'
  return null
}

function _jiejiSkirtChoices() {
  return [
    {
      text: 'jieji_skirt_tieskirt',
      description: 'hint_jieji_skirt_tieskirt',
    },
    {
      text: 'jieji_skirt_looseskirt',
      description: 'hint_jieji_skirt_looseskirt',
    },
    {
      text: 'jieji_skirt_bloodskirt',
      description: 'hint_jieji_skirt_bloodskirt',
    },
  ]
}

/// 赶路劫裙革三选。debug.forceJiejiEvent('skirt') / forceSkirt 直接走这里，仍弹出三选。
async function playJiejiSkirtEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_skirt')
  dialog.pushSelection('jiejiSkirt', _jiejiSkirtChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiSkirt')
  var selected = _jiejiSkirtNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieskirt'
  }

  final seasonId = _jiejiSkirtSeasonId()
  if (selected == 'tieskirt') {
    final herbNeed = _jiejiSkirtTieskirtHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_skirt_tieskirt_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiSkirtTieskirtLife)
      dialog.pushDialog('hint_jieji_skirt_tieskirt_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiSkirtTieskirtGongfaRate)
    }
  } else if (selected == 'looseskirt') {
    final moneyNeed = _jiejiSkirtLooseskirtMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_skirt_looseskirt_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiSkirtLooseskirtHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiSkirtLooseskirtLife)
      dialog.pushDialog('hint_jieji_skirt_looseskirt_ok', interpolations: [kJiejiSkirtLooseskirtHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiSkirtCostLife(_jiejiSkirtBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_skirt_bloodskirt_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiSkirtBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiSkirtBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_skirt_bloodskirt_none', interpolations: [kJiejiSkirtBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00002%。出过则返回 true。
async function tryJiejiSkirtOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiSkirtTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastSkirtMove ?? -999
  if (moves - last < kJiejiSkirtMoveCooldown) return false

  var rate = kJiejiSkirtBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastSkirtMove = moves
  await playJiejiSkirtEvent(terrain)
  return true
}
