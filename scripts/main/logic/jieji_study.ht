/// 家「夜课」三选：温书 / 抄录 / 苦读。仅家；不替换歇息。
const kJiejiStudyCooldownDays = 1
const kJiejiStudyRecapRate = 0.7
const kJiejiStudyRecapMin = 6
const kJiejiStudyCopyHerb = 2
const kJiejiStudyCopyHerbMist = 1
const kJiejiStudyCopyBlankRate = 0.30
const kJiejiStudyCopyMoney = 40
const kJiejiStudyGrindRate = 1.3
const kJiejiStudyGrindMin = 10
const kJiejiStudyGrindLife = 2
const kJiejiStudyGrindLifeBlood = 3
const kJiejiStudyGrindGongfaRate = 0.15

function _jiejiStudySeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return 'thunder'
}

function _jiejiStudyCurrentDay() {
  if (game.timestamp == null) return null
  if (Constants.ticksPerDay == null) return null
  if (Constants.ticksPerDay <= 0) return null
  return game.timestamp ~/ Constants.ticksPerDay
}

function _jiejiStudyOnCooldown() {
  final jieji = ensureJiejiFlags()
  final day = _jiejiStudyCurrentDay()
  if (day == null) return false
  if (jieji.lastStudyDay == null) return false
  if (day - jieji.lastStudyDay < kJiejiStudyCooldownDays) return true
  return false
}

function _jiejiStudyMark() {
  final jieji = ensureJiejiFlags()
  jieji.lastStudyDay = _jiejiStudyCurrentDay()
}

/// 有赶路耗日辅助则耗 1 日；与 _jiejiRoadSpendDay 同一套 Game.updateGame。不可见则跳过。
async function _jiejiStudySpendDay() {
  if (Constants.ticksPerDay == null) return
  if (Constants.ticksPerDay <= 0) return
  await Game.updateGame(tick: Constants.ticksPerDay)
}

function _jiejiStudyCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiStudyGrantBlank() {
  final card = BattleCard(rank: 0)
  card.isCardBlank = true
  Player.acquireCard(card)
  return card
}

function _jiejiStudyBaseExp() {
  return jiejiCultivateBaseExp()
}

function _jiejiStudyRecapExp(seasonId) {
  final base = _jiejiStudyBaseExp()
  if (seasonId == 'thunder') {
    var thunderN = base
    if (thunderN < 1) thunderN = 1
    return thunderN
  }
  var n = (base * kJiejiStudyRecapRate).round()
  if (n < kJiejiStudyRecapMin) n = kJiejiStudyRecapMin
  if (n < 1) n = 1
  return n
}

function _jiejiStudyGrindExp() {
  final base = _jiejiStudyBaseExp()
  var n = (base * kJiejiStudyGrindRate).round()
  if (n < kJiejiStudyGrindMin) n = kJiejiStudyGrindMin
  if (n < 1) n = 1
  return n
}

function _jiejiStudyCopyHerbCost(seasonId) {
  if (seasonId == 'mist') return kJiejiStudyCopyHerbMist
  return kJiejiStudyCopyHerb
}

function _jiejiStudyGrindLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiStudyGrindLifeBlood
  return kJiejiStudyGrindLife
}

function _jiejiStudyNormalizeKind(kind) {
  if (kind == 'recap' || kind == 'jieji_study_recap') return 'recap'
  if (kind == 'copy' || kind == 'jieji_study_copy') return 'copy'
  if (kind == 'grind' || kind == 'jieji_study_grind') return 'grind'
  return null
}

function _jiejiStudyChoices() {
  return [
    {
      text: 'jieji_study_recap',
      description: 'hint_jieji_study_recap',
    },
    {
      text: 'jieji_study_copy',
      description: 'hint_jieji_study_copy',
    },
    {
      text: 'jieji_study_grind',
      description: 'hint_jieji_study_grind',
    },
    'cancel',
  ]
}

/// 家夜课三选。free 为 true 时不扣费、不检查冷却（debug），仍弹出三选。
/// 返回 'ok' | 'cooldown' | 'poor' | 'cancel'。
async function studyJiejiHome({ free = false }) {
  if (hero == null) return 'cancel'
  if (free != true && _jiejiStudyOnCooldown()) {
    return 'cooldown'
  }

  final seasonId = _jiejiStudySeasonId()
  final recapExp = _jiejiStudyRecapExp(seasonId)
  final grindExp = _jiejiStudyGrindExp()
  dialog.pushDialog('hint_studyJiejiHome', interpolations: [recapExp, grindExp])
  dialog.pushSelection('jiejiStudy', _jiejiStudyChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiStudy')
  var selected = null
  if (picked == null || picked == 'cancel') {
    if (free == true && picked == null) {
      selected = 'recap'
    } else {
      return 'cancel'
    }
  } else {
    selected = _jiejiStudyNormalizeKind(picked)
  }
  if (selected == null) return 'cancel'

  if (free != true) {
    if (selected == 'copy') {
      final herbNeed = _jiejiStudyCopyHerbCost(seasonId)
      final herbHave = hero.materials['herb'] ?? 0
      if (herbHave < herbNeed) {
        return 'poor'
      }
    }
  }

  if (free != true) {
    if (selected == 'copy') {
      Player.exhaust('herb', _jiejiStudyCopyHerbCost(seasonId))
    }
    if (selected == 'grind') {
      _jiejiStudyCostLife(_jiejiStudyGrindLifeCost(seasonId))
    }
    if (selected == 'recap') {
      await _jiejiStudySpendDay()
    }
    _jiejiStudyMark()
  }

  if (selected == 'copy') {
    if (random.nextDouble() < kJiejiStudyCopyBlankRate) {
      _jiejiStudyGrantBlank()
      dialog.pushDialog('hint_studyJiejiHome_copy_blank')
    } else {
      await Player.collect('money', kJiejiStudyCopyMoney, incurIncident: false)
      dialog.pushDialog('hint_studyJiejiHome_copy_money')
    }
    await dialog.execute()
  } else if (selected == 'grind') {
    final gained = grindExp
    assert(gained > 0)
    Player.gainExp(gained)
    dialog.pushDialog('hint_studyJiejiHome_grind', interpolations: [gained])
    await dialog.execute()
    await tryDropGongfaShard(rate: kJiejiStudyGrindGongfaRate)
  } else {
    final gained = recapExp
    assert(gained > 0)
    Player.gainExp(gained)
    dialog.pushDialog('hint_studyJiejiHome_recap', interpolations: [gained])
    await dialog.execute()
  }

  Game.updateUI()
  return 'ok'
}
