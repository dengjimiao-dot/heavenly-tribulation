/// 赶路「劫尺革」三选：系尺 / 解尺 / 血尺。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫尺革都没中时才滚。
const kJiejiUlnastrapBaseRate = 0.000000000003
const kJiejiUlnastrapMoveCooldown = 24
const kJiejiUlnastrapTieulnastrapHerb = 1
const kJiejiUlnastrapTieulnastrapLife = 1
const kJiejiUlnastrapTieulnastrapGongfaRate = 0.005
const kJiejiUlnastrapLooseulnastrapMoney = 1
const kJiejiUlnastrapLooseulnastrapMoneyThunder = 1
const kJiejiUlnastrapLooseulnastrapHerb = 1
const kJiejiUlnastrapLooseulnastrapLife = 1
const kJiejiUlnastrapBloodLife = 1
const kJiejiUlnastrapBloodLifeBlood = 2
const kJiejiUlnastrapBloodGongfaRate = 0.03
const kJiejiUlnastrapBloodMoney = 2

function _jiejiUlnastrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiUlnastrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiUlnastrapTieulnastrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiUlnastrapTieulnastrapHerb
}

function _jiejiUlnastrapLooseulnastrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiUlnastrapLooseulnastrapMoneyThunder
  return kJiejiUlnastrapLooseulnastrapMoney
}

function _jiejiUlnastrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiUlnastrapBloodLifeBlood
  return kJiejiUlnastrapBloodLife
}

function _jiejiUlnastrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiUlnastrapNormalizeKind(kind) {
  if (kind == 'tieulnastrap' || kind == 'jieji_ulnastrap_tieulnastrap') return 'tieulnastrap'
  if (kind == 'looseulnastrap' || kind == 'jieji_ulnastrap_looseulnastrap') return 'looseulnastrap'
  if (kind == 'bloodulnastrap' || kind == 'jieji_ulnastrap_bloodulnastrap') return 'bloodulnastrap'
  return null
}

function _jiejiUlnastrapChoices() {
  return [
    {
      text: 'jieji_ulnastrap_tieulnastrap',
      description: 'hint_jieji_ulnastrap_tieulnastrap',
    },
    {
      text: 'jieji_ulnastrap_looseulnastrap',
      description: 'hint_jieji_ulnastrap_looseulnastrap',
    },
    {
      text: 'jieji_ulnastrap_bloodulnastrap',
      description: 'hint_jieji_ulnastrap_bloodulnastrap',
    },
  ]
}

/// 赶路劫尺革三选。debug.forceJiejiEvent('ulnastrap') / forceUlnastrap 直接走这里，仍弹出三选。
async function playJiejiUlnastrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_ulnastrap')
  dialog.pushSelection('jiejiUlnastrap', _jiejiUlnastrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiUlnastrap')
  var selected = _jiejiUlnastrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieulnastrap'
  }

  final seasonId = _jiejiUlnastrapSeasonId()
  if (selected == 'tieulnastrap') {
    final herbNeed = _jiejiUlnastrapTieulnastrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_ulnastrap_tieulnastrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiUlnastrapTieulnastrapLife)
      dialog.pushDialog('hint_jieji_ulnastrap_tieulnastrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiUlnastrapTieulnastrapGongfaRate)
    }
  } else if (selected == 'looseulnastrap') {
    final moneyNeed = _jiejiUlnastrapLooseulnastrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_ulnastrap_looseulnastrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiUlnastrapLooseulnastrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiUlnastrapLooseulnastrapLife)
      dialog.pushDialog('hint_jieji_ulnastrap_looseulnastrap_ok', interpolations: [kJiejiUlnastrapLooseulnastrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiUlnastrapCostLife(_jiejiUlnastrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_ulnastrap_bloodulnastrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiUlnastrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiUlnastrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_ulnastrap_bloodulnastrap_none', interpolations: [kJiejiUlnastrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000000003%。出过则返回 true。
async function tryJiejiUlnastrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiUlnastrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastUlnastrapMove ?? -999
  if (moves - last < kJiejiUlnastrapMoveCooldown) return false

  var rate = kJiejiUlnastrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastUlnastrapMove = moves
  await playJiejiUlnastrapEvent(terrain)
  return true
}
