/// 赶路「劫肋胸革」三选：系肋胸 / 解肋胸 / 血肋胸。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革、劫肋头革、劫肋颈革、劫肋结节革、劫肋角革、劫肋沟革、劫肋脊革、劫肋体革、劫肋椎革、劫肋横突革、劫肋软骨结革、劫胸肋革、劫柄胸革、劫胸骨角革、劫剑胸革、劫肋胸革都没中时才滚。
const kJiejiCostosternalstrapBaseRate = 0.00000000000000008
const kJiejiCostosternalstrapMoveCooldown = 24
const kJiejiCostosternalstrapTiecostosternalstrapHerb = 1
const kJiejiCostosternalstrapTiecostosternalstrapLife = 1
const kJiejiCostosternalstrapTiecostosternalstrapGongfaRate = 0.005
const kJiejiCostosternalstrapLoosecostosternalstrapMoney = 1
const kJiejiCostosternalstrapLoosecostosternalstrapMoneyThunder = 1
const kJiejiCostosternalstrapLoosecostosternalstrapHerb = 1
const kJiejiCostosternalstrapLoosecostosternalstrapLife = 1
const kJiejiCostosternalstrapBloodLife = 1
const kJiejiCostosternalstrapBloodLifeBlood = 2
const kJiejiCostosternalstrapBloodGongfaRate = 0.03
const kJiejiCostosternalstrapBloodMoney = 2

function _jiejiCostosternalstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiCostosternalstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiCostosternalstrapTiecostosternalstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiCostosternalstrapTiecostosternalstrapHerb
}

function _jiejiCostosternalstrapLoosecostosternalstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiCostosternalstrapLoosecostosternalstrapMoneyThunder
  return kJiejiCostosternalstrapLoosecostosternalstrapMoney
}

function _jiejiCostosternalstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiCostosternalstrapBloodLifeBlood
  return kJiejiCostosternalstrapBloodLife
}

function _jiejiCostosternalstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiCostosternalstrapNormalizeKind(kind) {
  if (kind == 'tiecostosternalstrap' || kind == 'jieji_costosternalstrap_tiecostosternalstrap') return 'tiecostosternalstrap'
  if (kind == 'loosecostosternalstrap' || kind == 'jieji_costosternalstrap_loosecostosternalstrap') return 'loosecostosternalstrap'
  if (kind == 'bloodcostosternalstrap' || kind == 'jieji_costosternalstrap_bloodcostosternalstrap') return 'bloodcostosternalstrap'
  return null
}

function _jiejiCostosternalstrapChoices() {
  return [
    {
      text: 'jieji_costosternalstrap_tiecostosternalstrap',
      description: 'hint_jieji_costosternalstrap_tiecostosternalstrap',
    },
    {
      text: 'jieji_costosternalstrap_loosecostosternalstrap',
      description: 'hint_jieji_costosternalstrap_loosecostosternalstrap',
    },
    {
      text: 'jieji_costosternalstrap_bloodcostosternalstrap',
      description: 'hint_jieji_costosternalstrap_bloodcostosternalstrap',
    },
  ]
}

/// 赶路劫肋胸革三选。debug.forceJiejiEvent('costosternalstrap') / forceCostosternalstrap 直接走这里，仍弹出三选。
async function playJiejiCostosternalstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_costosternalstrap')
  dialog.pushSelection('jiejiCostosternalstrap', _jiejiCostosternalstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiCostosternalstrap')
  var selected = _jiejiCostosternalstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiecostosternalstrap'
  }

  final seasonId = _jiejiCostosternalstrapSeasonId()
  if (selected == 'tiecostosternalstrap') {
    final herbNeed = _jiejiCostosternalstrapTiecostosternalstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_costosternalstrap_tiecostosternalstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiCostosternalstrapTiecostosternalstrapLife)
      dialog.pushDialog('hint_jieji_costosternalstrap_tiecostosternalstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiCostosternalstrapTiecostosternalstrapGongfaRate)
    }
  } else if (selected == 'loosecostosternalstrap') {
    final moneyNeed = _jiejiCostosternalstrapLoosecostosternalstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_costosternalstrap_loosecostosternalstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiCostosternalstrapLoosecostosternalstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiCostosternalstrapLoosecostosternalstrapLife)
      dialog.pushDialog('hint_jieji_costosternalstrap_loosecostosternalstrap_ok', interpolations: [kJiejiCostosternalstrapLoosecostosternalstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiCostosternalstrapCostLife(_jiejiCostosternalstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_costosternalstrap_bloodcostosternalstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiCostosternalstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiCostosternalstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_costosternalstrap_bloodcostosternalstrap_none', interpolations: [kJiejiCostosternalstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000000008%。出过则返回 true。
async function tryJiejiCostosternalstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiCostosternalstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastCostosternalstrapMove ?? -999
  if (moves - last < kJiejiCostosternalstrapMoveCooldown) return false

  var rate = kJiejiCostosternalstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastCostosternalstrapMove = moves
  await playJiejiCostosternalstrapEvent(terrain)
  return true
}
