/// 赶路「劫扣革」三选：系扣 / 解扣 / 血扣。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革都没中时才滚。
const kJiejiBilletBaseRate = 0.00000012
const kJiejiBilletMoveCooldown = 24
const kJiejiBilletTiebilletHerb = 1
const kJiejiBilletTiebilletLife = 1
const kJiejiBilletTiebilletGongfaRate = 0.005
const kJiejiBilletLoosebilletMoney = 1
const kJiejiBilletLoosebilletMoneyThunder = 1
const kJiejiBilletLoosebilletHerb = 1
const kJiejiBilletLoosebilletLife = 1
const kJiejiBilletBloodLife = 1
const kJiejiBilletBloodLifeBlood = 2
const kJiejiBilletBloodGongfaRate = 0.03
const kJiejiBilletBloodMoney = 2

function _jiejiBilletSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiBilletTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiBilletTiebilletHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiBilletTiebilletHerb
}

function _jiejiBilletLoosebilletMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiBilletLoosebilletMoneyThunder
  return kJiejiBilletLoosebilletMoney
}

function _jiejiBilletBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiBilletBloodLifeBlood
  return kJiejiBilletBloodLife
}

function _jiejiBilletCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiBilletNormalizeKind(kind) {
  if (kind == 'tiebillet' || kind == 'jieji_billet_tiebillet') return 'tiebillet'
  if (kind == 'loosebillet' || kind == 'jieji_billet_loosebillet') return 'loosebillet'
  if (kind == 'bloodbillet' || kind == 'jieji_billet_bloodbillet') return 'bloodbillet'
  return null
}

function _jiejiBilletChoices() {
  return [
    {
      text: 'jieji_billet_tiebillet',
      description: 'hint_jieji_billet_tiebillet',
    },
    {
      text: 'jieji_billet_loosebillet',
      description: 'hint_jieji_billet_loosebillet',
    },
    {
      text: 'jieji_billet_bloodbillet',
      description: 'hint_jieji_billet_bloodbillet',
    },
  ]
}

/// 赶路劫扣革三选。debug.forceJiejiEvent('billet') / forceBillet 直接走这里，仍弹出三选。
async function playJiejiBilletEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_billet')
  dialog.pushSelection('jiejiBillet', _jiejiBilletChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiBillet')
  var selected = _jiejiBilletNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiebillet'
  }

  final seasonId = _jiejiBilletSeasonId()
  if (selected == 'tiebillet') {
    final herbNeed = _jiejiBilletTiebilletHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_billet_tiebillet_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiBilletTiebilletLife)
      dialog.pushDialog('hint_jieji_billet_tiebillet_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiBilletTiebilletGongfaRate)
    }
  } else if (selected == 'loosebillet') {
    final moneyNeed = _jiejiBilletLoosebilletMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_billet_loosebillet_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiBilletLoosebilletHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiBilletLoosebilletLife)
      dialog.pushDialog('hint_jieji_billet_loosebillet_ok', interpolations: [kJiejiBilletLoosebilletHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiBilletCostLife(_jiejiBilletBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_billet_bloodbillet_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiBilletBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiBilletBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_billet_bloodbillet_none', interpolations: [kJiejiBilletBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000012%。出过则返回 true。
async function tryJiejiBilletOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiBilletTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastBilletMove ?? -999
  if (moves - last < kJiejiBilletMoveCooldown) return false

  var rate = kJiejiBilletBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastBilletMove = moves
  await playJiejiBilletEvent(terrain)
  return true
}
