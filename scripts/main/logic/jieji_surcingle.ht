/// 赶路「劫肚带」三选：系带 / 解带 / 血带。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫都没中时才滚。
const kJiejiSurcingleBaseRate = 0.000012
const kJiejiSurcingleMoveCooldown = 24
const kJiejiSurcingleTiesurcingleHerb = 1
const kJiejiSurcingleTiesurcingleLife = 1
const kJiejiSurcingleTiesurcingleGongfaRate = 0.006
const kJiejiSurcingleLoosesurcingleMoney = 1
const kJiejiSurcingleLoosesurcingleMoneyThunder = 1
const kJiejiSurcingleLoosesurcingleHerb = 1
const kJiejiSurcingleLoosesurcingleLife = 1
const kJiejiSurcingleBloodLife = 1
const kJiejiSurcingleBloodLifeBlood = 2
const kJiejiSurcingleBloodGongfaRate = 0.04
const kJiejiSurcingleBloodMoney = 2

function _jiejiSurcingleSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiSurcingleTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiSurcingleTiesurcingleHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiSurcingleTiesurcingleHerb
}

function _jiejiSurcingleLoosesurcingleMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiSurcingleLoosesurcingleMoneyThunder
  return kJiejiSurcingleLoosesurcingleMoney
}

function _jiejiSurcingleBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiSurcingleBloodLifeBlood
  return kJiejiSurcingleBloodLife
}

function _jiejiSurcingleCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiSurcingleNormalizeKind(kind) {
  if (kind == 'tiesurcingle' || kind == 'jieji_surcingle_tiesurcingle') return 'tiesurcingle'
  if (kind == 'loosesurcingle' || kind == 'jieji_surcingle_loosesurcingle') return 'loosesurcingle'
  if (kind == 'bloodsurcingle' || kind == 'jieji_surcingle_bloodsurcingle') return 'bloodsurcingle'
  return null
}

function _jiejiSurcingleChoices() {
  return [
    {
      text: 'jieji_surcingle_tiesurcingle',
      description: 'hint_jieji_surcingle_tiesurcingle',
    },
    {
      text: 'jieji_surcingle_loosesurcingle',
      description: 'hint_jieji_surcingle_loosesurcingle',
    },
    {
      text: 'jieji_surcingle_bloodsurcingle',
      description: 'hint_jieji_surcingle_bloodsurcingle',
    },
  ]
}

/// 赶路劫肚带三选。debug.forceJiejiEvent('surcingle') / forceSurcingle 直接走这里，仍弹出三选。
async function playJiejiSurcingleEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_surcingle')
  dialog.pushSelection('jiejiSurcingle', _jiejiSurcingleChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiSurcingle')
  var selected = _jiejiSurcingleNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiesurcingle'
  }

  final seasonId = _jiejiSurcingleSeasonId()
  if (selected == 'tiesurcingle') {
    final herbNeed = _jiejiSurcingleTiesurcingleHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_surcingle_tiesurcingle_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiSurcingleTiesurcingleLife)
      dialog.pushDialog('hint_jieji_surcingle_tiesurcingle_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiSurcingleTiesurcingleGongfaRate)
    }
  } else if (selected == 'loosesurcingle') {
    final moneyNeed = _jiejiSurcingleLoosesurcingleMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_surcingle_loosesurcingle_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiSurcingleLoosesurcingleHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiSurcingleLoosesurcingleLife)
      dialog.pushDialog('hint_jieji_surcingle_loosesurcingle_ok', interpolations: [kJiejiSurcingleLoosesurcingleHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiSurcingleCostLife(_jiejiSurcingleBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_surcingle_bloodsurcingle_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiSurcingleBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiSurcingleBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_surcingle_bloodsurcingle_none', interpolations: [kJiejiSurcingleBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0012%。出过则返回 true。
async function tryJiejiSurcingleOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiSurcingleTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastSurcingleMove ?? -999
  if (moves - last < kJiejiSurcingleMoveCooldown) return false

  var rate = kJiejiSurcingleBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastSurcingleMove = moves
  await playJiejiSurcingleEvent(terrain)
  return true
}
