/// 赶路「劫肱革」三选：系肱 / 解肱 / 血肱。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革都没中时才滚。
const kJiejiUpperarmstrapBaseRate = 0.00000000001
const kJiejiUpperarmstrapMoveCooldown = 24
const kJiejiUpperarmstrapTieupperarmstrapHerb = 1
const kJiejiUpperarmstrapTieupperarmstrapLife = 1
const kJiejiUpperarmstrapTieupperarmstrapGongfaRate = 0.005
const kJiejiUpperarmstrapLooseupperarmstrapMoney = 1
const kJiejiUpperarmstrapLooseupperarmstrapMoneyThunder = 1
const kJiejiUpperarmstrapLooseupperarmstrapHerb = 1
const kJiejiUpperarmstrapLooseupperarmstrapLife = 1
const kJiejiUpperarmstrapBloodLife = 1
const kJiejiUpperarmstrapBloodLifeBlood = 2
const kJiejiUpperarmstrapBloodGongfaRate = 0.03
const kJiejiUpperarmstrapBloodMoney = 2

function _jiejiUpperarmstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiUpperarmstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiUpperarmstrapTieupperarmstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiUpperarmstrapTieupperarmstrapHerb
}

function _jiejiUpperarmstrapLooseupperarmstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiUpperarmstrapLooseupperarmstrapMoneyThunder
  return kJiejiUpperarmstrapLooseupperarmstrapMoney
}

function _jiejiUpperarmstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiUpperarmstrapBloodLifeBlood
  return kJiejiUpperarmstrapBloodLife
}

function _jiejiUpperarmstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiUpperarmstrapNormalizeKind(kind) {
  if (kind == 'tieupperarmstrap' || kind == 'jieji_upperarmstrap_tieupperarmstrap') return 'tieupperarmstrap'
  if (kind == 'looseupperarmstrap' || kind == 'jieji_upperarmstrap_looseupperarmstrap') return 'looseupperarmstrap'
  if (kind == 'bloodupperarmstrap' || kind == 'jieji_upperarmstrap_bloodupperarmstrap') return 'bloodupperarmstrap'
  return null
}

function _jiejiUpperarmstrapChoices() {
  return [
    {
      text: 'jieji_upperarmstrap_tieupperarmstrap',
      description: 'hint_jieji_upperarmstrap_tieupperarmstrap',
    },
    {
      text: 'jieji_upperarmstrap_looseupperarmstrap',
      description: 'hint_jieji_upperarmstrap_looseupperarmstrap',
    },
    {
      text: 'jieji_upperarmstrap_bloodupperarmstrap',
      description: 'hint_jieji_upperarmstrap_bloodupperarmstrap',
    },
  ]
}

/// 赶路劫肱革三选。debug.forceJiejiEvent('upperarmstrap') / forceUpperarmstrap 直接走这里，仍弹出三选。
async function playJiejiUpperarmstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_upperarmstrap')
  dialog.pushSelection('jiejiUpperarmstrap', _jiejiUpperarmstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiUpperarmstrap')
  var selected = _jiejiUpperarmstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieupperarmstrap'
  }

  final seasonId = _jiejiUpperarmstrapSeasonId()
  if (selected == 'tieupperarmstrap') {
    final herbNeed = _jiejiUpperarmstrapTieupperarmstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_upperarmstrap_tieupperarmstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiUpperarmstrapTieupperarmstrapLife)
      dialog.pushDialog('hint_jieji_upperarmstrap_tieupperarmstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiUpperarmstrapTieupperarmstrapGongfaRate)
    }
  } else if (selected == 'looseupperarmstrap') {
    final moneyNeed = _jiejiUpperarmstrapLooseupperarmstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_upperarmstrap_looseupperarmstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiUpperarmstrapLooseupperarmstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiUpperarmstrapLooseupperarmstrapLife)
      dialog.pushDialog('hint_jieji_upperarmstrap_looseupperarmstrap_ok', interpolations: [kJiejiUpperarmstrapLooseupperarmstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiUpperarmstrapCostLife(_jiejiUpperarmstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_upperarmstrap_bloodupperarmstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiUpperarmstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiUpperarmstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_upperarmstrap_bloodupperarmstrap_none', interpolations: [kJiejiUpperarmstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000001%。出过则返回 true。
async function tryJiejiUpperarmstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiUpperarmstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastUpperarmstrapMove ?? -999
  if (moves - last < kJiejiUpperarmstrapMoveCooldown) return false

  var rate = kJiejiUpperarmstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastUpperarmstrapMove = moves
  await playJiejiUpperarmstrapEvent(terrain)
  return true
}
