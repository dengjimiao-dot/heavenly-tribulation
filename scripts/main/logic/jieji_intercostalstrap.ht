/// 赶路「劫肋间革」三选：系间 / 解间 / 血间。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革都没中时才滚。
const kJiejiIntercostalstrapBaseRate = 0.00000000000002
const kJiejiIntercostalstrapMoveCooldown = 24
const kJiejiIntercostalstrapTieintercostalstrapHerb = 1
const kJiejiIntercostalstrapTieintercostalstrapLife = 1
const kJiejiIntercostalstrapTieintercostalstrapGongfaRate = 0.005
const kJiejiIntercostalstrapLooseintercostalstrapMoney = 1
const kJiejiIntercostalstrapLooseintercostalstrapMoneyThunder = 1
const kJiejiIntercostalstrapLooseintercostalstrapHerb = 1
const kJiejiIntercostalstrapLooseintercostalstrapLife = 1
const kJiejiIntercostalstrapBloodLife = 1
const kJiejiIntercostalstrapBloodLifeBlood = 2
const kJiejiIntercostalstrapBloodGongfaRate = 0.03
const kJiejiIntercostalstrapBloodMoney = 2

function _jiejiIntercostalstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiIntercostalstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiIntercostalstrapTieintercostalstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiIntercostalstrapTieintercostalstrapHerb
}

function _jiejiIntercostalstrapLooseintercostalstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiIntercostalstrapLooseintercostalstrapMoneyThunder
  return kJiejiIntercostalstrapLooseintercostalstrapMoney
}

function _jiejiIntercostalstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiIntercostalstrapBloodLifeBlood
  return kJiejiIntercostalstrapBloodLife
}

function _jiejiIntercostalstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiIntercostalstrapNormalizeKind(kind) {
  if (kind == 'tieintercostalstrap' || kind == 'jieji_intercostalstrap_tieintercostalstrap') return 'tieintercostalstrap'
  if (kind == 'looseintercostalstrap' || kind == 'jieji_intercostalstrap_looseintercostalstrap') return 'looseintercostalstrap'
  if (kind == 'bloodintercostalstrap' || kind == 'jieji_intercostalstrap_bloodintercostalstrap') return 'bloodintercostalstrap'
  return null
}

function _jiejiIntercostalstrapChoices() {
  return [
    {
      text: 'jieji_intercostalstrap_tieintercostalstrap',
      description: 'hint_jieji_intercostalstrap_tieintercostalstrap',
    },
    {
      text: 'jieji_intercostalstrap_looseintercostalstrap',
      description: 'hint_jieji_intercostalstrap_looseintercostalstrap',
    },
    {
      text: 'jieji_intercostalstrap_bloodintercostalstrap',
      description: 'hint_jieji_intercostalstrap_bloodintercostalstrap',
    },
  ]
}

/// 赶路劫肋间革三选。debug.forceJiejiEvent('intercostalstrap') / forceIntercostalstrap 直接走这里，仍弹出三选。
async function playJiejiIntercostalstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_intercostalstrap')
  dialog.pushSelection('jiejiIntercostalstrap', _jiejiIntercostalstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiIntercostalstrap')
  var selected = _jiejiIntercostalstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieintercostalstrap'
  }

  final seasonId = _jiejiIntercostalstrapSeasonId()
  if (selected == 'tieintercostalstrap') {
    final herbNeed = _jiejiIntercostalstrapTieintercostalstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_intercostalstrap_tieintercostalstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiIntercostalstrapTieintercostalstrapLife)
      dialog.pushDialog('hint_jieji_intercostalstrap_tieintercostalstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiIntercostalstrapTieintercostalstrapGongfaRate)
    }
  } else if (selected == 'looseintercostalstrap') {
    final moneyNeed = _jiejiIntercostalstrapLooseintercostalstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_intercostalstrap_looseintercostalstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiIntercostalstrapLooseintercostalstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiIntercostalstrapLooseintercostalstrapLife)
      dialog.pushDialog('hint_jieji_intercostalstrap_looseintercostalstrap_ok', interpolations: [kJiejiIntercostalstrapLooseintercostalstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiIntercostalstrapCostLife(_jiejiIntercostalstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_intercostalstrap_bloodintercostalstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiIntercostalstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiIntercostalstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_intercostalstrap_bloodintercostalstrap_none', interpolations: [kJiejiIntercostalstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000002%。出过则返回 true。
async function tryJiejiIntercostalstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiIntercostalstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastIntercostalstrapMove ?? -999
  if (moves - last < kJiejiIntercostalstrapMoveCooldown) return false

  var rate = kJiejiIntercostalstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastIntercostalstrapMove = moves
  await playJiejiIntercostalstrapEvent(terrain)
  return true
}
