/// 赶路「劫翼革」三选：系翼 / 解翼 / 血翼。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革都没中时才滚。
const kJiejiFenderBaseRate = 0.00000015
const kJiejiFenderMoveCooldown = 24
const kJiejiFenderTiefenderHerb = 1
const kJiejiFenderTiefenderLife = 1
const kJiejiFenderTiefenderGongfaRate = 0.005
const kJiejiFenderLoosefenderMoney = 1
const kJiejiFenderLoosefenderMoneyThunder = 1
const kJiejiFenderLoosefenderHerb = 1
const kJiejiFenderLoosefenderLife = 1
const kJiejiFenderBloodLife = 1
const kJiejiFenderBloodLifeBlood = 2
const kJiejiFenderBloodGongfaRate = 0.03
const kJiejiFenderBloodMoney = 2

function _jiejiFenderSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiFenderTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiFenderTiefenderHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiFenderTiefenderHerb
}

function _jiejiFenderLoosefenderMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiFenderLoosefenderMoneyThunder
  return kJiejiFenderLoosefenderMoney
}

function _jiejiFenderBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiFenderBloodLifeBlood
  return kJiejiFenderBloodLife
}

function _jiejiFenderCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiFenderNormalizeKind(kind) {
  if (kind == 'tiefender' || kind == 'jieji_fender_tiefender') return 'tiefender'
  if (kind == 'loosefender' || kind == 'jieji_fender_loosefender') return 'loosefender'
  if (kind == 'bloodfender' || kind == 'jieji_fender_bloodfender') return 'bloodfender'
  return null
}

function _jiejiFenderChoices() {
  return [
    {
      text: 'jieji_fender_tiefender',
      description: 'hint_jieji_fender_tiefender',
    },
    {
      text: 'jieji_fender_loosefender',
      description: 'hint_jieji_fender_loosefender',
    },
    {
      text: 'jieji_fender_bloodfender',
      description: 'hint_jieji_fender_bloodfender',
    },
  ]
}

/// 赶路劫翼革三选。debug.forceJiejiEvent('fender') / forceFender 直接走这里，仍弹出三选。
async function playJiejiFenderEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_fender')
  dialog.pushSelection('jiejiFender', _jiejiFenderChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiFender')
  var selected = _jiejiFenderNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiefender'
  }

  final seasonId = _jiejiFenderSeasonId()
  if (selected == 'tiefender') {
    final herbNeed = _jiejiFenderTiefenderHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_fender_tiefender_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiFenderTiefenderLife)
      dialog.pushDialog('hint_jieji_fender_tiefender_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiFenderTiefenderGongfaRate)
    }
  } else if (selected == 'loosefender') {
    final moneyNeed = _jiejiFenderLoosefenderMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_fender_loosefender_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiFenderLoosefenderHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiFenderLoosefenderLife)
      dialog.pushDialog('hint_jieji_fender_loosefender_ok', interpolations: [kJiejiFenderLoosefenderHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiFenderCostLife(_jiejiFenderBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_fender_bloodfender_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiFenderBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiFenderBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_fender_bloodfender_none', interpolations: [kJiejiFenderBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000015%。出过则返回 true。
async function tryJiejiFenderOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiFenderTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastFenderMove ?? -999
  if (moves - last < kJiejiFenderMoveCooldown) return false

  var rate = kJiejiFenderBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastFenderMove = moves
  await playJiejiFenderEvent(terrain)
  return true
}
