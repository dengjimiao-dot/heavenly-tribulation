/// 赶路「劫膝革」三选：系膝 / 解膝 / 血膝。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革都没中时才滚。
const kJiejiKneestrapBaseRate = 0.000000008
const kJiejiKneestrapMoveCooldown = 24
const kJiejiKneestrapTiekneestrapHerb = 1
const kJiejiKneestrapTiekneestrapLife = 1
const kJiejiKneestrapTiekneestrapGongfaRate = 0.005
const kJiejiKneestrapLoosekneestrapMoney = 1
const kJiejiKneestrapLoosekneestrapMoneyThunder = 1
const kJiejiKneestrapLoosekneestrapHerb = 1
const kJiejiKneestrapLoosekneestrapLife = 1
const kJiejiKneestrapBloodLife = 1
const kJiejiKneestrapBloodLifeBlood = 2
const kJiejiKneestrapBloodGongfaRate = 0.03
const kJiejiKneestrapBloodMoney = 2

function _jiejiKneestrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiKneestrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiKneestrapTiekneestrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiKneestrapTiekneestrapHerb
}

function _jiejiKneestrapLoosekneestrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiKneestrapLoosekneestrapMoneyThunder
  return kJiejiKneestrapLoosekneestrapMoney
}

function _jiejiKneestrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiKneestrapBloodLifeBlood
  return kJiejiKneestrapBloodLife
}

function _jiejiKneestrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiKneestrapNormalizeKind(kind) {
  if (kind == 'tiekneestrap' || kind == 'jieji_kneestrap_tiekneestrap') return 'tiekneestrap'
  if (kind == 'loosekneestrap' || kind == 'jieji_kneestrap_loosekneestrap') return 'loosekneestrap'
  if (kind == 'bloodkneestrap' || kind == 'jieji_kneestrap_bloodkneestrap') return 'bloodkneestrap'
  return null
}

function _jiejiKneestrapChoices() {
  return [
    {
      text: 'jieji_kneestrap_tiekneestrap',
      description: 'hint_jieji_kneestrap_tiekneestrap',
    },
    {
      text: 'jieji_kneestrap_loosekneestrap',
      description: 'hint_jieji_kneestrap_loosekneestrap',
    },
    {
      text: 'jieji_kneestrap_bloodkneestrap',
      description: 'hint_jieji_kneestrap_bloodkneestrap',
    },
  ]
}

/// 赶路劫膝革三选。debug.forceJiejiEvent('kneestrap') / forceKneestrap 直接走这里，仍弹出三选。
async function playJiejiKneestrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_kneestrap')
  dialog.pushSelection('jiejiKneestrap', _jiejiKneestrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiKneestrap')
  var selected = _jiejiKneestrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiekneestrap'
  }

  final seasonId = _jiejiKneestrapSeasonId()
  if (selected == 'tiekneestrap') {
    final herbNeed = _jiejiKneestrapTiekneestrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_kneestrap_tiekneestrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiKneestrapTiekneestrapLife)
      dialog.pushDialog('hint_jieji_kneestrap_tiekneestrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiKneestrapTiekneestrapGongfaRate)
    }
  } else if (selected == 'loosekneestrap') {
    final moneyNeed = _jiejiKneestrapLoosekneestrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_kneestrap_loosekneestrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiKneestrapLoosekneestrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiKneestrapLoosekneestrapLife)
      dialog.pushDialog('hint_jieji_kneestrap_loosekneestrap_ok', interpolations: [kJiejiKneestrapLoosekneestrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiKneestrapCostLife(_jiejiKneestrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_kneestrap_bloodkneestrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiKneestrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiKneestrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_kneestrap_bloodkneestrap_none', interpolations: [kJiejiKneestrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000008%。出过则返回 true。
async function tryJiejiKneestrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiKneestrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastKneestrapMove ?? -999
  if (moves - last < kJiejiKneestrapMoveCooldown) return false

  var rate = kJiejiKneestrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastKneestrapMove = moves
  await playJiejiKneestrapEvent(terrain)
  return true
}
