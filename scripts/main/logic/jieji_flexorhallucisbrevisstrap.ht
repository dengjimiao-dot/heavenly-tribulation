const kJiejiFlexorhallucisbrevisstrapBaseRate = 0.00000000000000008
const kJiejiFlexorhallucisbrevisstrapMoveCooldown = 24
const kJiejiFlexorhallucisbrevisstrapTieflexorhallucisbrevisstrapHerb = 1
const kJiejiFlexorhallucisbrevisstrapTieflexorhallucisbrevisstrapLife = 1
const kJiejiFlexorhallucisbrevisstrapTieflexorhallucisbrevisstrapGongfaRate = 0.005
const kJiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapMoney = 1
const kJiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapMoneyThunder = 1
const kJiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapHerb = 1
const kJiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapLife = 1
const kJiejiFlexorhallucisbrevisstrapBloodLife = 1
const kJiejiFlexorhallucisbrevisstrapBloodLifeBlood = 2
const kJiejiFlexorhallucisbrevisstrapBloodGongfaRate = 0.03
const kJiejiFlexorhallucisbrevisstrapBloodMoney = 2

function _jiejiFlexorhallucisbrevisstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiFlexorhallucisbrevisstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiFlexorhallucisbrevisstrapTieflexorhallucisbrevisstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiFlexorhallucisbrevisstrapTieflexorhallucisbrevisstrapHerb
}

function _jiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapMoneyThunder
  return kJiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapMoney
}

function _jiejiFlexorhallucisbrevisstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiFlexorhallucisbrevisstrapBloodLifeBlood
  return kJiejiFlexorhallucisbrevisstrapBloodLife
}

function _jiejiFlexorhallucisbrevisstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiFlexorhallucisbrevisstrapNormalizeKind(kind) {
  if (kind == 'tieflexorhallucisbrevisstrap' || kind == 'jieji_flexorhallucisbrevisstrap_tieflexorhallucisbrevisstrap') return 'tieflexorhallucisbrevisstrap'
  if (kind == 'looseflexorhallucisbrevisstrap' || kind == 'jieji_flexorhallucisbrevisstrap_looseflexorhallucisbrevisstrap') return 'looseflexorhallucisbrevisstrap'
  if (kind == 'bloodflexorhallucisbrevisstrap' || kind == 'jieji_flexorhallucisbrevisstrap_bloodflexorhallucisbrevisstrap') return 'bloodflexorhallucisbrevisstrap'
  return null
}

function _jiejiFlexorhallucisbrevisstrapChoices() {
  return [
    {
      text: 'jieji_flexorhallucisbrevisstrap_tieflexorhallucisbrevisstrap',
      description: 'hint_jieji_flexorhallucisbrevisstrap_tieflexorhallucisbrevisstrap',
    },
    {
      text: 'jieji_flexorhallucisbrevisstrap_looseflexorhallucisbrevisstrap',
      description: 'hint_jieji_flexorhallucisbrevisstrap_looseflexorhallucisbrevisstrap',
    },
    {
      text: 'jieji_flexorhallucisbrevisstrap_bloodflexorhallucisbrevisstrap',
      description: 'hint_jieji_flexorhallucisbrevisstrap_bloodflexorhallucisbrevisstrap',
    },
  ]
}

/// 赶路劫踇短屈肌革三选。debug.forceJiejiEvent('flexorhallucisbrevisstrap') / forceFlexorhallucisbrevisstrap 直接走这里，仍弹出三选。
async function playJiejiFlexorhallucisbrevisstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_flexorhallucisbrevisstrap')
  dialog.pushSelection('jiejiFlexorhallucisbrevisstrap', _jiejiFlexorhallucisbrevisstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiFlexorhallucisbrevisstrap')
  var selected = _jiejiFlexorhallucisbrevisstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieflexorhallucisbrevisstrap'
  }

  final seasonId = _jiejiFlexorhallucisbrevisstrapSeasonId()
  if (selected == 'tieflexorhallucisbrevisstrap') {
    final herbNeed = _jiejiFlexorhallucisbrevisstrapTieflexorhallucisbrevisstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_flexorhallucisbrevisstrap_tieflexorhallucisbrevisstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiFlexorhallucisbrevisstrapTieflexorhallucisbrevisstrapLife)
      dialog.pushDialog('hint_jieji_flexorhallucisbrevisstrap_tieflexorhallucisbrevisstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiFlexorhallucisbrevisstrapTieflexorhallucisbrevisstrapGongfaRate)
    }
  } else if (selected == 'looseflexorhallucisbrevisstrap') {
    final moneyNeed = _jiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_flexorhallucisbrevisstrap_looseflexorhallucisbrevisstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapLife)
      dialog.pushDialog('hint_jieji_flexorhallucisbrevisstrap_looseflexorhallucisbrevisstrap_ok', interpolations: [kJiejiFlexorhallucisbrevisstrapLooseflexorhallucisbrevisstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiFlexorhallucisbrevisstrapCostLife(_jiejiFlexorhallucisbrevisstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_flexorhallucisbrevisstrap_bloodflexorhallucisbrevisstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiFlexorhallucisbrevisstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiFlexorhallucisbrevisstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_flexorhallucisbrevisstrap_bloodflexorhallucisbrevisstrap_none', interpolations: [kJiejiFlexorhallucisbrevisstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000000008%。出过则返回 true。
async function tryJiejiFlexorhallucisbrevisstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiFlexorhallucisbrevisstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastFlexorhallucisbrevisstrapMove ?? -999
  if (moves - last < kJiejiFlexorhallucisbrevisstrapMoveCooldown) return false

  var rate = kJiejiFlexorhallucisbrevisstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastFlexorhallucisbrevisstrapMove = moves
  await playJiejiFlexorhallucisbrevisstrapEvent(terrain)
  return true
}
