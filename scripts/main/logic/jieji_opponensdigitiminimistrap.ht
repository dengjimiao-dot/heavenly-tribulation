/// 赶路「劫小指对掌肌革」三选：系小指对掌肌 / 解小指对掌肌 / 血小指对掌肌。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革、劫肋头革、劫肋颈革、劫肋结节革、劫肋角革、劫肋沟革、劫肋脊革、劫肋体革、劫肋椎革、劫肋横突革、劫肋软骨结革、劫胸肋革、劫柄胸革、劫胸骨角革、劫剑胸革、劫肋胸革、劫颈静脉切迹革、劫锁骨切迹革、劫肋软骨弓革、劫肋下角革、劫胸骨体革、劫肋剑突革、劫锁间韧带革、劫肋软骨结合革、劫胸骨肌革、劫胸大肌革、劫前锯肌革、劫锁骨下肌革、劫背阔肌革、劫斜方肌革、劫三角肌革、劫冈下肌革、劫大圆肌革、劫小圆肌革、劫冈上肌革、劫肩胛下肌革、劫喙肱肌革、劫肱肌革、劫肱三头肌革、劫肘肌革、劫肱桡肌革、劫指伸肌革、劫尺侧腕屈肌革、劫掌长肌革、劫桡侧腕屈肌革、劫尺侧腕伸肌革、劫桡侧腕长伸肌革、劫桡侧腕短伸肌革、劫拇长展肌革、劫拇短伸肌革、劫拇长伸肌革、劫拇短展肌革、劫拇长屈肌革、劫拇短屈肌革、劫拇对掌肌革、劫拇收肌革、劫蚓状肌革、劫骨间掌侧肌革、劫第一骨间背侧肌革、劫第二骨间背侧肌革、劫第三骨间背侧肌革、劫第四骨间背侧肌革、劫小指展肌革、劫小指短屈肌革、劫小指对掌肌革都没中时才滚。
const kJiejiOpponensdigitiminimistrapBaseRate = 0.00000000000000008
const kJiejiOpponensdigitiminimistrapMoveCooldown = 24
const kJiejiOpponensdigitiminimistrapTieopponensdigitiminimistrapHerb = 1
const kJiejiOpponensdigitiminimistrapTieopponensdigitiminimistrapLife = 1
const kJiejiOpponensdigitiminimistrapTieopponensdigitiminimistrapGongfaRate = 0.005
const kJiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapMoney = 1
const kJiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapMoneyThunder = 1
const kJiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapHerb = 1
const kJiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapLife = 1
const kJiejiOpponensdigitiminimistrapBloodLife = 1
const kJiejiOpponensdigitiminimistrapBloodLifeBlood = 2
const kJiejiOpponensdigitiminimistrapBloodGongfaRate = 0.03
const kJiejiOpponensdigitiminimistrapBloodMoney = 2

function _jiejiOpponensdigitiminimistrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiOpponensdigitiminimistrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiOpponensdigitiminimistrapTieopponensdigitiminimistrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiOpponensdigitiminimistrapTieopponensdigitiminimistrapHerb
}

function _jiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapMoneyThunder
  return kJiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapMoney
}

function _jiejiOpponensdigitiminimistrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiOpponensdigitiminimistrapBloodLifeBlood
  return kJiejiOpponensdigitiminimistrapBloodLife
}

function _jiejiOpponensdigitiminimistrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiOpponensdigitiminimistrapNormalizeKind(kind) {
  if (kind == 'tieopponensdigitiminimistrap' || kind == 'jieji_opponensdigitiminimistrap_tieopponensdigitiminimistrap') return 'tieopponensdigitiminimistrap'
  if (kind == 'looseopponensdigitiminimistrap' || kind == 'jieji_opponensdigitiminimistrap_looseopponensdigitiminimistrap') return 'looseopponensdigitiminimistrap'
  if (kind == 'bloodopponensdigitiminimistrap' || kind == 'jieji_opponensdigitiminimistrap_bloodopponensdigitiminimistrap') return 'bloodopponensdigitiminimistrap'
  return null
}

function _jiejiOpponensdigitiminimistrapChoices() {
  return [
    {
      text: 'jieji_opponensdigitiminimistrap_tieopponensdigitiminimistrap',
      description: 'hint_jieji_opponensdigitiminimistrap_tieopponensdigitiminimistrap',
    },
    {
      text: 'jieji_opponensdigitiminimistrap_looseopponensdigitiminimistrap',
      description: 'hint_jieji_opponensdigitiminimistrap_looseopponensdigitiminimistrap',
    },
    {
      text: 'jieji_opponensdigitiminimistrap_bloodopponensdigitiminimistrap',
      description: 'hint_jieji_opponensdigitiminimistrap_bloodopponensdigitiminimistrap',
    },
  ]
}

/// 赶路劫小指对掌肌革三选。debug.forceJiejiEvent('opponensdigitiminimistrap') / forceOpponensdigitiminimistrap 直接走这里，仍弹出三选。
async function playJiejiOpponensdigitiminimistrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_opponensdigitiminimistrap')
  dialog.pushSelection('jiejiOpponensdigitiminimistrap', _jiejiOpponensdigitiminimistrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiOpponensdigitiminimistrap')
  var selected = _jiejiOpponensdigitiminimistrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieopponensdigitiminimistrap'
  }

  final seasonId = _jiejiOpponensdigitiminimistrapSeasonId()
  if (selected == 'tieopponensdigitiminimistrap') {
    final herbNeed = _jiejiOpponensdigitiminimistrapTieopponensdigitiminimistrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_opponensdigitiminimistrap_tieopponensdigitiminimistrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiOpponensdigitiminimistrapTieopponensdigitiminimistrapLife)
      dialog.pushDialog('hint_jieji_opponensdigitiminimistrap_tieopponensdigitiminimistrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiOpponensdigitiminimistrapTieopponensdigitiminimistrapGongfaRate)
    }
  } else if (selected == 'looseopponensdigitiminimistrap') {
    final moneyNeed = _jiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_opponensdigitiminimistrap_looseopponensdigitiminimistrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapLife)
      dialog.pushDialog('hint_jieji_opponensdigitiminimistrap_looseopponensdigitiminimistrap_ok', interpolations: [kJiejiOpponensdigitiminimistrapLooseopponensdigitiminimistrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiOpponensdigitiminimistrapCostLife(_jiejiOpponensdigitiminimistrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_opponensdigitiminimistrap_bloodopponensdigitiminimistrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiOpponensdigitiminimistrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiOpponensdigitiminimistrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_opponensdigitiminimistrap_bloodopponensdigitiminimistrap_none', interpolations: [kJiejiOpponensdigitiminimistrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000000008%。出过则返回 true。
async function tryJiejiOpponensdigitiminimistrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiOpponensdigitiminimistrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastOpponensdigitiminimistrapMove ?? -999
  if (moves - last < kJiejiOpponensdigitiminimistrapMoveCooldown) return false

  var rate = kJiejiOpponensdigitiminimistrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastOpponensdigitiminimistrapMove = moves
  await playJiejiOpponensdigitiminimistrapEvent(terrain)
  return true
}
