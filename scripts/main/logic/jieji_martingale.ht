/// 赶路「劫攀胸」三选：系攀 / 解攀 / 血攀。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带都没中时才滚。
const kJiejiMartingaleBaseRate = 0.000008
const kJiejiMartingaleMoveCooldown = 24
const kJiejiMartingaleTiemartingaleHerb = 1
const kJiejiMartingaleTiemartingaleLife = 1
const kJiejiMartingaleTiemartingaleGongfaRate = 0.006
const kJiejiMartingaleLoosemartingaleMoney = 1
const kJiejiMartingaleLoosemartingaleMoneyThunder = 1
const kJiejiMartingaleLoosemartingaleHerb = 1
const kJiejiMartingaleLoosemartingaleLife = 1
const kJiejiMartingaleBloodLife = 1
const kJiejiMartingaleBloodLifeBlood = 2
const kJiejiMartingaleBloodGongfaRate = 0.04
const kJiejiMartingaleBloodMoney = 2

function _jiejiMartingaleSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiMartingaleTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiMartingaleTiemartingaleHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiMartingaleTiemartingaleHerb
}

function _jiejiMartingaleLoosemartingaleMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiMartingaleLoosemartingaleMoneyThunder
  return kJiejiMartingaleLoosemartingaleMoney
}

function _jiejiMartingaleBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiMartingaleBloodLifeBlood
  return kJiejiMartingaleBloodLife
}

function _jiejiMartingaleCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiMartingaleNormalizeKind(kind) {
  if (kind == 'tiemartingale' || kind == 'jieji_martingale_tiemartingale') return 'tiemartingale'
  if (kind == 'loosemartingale' || kind == 'jieji_martingale_loosemartingale') return 'loosemartingale'
  if (kind == 'bloodmartingale' || kind == 'jieji_martingale_bloodmartingale') return 'bloodmartingale'
  return null
}

function _jiejiMartingaleChoices() {
  return [
    {
      text: 'jieji_martingale_tiemartingale',
      description: 'hint_jieji_martingale_tiemartingale',
    },
    {
      text: 'jieji_martingale_loosemartingale',
      description: 'hint_jieji_martingale_loosemartingale',
    },
    {
      text: 'jieji_martingale_bloodmartingale',
      description: 'hint_jieji_martingale_bloodmartingale',
    },
  ]
}

/// 赶路劫攀胸三选。debug.forceJiejiEvent('martingale') / forceMartingale 直接走这里，仍弹出三选。
async function playJiejiMartingaleEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_martingale')
  dialog.pushSelection('jiejiMartingale', _jiejiMartingaleChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiMartingale')
  var selected = _jiejiMartingaleNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiemartingale'
  }

  final seasonId = _jiejiMartingaleSeasonId()
  if (selected == 'tiemartingale') {
    final herbNeed = _jiejiMartingaleTiemartingaleHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_martingale_tiemartingale_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiMartingaleTiemartingaleLife)
      dialog.pushDialog('hint_jieji_martingale_tiemartingale_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiMartingaleTiemartingaleGongfaRate)
    }
  } else if (selected == 'loosemartingale') {
    final moneyNeed = _jiejiMartingaleLoosemartingaleMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_martingale_loosemartingale_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiMartingaleLoosemartingaleHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiMartingaleLoosemartingaleLife)
      dialog.pushDialog('hint_jieji_martingale_loosemartingale_ok', interpolations: [kJiejiMartingaleLoosemartingaleHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiMartingaleCostLife(_jiejiMartingaleBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_martingale_bloodmartingale_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiMartingaleBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiMartingaleBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_martingale_bloodmartingale_none', interpolations: [kJiejiMartingaleBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0008%。出过则返回 true。
async function tryJiejiMartingaleOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiMartingaleTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastMartingaleMove ?? -999
  if (moves - last < kJiejiMartingaleMoveCooldown) return false

  var rate = kJiejiMartingaleBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastMartingaleMove = moves
  await playJiejiMartingaleEvent(terrain)
  return true
}
