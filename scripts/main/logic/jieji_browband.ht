/// 赶路「劫额革」三选：系额 / 解额 / 血额。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革都没中时才滚。
const kJiejiBrowbandBaseRate = 0.000006
const kJiejiBrowbandMoveCooldown = 24
const kJiejiBrowbandTiebrowbandHerb = 1
const kJiejiBrowbandTiebrowbandLife = 1
const kJiejiBrowbandTiebrowbandGongfaRate = 0.005
const kJiejiBrowbandLoosebrowbandMoney = 1
const kJiejiBrowbandLoosebrowbandMoneyThunder = 1
const kJiejiBrowbandLoosebrowbandHerb = 1
const kJiejiBrowbandLoosebrowbandLife = 1
const kJiejiBrowbandBloodLife = 1
const kJiejiBrowbandBloodLifeBlood = 2
const kJiejiBrowbandBloodGongfaRate = 0.03
const kJiejiBrowbandBloodMoney = 2

function _jiejiBrowbandSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiBrowbandTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiBrowbandTiebrowbandHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiBrowbandTiebrowbandHerb
}

function _jiejiBrowbandLoosebrowbandMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiBrowbandLoosebrowbandMoneyThunder
  return kJiejiBrowbandLoosebrowbandMoney
}

function _jiejiBrowbandBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiBrowbandBloodLifeBlood
  return kJiejiBrowbandBloodLife
}

function _jiejiBrowbandCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiBrowbandNormalizeKind(kind) {
  if (kind == 'tiebrowband' || kind == 'jieji_browband_tiebrowband') return 'tiebrowband'
  if (kind == 'loosebrowband' || kind == 'jieji_browband_loosebrowband') return 'loosebrowband'
  if (kind == 'bloodbrowband' || kind == 'jieji_browband_bloodbrowband') return 'bloodbrowband'
  return null
}

function _jiejiBrowbandChoices() {
  return [
    {
      text: 'jieji_browband_tiebrowband',
      description: 'hint_jieji_browband_tiebrowband',
    },
    {
      text: 'jieji_browband_loosebrowband',
      description: 'hint_jieji_browband_loosebrowband',
    },
    {
      text: 'jieji_browband_bloodbrowband',
      description: 'hint_jieji_browband_bloodbrowband',
    },
  ]
}

/// 赶路劫额革三选。debug.forceJiejiEvent('browband') / forceBrowband 直接走这里，仍弹出三选。
async function playJiejiBrowbandEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_browband')
  dialog.pushSelection('jiejiBrowband', _jiejiBrowbandChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiBrowband')
  var selected = _jiejiBrowbandNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiebrowband'
  }

  final seasonId = _jiejiBrowbandSeasonId()
  if (selected == 'tiebrowband') {
    final herbNeed = _jiejiBrowbandTiebrowbandHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_browband_tiebrowband_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiBrowbandTiebrowbandLife)
      dialog.pushDialog('hint_jieji_browband_tiebrowband_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiBrowbandTiebrowbandGongfaRate)
    }
  } else if (selected == 'loosebrowband') {
    final moneyNeed = _jiejiBrowbandLoosebrowbandMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_browband_loosebrowband_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiBrowbandLoosebrowbandHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiBrowbandLoosebrowbandLife)
      dialog.pushDialog('hint_jieji_browband_loosebrowband_ok', interpolations: [kJiejiBrowbandLoosebrowbandHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiBrowbandCostLife(_jiejiBrowbandBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_browband_bloodbrowband_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiBrowbandBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiBrowbandBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_browband_bloodbrowband_none', interpolations: [kJiejiBrowbandBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0006%。出过则返回 true。
async function tryJiejiBrowbandOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiBrowbandTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastBrowbandMove ?? -999
  if (moves - last < kJiejiBrowbandMoveCooldown) return false

  var rate = kJiejiBrowbandBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastBrowbandMove = moves
  await playJiejiBrowbandEvent(terrain)
  return true
}
