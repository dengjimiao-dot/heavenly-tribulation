/// 赶路「劫络革」三选：系络 / 解络 / 血络。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革都没中时才滚。
const kJiejiFiadorBaseRate = 0.0000006
const kJiejiFiadorMoveCooldown = 24
const kJiejiFiadorTiefiadorHerb = 1
const kJiejiFiadorTiefiadorLife = 1
const kJiejiFiadorTiefiadorGongfaRate = 0.005
const kJiejiFiadorLoosefiadorMoney = 1
const kJiejiFiadorLoosefiadorMoneyThunder = 1
const kJiejiFiadorLoosefiadorHerb = 1
const kJiejiFiadorLoosefiadorLife = 1
const kJiejiFiadorBloodLife = 1
const kJiejiFiadorBloodLifeBlood = 2
const kJiejiFiadorBloodGongfaRate = 0.03
const kJiejiFiadorBloodMoney = 2

function _jiejiFiadorSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiFiadorTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiFiadorTiefiadorHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiFiadorTiefiadorHerb
}

function _jiejiFiadorLoosefiadorMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiFiadorLoosefiadorMoneyThunder
  return kJiejiFiadorLoosefiadorMoney
}

function _jiejiFiadorBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiFiadorBloodLifeBlood
  return kJiejiFiadorBloodLife
}

function _jiejiFiadorCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiFiadorNormalizeKind(kind) {
  if (kind == 'tiefiador' || kind == 'jieji_fiador_tiefiador') return 'tiefiador'
  if (kind == 'loosefiador' || kind == 'jieji_fiador_loosefiador') return 'loosefiador'
  if (kind == 'bloodfiador' || kind == 'jieji_fiador_bloodfiador') return 'bloodfiador'
  return null
}

function _jiejiFiadorChoices() {
  return [
    {
      text: 'jieji_fiador_tiefiador',
      description: 'hint_jieji_fiador_tiefiador',
    },
    {
      text: 'jieji_fiador_loosefiador',
      description: 'hint_jieji_fiador_loosefiador',
    },
    {
      text: 'jieji_fiador_bloodfiador',
      description: 'hint_jieji_fiador_bloodfiador',
    },
  ]
}

/// 赶路劫络革三选。debug.forceJiejiEvent('fiador') / forceFiador 直接走这里，仍弹出三选。
async function playJiejiFiadorEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_fiador')
  dialog.pushSelection('jiejiFiador', _jiejiFiadorChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiFiador')
  var selected = _jiejiFiadorNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiefiador'
  }

  final seasonId = _jiejiFiadorSeasonId()
  if (selected == 'tiefiador') {
    final herbNeed = _jiejiFiadorTiefiadorHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_fiador_tiefiador_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiFiadorTiefiadorLife)
      dialog.pushDialog('hint_jieji_fiador_tiefiador_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiFiadorTiefiadorGongfaRate)
    }
  } else if (selected == 'loosefiador') {
    final moneyNeed = _jiejiFiadorLoosefiadorMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_fiador_loosefiador_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiFiadorLoosefiadorHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiFiadorLoosefiadorLife)
      dialog.pushDialog('hint_jieji_fiador_loosefiador_ok', interpolations: [kJiejiFiadorLoosefiadorHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiFiadorCostLife(_jiejiFiadorBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_fiador_bloodfiador_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiFiadorBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiFiadorBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_fiador_bloodfiador_none', interpolations: [kJiejiFiadorBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00006%。出过则返回 true。
async function tryJiejiFiadorOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiFiadorTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastFiadorMove ?? -999
  if (moves - last < kJiejiFiadorMoveCooldown) return false

  var rate = kJiejiFiadorBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastFiadorMove = moves
  await playJiejiFiadorEvent(terrain)
  return true
}
