/// 赶路「劫拇革」三选：系拇 / 解拇 / 血拇。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革都没中时才滚。
const kJiejiThumbstrapBaseRate = 0.00000000003
const kJiejiThumbstrapMoveCooldown = 24
const kJiejiThumbstrapTiethumbstrapHerb = 1
const kJiejiThumbstrapTiethumbstrapLife = 1
const kJiejiThumbstrapTiethumbstrapGongfaRate = 0.005
const kJiejiThumbstrapLoosethumbstrapMoney = 1
const kJiejiThumbstrapLoosethumbstrapMoneyThunder = 1
const kJiejiThumbstrapLoosethumbstrapHerb = 1
const kJiejiThumbstrapLoosethumbstrapLife = 1
const kJiejiThumbstrapBloodLife = 1
const kJiejiThumbstrapBloodLifeBlood = 2
const kJiejiThumbstrapBloodGongfaRate = 0.03
const kJiejiThumbstrapBloodMoney = 2

function _jiejiThumbstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiThumbstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiThumbstrapTiethumbstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiThumbstrapTiethumbstrapHerb
}

function _jiejiThumbstrapLoosethumbstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiThumbstrapLoosethumbstrapMoneyThunder
  return kJiejiThumbstrapLoosethumbstrapMoney
}

function _jiejiThumbstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiThumbstrapBloodLifeBlood
  return kJiejiThumbstrapBloodLife
}

function _jiejiThumbstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiThumbstrapNormalizeKind(kind) {
  if (kind == 'tiethumbstrap' || kind == 'jieji_thumbstrap_tiethumbstrap') return 'tiethumbstrap'
  if (kind == 'loosethumbstrap' || kind == 'jieji_thumbstrap_loosethumbstrap') return 'loosethumbstrap'
  if (kind == 'bloodthumbstrap' || kind == 'jieji_thumbstrap_bloodthumbstrap') return 'bloodthumbstrap'
  return null
}

function _jiejiThumbstrapChoices() {
  return [
    {
      text: 'jieji_thumbstrap_tiethumbstrap',
      description: 'hint_jieji_thumbstrap_tiethumbstrap',
    },
    {
      text: 'jieji_thumbstrap_loosethumbstrap',
      description: 'hint_jieji_thumbstrap_loosethumbstrap',
    },
    {
      text: 'jieji_thumbstrap_bloodthumbstrap',
      description: 'hint_jieji_thumbstrap_bloodthumbstrap',
    },
  ]
}

/// 赶路劫拇革三选。debug.forceJiejiEvent('thumbstrap') / forceThumbstrap 直接走这里，仍弹出三选。
async function playJiejiThumbstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_thumbstrap')
  dialog.pushSelection('jiejiThumbstrap', _jiejiThumbstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiThumbstrap')
  var selected = _jiejiThumbstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiethumbstrap'
  }

  final seasonId = _jiejiThumbstrapSeasonId()
  if (selected == 'tiethumbstrap') {
    final herbNeed = _jiejiThumbstrapTiethumbstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_thumbstrap_tiethumbstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiThumbstrapTiethumbstrapLife)
      dialog.pushDialog('hint_jieji_thumbstrap_tiethumbstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiThumbstrapTiethumbstrapGongfaRate)
    }
  } else if (selected == 'loosethumbstrap') {
    final moneyNeed = _jiejiThumbstrapLoosethumbstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_thumbstrap_loosethumbstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiThumbstrapLoosethumbstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiThumbstrapLoosethumbstrapLife)
      dialog.pushDialog('hint_jieji_thumbstrap_loosethumbstrap_ok', interpolations: [kJiejiThumbstrapLoosethumbstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiThumbstrapCostLife(_jiejiThumbstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_thumbstrap_bloodthumbstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiThumbstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiThumbstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_thumbstrap_bloodthumbstrap_none', interpolations: [kJiejiThumbstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000003%。出过则返回 true。
async function tryJiejiThumbstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiThumbstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastThumbstrapMove ?? -999
  if (moves - last < kJiejiThumbstrapMoveCooldown) return false

  var rate = kJiejiThumbstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastThumbstrapMove = moves
  await playJiejiThumbstrapEvent(terrain)
  return true
}
