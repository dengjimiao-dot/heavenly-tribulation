/// 赶路「劫喙革」三选：系喙 / 解喙 / 血喙。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫喙革都没中时才滚。
const kJiejiCoracoidstrapBaseRate = 0.000000000001
const kJiejiCoracoidstrapMoveCooldown = 24
const kJiejiCoracoidstrapTiecoracoidstrapHerb = 1
const kJiejiCoracoidstrapTiecoracoidstrapLife = 1
const kJiejiCoracoidstrapTiecoracoidstrapGongfaRate = 0.005
const kJiejiCoracoidstrapLoosecoracoidstrapMoney = 1
const kJiejiCoracoidstrapLoosecoracoidstrapMoneyThunder = 1
const kJiejiCoracoidstrapLoosecoracoidstrapHerb = 1
const kJiejiCoracoidstrapLoosecoracoidstrapLife = 1
const kJiejiCoracoidstrapBloodLife = 1
const kJiejiCoracoidstrapBloodLifeBlood = 2
const kJiejiCoracoidstrapBloodGongfaRate = 0.03
const kJiejiCoracoidstrapBloodMoney = 2

function _jiejiCoracoidstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiCoracoidstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiCoracoidstrapTiecoracoidstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiCoracoidstrapTiecoracoidstrapHerb
}

function _jiejiCoracoidstrapLoosecoracoidstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiCoracoidstrapLoosecoracoidstrapMoneyThunder
  return kJiejiCoracoidstrapLoosecoracoidstrapMoney
}

function _jiejiCoracoidstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiCoracoidstrapBloodLifeBlood
  return kJiejiCoracoidstrapBloodLife
}

function _jiejiCoracoidstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiCoracoidstrapNormalizeKind(kind) {
  if (kind == 'tiecoracoidstrap' || kind == 'jieji_coracoidstrap_tiecoracoidstrap') return 'tiecoracoidstrap'
  if (kind == 'loosecoracoidstrap' || kind == 'jieji_coracoidstrap_loosecoracoidstrap') return 'loosecoracoidstrap'
  if (kind == 'bloodcoracoidstrap' || kind == 'jieji_coracoidstrap_bloodcoracoidstrap') return 'bloodcoracoidstrap'
  return null
}

function _jiejiCoracoidstrapChoices() {
  return [
    {
      text: 'jieji_coracoidstrap_tiecoracoidstrap',
      description: 'hint_jieji_coracoidstrap_tiecoracoidstrap',
    },
    {
      text: 'jieji_coracoidstrap_loosecoracoidstrap',
      description: 'hint_jieji_coracoidstrap_loosecoracoidstrap',
    },
    {
      text: 'jieji_coracoidstrap_bloodcoracoidstrap',
      description: 'hint_jieji_coracoidstrap_bloodcoracoidstrap',
    },
  ]
}

/// 赶路劫喙革三选。debug.forceJiejiEvent('coracoidstrap') / forceCoracoidstrap 直接走这里，仍弹出三选。
async function playJiejiCoracoidstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_coracoidstrap')
  dialog.pushSelection('jiejiCoracoidstrap', _jiejiCoracoidstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiCoracoidstrap')
  var selected = _jiejiCoracoidstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiecoracoidstrap'
  }

  final seasonId = _jiejiCoracoidstrapSeasonId()
  if (selected == 'tiecoracoidstrap') {
    final herbNeed = _jiejiCoracoidstrapTiecoracoidstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_coracoidstrap_tiecoracoidstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiCoracoidstrapTiecoracoidstrapLife)
      dialog.pushDialog('hint_jieji_coracoidstrap_tiecoracoidstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiCoracoidstrapTiecoracoidstrapGongfaRate)
    }
  } else if (selected == 'loosecoracoidstrap') {
    final moneyNeed = _jiejiCoracoidstrapLoosecoracoidstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_coracoidstrap_loosecoracoidstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiCoracoidstrapLoosecoracoidstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiCoracoidstrapLoosecoracoidstrapLife)
      dialog.pushDialog('hint_jieji_coracoidstrap_loosecoracoidstrap_ok', interpolations: [kJiejiCoracoidstrapLoosecoracoidstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiCoracoidstrapCostLife(_jiejiCoracoidstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_coracoidstrap_bloodcoracoidstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiCoracoidstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiCoracoidstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_coracoidstrap_bloodcoracoidstrap_none', interpolations: [kJiejiCoracoidstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000000001%。出过则返回 true。
async function tryJiejiCoracoidstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiCoracoidstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastCoracoidstrapMove ?? -999
  if (moves - last < kJiejiCoracoidstrapMoveCooldown) return false

  var rate = kJiejiCoracoidstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastCoracoidstrapMove = moves
  await playJiejiCoracoidstrapEvent(terrain)
  return true
}
