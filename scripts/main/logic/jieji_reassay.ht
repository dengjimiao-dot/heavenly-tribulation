/// 铸牌斋「再检」：再温 / 再借 / 血检。不替换铸牌、精铸、业力录、检胚。
/// 与检胚（jieji_assay.ht / lastAssayDay）分开；本文件用 lastReassayDay。
const kJiejiReassayCooldownDays = 1
const kJiejiReassayWarmHerb = 1
const kJiejiReassayWarmHerbMist = 0
const kJiejiReassayWarmLife = 6
const kJiejiReassayBorrowMoney = 40
const kJiejiReassayBorrowMoneyThunder = 20
const kJiejiReassayBorrowBlankRate = 0.20
const kJiejiReassayBorrowLife = 4
const kJiejiReassayBloodLife = 2
const kJiejiReassayBloodLifeBlood = 3
const kJiejiReassayBloodGongfaRate = 0.35
const kJiejiReassayBloodMoney = 40

function _jiejiReassaySeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiReassayCurrentDay() {
  if (game.timestamp == null) return null
  if (Constants.ticksPerDay == null) return null
  if (Constants.ticksPerDay <= 0) return null
  return game.timestamp ~/ Constants.ticksPerDay
}

function _jiejiReassayOnCooldown() {
  final jieji = ensureJiejiFlags()
  final day = _jiejiReassayCurrentDay()
  if (day == null) return false
  if (jieji.lastReassayDay == null) return false
  if (day - jieji.lastReassayDay < kJiejiReassayCooldownDays) return true
  return false
}

function _jiejiReassayMark() {
  final jieji = ensureJiejiFlags()
  jieji.lastReassayDay = _jiejiReassayCurrentDay()
}

function _jiejiReassayCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiReassayWarmHerbCost(seasonId) {
  if (seasonId == 'mist') return kJiejiReassayWarmHerbMist
  return kJiejiReassayWarmHerb
}

function _jiejiReassayBorrowMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiReassayBorrowMoneyThunder
  return kJiejiReassayBorrowMoney
}

function _jiejiReassayBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiReassayBloodLifeBlood
  return kJiejiReassayBloodLife
}

function _jiejiReassayNormalizeKind(kind) {
  if (kind == 'warm' || kind == 'jieji_reassay_warm') return 'warm'
  if (kind == 'borrow' || kind == 'jieji_reassay_borrow') return 'borrow'
  if (kind == 'blood' || kind == 'jieji_reassay_blood') return 'blood'
  return null
}

function _jiejiReassayChoices() {
  return [
    {
      text: 'jieji_reassay_warm',
      description: 'hint_jieji_reassay_warm',
    },
    {
      text: 'jieji_reassay_borrow',
      description: 'hint_jieji_reassay_borrow',
    },
    {
      text: 'jieji_reassay_blood',
      description: 'hint_jieji_reassay_blood',
    },
    'cancel',
  ]
}

function _jiejiReassayHerbNeed(selected, seasonId) {
  if (selected == 'warm') return _jiejiReassayWarmHerbCost(seasonId)
  return 0
}

function _jiejiReassayMoneyNeed(selected, seasonId) {
  if (selected == 'borrow') return _jiejiReassayBorrowMoneyCost(seasonId)
  return 0
}

function _jiejiReassayGrantBlank() {
  final card = BattleCard(rank: 0)
  if (card == null) return null
  card.isCardBlank = true
  Player.acquireCard(card)
  return card
}

/// 铸牌斋再检三选。free 为 true 时不扣费、不检查冷却（debug），仍弹出三选。
/// null 选择在 free 时默认再温。
/// 返回 'ok' | 'cooldown' | 'poor' | 'cancel'。
async function reassayJiejiBlank({ free = false }) {
  if (hero == null) return 'cancel'
  if (free != true && _jiejiReassayOnCooldown()) {
    return 'cooldown'
  }

  dialog.pushDialog('hint_reassayJiejiBlank')
  dialog.pushSelection('jiejiReassay', _jiejiReassayChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiReassay')
  var selected = null
  if (picked == null || picked == 'cancel') {
    if (free == true && picked == null) {
      selected = 'warm'
    } else {
      return 'cancel'
    }
  } else {
    selected = _jiejiReassayNormalizeKind(picked)
  }
  if (selected == null) return 'cancel'

  final seasonId = _jiejiReassaySeasonId()
  if (free != true) {
    final herbNeed = _jiejiReassayHerbNeed(selected, seasonId)
    final moneyNeed = _jiejiReassayMoneyNeed(selected, seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    final moneyHave = hero.materials['money'] ?? 0
    if (herbHave < herbNeed || moneyHave < moneyNeed) {
      return 'poor'
    }
  }

  if (free != true) {
    final herbNeed = _jiejiReassayHerbNeed(selected, seasonId)
    final moneyNeed = _jiejiReassayMoneyNeed(selected, seasonId)
    if (herbNeed > 0) {
      Player.exhaust('herb', herbNeed)
    }
    if (moneyNeed > 0) {
      Player.exhaust('money', moneyNeed)
    }
    if (selected == 'blood') {
      _jiejiReassayCostLife(_jiejiReassayBloodLifeCost(seasonId))
    }
    _jiejiReassayMark()
  }

  if (selected == 'borrow') {
    if (random.nextDouble() < kJiejiReassayBorrowBlankRate) {
      final card = _jiejiReassayGrantBlank()
      if (card != null) {
        dialog.pushDialog('hint_reassayJiejiBlank_borrow_blank')
      } else {
        Player.restoreLife(kJiejiReassayBorrowLife)
        dialog.pushDialog('hint_reassayJiejiBlank_borrow_life')
      }
    } else {
      Player.restoreLife(kJiejiReassayBorrowLife)
      dialog.pushDialog('hint_reassayJiejiBlank_borrow_life')
    }
    await dialog.execute()
  } else if (selected == 'blood') {
    final dropped = await tryDropGongfaShard(rate: kJiejiReassayBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiReassayBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_reassayJiejiBlank_blood_money')
      await dialog.execute()
    } else {
      dialog.pushDialog('hint_reassayJiejiBlank_blood')
      await dialog.execute()
    }
  } else {
    Player.restoreLife(kJiejiReassayWarmLife)
    dialog.pushDialog('hint_reassayJiejiBlank_warm')
    await dialog.execute()
  }

  Game.updateUI()
  return 'ok'
}
