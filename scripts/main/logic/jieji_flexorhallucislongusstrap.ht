const kJiejiFlexorhallucislongusstrapBaseRate = 0.00000000000000007
const kJiejiFlexorhallucislongusstrapMoveCooldown = 24
const kJiejiFlexorhallucislongusstrapTieflexorhallucislongusstrapHerb = 1
const kJiejiFlexorhallucislongusstrapTieflexorhallucislongusstrapLife = 1
const kJiejiFlexorhallucislongusstrapTieflexorhallucislongusstrapGongfaRate = 0.005
const kJiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapMoney = 1
const kJiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapMoneyThunder = 1
const kJiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapHerb = 1
const kJiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapLife = 1
const kJiejiFlexorhallucislongusstrapBloodLife = 1
const kJiejiFlexorhallucislongusstrapBloodLifeBlood = 2
const kJiejiFlexorhallucislongusstrapBloodGongfaRate = 0.03
const kJiejiFlexorhallucislongusstrapBloodMoney = 2

function _jiejiFlexorhallucislongusstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiFlexorhallucislongusstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiFlexorhallucislongusstrapTieflexorhallucislongusstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiFlexorhallucislongusstrapTieflexorhallucislongusstrapHerb
}

function _jiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapMoneyThunder
  return kJiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapMoney
}

function _jiejiFlexorhallucislongusstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiFlexorhallucislongusstrapBloodLifeBlood
  return kJiejiFlexorhallucislongusstrapBloodLife
}

function _jiejiFlexorhallucislongusstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiFlexorhallucislongusstrapNormalizeKind(kind) {
  if (kind == 'tieflexorhallucislongusstrap' || kind == 'jieji_flexorhallucislongusstrap_tieflexorhallucislongusstrap') return 'tieflexorhallucislongusstrap'
  if (kind == 'looseflexorhallucislongusstrap' || kind == 'jieji_flexorhallucislongusstrap_looseflexorhallucislongusstrap') return 'looseflexorhallucislongusstrap'
  if (kind == 'bloodflexorhallucislongusstrap' || kind == 'jieji_flexorhallucislongusstrap_bloodflexorhallucislongusstrap') return 'bloodflexorhallucislongusstrap'
  return null
}

function _jiejiFlexorhallucislongusstrapChoices() {
  return [
    {
      text: 'jieji_flexorhallucislongusstrap_tieflexorhallucislongusstrap',
      description: 'hint_jieji_flexorhallucislongusstrap_tieflexorhallucislongusstrap',
    },
    {
      text: 'jieji_flexorhallucislongusstrap_looseflexorhallucislongusstrap',
      description: 'hint_jieji_flexorhallucislongusstrap_looseflexorhallucislongusstrap',
    },
    {
      text: 'jieji_flexorhallucislongusstrap_bloodflexorhallucislongusstrap',
      description: 'hint_jieji_flexorhallucislongusstrap_bloodflexorhallucislongusstrap',
    },
  ]
}

/// 赶路劫踇长屈肌革三选。debug.forceJiejiEvent('flexorhallucislongusstrap') / forceFlexorhallucislongusstrap 直接走这里，仍弹出三选。
async function playJiejiFlexorhallucislongusstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_flexorhallucislongusstrap')
  dialog.pushSelection('jiejiFlexorhallucislongusstrap', _jiejiFlexorhallucislongusstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiFlexorhallucislongusstrap')
  var selected = _jiejiFlexorhallucislongusstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieflexorhallucislongusstrap'
  }

  final seasonId = _jiejiFlexorhallucislongusstrapSeasonId()
  if (selected == 'tieflexorhallucislongusstrap') {
    final herbNeed = _jiejiFlexorhallucislongusstrapTieflexorhallucislongusstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_flexorhallucislongusstrap_tieflexorhallucislongusstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiFlexorhallucislongusstrapTieflexorhallucislongusstrapLife)
      dialog.pushDialog('hint_jieji_flexorhallucislongusstrap_tieflexorhallucislongusstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiFlexorhallucislongusstrapTieflexorhallucislongusstrapGongfaRate)
    }
  } else if (selected == 'looseflexorhallucislongusstrap') {
    final moneyNeed = _jiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_flexorhallucislongusstrap_looseflexorhallucislongusstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapLife)
      dialog.pushDialog('hint_jieji_flexorhallucislongusstrap_looseflexorhallucislongusstrap_ok', interpolations: [kJiejiFlexorhallucislongusstrapLooseflexorhallucislongusstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiFlexorhallucislongusstrapCostLife(_jiejiFlexorhallucislongusstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_flexorhallucislongusstrap_bloodflexorhallucislongusstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiFlexorhallucislongusstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiFlexorhallucislongusstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_flexorhallucislongusstrap_bloodflexorhallucislongusstrap_none', interpolations: [kJiejiFlexorhallucislongusstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000000007%。出过则返回 true。
async function tryJiejiFlexorhallucislongusstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiFlexorhallucislongusstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastFlexorhallucislongusstrapMove ?? -999
  if (moves - last < kJiejiFlexorhallucislongusstrapMoveCooldown) return false

  var rate = kJiejiFlexorhallucislongusstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastFlexorhallucislongusstrapMove = moves
  await playJiejiFlexorhallucislongusstrapEvent(terrain)
  return true
}
