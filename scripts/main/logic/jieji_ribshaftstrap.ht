/// 赶路「劫肋体革」三选：系体 / 解体 / 血体。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革、劫肋头革、劫肋颈革、劫肋结节革、劫肋角革、劫肋沟革、劫肋脊革、劫肋体革、劫肋椎革都没中时才滚。
const kJiejiRibshaftstrapBaseRate = 0.0000000000000003
const kJiejiRibshaftstrapMoveCooldown = 24
const kJiejiRibshaftstrapTieribshaftstrapHerb = 1
const kJiejiRibshaftstrapTieribshaftstrapLife = 1
const kJiejiRibshaftstrapTieribshaftstrapGongfaRate = 0.005
const kJiejiRibshaftstrapLooseribshaftstrapMoney = 1
const kJiejiRibshaftstrapLooseribshaftstrapMoneyThunder = 1
const kJiejiRibshaftstrapLooseribshaftstrapHerb = 1
const kJiejiRibshaftstrapLooseribshaftstrapLife = 1
const kJiejiRibshaftstrapBloodLife = 1
const kJiejiRibshaftstrapBloodLifeBlood = 2
const kJiejiRibshaftstrapBloodGongfaRate = 0.03
const kJiejiRibshaftstrapBloodMoney = 2

function _jiejiRibshaftstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiRibshaftstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiRibshaftstrapTieribshaftstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiRibshaftstrapTieribshaftstrapHerb
}

function _jiejiRibshaftstrapLooseribshaftstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiRibshaftstrapLooseribshaftstrapMoneyThunder
  return kJiejiRibshaftstrapLooseribshaftstrapMoney
}

function _jiejiRibshaftstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiRibshaftstrapBloodLifeBlood
  return kJiejiRibshaftstrapBloodLife
}

function _jiejiRibshaftstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiRibshaftstrapNormalizeKind(kind) {
  if (kind == 'tieribshaftstrap' || kind == 'jieji_ribshaftstrap_tieribshaftstrap') return 'tieribshaftstrap'
  if (kind == 'looseribshaftstrap' || kind == 'jieji_ribshaftstrap_looseribshaftstrap') return 'looseribshaftstrap'
  if (kind == 'bloodribshaftstrap' || kind == 'jieji_ribshaftstrap_bloodribshaftstrap') return 'bloodribshaftstrap'
  return null
}

function _jiejiRibshaftstrapChoices() {
  return [
    {
      text: 'jieji_ribshaftstrap_tieribshaftstrap',
      description: 'hint_jieji_ribshaftstrap_tieribshaftstrap',
    },
    {
      text: 'jieji_ribshaftstrap_looseribshaftstrap',
      description: 'hint_jieji_ribshaftstrap_looseribshaftstrap',
    },
    {
      text: 'jieji_ribshaftstrap_bloodribshaftstrap',
      description: 'hint_jieji_ribshaftstrap_bloodribshaftstrap',
    },
  ]
}

/// 赶路劫肋体革三选。debug.forceJiejiEvent('ribshaftstrap') / forceRibshaftstrap 直接走这里，仍弹出三选。
async function playJiejiRibshaftstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_ribshaftstrap')
  dialog.pushSelection('jiejiRibshaftstrap', _jiejiRibshaftstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiRibshaftstrap')
  var selected = _jiejiRibshaftstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieribshaftstrap'
  }

  final seasonId = _jiejiRibshaftstrapSeasonId()
  if (selected == 'tieribshaftstrap') {
    final herbNeed = _jiejiRibshaftstrapTieribshaftstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_ribshaftstrap_tieribshaftstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiRibshaftstrapTieribshaftstrapLife)
      dialog.pushDialog('hint_jieji_ribshaftstrap_tieribshaftstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiRibshaftstrapTieribshaftstrapGongfaRate)
    }
  } else if (selected == 'looseribshaftstrap') {
    final moneyNeed = _jiejiRibshaftstrapLooseribshaftstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_ribshaftstrap_looseribshaftstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiRibshaftstrapLooseribshaftstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiRibshaftstrapLooseribshaftstrapLife)
      dialog.pushDialog('hint_jieji_ribshaftstrap_looseribshaftstrap_ok', interpolations: [kJiejiRibshaftstrapLooseribshaftstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiRibshaftstrapCostLife(_jiejiRibshaftstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_ribshaftstrap_bloodribshaftstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiRibshaftstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiRibshaftstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_ribshaftstrap_bloodribshaftstrap_none', interpolations: [kJiejiRibshaftstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00000000000003%。出过则返回 true。
async function tryJiejiRibshaftstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiRibshaftstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastRibshaftstrapMove ?? -999
  if (moves - last < kJiejiRibshaftstrapMoveCooldown) return false

  var rate = kJiejiRibshaftstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastRibshaftstrapMove = moves
  await playJiejiRibshaftstrapEvent(terrain)
  return true
}
