/// 赶路「劫甩革」三选：系甩 / 解甩 / 血甩。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革都没中时才滚。
const kJiejiReataBaseRate = 0.0000003
const kJiejiReataMoveCooldown = 24
const kJiejiReataTiereataHerb = 1
const kJiejiReataTiereataLife = 1
const kJiejiReataTiereataGongfaRate = 0.005
const kJiejiReataLoosereataMoney = 1
const kJiejiReataLoosereataMoneyThunder = 1
const kJiejiReataLoosereataHerb = 1
const kJiejiReataLoosereataLife = 1
const kJiejiReataBloodLife = 1
const kJiejiReataBloodLifeBlood = 2
const kJiejiReataBloodGongfaRate = 0.03
const kJiejiReataBloodMoney = 2

function _jiejiReataSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiReataTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiReataTiereataHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiReataTiereataHerb
}

function _jiejiReataLoosereataMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiReataLoosereataMoneyThunder
  return kJiejiReataLoosereataMoney
}

function _jiejiReataBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiReataBloodLifeBlood
  return kJiejiReataBloodLife
}

function _jiejiReataCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiReataNormalizeKind(kind) {
  if (kind == 'tiereata' || kind == 'jieji_reata_tiereata') return 'tiereata'
  if (kind == 'loosereata' || kind == 'jieji_reata_loosereata') return 'loosereata'
  if (kind == 'bloodreata' || kind == 'jieji_reata_bloodreata') return 'bloodreata'
  return null
}

function _jiejiReataChoices() {
  return [
    {
      text: 'jieji_reata_tiereata',
      description: 'hint_jieji_reata_tiereata',
    },
    {
      text: 'jieji_reata_loosereata',
      description: 'hint_jieji_reata_loosereata',
    },
    {
      text: 'jieji_reata_bloodreata',
      description: 'hint_jieji_reata_bloodreata',
    },
  ]
}

/// 赶路劫甩革三选。debug.forceJiejiEvent('reata') / forceReata 直接走这里，仍弹出三选。
async function playJiejiReataEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_reata')
  dialog.pushSelection('jiejiReata', _jiejiReataChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiReata')
  var selected = _jiejiReataNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiereata'
  }

  final seasonId = _jiejiReataSeasonId()
  if (selected == 'tiereata') {
    final herbNeed = _jiejiReataTiereataHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_reata_tiereata_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiReataTiereataLife)
      dialog.pushDialog('hint_jieji_reata_tiereata_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiReataTiereataGongfaRate)
    }
  } else if (selected == 'loosereata') {
    final moneyNeed = _jiejiReataLoosereataMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_reata_loosereata_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiReataLoosereataHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiReataLoosereataLife)
      dialog.pushDialog('hint_jieji_reata_loosereata_ok', interpolations: [kJiejiReataLoosereataHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiReataCostLife(_jiejiReataBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_reata_bloodreata_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiReataBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiReataBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_reata_bloodreata_none', interpolations: [kJiejiReataBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00003%。出过则返回 true。
async function tryJiejiReataOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiReataTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastReataMove ?? -999
  if (moves - last < kJiejiReataMoveCooldown) return false

  var rate = kJiejiReataBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastReataMove = moves
  await playJiejiReataEvent(terrain)
  return true
}
