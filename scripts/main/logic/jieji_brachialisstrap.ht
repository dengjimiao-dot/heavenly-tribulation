/// 赶路「劫肱肌革」三选：系肱肌 / 解肱肌 / 血肱肌。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革、劫肋头革、劫肋颈革、劫肋结节革、劫肋角革、劫肋沟革、劫肋脊革、劫肋体革、劫肋椎革、劫肋横突革、劫肋软骨结革、劫胸肋革、劫柄胸革、劫胸骨角革、劫剑胸革、劫肋胸革、劫颈静脉切迹革、劫锁骨切迹革、劫肋软骨弓革、劫肋下角革、劫胸骨体革、劫肋剑突革、劫锁间韧带革、劫肋软骨结合革、劫胸骨肌革、劫胸大肌革、劫前锯肌革、劫锁骨下肌革、劫背阔肌革、劫斜方肌革、劫三角肌革、劫冈下肌革、劫大圆肌革、劫小圆肌革、劫冈上肌革、劫肩胛下肌革、劫喙肱肌革、劫肱肌革都没中时才滚。
const kJiejiBrachialisstrapBaseRate = 0.00000000000000008
const kJiejiBrachialisstrapMoveCooldown = 24
const kJiejiBrachialisstrapTiebrachialisstrapHerb = 1
const kJiejiBrachialisstrapTiebrachialisstrapLife = 1
const kJiejiBrachialisstrapTiebrachialisstrapGongfaRate = 0.005
const kJiejiBrachialisstrapLoosebrachialisstrapMoney = 1
const kJiejiBrachialisstrapLoosebrachialisstrapMoneyThunder = 1
const kJiejiBrachialisstrapLoosebrachialisstrapHerb = 1
const kJiejiBrachialisstrapLoosebrachialisstrapLife = 1
const kJiejiBrachialisstrapBloodLife = 1
const kJiejiBrachialisstrapBloodLifeBlood = 2
const kJiejiBrachialisstrapBloodGongfaRate = 0.03
const kJiejiBrachialisstrapBloodMoney = 2

function _jiejiBrachialisstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiBrachialisstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiBrachialisstrapTiebrachialisstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiBrachialisstrapTiebrachialisstrapHerb
}

function _jiejiBrachialisstrapLoosebrachialisstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiBrachialisstrapLoosebrachialisstrapMoneyThunder
  return kJiejiBrachialisstrapLoosebrachialisstrapMoney
}

function _jiejiBrachialisstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiBrachialisstrapBloodLifeBlood
  return kJiejiBrachialisstrapBloodLife
}

function _jiejiBrachialisstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiBrachialisstrapNormalizeKind(kind) {
  if (kind == 'tiebrachialisstrap' || kind == 'jieji_brachialisstrap_tiebrachialisstrap') return 'tiebrachialisstrap'
  if (kind == 'loosebrachialisstrap' || kind == 'jieji_brachialisstrap_loosebrachialisstrap') return 'loosebrachialisstrap'
  if (kind == 'bloodbrachialisstrap' || kind == 'jieji_brachialisstrap_bloodbrachialisstrap') return 'bloodbrachialisstrap'
  return null
}

function _jiejiBrachialisstrapChoices() {
  return [
    {
      text: 'jieji_brachialisstrap_tiebrachialisstrap',
      description: 'hint_jieji_brachialisstrap_tiebrachialisstrap',
    },
    {
      text: 'jieji_brachialisstrap_loosebrachialisstrap',
      description: 'hint_jieji_brachialisstrap_loosebrachialisstrap',
    },
    {
      text: 'jieji_brachialisstrap_bloodbrachialisstrap',
      description: 'hint_jieji_brachialisstrap_bloodbrachialisstrap',
    },
  ]
}

/// 赶路劫肱肌革三选。debug.forceJiejiEvent('brachialisstrap') / forceBrachialisstrap 直接走这里，仍弹出三选。
async function playJiejiBrachialisstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_brachialisstrap')
  dialog.pushSelection('jiejiBrachialisstrap', _jiejiBrachialisstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiBrachialisstrap')
  var selected = _jiejiBrachialisstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiebrachialisstrap'
  }

  final seasonId = _jiejiBrachialisstrapSeasonId()
  if (selected == 'tiebrachialisstrap') {
    final herbNeed = _jiejiBrachialisstrapTiebrachialisstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_brachialisstrap_tiebrachialisstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiBrachialisstrapTiebrachialisstrapLife)
      dialog.pushDialog('hint_jieji_brachialisstrap_tiebrachialisstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiBrachialisstrapTiebrachialisstrapGongfaRate)
    }
  } else if (selected == 'loosebrachialisstrap') {
    final moneyNeed = _jiejiBrachialisstrapLoosebrachialisstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_brachialisstrap_loosebrachialisstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiBrachialisstrapLoosebrachialisstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiBrachialisstrapLoosebrachialisstrapLife)
      dialog.pushDialog('hint_jieji_brachialisstrap_loosebrachialisstrap_ok', interpolations: [kJiejiBrachialisstrapLoosebrachialisstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiBrachialisstrapCostLife(_jiejiBrachialisstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_brachialisstrap_bloodbrachialisstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiBrachialisstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiBrachialisstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_brachialisstrap_bloodbrachialisstrap_none', interpolations: [kJiejiBrachialisstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000000008%。出过则返回 true。
async function tryJiejiBrachialisstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiBrachialisstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastBrachialisstrapMove ?? -999
  if (moves - last < kJiejiBrachialisstrapMoveCooldown) return false

  var rate = kJiejiBrachialisstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastBrachialisstrapMove = moves
  await playJiejiBrachialisstrapEvent(terrain)
  return true
}
