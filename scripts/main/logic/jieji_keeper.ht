/// 赶路「劫环革」三选：系环 / 解环 / 血环。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革都没中时才滚。
const kJiejiKeeperBaseRate = 0.0000001
const kJiejiKeeperMoveCooldown = 24
const kJiejiKeeperTiekeeperHerb = 1
const kJiejiKeeperTiekeeperLife = 1
const kJiejiKeeperTiekeeperGongfaRate = 0.005
const kJiejiKeeperLoosekeeperMoney = 1
const kJiejiKeeperLoosekeeperMoneyThunder = 1
const kJiejiKeeperLoosekeeperHerb = 1
const kJiejiKeeperLoosekeeperLife = 1
const kJiejiKeeperBloodLife = 1
const kJiejiKeeperBloodLifeBlood = 2
const kJiejiKeeperBloodGongfaRate = 0.03
const kJiejiKeeperBloodMoney = 2

function _jiejiKeeperSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiKeeperTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiKeeperTiekeeperHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiKeeperTiekeeperHerb
}

function _jiejiKeeperLoosekeeperMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiKeeperLoosekeeperMoneyThunder
  return kJiejiKeeperLoosekeeperMoney
}

function _jiejiKeeperBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiKeeperBloodLifeBlood
  return kJiejiKeeperBloodLife
}

function _jiejiKeeperCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiKeeperNormalizeKind(kind) {
  if (kind == 'tiekeeper' || kind == 'jieji_keeper_tiekeeper') return 'tiekeeper'
  if (kind == 'loosekeeper' || kind == 'jieji_keeper_loosekeeper') return 'loosekeeper'
  if (kind == 'bloodkeeper' || kind == 'jieji_keeper_bloodkeeper') return 'bloodkeeper'
  return null
}

function _jiejiKeeperChoices() {
  return [
    {
      text: 'jieji_keeper_tiekeeper',
      description: 'hint_jieji_keeper_tiekeeper',
    },
    {
      text: 'jieji_keeper_loosekeeper',
      description: 'hint_jieji_keeper_loosekeeper',
    },
    {
      text: 'jieji_keeper_bloodkeeper',
      description: 'hint_jieji_keeper_bloodkeeper',
    },
  ]
}

/// 赶路劫环革三选。debug.forceJiejiEvent('keeper') / forceKeeper 直接走这里，仍弹出三选。
async function playJiejiKeeperEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_keeper')
  dialog.pushSelection('jiejiKeeper', _jiejiKeeperChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiKeeper')
  var selected = _jiejiKeeperNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiekeeper'
  }

  final seasonId = _jiejiKeeperSeasonId()
  if (selected == 'tiekeeper') {
    final herbNeed = _jiejiKeeperTiekeeperHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_keeper_tiekeeper_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiKeeperTiekeeperLife)
      dialog.pushDialog('hint_jieji_keeper_tiekeeper_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiKeeperTiekeeperGongfaRate)
    }
  } else if (selected == 'loosekeeper') {
    final moneyNeed = _jiejiKeeperLoosekeeperMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_keeper_loosekeeper_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiKeeperLoosekeeperHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiKeeperLoosekeeperLife)
      dialog.pushDialog('hint_jieji_keeper_loosekeeper_ok', interpolations: [kJiejiKeeperLoosekeeperHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiKeeperCostLife(_jiejiKeeperBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_keeper_bloodkeeper_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiKeeperBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiKeeperBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_keeper_bloodkeeper_none', interpolations: [kJiejiKeeperBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00001%。出过则返回 true。
async function tryJiejiKeeperOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiKeeperTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastKeeperMove ?? -999
  if (moves - last < kJiejiKeeperMoveCooldown) return false

  var rate = kJiejiKeeperBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastKeeperMove = moves
  await playJiejiKeeperEvent(terrain)
  return true
}
