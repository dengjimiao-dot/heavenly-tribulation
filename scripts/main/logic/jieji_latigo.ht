/// 赶路「劫肚革」三选：系肚 / 解肚 / 血肚。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革都没中时才滚。
const kJiejiLatigoBaseRate = 0.00000025
const kJiejiLatigoMoveCooldown = 24
const kJiejiLatigoTielatigoHerb = 1
const kJiejiLatigoTielatigoLife = 1
const kJiejiLatigoTielatigoGongfaRate = 0.005
const kJiejiLatigoLooselatigoMoney = 1
const kJiejiLatigoLooselatigoMoneyThunder = 1
const kJiejiLatigoLooselatigoHerb = 1
const kJiejiLatigoLooselatigoLife = 1
const kJiejiLatigoBloodLife = 1
const kJiejiLatigoBloodLifeBlood = 2
const kJiejiLatigoBloodGongfaRate = 0.03
const kJiejiLatigoBloodMoney = 2

function _jiejiLatigoSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiLatigoTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiLatigoTielatigoHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiLatigoTielatigoHerb
}

function _jiejiLatigoLooselatigoMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiLatigoLooselatigoMoneyThunder
  return kJiejiLatigoLooselatigoMoney
}

function _jiejiLatigoBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiLatigoBloodLifeBlood
  return kJiejiLatigoBloodLife
}

function _jiejiLatigoCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiLatigoNormalizeKind(kind) {
  if (kind == 'tielatigo' || kind == 'jieji_latigo_tielatigo') return 'tielatigo'
  if (kind == 'looselatigo' || kind == 'jieji_latigo_looselatigo') return 'looselatigo'
  if (kind == 'bloodlatigo' || kind == 'jieji_latigo_bloodlatigo') return 'bloodlatigo'
  return null
}

function _jiejiLatigoChoices() {
  return [
    {
      text: 'jieji_latigo_tielatigo',
      description: 'hint_jieji_latigo_tielatigo',
    },
    {
      text: 'jieji_latigo_looselatigo',
      description: 'hint_jieji_latigo_looselatigo',
    },
    {
      text: 'jieji_latigo_bloodlatigo',
      description: 'hint_jieji_latigo_bloodlatigo',
    },
  ]
}

/// 赶路劫肚革三选。debug.forceJiejiEvent('latigo') / forceLatigo 直接走这里，仍弹出三选。
async function playJiejiLatigoEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_latigo')
  dialog.pushSelection('jiejiLatigo', _jiejiLatigoChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiLatigo')
  var selected = _jiejiLatigoNormalizeKind(picked)
  if (selected == null) {
    selected = 'tielatigo'
  }

  final seasonId = _jiejiLatigoSeasonId()
  if (selected == 'tielatigo') {
    final herbNeed = _jiejiLatigoTielatigoHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_latigo_tielatigo_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiLatigoTielatigoLife)
      dialog.pushDialog('hint_jieji_latigo_tielatigo_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiLatigoTielatigoGongfaRate)
    }
  } else if (selected == 'looselatigo') {
    final moneyNeed = _jiejiLatigoLooselatigoMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_latigo_looselatigo_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiLatigoLooselatigoHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiLatigoLooselatigoLife)
      dialog.pushDialog('hint_jieji_latigo_looselatigo_ok', interpolations: [kJiejiLatigoLooselatigoHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiLatigoCostLife(_jiejiLatigoBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_latigo_bloodlatigo_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiLatigoBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiLatigoBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_latigo_bloodlatigo_none', interpolations: [kJiejiLatigoBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000025%。出过则返回 true。
async function tryJiejiLatigoOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiLatigoTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastLatigoMove ?? -999
  if (moves - last < kJiejiLatigoMoveCooldown) return false

  var rate = kJiejiLatigoBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastLatigoMove = moves
  await playJiejiLatigoEvent(terrain)
  return true
}
