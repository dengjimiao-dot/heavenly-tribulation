/// 赶路「劫肋角革」三选：系角 / 解角 / 血角。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革、劫肋头革、劫肋颈革、劫肋结节革、劫肋角革、劫肋沟革都没中时才滚。
const kJiejiRibanglestrapBaseRate = 0.000000000000001
const kJiejiRibanglestrapMoveCooldown = 24
const kJiejiRibanglestrapTieribanglestrapHerb = 1
const kJiejiRibanglestrapTieribanglestrapLife = 1
const kJiejiRibanglestrapTieribanglestrapGongfaRate = 0.005
const kJiejiRibanglestrapLooseribanglestrapMoney = 1
const kJiejiRibanglestrapLooseribanglestrapMoneyThunder = 1
const kJiejiRibanglestrapLooseribanglestrapHerb = 1
const kJiejiRibanglestrapLooseribanglestrapLife = 1
const kJiejiRibanglestrapBloodLife = 1
const kJiejiRibanglestrapBloodLifeBlood = 2
const kJiejiRibanglestrapBloodGongfaRate = 0.03
const kJiejiRibanglestrapBloodMoney = 2

function _jiejiRibanglestrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiRibanglestrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiRibanglestrapTieribanglestrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiRibanglestrapTieribanglestrapHerb
}

function _jiejiRibanglestrapLooseribanglestrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiRibanglestrapLooseribanglestrapMoneyThunder
  return kJiejiRibanglestrapLooseribanglestrapMoney
}

function _jiejiRibanglestrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiRibanglestrapBloodLifeBlood
  return kJiejiRibanglestrapBloodLife
}

function _jiejiRibanglestrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiRibanglestrapNormalizeKind(kind) {
  if (kind == 'tieribanglestrap' || kind == 'jieji_ribanglestrap_tieribanglestrap') return 'tieribanglestrap'
  if (kind == 'looseribanglestrap' || kind == 'jieji_ribanglestrap_looseribanglestrap') return 'looseribanglestrap'
  if (kind == 'bloodribanglestrap' || kind == 'jieji_ribanglestrap_bloodribanglestrap') return 'bloodribanglestrap'
  return null
}

function _jiejiRibanglestrapChoices() {
  return [
    {
      text: 'jieji_ribanglestrap_tieribanglestrap',
      description: 'hint_jieji_ribanglestrap_tieribanglestrap',
    },
    {
      text: 'jieji_ribanglestrap_looseribanglestrap',
      description: 'hint_jieji_ribanglestrap_looseribanglestrap',
    },
    {
      text: 'jieji_ribanglestrap_bloodribanglestrap',
      description: 'hint_jieji_ribanglestrap_bloodribanglestrap',
    },
  ]
}

/// 赶路劫肋角革三选。debug.forceJiejiEvent('ribanglestrap') / forceRibanglestrap 直接走这里，仍弹出三选。
async function playJiejiRibanglestrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_ribanglestrap')
  dialog.pushSelection('jiejiRibanglestrap', _jiejiRibanglestrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiRibanglestrap')
  var selected = _jiejiRibanglestrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieribanglestrap'
  }

  final seasonId = _jiejiRibanglestrapSeasonId()
  if (selected == 'tieribanglestrap') {
    final herbNeed = _jiejiRibanglestrapTieribanglestrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_ribanglestrap_tieribanglestrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiRibanglestrapTieribanglestrapLife)
      dialog.pushDialog('hint_jieji_ribanglestrap_tieribanglestrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiRibanglestrapTieribanglestrapGongfaRate)
    }
  } else if (selected == 'looseribanglestrap') {
    final moneyNeed = _jiejiRibanglestrapLooseribanglestrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_ribanglestrap_looseribanglestrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiRibanglestrapLooseribanglestrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiRibanglestrapLooseribanglestrapLife)
      dialog.pushDialog('hint_jieji_ribanglestrap_looseribanglestrap_ok', interpolations: [kJiejiRibanglestrapLooseribanglestrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiRibanglestrapCostLife(_jiejiRibanglestrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_ribanglestrap_bloodribanglestrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiRibanglestrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiRibanglestrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_ribanglestrap_bloodribanglestrap_none', interpolations: [kJiejiRibanglestrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0000000000001%。出过则返回 true。
async function tryJiejiRibanglestrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiRibanglestrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastRibanglestrapMove ?? -999
  if (moves - last < kJiejiRibanglestrapMoveCooldown) return false

  var rate = kJiejiRibanglestrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastRibanglestrapMove = moves
  await playJiejiRibanglestrapEvent(terrain)
  return true
}
