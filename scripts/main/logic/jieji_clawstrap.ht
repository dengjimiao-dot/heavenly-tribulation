/// 赶路「劫爪革」三选：系爪 / 解爪 / 血爪。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革都没中时才滚。
const kJiejiClawstrapBaseRate = 0.0000000005
const kJiejiClawstrapMoveCooldown = 24
const kJiejiClawstrapTieclawstrapHerb = 1
const kJiejiClawstrapTieclawstrapLife = 1
const kJiejiClawstrapTieclawstrapGongfaRate = 0.005
const kJiejiClawstrapLooseclawstrapMoney = 1
const kJiejiClawstrapLooseclawstrapMoneyThunder = 1
const kJiejiClawstrapLooseclawstrapHerb = 1
const kJiejiClawstrapLooseclawstrapLife = 1
const kJiejiClawstrapBloodLife = 1
const kJiejiClawstrapBloodLifeBlood = 2
const kJiejiClawstrapBloodGongfaRate = 0.03
const kJiejiClawstrapBloodMoney = 2

function _jiejiClawstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiClawstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiClawstrapTieclawstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiClawstrapTieclawstrapHerb
}

function _jiejiClawstrapLooseclawstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiClawstrapLooseclawstrapMoneyThunder
  return kJiejiClawstrapLooseclawstrapMoney
}

function _jiejiClawstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiClawstrapBloodLifeBlood
  return kJiejiClawstrapBloodLife
}

function _jiejiClawstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiClawstrapNormalizeKind(kind) {
  if (kind == 'tieclawstrap' || kind == 'jieji_clawstrap_tieclawstrap') return 'tieclawstrap'
  if (kind == 'looseclawstrap' || kind == 'jieji_clawstrap_looseclawstrap') return 'looseclawstrap'
  if (kind == 'bloodclawstrap' || kind == 'jieji_clawstrap_bloodclawstrap') return 'bloodclawstrap'
  return null
}

function _jiejiClawstrapChoices() {
  return [
    {
      text: 'jieji_clawstrap_tieclawstrap',
      description: 'hint_jieji_clawstrap_tieclawstrap',
    },
    {
      text: 'jieji_clawstrap_looseclawstrap',
      description: 'hint_jieji_clawstrap_looseclawstrap',
    },
    {
      text: 'jieji_clawstrap_bloodclawstrap',
      description: 'hint_jieji_clawstrap_bloodclawstrap',
    },
  ]
}

/// 赶路劫爪革三选。debug.forceJiejiEvent('clawstrap') / forceClawstrap 直接走这里，仍弹出三选。
async function playJiejiClawstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_clawstrap')
  dialog.pushSelection('jiejiClawstrap', _jiejiClawstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiClawstrap')
  var selected = _jiejiClawstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieclawstrap'
  }

  final seasonId = _jiejiClawstrapSeasonId()
  if (selected == 'tieclawstrap') {
    final herbNeed = _jiejiClawstrapTieclawstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_clawstrap_tieclawstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiClawstrapTieclawstrapLife)
      dialog.pushDialog('hint_jieji_clawstrap_tieclawstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiClawstrapTieclawstrapGongfaRate)
    }
  } else if (selected == 'looseclawstrap') {
    final moneyNeed = _jiejiClawstrapLooseclawstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_clawstrap_looseclawstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiClawstrapLooseclawstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiClawstrapLooseclawstrapLife)
      dialog.pushDialog('hint_jieji_clawstrap_looseclawstrap_ok', interpolations: [kJiejiClawstrapLooseclawstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiClawstrapCostLife(_jiejiClawstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_clawstrap_bloodclawstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiClawstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiClawstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_clawstrap_bloodclawstrap_none', interpolations: [kJiejiClawstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00000005%。出过则返回 true。
async function tryJiejiClawstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiClawstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastClawstrapMove ?? -999
  if (moves - last < kJiejiClawstrapMoveCooldown) return false

  var rate = kJiejiClawstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastClawstrapMove = moves
  await playJiejiClawstrapEvent(terrain)
  return true
}
