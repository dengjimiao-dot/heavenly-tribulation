/// 赶路「劫裹」三选：系裹 / 解裹 / 血裹。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎都没中时才滚。
const kJiejiWrapBaseRate = 0.0002
const kJiejiWrapMoveCooldown = 24
const kJiejiWrapTiewrapHerb = 1
const kJiejiWrapTiewrapLife = 1
const kJiejiWrapTiewrapGongfaRate = 0.015
const kJiejiWrapLoosewrapMoney = 1
const kJiejiWrapLoosewrapMoneyThunder = 1
const kJiejiWrapLoosewrapHerb = 1
const kJiejiWrapLoosewrapLife = 1
const kJiejiWrapBloodLife = 1
const kJiejiWrapBloodLifeBlood = 2
const kJiejiWrapBloodGongfaRate = 0.08
const kJiejiWrapBloodMoney = 2

function _jiejiWrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiWrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiWrapTiewrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiWrapTiewrapHerb
}

function _jiejiWrapLoosewrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiWrapLoosewrapMoneyThunder
  return kJiejiWrapLoosewrapMoney
}

function _jiejiWrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiWrapBloodLifeBlood
  return kJiejiWrapBloodLife
}

function _jiejiWrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiWrapNormalizeKind(kind) {
  if (kind == 'tiewrap' || kind == 'jieji_wrap_tiewrap') return 'tiewrap'
  if (kind == 'loosewrap' || kind == 'jieji_wrap_loosewrap') return 'loosewrap'
  if (kind == 'bloodwrap' || kind == 'jieji_wrap_bloodwrap') return 'bloodwrap'
  return null
}

function _jiejiWrapChoices() {
  return [
    {
      text: 'jieji_wrap_tiewrap',
      description: 'hint_jieji_wrap_tiewrap',
    },
    {
      text: 'jieji_wrap_loosewrap',
      description: 'hint_jieji_wrap_loosewrap',
    },
    {
      text: 'jieji_wrap_bloodwrap',
      description: 'hint_jieji_wrap_bloodwrap',
    },
  ]
}

/// 赶路劫裹三选。debug.forceJiejiEvent('wrap') / forceWrap 直接走这里，仍弹出三选。
async function playJiejiWrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_wrap')
  dialog.pushSelection('jiejiWrap', _jiejiWrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiWrap')
  var selected = _jiejiWrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiewrap'
  }

  final seasonId = _jiejiWrapSeasonId()
  if (selected == 'tiewrap') {
    final herbNeed = _jiejiWrapTiewrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_wrap_tiewrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiWrapTiewrapLife)
      dialog.pushDialog('hint_jieji_wrap_tiewrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiWrapTiewrapGongfaRate)
    }
  } else if (selected == 'loosewrap') {
    final moneyNeed = _jiejiWrapLoosewrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_wrap_loosewrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiWrapLoosewrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiWrapLoosewrapLife)
      dialog.pushDialog('hint_jieji_wrap_loosewrap_ok', interpolations: [kJiejiWrapLoosewrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiWrapCostLife(_jiejiWrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_wrap_bloodwrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiWrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiWrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_wrap_bloodwrap_none', interpolations: [kJiejiWrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.02%。出过则返回 true。
async function tryJiejiWrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiWrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastWrapMove ?? -999
  if (moves - last < kJiejiWrapMoveCooldown) return false

  var rate = kJiejiWrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastWrapMove = moves
  await playJiejiWrapEvent(terrain)
  return true
}
