/// 赶路「劫肩胛革」三选：系胛 / 解胛 / 血胛。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革都没中时才滚。
const kJiejiScapulastrapBaseRate = 0.0000000000005
const kJiejiScapulastrapMoveCooldown = 24
const kJiejiScapulastrapTiescapulastrapHerb = 1
const kJiejiScapulastrapTiescapulastrapLife = 1
const kJiejiScapulastrapTiescapulastrapGongfaRate = 0.005
const kJiejiScapulastrapLoosescapulastrapMoney = 1
const kJiejiScapulastrapLoosescapulastrapMoneyThunder = 1
const kJiejiScapulastrapLoosescapulastrapHerb = 1
const kJiejiScapulastrapLoosescapulastrapLife = 1
const kJiejiScapulastrapBloodLife = 1
const kJiejiScapulastrapBloodLifeBlood = 2
const kJiejiScapulastrapBloodGongfaRate = 0.03
const kJiejiScapulastrapBloodMoney = 2

function _jiejiScapulastrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiScapulastrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiScapulastrapTiescapulastrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiScapulastrapTiescapulastrapHerb
}

function _jiejiScapulastrapLoosescapulastrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiScapulastrapLoosescapulastrapMoneyThunder
  return kJiejiScapulastrapLoosescapulastrapMoney
}

function _jiejiScapulastrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiScapulastrapBloodLifeBlood
  return kJiejiScapulastrapBloodLife
}

function _jiejiScapulastrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiScapulastrapNormalizeKind(kind) {
  if (kind == 'tiescapulastrap' || kind == 'jieji_scapulastrap_tiescapulastrap') return 'tiescapulastrap'
  if (kind == 'loosescapulastrap' || kind == 'jieji_scapulastrap_loosescapulastrap') return 'loosescapulastrap'
  if (kind == 'bloodscapulastrap' || kind == 'jieji_scapulastrap_bloodscapulastrap') return 'bloodscapulastrap'
  return null
}

function _jiejiScapulastrapChoices() {
  return [
    {
      text: 'jieji_scapulastrap_tiescapulastrap',
      description: 'hint_jieji_scapulastrap_tiescapulastrap',
    },
    {
      text: 'jieji_scapulastrap_loosescapulastrap',
      description: 'hint_jieji_scapulastrap_loosescapulastrap',
    },
    {
      text: 'jieji_scapulastrap_bloodscapulastrap',
      description: 'hint_jieji_scapulastrap_bloodscapulastrap',
    },
  ]
}

/// 赶路劫肩胛革三选。debug.forceJiejiEvent('scapulastrap') / forceScapulastrap 直接走这里，仍弹出三选。
async function playJiejiScapulastrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_scapulastrap')
  dialog.pushSelection('jiejiScapulastrap', _jiejiScapulastrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiScapulastrap')
  var selected = _jiejiScapulastrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiescapulastrap'
  }

  final seasonId = _jiejiScapulastrapSeasonId()
  if (selected == 'tiescapulastrap') {
    final herbNeed = _jiejiScapulastrapTiescapulastrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_scapulastrap_tiescapulastrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiScapulastrapTiescapulastrapLife)
      dialog.pushDialog('hint_jieji_scapulastrap_tiescapulastrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiScapulastrapTiescapulastrapGongfaRate)
    }
  } else if (selected == 'loosescapulastrap') {
    final moneyNeed = _jiejiScapulastrapLoosescapulastrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_scapulastrap_loosescapulastrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiScapulastrapLoosescapulastrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiScapulastrapLoosescapulastrapLife)
      dialog.pushDialog('hint_jieji_scapulastrap_loosescapulastrap_ok', interpolations: [kJiejiScapulastrapLoosescapulastrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiScapulastrapCostLife(_jiejiScapulastrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_scapulastrap_bloodscapulastrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiScapulastrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiScapulastrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_scapulastrap_bloodscapulastrap_none', interpolations: [kJiejiScapulastrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00000000005%。出过则返回 true。
async function tryJiejiScapulastrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiScapulastrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastScapulastrapMove ?? -999
  if (moves - last < kJiejiScapulastrapMoveCooldown) return false

  var rate = kJiejiScapulastrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastScapulastrapMove = moves
  await playJiejiScapulastrapEvent(terrain)
  return true
}
