/// 赶路「劫腕革」三选：系腕 / 解腕 / 血腕。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革都没中时才滚。
const kJiejiWriststrapBaseRate = 0.0000000002
const kJiejiWriststrapMoveCooldown = 24
const kJiejiWriststrapTiewriststrapHerb = 1
const kJiejiWriststrapTiewriststrapLife = 1
const kJiejiWriststrapTiewriststrapGongfaRate = 0.005
const kJiejiWriststrapLoosewriststrapMoney = 1
const kJiejiWriststrapLoosewriststrapMoneyThunder = 1
const kJiejiWriststrapLoosewriststrapHerb = 1
const kJiejiWriststrapLoosewriststrapLife = 1
const kJiejiWriststrapBloodLife = 1
const kJiejiWriststrapBloodLifeBlood = 2
const kJiejiWriststrapBloodGongfaRate = 0.03
const kJiejiWriststrapBloodMoney = 2

function _jiejiWriststrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiWriststrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiWriststrapTiewriststrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiWriststrapTiewriststrapHerb
}

function _jiejiWriststrapLoosewriststrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiWriststrapLoosewriststrapMoneyThunder
  return kJiejiWriststrapLoosewriststrapMoney
}

function _jiejiWriststrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiWriststrapBloodLifeBlood
  return kJiejiWriststrapBloodLife
}

function _jiejiWriststrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiWriststrapNormalizeKind(kind) {
  if (kind == 'tiewriststrap' || kind == 'jieji_wriststrap_tiewriststrap') return 'tiewriststrap'
  if (kind == 'loosewriststrap' || kind == 'jieji_wriststrap_loosewriststrap') return 'loosewriststrap'
  if (kind == 'bloodwriststrap' || kind == 'jieji_wriststrap_bloodwriststrap') return 'bloodwriststrap'
  return null
}

function _jiejiWriststrapChoices() {
  return [
    {
      text: 'jieji_wriststrap_tiewriststrap',
      description: 'hint_jieji_wriststrap_tiewriststrap',
    },
    {
      text: 'jieji_wriststrap_loosewriststrap',
      description: 'hint_jieji_wriststrap_loosewriststrap',
    },
    {
      text: 'jieji_wriststrap_bloodwriststrap',
      description: 'hint_jieji_wriststrap_bloodwriststrap',
    },
  ]
}

/// 赶路劫腕革三选。debug.forceJiejiEvent('wriststrap') / forceWriststrap 直接走这里，仍弹出三选。
async function playJiejiWriststrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_wriststrap')
  dialog.pushSelection('jiejiWriststrap', _jiejiWriststrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiWriststrap')
  var selected = _jiejiWriststrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiewriststrap'
  }

  final seasonId = _jiejiWriststrapSeasonId()
  if (selected == 'tiewriststrap') {
    final herbNeed = _jiejiWriststrapTiewriststrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_wriststrap_tiewriststrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiWriststrapTiewriststrapLife)
      dialog.pushDialog('hint_jieji_wriststrap_tiewriststrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiWriststrapTiewriststrapGongfaRate)
    }
  } else if (selected == 'loosewriststrap') {
    final moneyNeed = _jiejiWriststrapLoosewriststrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_wriststrap_loosewriststrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiWriststrapLoosewriststrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiWriststrapLoosewriststrapLife)
      dialog.pushDialog('hint_jieji_wriststrap_loosewriststrap_ok', interpolations: [kJiejiWriststrapLoosewriststrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiWriststrapCostLife(_jiejiWriststrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_wriststrap_bloodwriststrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiWriststrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiWriststrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_wriststrap_bloodwriststrap_none', interpolations: [kJiejiWriststrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.00000002%。出过则返回 true。
async function tryJiejiWriststrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiWriststrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastWriststrapMove ?? -999
  if (moves - last < kJiejiWriststrapMoveCooldown) return false

  var rate = kJiejiWriststrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastWriststrapMove = moves
  await playJiejiWriststrapEvent(terrain)
  return true
}
