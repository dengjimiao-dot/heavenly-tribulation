/// 赶路「劫杯」三选：举杯 / 收杯 / 血杯。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗都没中时才滚。
const kJiejiCupBaseRate = 0.012
const kJiejiCupMoveCooldown = 24
const kJiejiCupRaisecupHerb = 1
const kJiejiCupRaisecupLife = 5
const kJiejiCupRaisecupGongfaRate = 0.08
const kJiejiCupStowcupMoney = 8
const kJiejiCupStowcupMoneyThunder = 4
const kJiejiCupStowcupHerb = 2
const kJiejiCupStowcupLife = 3
const kJiejiCupBloodLife = 2
const kJiejiCupBloodLifeBlood = 3
const kJiejiCupBloodGongfaRate = 0.26
const kJiejiCupBloodMoney = 16

function _jiejiCupSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiCupTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiCupRaisecupHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiCupRaisecupHerb
}

function _jiejiCupStowcupMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiCupStowcupMoneyThunder
  return kJiejiCupStowcupMoney
}

function _jiejiCupBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiCupBloodLifeBlood
  return kJiejiCupBloodLife
}

function _jiejiCupCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiCupNormalizeKind(kind) {
  if (kind == 'raisecup' || kind == 'jieji_cup_raisecup') return 'raisecup'
  if (kind == 'stowcup' || kind == 'jieji_cup_stowcup') return 'stowcup'
  if (kind == 'bloodcup' || kind == 'jieji_cup_bloodcup') return 'bloodcup'
  return null
}

function _jiejiCupChoices() {
  return [
    {
      text: 'jieji_cup_raisecup',
      description: 'hint_jieji_cup_raisecup',
    },
    {
      text: 'jieji_cup_stowcup',
      description: 'hint_jieji_cup_stowcup',
    },
    {
      text: 'jieji_cup_bloodcup',
      description: 'hint_jieji_cup_bloodcup',
    },
  ]
}

/// 赶路劫杯三选。debug.forceJiejiEvent('cup') / forceCup 直接走这里，仍弹出三选。
async function playJiejiCupEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_cup')
  dialog.pushSelection('jiejiCup', _jiejiCupChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiCup')
  var selected = _jiejiCupNormalizeKind(picked)
  if (selected == null) {
    selected = 'raisecup'
  }

  final seasonId = _jiejiCupSeasonId()
  if (selected == 'raisecup') {
    final herbNeed = _jiejiCupRaisecupHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_cup_raisecup_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiCupRaisecupLife)
      dialog.pushDialog('hint_jieji_cup_raisecup_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiCupRaisecupGongfaRate)
    }
  } else if (selected == 'stowcup') {
    final moneyNeed = _jiejiCupStowcupMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_cup_stowcup_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiCupStowcupHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiCupStowcupLife)
      dialog.pushDialog('hint_jieji_cup_stowcup_ok', interpolations: [kJiejiCupStowcupHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiCupCostLife(_jiejiCupBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_cup_bloodcup_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiCupBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiCupBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_cup_bloodcup_none', interpolations: [kJiejiCupBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 1.2%。出过则返回 true。
async function tryJiejiCupOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiCupTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastCupMove ?? -999
  if (moves - last < kJiejiCupMoveCooldown) return false

  var rate = kJiejiCupBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastCupMove = moves
  await playJiejiCupEvent(terrain)
  return true
}
