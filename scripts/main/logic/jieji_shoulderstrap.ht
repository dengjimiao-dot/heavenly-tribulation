/// 赶路「劫肩革」三选：系肩 / 解肩 / 血肩。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革都没中时才滚。
const kJiejiShoulderstrapBaseRate = 0.00000005
const kJiejiShoulderstrapMoveCooldown = 24
const kJiejiShoulderstrapTieshoulderstrapHerb = 1
const kJiejiShoulderstrapTieshoulderstrapLife = 1
const kJiejiShoulderstrapTieshoulderstrapGongfaRate = 0.005
const kJiejiShoulderstrapLooseshoulderstrapMoney = 1
const kJiejiShoulderstrapLooseshoulderstrapMoneyThunder = 1
const kJiejiShoulderstrapLooseshoulderstrapHerb = 1
const kJiejiShoulderstrapLooseshoulderstrapLife = 1
const kJiejiShoulderstrapBloodLife = 1
const kJiejiShoulderstrapBloodLifeBlood = 2
const kJiejiShoulderstrapBloodGongfaRate = 0.03
const kJiejiShoulderstrapBloodMoney = 2

function _jiejiShoulderstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiShoulderstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiShoulderstrapTieshoulderstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiShoulderstrapTieshoulderstrapHerb
}

function _jiejiShoulderstrapLooseshoulderstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiShoulderstrapLooseshoulderstrapMoneyThunder
  return kJiejiShoulderstrapLooseshoulderstrapMoney
}

function _jiejiShoulderstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiShoulderstrapBloodLifeBlood
  return kJiejiShoulderstrapBloodLife
}

function _jiejiShoulderstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiShoulderstrapNormalizeKind(kind) {
  if (kind == 'tieshoulderstrap' || kind == 'jieji_shoulderstrap_tieshoulderstrap') return 'tieshoulderstrap'
  if (kind == 'looseshoulderstrap' || kind == 'jieji_shoulderstrap_looseshoulderstrap') return 'looseshoulderstrap'
  if (kind == 'bloodshoulderstrap' || kind == 'jieji_shoulderstrap_bloodshoulderstrap') return 'bloodshoulderstrap'
  return null
}

function _jiejiShoulderstrapChoices() {
  return [
    {
      text: 'jieji_shoulderstrap_tieshoulderstrap',
      description: 'hint_jieji_shoulderstrap_tieshoulderstrap',
    },
    {
      text: 'jieji_shoulderstrap_looseshoulderstrap',
      description: 'hint_jieji_shoulderstrap_looseshoulderstrap',
    },
    {
      text: 'jieji_shoulderstrap_bloodshoulderstrap',
      description: 'hint_jieji_shoulderstrap_bloodshoulderstrap',
    },
  ]
}

/// 赶路劫肩革三选。debug.forceJiejiEvent('shoulderstrap') / forceShoulderstrap 直接走这里，仍弹出三选。
async function playJiejiShoulderstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_shoulderstrap')
  dialog.pushSelection('jiejiShoulderstrap', _jiejiShoulderstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiShoulderstrap')
  var selected = _jiejiShoulderstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tieshoulderstrap'
  }

  final seasonId = _jiejiShoulderstrapSeasonId()
  if (selected == 'tieshoulderstrap') {
    final herbNeed = _jiejiShoulderstrapTieshoulderstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_shoulderstrap_tieshoulderstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiShoulderstrapTieshoulderstrapLife)
      dialog.pushDialog('hint_jieji_shoulderstrap_tieshoulderstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiShoulderstrapTieshoulderstrapGongfaRate)
    }
  } else if (selected == 'looseshoulderstrap') {
    final moneyNeed = _jiejiShoulderstrapLooseshoulderstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_shoulderstrap_looseshoulderstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiShoulderstrapLooseshoulderstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiShoulderstrapLooseshoulderstrapLife)
      dialog.pushDialog('hint_jieji_shoulderstrap_looseshoulderstrap_ok', interpolations: [kJiejiShoulderstrapLooseshoulderstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiShoulderstrapCostLife(_jiejiShoulderstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_shoulderstrap_bloodshoulderstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiShoulderstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiShoulderstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_shoulderstrap_bloodshoulderstrap_none', interpolations: [kJiejiShoulderstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000005%。出过则返回 true。
async function tryJiejiShoulderstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiShoulderstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastShoulderstrapMove ?? -999
  if (moves - last < kJiejiShoulderstrapMoveCooldown) return false

  var rate = kJiejiShoulderstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastShoulderstrapMove = moves
  await playJiejiShoulderstrapEvent(terrain)
  return true
}
