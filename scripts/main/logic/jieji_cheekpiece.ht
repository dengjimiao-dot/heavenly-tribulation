/// 赶路「劫颊革」三选：系颊 / 解颊 / 血颊。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革都没中时才滚。
const kJiejiCheekpieceBaseRate = 0.000003
const kJiejiCheekpieceMoveCooldown = 24
const kJiejiCheekpieceTiecheekpieceHerb = 1
const kJiejiCheekpieceTiecheekpieceLife = 1
const kJiejiCheekpieceTiecheekpieceGongfaRate = 0.005
const kJiejiCheekpieceLoosecheekpieceMoney = 1
const kJiejiCheekpieceLoosecheekpieceMoneyThunder = 1
const kJiejiCheekpieceLoosecheekpieceHerb = 1
const kJiejiCheekpieceLoosecheekpieceLife = 1
const kJiejiCheekpieceBloodLife = 1
const kJiejiCheekpieceBloodLifeBlood = 2
const kJiejiCheekpieceBloodGongfaRate = 0.03
const kJiejiCheekpieceBloodMoney = 2

function _jiejiCheekpieceSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiCheekpieceTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiCheekpieceTiecheekpieceHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiCheekpieceTiecheekpieceHerb
}

function _jiejiCheekpieceLoosecheekpieceMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiCheekpieceLoosecheekpieceMoneyThunder
  return kJiejiCheekpieceLoosecheekpieceMoney
}

function _jiejiCheekpieceBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiCheekpieceBloodLifeBlood
  return kJiejiCheekpieceBloodLife
}

function _jiejiCheekpieceCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiCheekpieceNormalizeKind(kind) {
  if (kind == 'tiecheekpiece' || kind == 'jieji_cheekpiece_tiecheekpiece') return 'tiecheekpiece'
  if (kind == 'loosecheekpiece' || kind == 'jieji_cheekpiece_loosecheekpiece') return 'loosecheekpiece'
  if (kind == 'bloodcheekpiece' || kind == 'jieji_cheekpiece_bloodcheekpiece') return 'bloodcheekpiece'
  return null
}

function _jiejiCheekpieceChoices() {
  return [
    {
      text: 'jieji_cheekpiece_tiecheekpiece',
      description: 'hint_jieji_cheekpiece_tiecheekpiece',
    },
    {
      text: 'jieji_cheekpiece_loosecheekpiece',
      description: 'hint_jieji_cheekpiece_loosecheekpiece',
    },
    {
      text: 'jieji_cheekpiece_bloodcheekpiece',
      description: 'hint_jieji_cheekpiece_bloodcheekpiece',
    },
  ]
}

/// 赶路劫颊革三选。debug.forceJiejiEvent('cheekpiece') / forceCheekpiece 直接走这里，仍弹出三选。
async function playJiejiCheekpieceEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_cheekpiece')
  dialog.pushSelection('jiejiCheekpiece', _jiejiCheekpieceChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiCheekpiece')
  var selected = _jiejiCheekpieceNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiecheekpiece'
  }

  final seasonId = _jiejiCheekpieceSeasonId()
  if (selected == 'tiecheekpiece') {
    final herbNeed = _jiejiCheekpieceTiecheekpieceHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_cheekpiece_tiecheekpiece_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiCheekpieceTiecheekpieceLife)
      dialog.pushDialog('hint_jieji_cheekpiece_tiecheekpiece_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiCheekpieceTiecheekpieceGongfaRate)
    }
  } else if (selected == 'loosecheekpiece') {
    final moneyNeed = _jiejiCheekpieceLoosecheekpieceMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_cheekpiece_loosecheekpiece_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiCheekpieceLoosecheekpieceHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiCheekpieceLoosecheekpieceLife)
      dialog.pushDialog('hint_jieji_cheekpiece_loosecheekpiece_ok', interpolations: [kJiejiCheekpieceLoosecheekpieceHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiCheekpieceCostLife(_jiejiCheekpieceBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_cheekpiece_bloodcheekpiece_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiCheekpieceBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiCheekpieceBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_cheekpiece_bloodcheekpiece_none', interpolations: [kJiejiCheekpieceBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.0003%。出过则返回 true。
async function tryJiejiCheekpieceOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiCheekpieceTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastCheekpieceMove ?? -999
  if (moves - last < kJiejiCheekpieceMoveCooldown) return false

  var rate = kJiejiCheekpieceBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastCheekpieceMove = moves
  await playJiejiCheekpieceEvent(terrain)
  return true
}
