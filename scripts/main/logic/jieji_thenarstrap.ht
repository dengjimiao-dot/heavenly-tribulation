/// 赶路「劫大鱼际革」三选：系大鱼际 / 解大鱼际 / 血大鱼际。隐藏、劫兆、野遇、赶路、行商、拾荒、扎营、残锋、残卷、雾灯、残鼓、汲泉、劫幡、劫铃、劫符、劫旌、劫烛、劫角、劫笛、劫笠、劫带、劫履、劫氅、劫扇、劫杖、劫伞、劫面、劫帔、劫手套、劫戒、劫镜、劫鼓、劫炬、劫梳、劫勺、劫碗、劫杯、劫罐、劫瓶、劫墨、劫袍、劫带、劫簪、劫笔、劫针、劫扣、劫绳、劫珠、劫钗、劫绦、劫穗、劫缎、劫缨、劫袖、劫领、劫缘、劫辫、劫翎、劫裹、劫轭、劫辔、劫缰、劫镫、劫鞦、劫勒、劫衔、劫绊、劫鞍、劫刺、劫绊索、劫蹄铁、劫鞍垫、劫肚带、劫尻带、劫额革、劫鼻革、劫咽革、劫颊革、劫顶革、劫面革、劫障革、劫笼革、劫套革、劫羁革、劫络革、劫鬃革、劫罗革、劫甩革、劫肚革、劫裙革、劫翼革、劫扣革、劫环革、劫胸革、劫颈革、劫肩革、劫背革、劫腰革、劫胯革、劫胁革、劫肋革、劫股革、劫膝革、劫胫革、劫踝革、劫踵革、劫足革、劫趾革、劫爪革、劫掌革、劫腕革、劫指革、劫节革、劫甲革、劫拇革、劫肘革、劫肱革、劫膊革、劫桡革、劫鹰革、劫喙革、劫肩峰革、劫肩胛革、劫锁骨革、劫胸骨革、劫柄革、劫剑突革、劫肋软革、劫浮肋革、劫肋弓革、劫肋间革、劫真肋革、劫假肋革、劫肋头革、劫肋颈革、劫肋结节革、劫肋角革、劫肋沟革、劫肋脊革、劫肋体革、劫肋椎革、劫肋横突革、劫肋软骨结革、劫胸肋革、劫柄胸革、劫胸骨角革、劫剑胸革、劫肋胸革、劫颈静脉切迹革、劫锁骨切迹革、劫肋软骨弓革、劫肋下角革、劫胸骨体革、劫肋剑突革、劫锁间韧带革、劫肋软骨结合革、劫胸骨肌革、劫胸大肌革、劫前锯肌革、劫锁骨下肌革、劫背阔肌革、劫斜方肌革、劫三角肌革、劫冈下肌革、劫大圆肌革、劫小圆肌革、劫冈上肌革、劫肩胛下肌革、劫喙肱肌革、劫肱肌革、劫肱三头肌革、劫肘肌革、劫肱桡肌革、劫指伸肌革、劫尺侧腕屈肌革、劫掌长肌革、劫桡侧腕屈肌革、劫尺侧腕伸肌革、劫桡侧腕长伸肌革、劫桡侧腕短伸肌革、劫拇长展肌革、劫拇短伸肌革、劫拇长伸肌革、劫拇短展肌革、劫拇长屈肌革、劫拇短屈肌革、劫拇对掌肌革、劫拇收肌革、劫蚓状肌革、劫骨间掌侧肌革、劫第一骨间背侧肌革、劫第二骨间背侧肌革、劫第三骨间背侧肌革、劫第四骨间背侧肌革、劫小指展肌革、劫小指短屈肌革、劫小指对掌肌革、劫食指展肌革、劫指浅屈肌革、劫指深屈肌革、劫指总伸肌革、劫食指伸肌革、劫小指伸肌革、劫旋后肌革、劫旋前圆肌革、劫旋前方肌革、劫掌短肌革、劫屈肌支持带革、劫大鱼际革都没中时才滚。
const kJiejiThenarstrapBaseRate = 0.00000000000000008
const kJiejiThenarstrapMoveCooldown = 24
const kJiejiThenarstrapTiethenarstrapHerb = 1
const kJiejiThenarstrapTiethenarstrapLife = 1
const kJiejiThenarstrapTiethenarstrapGongfaRate = 0.005
const kJiejiThenarstrapLoosethenarstrapMoney = 1
const kJiejiThenarstrapLoosethenarstrapMoneyThunder = 1
const kJiejiThenarstrapLoosethenarstrapHerb = 1
const kJiejiThenarstrapLoosethenarstrapLife = 1
const kJiejiThenarstrapBloodLife = 1
const kJiejiThenarstrapBloodLifeBlood = 2
const kJiejiThenarstrapBloodGongfaRate = 0.03
const kJiejiThenarstrapBloodMoney = 2

function _jiejiThenarstrapSeasonId() {
  if (game.jieji != null && game.jieji.seasonId != null) {
    return game.jieji.seasonId
  }
  return null
}

function _jiejiThenarstrapTutorialLocked() {
  return game.enableTutorial && game.flags.tutorial.bountyQuest != true
}

function _jiejiThenarstrapTiethenarstrapHerbCost(seasonId) {
  if (seasonId == 'mist') return 0
  return kJiejiThenarstrapTiethenarstrapHerb
}

function _jiejiThenarstrapLoosethenarstrapMoneyCost(seasonId) {
  if (seasonId == 'thunder') return kJiejiThenarstrapLoosethenarstrapMoneyThunder
  return kJiejiThenarstrapLoosethenarstrapMoney
}

function _jiejiThenarstrapBloodLifeCost(seasonId) {
  if (seasonId == 'blood') return kJiejiThenarstrapBloodLifeBlood
  return kJiejiThenarstrapBloodLife
}

function _jiejiThenarstrapCostLife(want) {
  var lost = want
  final life = hero.life ?? 1
  if (life - lost < 1) lost = life - 1
  if (lost < 0) lost = 0
  if (lost > 0) {
    Player.setLife(hero.life - lost)
  }
  return lost
}

function _jiejiThenarstrapNormalizeKind(kind) {
  if (kind == 'tiethenarstrap' || kind == 'jieji_thenarstrap_tiethenarstrap') return 'tiethenarstrap'
  if (kind == 'loosethenarstrap' || kind == 'jieji_thenarstrap_loosethenarstrap') return 'loosethenarstrap'
  if (kind == 'bloodthenarstrap' || kind == 'jieji_thenarstrap_bloodthenarstrap') return 'bloodthenarstrap'
  return null
}

function _jiejiThenarstrapChoices() {
  return [
    {
      text: 'jieji_thenarstrap_tiethenarstrap',
      description: 'hint_jieji_thenarstrap_tiethenarstrap',
    },
    {
      text: 'jieji_thenarstrap_loosethenarstrap',
      description: 'hint_jieji_thenarstrap_loosethenarstrap',
    },
    {
      text: 'jieji_thenarstrap_bloodthenarstrap',
      description: 'hint_jieji_thenarstrap_bloodthenarstrap',
    },
  ]
}

/// 赶路劫大鱼际革三选。debug.forceJiejiEvent('thenarstrap') / forceThenarstrap 直接走这里，仍弹出三选。
async function playJiejiThenarstrapEvent(terrain) {
  if (hero == null) return false

  dialog.pushDialog('hint_jieji_thenarstrap')
  dialog.pushSelection('jiejiThenarstrap', _jiejiThenarstrapChoices())
  await dialog.execute()
  final picked = dialog.checkSelected('jiejiThenarstrap')
  var selected = _jiejiThenarstrapNormalizeKind(picked)
  if (selected == null) {
    selected = 'tiethenarstrap'
  }

  final seasonId = _jiejiThenarstrapSeasonId()
  if (selected == 'tiethenarstrap') {
    final herbNeed = _jiejiThenarstrapTiethenarstrapHerbCost(seasonId)
    final herbHave = hero.materials['herb'] ?? 0
    if (herbNeed > 0 && herbHave < herbNeed) {
      dialog.pushDialog('hint_jieji_thenarstrap_tiethenarstrap_broke', interpolations: [herbNeed])
      await dialog.execute()
    } else {
      if (herbNeed > 0) {
        Player.exhaust('herb', herbNeed)
      }
      final healed = Player.restoreLife(kJiejiThenarstrapTiethenarstrapLife)
      dialog.pushDialog('hint_jieji_thenarstrap_tiethenarstrap_ok', interpolations: [healed])
      await dialog.execute()
      await tryDropGongfaShard(rate: kJiejiThenarstrapTiethenarstrapGongfaRate)
    }
  } else if (selected == 'loosethenarstrap') {
    final moneyNeed = _jiejiThenarstrapLoosethenarstrapMoneyCost(seasonId)
    final moneyHave = hero.materials['money'] ?? 0
    if (moneyHave < moneyNeed) {
      dialog.pushDialog('hint_jieji_thenarstrap_loosethenarstrap_broke', interpolations: [moneyNeed])
      await dialog.execute()
    } else {
      Player.exhaust('money', moneyNeed)
      await Player.collect('herb', kJiejiThenarstrapLoosethenarstrapHerb, incurIncident: false)
      final healed = Player.restoreLife(kJiejiThenarstrapLoosethenarstrapLife)
      dialog.pushDialog('hint_jieji_thenarstrap_loosethenarstrap_ok', interpolations: [kJiejiThenarstrapLoosethenarstrapHerb, healed])
      await dialog.execute()
    }
  } else {
    final lost = _jiejiThenarstrapCostLife(_jiejiThenarstrapBloodLifeCost(seasonId))
    dialog.pushDialog('hint_jieji_thenarstrap_bloodthenarstrap_ok', interpolations: [lost])
    await dialog.execute()
    final dropped = await tryDropGongfaShard(rate: kJiejiThenarstrapBloodGongfaRate)
    if (dropped != true) {
      await Player.collect('money', kJiejiThenarstrapBloodMoney, incurIncident: false)
      dialog.pushDialog('hint_jieji_thenarstrap_bloodthenarstrap_none', interpolations: [kJiejiThenarstrapBloodMoney])
      await dialog.execute()
    }
  }

  Game.updateUI()
  return true
}

/// 赶路触发：教程锁与路遇相同；冷却 24 步；约 0.000000000000008%。出过则返回 true。
async function tryJiejiThenarstrapOnMove(terrain) {
  if (hero == null) return false
  if (_jiejiThenarstrapTutorialLocked()) return false

  final jieji = ensureJiejiFlags()
  final moves = jieji.worldMoves ?? 0
  final last = jieji.lastThenarstrapMove ?? -999
  if (moves - last < kJiejiThenarstrapMoveCooldown) return false

  var rate = kJiejiThenarstrapBaseRate
  if (rate < 0) rate = 0
  if (random.nextDouble() > rate) return false

  jieji.lastThenarstrapMove = moves
  await playJiejiThenarstrapEvent(terrain)
  return true
}
